{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-prophetic-archive.local/schemas/bible-book-v1.schema.json",
  "title": "The Prophetic Archive Bible Book v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "collection",
    "document_type",
    "title",
    "translationCode",
    "bookId",
    "bookOrder",
    "testament",
    "chapters",
    "blocks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "collection": {
      "const": "kjv-bible"
    },
    "document_type": {
      "const": "bible_book"
    },
    "title": {
      "type": "string"
    },
    "translationCode": {
      "const": "KJV"
    },
    "bookId": {
      "type": "string"
    },
    "bookOrder": {
      "type": "integer",
      "minimum": 1,
      "maximum": 66
    },
    "testament": {
      "enum": [
        "old",
        "new"
      ]
    },
    "chapters": {
      "type": "array",
      "minItems": 1
    },
    "blocks": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
