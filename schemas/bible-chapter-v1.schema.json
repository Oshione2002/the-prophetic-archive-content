{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-prophetic-archive.local/schemas/bible-chapter-v1.schema.json",
  "title": "The Prophetic Archive Bible Chapter v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "collection",
    "document_type",
    "title",
    "translationCode",
    "bookId",
    "bookName",
    "bookOrder",
    "testament",
    "chapter",
    "sortOrder",
    "verses"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "collection": {
      "const": "kjv-bible"
    },
    "document_type": {
      "const": "bible_chapter"
    },
    "translationCode": {
      "const": "KJV"
    },
    "bookId": {
      "type": "string"
    },
    "bookName": {
      "type": "string"
    },
    "bookOrder": {
      "type": "integer",
      "minimum": 1,
      "maximum": 66
    },
    "testament": {
      "enum": [
        "old",
        "new"
      ]
    },
    "chapter": {
      "type": "integer",
      "minimum": 1
    },
    "sortOrder": {
      "type": "integer",
      "minimum": 1
    },
    "verses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "verse",
          "verseId",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "verse": {
            "type": "integer",
            "minimum": 1
          },
          "verseId": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
