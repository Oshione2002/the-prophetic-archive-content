{
  "schemaVersion": 1,
  "id": "kjv-genesis-011",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 11,
  "title": "Genesis 11",
  "display_title": "Genesis 11",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "genesis",
  "book": "Genesis",
  "bookName": "Genesis",
