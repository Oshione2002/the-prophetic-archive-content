  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:genesis:5:1",
      "numberLabel": "1",
      "text": "This is the book of the generations of Adam. In the day that God created man, in the likeness of God made he him;",
      "metadata": {
        "reference": "Genesis 5:1",
        "verseKey": "kjv:genesis:5:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:genesis:5:2",
      "numberLabel": "2",
      "text": "Male and female created he them; and blessed them, and called their name Adam, in the day when they were created.",
      "metadata": {
        "reference": "Genesis 5:2",
        "verseKey": "kjv:genesis:5:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:genesis:5:3",
      "numberLabel": "3",
      "text": "And Adam lived an hundred and thirty years, and begat a son in his own likeness, after his image; and called his name Seth:",
      "metadata": {
        "reference": "Genesis 5:3",
        "verseKey": "kjv:genesis:5:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:genesis:5:4",
      "numberLabel": "4",
      "text": "And the days of Adam after he had begotten Seth were eight hundred years: and he begat sons and daughters:",
      "metadata": {
        "reference": "Genesis 5:4",
        "verseKey": "kjv:genesis:5:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:genesis:5:5",
      "numberLabel": "5",
      "text": "And all the days that Adam lived were nine hundred and thirty years: and he died.",
      "metadata": {
        "reference": "Genesis 5:5",
        "verseKey": "kjv:genesis:5:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:genesis:5:6",
      "numberLabel": "6",
      "text": "And Seth lived an hundred and five years, and begat Enos:",
      "metadata": {
        "reference": "Genesis 5:6",
        "verseKey": "kjv:genesis:5:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:genesis:5:7",
      "numberLabel": "7",
      "text": "And Seth lived after he begat Enos eight hundred and seven years, and begat sons and daughters:",
      "metadata": {
        "reference": "Genesis 5:7",
        "verseKey": "kjv:genesis:5:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:genesis:5:8",
      "numberLabel": "8",
      "text": "And all the days of Seth were nine hundred and twelve years: and he died.",
      "metadata": {
        "reference": "Genesis 5:8",
        "verseKey": "kjv:genesis:5:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:genesis:5:9",
      "numberLabel": "9",
      "text": "And Enos lived ninety years, and begat Cainan:",
      "metadata": {
        "reference": "Genesis 5:9",
        "verseKey": "kjv:genesis:5:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:genesis:5:10",
      "numberLabel": "10",
      "text": "And Enos lived after he begat Cainan eight hundred and fifteen years, and begat sons and daughters:",
      "metadata": {
        "reference": "Genesis 5:10",
        "verseKey": "kjv:genesis:5:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:genesis:5:11",
      "numberLabel": "11",
      "text": "And all the days of Enos were nine hundred and five years: and he died.",
      "metadata": {
        "reference": "Genesis 5:11",
        "verseKey": "kjv:genesis:5:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:genesis:5:12",
      "numberLabel": "12",
      "text": "And Cainan lived seventy years, and begat Mahalaleel:",
      "metadata": {
        "reference": "Genesis 5:12",
        "verseKey": "kjv:genesis:5:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:genesis:5:13",
      "numberLabel": "13",
      "text": "And Cainan lived after he begat Mahalaleel eight hundred and forty years, and begat sons and daughters:",
      "metadata": {
        "reference": "Genesis 5:13",
        "verseKey": "kjv:genesis:5:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:genesis:5:14",
      "numberLabel": "14",
      "text": "And all the days of Cainan were nine hundred and ten years: and he died.",
      "metadata": {
        "reference": "Genesis 5:14",
        "verseKey": "kjv:genesis:5:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:genesis:5:15",
      "numberLabel": "15",
      "text": "And Mahalaleel lived sixty and five years, and begat Jared:",
      "metadata": {
        "reference": "Genesis 5:15",
        "verseKey": "kjv:genesis:5:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:genesis:5:16",
      "numberLabel": "16",
      "text": "And Mahalaleel lived after he begat Jared eight hundred and thirty years, and begat sons and daughters:",
      "metadata": {
        "reference": "Genesis 5:16",
        "verseKey": "kjv:genesis:5:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:genesis:5:17",
      "numberLabel": "17",
      "text": "And all the days of Mahalaleel were eight hundred ninety and five years: and he died.",
      "metadata": {
        "reference": "Genesis 5:17",
        "verseKey": "kjv:genesis:5:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:genesis:5:18",
      "numberLabel": "18",
      "text": "And Jared lived an hundred sixty and two years, and he begat Enoch:",
      "metadata": {
        "reference": "Genesis 5:18",
        "verseKey": "kjv:genesis:5:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:genesis:5:19",
      "numberLabel": "19",
      "text": "And Jared lived after he begat Enoch eight hundred years, and begat sons and daughters:",
      "metadata": {
        "reference": "Genesis 5:19",
        "verseKey": "kjv:genesis:5:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:genesis:5:20",
      "numberLabel": "20",
      "text": "And all the days of Jared were nine hundred sixty and two years: and he died.",
      "metadata": {
        "reference": "Genesis 5:20",
        "verseKey": "kjv:genesis:5:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:genesis:5:21",
      "numberLabel": "21",
      "text": "And Enoch lived sixty and five years, and begat Methuselah:",
      "metadata": {
        "reference": "Genesis 5:21",
        "verseKey": "kjv:genesis:5:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:genesis:5:22",
      "numberLabel": "22",
      "text": "And Enoch walked with God after he begat Methuselah three hundred years, and begat sons and daughters:",
      "metadata": {
        "reference": "Genesis 5:22",
        "verseKey": "kjv:genesis:5:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:genesis:5:23",
      "numberLabel": "23",
      "text": "And all the days of Enoch were three hundred sixty and five years:",
      "metadata": {
        "reference": "Genesis 5:23",
        "verseKey": "kjv:genesis:5:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:genesis:5:24",
      "numberLabel": "24",
      "text": "And Enoch walked with God: and he was not; for God took him.",
      "metadata": {
        "reference": "Genesis 5:24",
        "verseKey": "kjv:genesis:5:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:genesis:5:25",
      "numberLabel": "25",
      "text": "And Methuselah lived an hundred eighty and seven years, and begat Lamech:",
      "metadata": {
        "reference": "Genesis 5:25",
        "verseKey": "kjv:genesis:5:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:genesis:5:26",
      "numberLabel": "26",
      "text": "And Methuselah lived after he begat Lamech seven hundred eighty and two years, and begat sons and daughters:",
      "metadata": {
        "reference": "Genesis 5:26",
        "verseKey": "kjv:genesis:5:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:genesis:5:27",
      "numberLabel": "27",
      "text": "And all the days of Methuselah were nine hundred sixty and nine years: and he died.",
      "metadata": {
        "reference": "Genesis 5:27",
        "verseKey": "kjv:genesis:5:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:genesis:5:28",
      "numberLabel": "28",
      "text": "And Lamech lived an hundred eighty and two years, and begat a son:",
      "metadata": {
        "reference": "Genesis 5:28",
        "verseKey": "kjv:genesis:5:28"
      }
    },
    {
      "id": "verse-029",
      "type": "bible_verse",
      "verse": 29,
      "verseId": "kjv:genesis:5:29",
      "numberLabel": "29",
      "text": "And he called his name Noah, saying, This same shall comfort us concerning our work and toil of our hands, because of the ground which the LORD hath cursed.",
      "metadata": {
        "reference": "Genesis 5:29",
        "verseKey": "kjv:genesis:5:29"
      }
    },
    {
      "id": "verse-030",
      "type": "bible_verse",
      "verse": 30,
      "verseId": "kjv:genesis:5:30",
      "numberLabel": "30",
      "text": "And Lamech lived after he begat Noah five hundred ninety and five years, and begat sons and daughters:",
      "metadata": {
        "reference": "Genesis 5:30",
        "verseKey": "kjv:genesis:5:30"
      }
    },
    {
      "id": "verse-031",
      "type": "bible_verse",
      "verse": 31,
      "verseId": "kjv:genesis:5:31",
      "numberLabel": "31",
      "text": "And all the days of Lamech were seven hundred seventy and seven years: and he died.",
      "metadata": {
        "reference": "Genesis 5:31",
        "verseKey": "kjv:genesis:5:31"
      }
    },
    {
      "id": "verse-032",
      "type": "bible_verse",
      "verse": 32,
      "verseId": "kjv:genesis:5:32",
      "numberLabel": "32",
      "text": "And Noah was five hundred years old: and Noah begat Shem, Ham, and Japheth.",
      "metadata": {
        "reference": "Genesis 5:32",
        "verseKey": "kjv:genesis:5:32"
      }
    }
  ],
