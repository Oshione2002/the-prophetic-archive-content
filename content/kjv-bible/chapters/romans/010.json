{
  "schemaVersion": 1,
  "id": "kjv-romans-010",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 10,
  "title": "Romans 10",
  "display_title": "Romans 10",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "romans",
  "book": "Romans",
  "bookName": "Romans",
  "bookOrder": 45,
