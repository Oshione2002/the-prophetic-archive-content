{
  "schemaVersion": 1,
  "id": "kjv-lamentations-005",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 5,
  "title": "Lamentations 5",
  "display_title": "Lamentations 5",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "lamentations",
  "book": "Lamentations",
  "bookName": "Lamentations",
  "bookOrder": 25,
  "testament": "old",
  "chapter": 5,
  "sortOrder": 25005,
  "verseCount": 22,
  "aliases": [
    "Lam",
    "La"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:lamentations:5:1",
      "numberLabel": "1",
      "text": "Remember, O LORD, what is come upon us: consider, and behold our reproach.",
      "metadata": {
        "reference": "Lamentations 5:1",
        "verseKey": "kjv:lamentations:5:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:lamentations:5:2",
      "numberLabel": "2",
      "text": "Our inheritance is turned to strangers, our houses to aliens.",
      "metadata": {
        "reference": "Lamentations 5:2",
        "verseKey": "kjv:lamentations:5:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:lamentations:5:3",
      "numberLabel": "3",
      "text": "We are orphans and fatherless, our mothers are as widows.",
      "metadata": {
        "reference": "Lamentations 5:3",
        "verseKey": "kjv:lamentations:5:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:lamentations:5:4",
      "numberLabel": "4",
      "text": "We have drunken our water for money; our wood is sold unto us.",
      "metadata": {
        "reference": "Lamentations 5:4",
        "verseKey": "kjv:lamentations:5:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:lamentations:5:5",
      "numberLabel": "5",
      "text": "Our necks are under persecution: we labour, and have no rest.",
      "metadata": {
        "reference": "Lamentations 5:5",
        "verseKey": "kjv:lamentations:5:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:lamentations:5:6",
      "numberLabel": "6",
      "text": "We have given the hand to the Egyptians, and to the Assyrians, to be satisfied with bread.",
      "metadata": {
        "reference": "Lamentations 5:6",
        "verseKey": "kjv:lamentations:5:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:lamentations:5:7",
      "numberLabel": "7",
      "text": "Our fathers have sinned, and are not; and we have borne their iniquities.",
      "metadata": {
        "reference": "Lamentations 5:7",
        "verseKey": "kjv:lamentations:5:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:lamentations:5:8",
      "numberLabel": "8",
      "text": "Servants have ruled over us: there is none that doth deliver us out of their hand.",
      "metadata": {
        "reference": "Lamentations 5:8",
        "verseKey": "kjv:lamentations:5:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:lamentations:5:9",
      "numberLabel": "9",
      "text": "We gat our bread with the peril of our lives because of the sword of the wilderness.",
      "metadata": {
        "reference": "Lamentations 5:9",
        "verseKey": "kjv:lamentations:5:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:lamentations:5:10",
      "numberLabel": "10",
      "text": "Our skin was black like an oven because of the terrible famine.",
      "metadata": {
        "reference": "Lamentations 5:10",
        "verseKey": "kjv:lamentations:5:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:lamentations:5:11",
      "numberLabel": "11",
      "text": "They ravished the women in Zion, and the maids in the cities of Judah.",
      "metadata": {
        "reference": "Lamentations 5:11",
        "verseKey": "kjv:lamentations:5:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:lamentations:5:12",
      "numberLabel": "12",
      "text": "Princes are hanged up by their hand: the faces of elders were not honoured.",
      "metadata": {
        "reference": "Lamentations 5:12",
        "verseKey": "kjv:lamentations:5:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:lamentations:5:13",
      "numberLabel": "13",
      "text": "They took the young men to grind, and the children fell under the wood.",
      "metadata": {
        "reference": "Lamentations 5:13",
        "verseKey": "kjv:lamentations:5:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:lamentations:5:14",
      "numberLabel": "14",
      "text": "The elders have ceased from the gate, the young men from their musick.",
      "metadata": {
        "reference": "Lamentations 5:14",
        "verseKey": "kjv:lamentations:5:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:lamentations:5:15",
      "numberLabel": "15",
      "text": "The joy of our heart is ceased; our dance is turned into mourning.",
      "metadata": {
        "reference": "Lamentations 5:15",
        "verseKey": "kjv:lamentations:5:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:lamentations:5:16",
      "numberLabel": "16",
      "text": "The crown is fallen from our head: woe unto us, that we have sinned!",
      "metadata": {
        "reference": "Lamentations 5:16",
        "verseKey": "kjv:lamentations:5:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:lamentations:5:17",
      "numberLabel": "17",
      "text": "For this our heart is faint; for these things our eyes are dim.",
      "metadata": {
        "reference": "Lamentations 5:17",
        "verseKey": "kjv:lamentations:5:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:lamentations:5:18",
      "numberLabel": "18",
      "text": "Because of the mountain of Zion, which is desolate, the foxes walk upon it.",
      "metadata": {
        "reference": "Lamentations 5:18",
        "verseKey": "kjv:lamentations:5:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:lamentations:5:19",
      "numberLabel": "19",
      "text": "Thou, O LORD, remainest for ever; thy throne from generation to generation.",
      "metadata": {
        "reference": "Lamentations 5:19",
        "verseKey": "kjv:lamentations:5:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:lamentations:5:20",
      "numberLabel": "20",
      "text": "Wherefore dost thou forget us for ever, and forsake us so long time?",
      "metadata": {
        "reference": "Lamentations 5:20",
        "verseKey": "kjv:lamentations:5:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:lamentations:5:21",
      "numberLabel": "21",
      "text": "Turn thou us unto thee, O LORD, and we shall be turned; renew our days as of old.",
      "metadata": {
        "reference": "Lamentations 5:21",
        "verseKey": "kjv:lamentations:5:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:lamentations:5:22",
      "numberLabel": "22",
      "text": "But thou hast utterly rejected us; thou art very wroth against us.",
      "metadata": {
        "reference": "Lamentations 5:22",
        "verseKey": "kjv:lamentations:5:22"
      }
    }
  ],
  "source": {
