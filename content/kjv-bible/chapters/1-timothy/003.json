{
  "schemaVersion": 1,
  "id": "kjv-1-timothy-003",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 3,
  "title": "1 Timothy 3",
  "display_title": "1 Timothy 3",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "1-timothy",
  "book": "1 Timothy",
  "bookName": "1 Timothy",
  "bookOrder": 54,
