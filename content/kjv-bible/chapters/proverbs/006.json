{
  "schemaVersion": 1,
  "id": "kjv-proverbs-006",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 6,
  "title": "Proverbs 6",
  "display_title": "Proverbs 6",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "proverbs",
  "book": "Proverbs",
  "bookName": "Proverbs",
  "bookOrder": 20,
  "testament": "old",
  "chapter": 6,
  "sortOrder": 20006,
  "verseCount": 35,
  "aliases": [
    "Prov",
    "Pr",
    "Prv"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:proverbs:6:1",
      "numberLabel": "1",
      "text": "My son, if thou be surety for thy friend, if thou hast stricken thy hand with a stranger,",
      "metadata": {
        "reference": "Proverbs 6:1",
        "verseKey": "kjv:proverbs:6:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:proverbs:6:2",
      "numberLabel": "2",
      "text": "Thou art snared with the words of thy mouth, thou art taken with the words of thy mouth.",
      "metadata": {
        "reference": "Proverbs 6:2",
        "verseKey": "kjv:proverbs:6:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:proverbs:6:3",
      "numberLabel": "3",
      "text": "Do this now, my son, and deliver thyself, when thou art come into the hand of thy friend; go, humble thyself, and make sure thy friend.",
      "metadata": {
        "reference": "Proverbs 6:3",
        "verseKey": "kjv:proverbs:6:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:proverbs:6:4",
      "numberLabel": "4",
      "text": "Give not sleep to thine eyes, nor slumber to thine eyelids.",
      "metadata": {
        "reference": "Proverbs 6:4",
        "verseKey": "kjv:proverbs:6:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:proverbs:6:5",
      "numberLabel": "5",
      "text": "Deliver thyself as a roe from the hand of the hunter, and as a bird from the hand of the fowler.",
      "metadata": {
        "reference": "Proverbs 6:5",
        "verseKey": "kjv:proverbs:6:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:proverbs:6:6",
      "numberLabel": "6",
      "text": "Go to the ant, thou sluggard; consider her ways, and be wise:",
      "metadata": {
        "reference": "Proverbs 6:6",
        "verseKey": "kjv:proverbs:6:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:proverbs:6:7",
      "numberLabel": "7",
      "text": "Which having no guide, overseer, or ruler,",
      "metadata": {
        "reference": "Proverbs 6:7",
        "verseKey": "kjv:proverbs:6:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:proverbs:6:8",
      "numberLabel": "8",
      "text": "Provideth her meat in the summer, and gathereth her food in the harvest.",
      "metadata": {
        "reference": "Proverbs 6:8",
        "verseKey": "kjv:proverbs:6:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:proverbs:6:9",
      "numberLabel": "9",
      "text": "How long wilt thou sleep, O sluggard? when wilt thou arise out of thy sleep?",
      "metadata": {
        "reference": "Proverbs 6:9",
        "verseKey": "kjv:proverbs:6:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:proverbs:6:10",
      "numberLabel": "10",
      "text": "Yet a little sleep, a little slumber, a little folding of the hands to sleep:",
      "metadata": {
        "reference": "Proverbs 6:10",
        "verseKey": "kjv:proverbs:6:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:proverbs:6:11",
      "numberLabel": "11",
      "text": "So shall thy poverty come as one that travelleth, and thy want as an armed man.",
      "metadata": {
        "reference": "Proverbs 6:11",
        "verseKey": "kjv:proverbs:6:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:proverbs:6:12",
      "numberLabel": "12",
      "text": "A naughty person, a wicked man, walketh with a froward mouth.",
      "metadata": {
        "reference": "Proverbs 6:12",
        "verseKey": "kjv:proverbs:6:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:proverbs:6:13",
      "numberLabel": "13",
      "text": "He winketh with his eyes, he speaketh with his feet, he teacheth with his fingers;",
      "metadata": {
        "reference": "Proverbs 6:13",
        "verseKey": "kjv:proverbs:6:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:proverbs:6:14",
      "numberLabel": "14",
      "text": "Frowardness is in his heart, he deviseth mischief continually; he soweth discord.",
      "metadata": {
        "reference": "Proverbs 6:14",
        "verseKey": "kjv:proverbs:6:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:proverbs:6:15",
      "numberLabel": "15",
      "text": "Therefore shall his calamity come suddenly; suddenly shall he be broken without remedy.",
      "metadata": {
        "reference": "Proverbs 6:15",
        "verseKey": "kjv:proverbs:6:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:proverbs:6:16",
      "numberLabel": "16",
      "text": "These six things doth the LORD hate: yea, seven are an abomination unto him:",
      "metadata": {
        "reference": "Proverbs 6:16",
        "verseKey": "kjv:proverbs:6:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:proverbs:6:17",
      "numberLabel": "17",
      "text": "A proud look, a lying tongue, and hands that shed innocent blood,",
      "metadata": {
        "reference": "Proverbs 6:17",
        "verseKey": "kjv:proverbs:6:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:proverbs:6:18",
      "numberLabel": "18",
      "text": "An heart that deviseth wicked imaginations, feet that be swift in running to mischief,",
      "metadata": {
        "reference": "Proverbs 6:18",
        "verseKey": "kjv:proverbs:6:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:proverbs:6:19",
      "numberLabel": "19",
      "text": "A false witness that speaketh lies, and he that soweth discord among brethren.",
      "metadata": {
        "reference": "Proverbs 6:19",
        "verseKey": "kjv:proverbs:6:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:proverbs:6:20",
      "numberLabel": "20",
      "text": "My son, keep thy father’s commandment, and forsake not the law of thy mother:",
      "metadata": {
        "reference": "Proverbs 6:20",
        "verseKey": "kjv:proverbs:6:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:proverbs:6:21",
      "numberLabel": "21",
      "text": "Bind them continually upon thine heart, and tie them about thy neck.",
      "metadata": {
        "reference": "Proverbs 6:21",
        "verseKey": "kjv:proverbs:6:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:proverbs:6:22",
      "numberLabel": "22",
      "text": "When thou goest, it shall lead thee; when thou sleepest, it shall keep thee; and when thou awakest, it shall talk with thee.",
      "metadata": {
        "reference": "Proverbs 6:22",
        "verseKey": "kjv:proverbs:6:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:proverbs:6:23",
      "numberLabel": "23",
      "text": "For the commandment is a lamp; and the law is light; and reproofs of instruction are the way of life:",
      "metadata": {
        "reference": "Proverbs 6:23",
        "verseKey": "kjv:proverbs:6:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:proverbs:6:24",
      "numberLabel": "24",
      "text": "To keep thee from the evil woman, from the flattery of the tongue of a strange woman.",
      "metadata": {
        "reference": "Proverbs 6:24",
        "verseKey": "kjv:proverbs:6:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:proverbs:6:25",
      "numberLabel": "25",
      "text": "Lust not after her beauty in thine heart; neither let her take thee with her eyelids.",
      "metadata": {
        "reference": "Proverbs 6:25",
        "verseKey": "kjv:proverbs:6:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:proverbs:6:26",
      "numberLabel": "26",
      "text": "For by means of a whorish woman a man is brought to a piece of bread: and the adulteress will hunt for the precious life.",
      "metadata": {
        "reference": "Proverbs 6:26",
        "verseKey": "kjv:proverbs:6:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:proverbs:6:27",
      "numberLabel": "27",
      "text": "Can a man take fire in his bosom, and his clothes not be burned?",
      "metadata": {
        "reference": "Proverbs 6:27",
        "verseKey": "kjv:proverbs:6:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:proverbs:6:28",
      "numberLabel": "28",
      "text": "Can one go upon hot coals, and his feet not be burned?",
      "metadata": {
        "reference": "Proverbs 6:28",
        "verseKey": "kjv:proverbs:6:28"
      }
    },
    {
      "id": "verse-029",
      "type": "bible_verse",
      "verse": 29,
      "verseId": "kjv:proverbs:6:29",
      "numberLabel": "29",
      "text": "So he that goeth in to his neighbour’s wife; whosoever toucheth her shall not be innocent.",
      "metadata": {
        "reference": "Proverbs 6:29",
        "verseKey": "kjv:proverbs:6:29"
      }
    },
    {
      "id": "verse-030",
      "type": "bible_verse",
      "verse": 30,
      "verseId": "kjv:proverbs:6:30",
      "numberLabel": "30",
      "text": "Men do not despise a thief, if he steal to satisfy his soul when he is hungry;",
      "metadata": {
        "reference": "Proverbs 6:30",
        "verseKey": "kjv:proverbs:6:30"
      }
    },
    {
      "id": "verse-031",
      "type": "bible_verse",
      "verse": 31,
      "verseId": "kjv:proverbs:6:31",
      "numberLabel": "31",
      "text": "But if he be found, he shall restore sevenfold; he shall give all the substance of his house.",
      "metadata": {
        "reference": "Proverbs 6:31",
        "verseKey": "kjv:proverbs:6:31"
      }
    },
    {
      "id": "verse-032",
      "type": "bible_verse",
      "verse": 32,
      "verseId": "kjv:proverbs:6:32",
      "numberLabel": "32",
      "text": "But whoso committeth adultery with a woman lacketh understanding: he that doeth it destroyeth his own soul.",
      "metadata": {
        "reference": "Proverbs 6:32",
        "verseKey": "kjv:proverbs:6:32"
      }
    },
    {
      "id": "verse-033",
      "type": "bible_verse",
      "verse": 33,
      "verseId": "kjv:proverbs:6:33",
      "numberLabel": "33",
      "text": "A wound and dishonour shall he get; and his reproach shall not be wiped away.",
      "metadata": {
        "reference": "Proverbs 6:33",
        "verseKey": "kjv:proverbs:6:33"
      }
    },
    {
      "id": "verse-034",
      "type": "bible_verse",
      "verse": 34,
      "verseId": "kjv:proverbs:6:34",
      "numberLabel": "34",
      "text": "For jealousy is the rage of a man: therefore he will not spare in the day of vengeance.",
      "metadata": {
        "reference": "Proverbs 6:34",
        "verseKey": "kjv:proverbs:6:34"
      }
    },
    {
      "id": "verse-035",
      "type": "bible_verse",
      "verse": 35,
      "verseId": "kjv:proverbs:6:35",
      "numberLabel": "35",
      "text": "He will not regard any ransom; neither will he rest content, though thou givest many gifts.",
      "metadata": {
        "reference": "Proverbs 6:35",
        "verseKey": "kjv:proverbs:6:35"
      }
    }
  ],
