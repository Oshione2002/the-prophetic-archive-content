{
  "schemaVersion": 1,
  "id": "kjv-proverbs-003",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 3,
  "title": "Proverbs 3",
  "display_title": "Proverbs 3",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "proverbs",
  "book": "Proverbs",
  "bookName": "Proverbs",
  "bookOrder": 20,
  "testament": "old",
  "chapter": 3,
  "sortOrder": 20003,
  "verseCount": 35,
  "aliases": [
    "Prov",
    "Pr",
    "Prv"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:proverbs:3:1",
      "numberLabel": "1",
      "text": "My son, forget not my law; but let thine heart keep my commandments:",
      "metadata": {
        "reference": "Proverbs 3:1",
        "verseKey": "kjv:proverbs:3:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:proverbs:3:2",
      "numberLabel": "2",
      "text": "For length of days, and long life, and peace, shall they add to thee.",
      "metadata": {
        "reference": "Proverbs 3:2",
        "verseKey": "kjv:proverbs:3:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:proverbs:3:3",
      "numberLabel": "3",
      "text": "Let not mercy and truth forsake thee: bind them about thy neck; write them upon the table of thine heart:",
      "metadata": {
        "reference": "Proverbs 3:3",
        "verseKey": "kjv:proverbs:3:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:proverbs:3:4",
      "numberLabel": "4",
      "text": "So shalt thou find favour and good understanding in the sight of God and man.",
      "metadata": {
        "reference": "Proverbs 3:4",
        "verseKey": "kjv:proverbs:3:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:proverbs:3:5",
      "numberLabel": "5",
      "text": "Trust in the LORD with all thine heart; and lean not unto thine own understanding.",
      "metadata": {
        "reference": "Proverbs 3:5",
        "verseKey": "kjv:proverbs:3:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:proverbs:3:6",
      "numberLabel": "6",
      "text": "In all thy ways acknowledge him, and he shall direct thy paths.",
      "metadata": {
        "reference": "Proverbs 3:6",
        "verseKey": "kjv:proverbs:3:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:proverbs:3:7",
      "numberLabel": "7",
      "text": "Be not wise in thine own eyes: fear the LORD, and depart from evil.",
      "metadata": {
        "reference": "Proverbs 3:7",
        "verseKey": "kjv:proverbs:3:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:proverbs:3:8",
      "numberLabel": "8",
      "text": "It shall be health to thy navel, and marrow to thy bones.",
      "metadata": {
        "reference": "Proverbs 3:8",
        "verseKey": "kjv:proverbs:3:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:proverbs:3:9",
      "numberLabel": "9",
      "text": "Honour the LORD with thy substance, and with the firstfruits of all thine increase:",
      "metadata": {
        "reference": "Proverbs 3:9",
        "verseKey": "kjv:proverbs:3:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:proverbs:3:10",
      "numberLabel": "10",
      "text": "So shall thy barns be filled with plenty, and thy presses shall burst out with new wine.",
      "metadata": {
        "reference": "Proverbs 3:10",
        "verseKey": "kjv:proverbs:3:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:proverbs:3:11",
      "numberLabel": "11",
      "text": "My son, despise not the chastening of the LORD; neither be weary of his correction:",
      "metadata": {
        "reference": "Proverbs 3:11",
        "verseKey": "kjv:proverbs:3:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:proverbs:3:12",
      "numberLabel": "12",
      "text": "For whom the LORD loveth he correcteth; even as a father the son in whom he delighteth.",
      "metadata": {
        "reference": "Proverbs 3:12",
        "verseKey": "kjv:proverbs:3:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:proverbs:3:13",
      "numberLabel": "13",
      "text": "Happy is the man that findeth wisdom, and the man that getteth understanding.",
      "metadata": {
        "reference": "Proverbs 3:13",
        "verseKey": "kjv:proverbs:3:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:proverbs:3:14",
      "numberLabel": "14",
      "text": "For the merchandise of it is better than the merchandise of silver, and the gain thereof than fine gold.",
      "metadata": {
        "reference": "Proverbs 3:14",
        "verseKey": "kjv:proverbs:3:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:proverbs:3:15",
      "numberLabel": "15",
      "text": "She is more precious than rubies: and all the things thou canst desire are not to be compared unto her.",
      "metadata": {
        "reference": "Proverbs 3:15",
        "verseKey": "kjv:proverbs:3:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:proverbs:3:16",
      "numberLabel": "16",
      "text": "Length of days is in her right hand; and in her left hand riches and honour.",
      "metadata": {
        "reference": "Proverbs 3:16",
        "verseKey": "kjv:proverbs:3:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:proverbs:3:17",
      "numberLabel": "17",
      "text": "Her ways are ways of pleasantness, and all her paths are peace.",
      "metadata": {
        "reference": "Proverbs 3:17",
        "verseKey": "kjv:proverbs:3:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:proverbs:3:18",
      "numberLabel": "18",
      "text": "She is a tree of life to them that lay hold upon her: and happy is every one that retaineth her.",
      "metadata": {
        "reference": "Proverbs 3:18",
        "verseKey": "kjv:proverbs:3:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:proverbs:3:19",
      "numberLabel": "19",
      "text": "The LORD by wisdom hath founded the earth; by understanding hath he established the heavens.",
      "metadata": {
        "reference": "Proverbs 3:19",
        "verseKey": "kjv:proverbs:3:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:proverbs:3:20",
      "numberLabel": "20",
      "text": "By his knowledge the depths are broken up, and the clouds drop down the dew.",
      "metadata": {
        "reference": "Proverbs 3:20",
        "verseKey": "kjv:proverbs:3:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:proverbs:3:21",
      "numberLabel": "21",
      "text": "My son, let not them depart from thine eyes: keep sound wisdom and discretion:",
      "metadata": {
        "reference": "Proverbs 3:21",
        "verseKey": "kjv:proverbs:3:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:proverbs:3:22",
      "numberLabel": "22",
      "text": "So shall they be life unto thy soul, and grace to thy neck.",
      "metadata": {
        "reference": "Proverbs 3:22",
        "verseKey": "kjv:proverbs:3:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:proverbs:3:23",
      "numberLabel": "23",
      "text": "Then shalt thou walk in thy way safely, and thy foot shall not stumble.",
      "metadata": {
        "reference": "Proverbs 3:23",
        "verseKey": "kjv:proverbs:3:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:proverbs:3:24",
      "numberLabel": "24",
      "text": "When thou liest down, thou shalt not be afraid: yea, thou shalt lie down, and thy sleep shall be sweet.",
      "metadata": {
        "reference": "Proverbs 3:24",
        "verseKey": "kjv:proverbs:3:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:proverbs:3:25",
      "numberLabel": "25",
      "text": "Be not afraid of sudden fear, neither of the desolation of the wicked, when it cometh.",
      "metadata": {
        "reference": "Proverbs 3:25",
        "verseKey": "kjv:proverbs:3:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:proverbs:3:26",
      "numberLabel": "26",
      "text": "For the LORD shall be thy confidence, and shall keep thy foot from being taken.",
      "metadata": {
        "reference": "Proverbs 3:26",
        "verseKey": "kjv:proverbs:3:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:proverbs:3:27",
      "numberLabel": "27",
      "text": "Withhold not good from them to whom it is due, when it is in the power of thine hand to do it.",
      "metadata": {
        "reference": "Proverbs 3:27",
        "verseKey": "kjv:proverbs:3:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:proverbs:3:28",
      "numberLabel": "28",
      "text": "Say not unto thy neighbour, Go, and come again, and to morrow I will give; when thou hast it by thee.",
      "metadata": {
        "reference": "Proverbs 3:28",
        "verseKey": "kjv:proverbs:3:28"
      }
    },
    {
      "id": "verse-029",
      "type": "bible_verse",
      "verse": 29,
      "verseId": "kjv:proverbs:3:29",
      "numberLabel": "29",
      "text": "Devise not evil against thy neighbour, seeing he dwelleth securely by thee.",
      "metadata": {
        "reference": "Proverbs 3:29",
        "verseKey": "kjv:proverbs:3:29"
      }
    },
    {
      "id": "verse-030",
      "type": "bible_verse",
      "verse": 30,
      "verseId": "kjv:proverbs:3:30",
      "numberLabel": "30",
      "text": "Strive not with a man without cause, if he have done thee no harm.",
      "metadata": {
        "reference": "Proverbs 3:30",
        "verseKey": "kjv:proverbs:3:30"
      }
    },
    {
      "id": "verse-031",
      "type": "bible_verse",
      "verse": 31,
      "verseId": "kjv:proverbs:3:31",
      "numberLabel": "31",
      "text": "Envy thou not the oppressor, and choose none of his ways.",
      "metadata": {
        "reference": "Proverbs 3:31",
        "verseKey": "kjv:proverbs:3:31"
      }
    },
    {
      "id": "verse-032",
      "type": "bible_verse",
      "verse": 32,
      "verseId": "kjv:proverbs:3:32",
      "numberLabel": "32",
      "text": "For the froward is abomination to the LORD: but his secret is with the righteous.",
      "metadata": {
        "reference": "Proverbs 3:32",
        "verseKey": "kjv:proverbs:3:32"
      }
    },
    {
      "id": "verse-033",
      "type": "bible_verse",
      "verse": 33,
      "verseId": "kjv:proverbs:3:33",
      "numberLabel": "33",
      "text": "The curse of the LORD is in the house of the wicked: but he blesseth the habitation of the just.",
      "metadata": {
        "reference": "Proverbs 3:33",
        "verseKey": "kjv:proverbs:3:33"
      }
    },
    {
      "id": "verse-034",
      "type": "bible_verse",
      "verse": 34,
      "verseId": "kjv:proverbs:3:34",
      "numberLabel": "34",
      "text": "Surely he scorneth the scorners: but he giveth grace unto the lowly.",
      "metadata": {
        "reference": "Proverbs 3:34",
        "verseKey": "kjv:proverbs:3:34"
      }
    },
    {
      "id": "verse-035",
      "type": "bible_verse",
      "verse": 35,
      "verseId": "kjv:proverbs:3:35",
      "numberLabel": "35",
      "text": "The wise shall inherit glory: but shame shall be the promotion of fools.",
      "metadata": {
        "reference": "Proverbs 3:35",
        "verseKey": "kjv:proverbs:3:35"
      }
    }
  ],
  "source": {
