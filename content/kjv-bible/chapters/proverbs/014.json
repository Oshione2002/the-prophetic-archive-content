{
  "schemaVersion": 1,
  "id": "kjv-proverbs-014",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 14,
  "title": "Proverbs 14",
  "display_title": "Proverbs 14",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "proverbs",
  "book": "Proverbs",
  "bookName": "Proverbs",
  "bookOrder": 20,
  "testament": "old",
  "chapter": 14,
  "sortOrder": 20014,
  "verseCount": 35,
  "aliases": [
    "Prov",
    "Pr",
    "Prv"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:proverbs:14:1",
      "numberLabel": "1",
      "text": "Every wise woman buildeth her house: but the foolish plucketh it down with her hands.",
      "metadata": {
        "reference": "Proverbs 14:1",
        "verseKey": "kjv:proverbs:14:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:proverbs:14:2",
      "numberLabel": "2",
      "text": "He that walketh in his uprightness feareth the LORD: but he that is perverse in his ways despiseth him.",
      "metadata": {
        "reference": "Proverbs 14:2",
        "verseKey": "kjv:proverbs:14:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:proverbs:14:3",
      "numberLabel": "3",
      "text": "In the mouth of the foolish is a rod of pride: but the lips of the wise shall preserve them.",
      "metadata": {
        "reference": "Proverbs 14:3",
        "verseKey": "kjv:proverbs:14:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:proverbs:14:4",
      "numberLabel": "4",
      "text": "Where no oxen are, the crib is clean: but much increase is by the strength of the ox.",
      "metadata": {
        "reference": "Proverbs 14:4",
        "verseKey": "kjv:proverbs:14:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:proverbs:14:5",
      "numberLabel": "5",
      "text": "A faithful witness will not lie: but a false witness will utter lies.",
      "metadata": {
        "reference": "Proverbs 14:5",
        "verseKey": "kjv:proverbs:14:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:proverbs:14:6",
      "numberLabel": "6",
      "text": "A scorner seeketh wisdom, and findeth it not: but knowledge is easy unto him that understandeth.",
      "metadata": {
        "reference": "Proverbs 14:6",
        "verseKey": "kjv:proverbs:14:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:proverbs:14:7",
      "numberLabel": "7",
      "text": "Go from the presence of a foolish man, when thou perceivest not in him the lips of knowledge.",
      "metadata": {
        "reference": "Proverbs 14:7",
        "verseKey": "kjv:proverbs:14:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:proverbs:14:8",
      "numberLabel": "8",
      "text": "The wisdom of the prudent is to understand his way: but the folly of fools is deceit.",
      "metadata": {
        "reference": "Proverbs 14:8",
        "verseKey": "kjv:proverbs:14:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:proverbs:14:9",
      "numberLabel": "9",
      "text": "Fools make a mock at sin: but among the righteous there is favour.",
      "metadata": {
        "reference": "Proverbs 14:9",
        "verseKey": "kjv:proverbs:14:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:proverbs:14:10",
      "numberLabel": "10",
      "text": "The heart knoweth his own bitterness; and a stranger doth not intermeddle with his joy.",
      "metadata": {
        "reference": "Proverbs 14:10",
        "verseKey": "kjv:proverbs:14:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:proverbs:14:11",
      "numberLabel": "11",
      "text": "The house of the wicked shall be overthrown: but the tabernacle of the upright shall flourish.",
      "metadata": {
        "reference": "Proverbs 14:11",
        "verseKey": "kjv:proverbs:14:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:proverbs:14:12",
      "numberLabel": "12",
      "text": "There is a way which seemeth right unto a man, but the end thereof are the ways of death.",
      "metadata": {
        "reference": "Proverbs 14:12",
        "verseKey": "kjv:proverbs:14:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:proverbs:14:13",
      "numberLabel": "13",
      "text": "Even in laughter the heart is sorrowful; and the end of that mirth is heaviness.",
      "metadata": {
        "reference": "Proverbs 14:13",
        "verseKey": "kjv:proverbs:14:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:proverbs:14:14",
      "numberLabel": "14",
      "text": "The backslider in heart shall be filled with his own ways: and a good man shall be satisfied from himself.",
      "metadata": {
        "reference": "Proverbs 14:14",
        "verseKey": "kjv:proverbs:14:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:proverbs:14:15",
      "numberLabel": "15",
      "text": "The simple believeth every word: but the prudent man looketh well to his going.",
      "metadata": {
        "reference": "Proverbs 14:15",
        "verseKey": "kjv:proverbs:14:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:proverbs:14:16",
      "numberLabel": "16",
      "text": "A wise man feareth, and departeth from evil: but the fool rageth, and is confident.",
      "metadata": {
        "reference": "Proverbs 14:16",
        "verseKey": "kjv:proverbs:14:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:proverbs:14:17",
      "numberLabel": "17",
      "text": "He that is soon angry dealeth foolishly: and a man of wicked devices is hated.",
      "metadata": {
        "reference": "Proverbs 14:17",
        "verseKey": "kjv:proverbs:14:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:proverbs:14:18",
      "numberLabel": "18",
      "text": "The simple inherit folly: but the prudent are crowned with knowledge.",
      "metadata": {
        "reference": "Proverbs 14:18",
        "verseKey": "kjv:proverbs:14:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:proverbs:14:19",
      "numberLabel": "19",
      "text": "The evil bow before the good; and the wicked at the gates of the righteous.",
      "metadata": {
        "reference": "Proverbs 14:19",
        "verseKey": "kjv:proverbs:14:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:proverbs:14:20",
      "numberLabel": "20",
      "text": "The poor is hated even of his own neighbour: but the rich hath many friends.",
      "metadata": {
        "reference": "Proverbs 14:20",
        "verseKey": "kjv:proverbs:14:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:proverbs:14:21",
      "numberLabel": "21",
      "text": "He that despiseth his neighbour sinneth: but he that hath mercy on the poor, happy is he.",
      "metadata": {
        "reference": "Proverbs 14:21",
        "verseKey": "kjv:proverbs:14:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:proverbs:14:22",
      "numberLabel": "22",
      "text": "Do they not err that devise evil? but mercy and truth shall be to them that devise good.",
      "metadata": {
        "reference": "Proverbs 14:22",
        "verseKey": "kjv:proverbs:14:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:proverbs:14:23",
      "numberLabel": "23",
      "text": "In all labour there is profit: but the talk of the lips tendeth only to penury.",
      "metadata": {
        "reference": "Proverbs 14:23",
        "verseKey": "kjv:proverbs:14:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:proverbs:14:24",
      "numberLabel": "24",
      "text": "The crown of the wise is their riches: but the foolishness of fools is folly.",
      "metadata": {
        "reference": "Proverbs 14:24",
        "verseKey": "kjv:proverbs:14:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:proverbs:14:25",
      "numberLabel": "25",
      "text": "A true witness delivereth souls: but a deceitful witness speaketh lies.",
      "metadata": {
        "reference": "Proverbs 14:25",
        "verseKey": "kjv:proverbs:14:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:proverbs:14:26",
      "numberLabel": "26",
      "text": "In the fear of the LORD is strong confidence: and his children shall have a place of refuge.",
      "metadata": {
        "reference": "Proverbs 14:26",
        "verseKey": "kjv:proverbs:14:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:proverbs:14:27",
      "numberLabel": "27",
      "text": "The fear of the LORD is a fountain of life, to depart from the snares of death.",
      "metadata": {
        "reference": "Proverbs 14:27",
        "verseKey": "kjv:proverbs:14:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:proverbs:14:28",
      "numberLabel": "28",
      "text": "In the multitude of people is the king’s honour: but in the want of people is the destruction of the prince.",
      "metadata": {
        "reference": "Proverbs 14:28",
        "verseKey": "kjv:proverbs:14:28"
      }
    },
    {
      "id": "verse-029",
      "type": "bible_verse",
      "verse": 29,
      "verseId": "kjv:proverbs:14:29",
      "numberLabel": "29",
      "text": "He that is slow to wrath is of great understanding: but he that is hasty of spirit exalteth folly.",
      "metadata": {
        "reference": "Proverbs 14:29",
        "verseKey": "kjv:proverbs:14:29"
      }
    },
    {
      "id": "verse-030",
      "type": "bible_verse",
      "verse": 30,
      "verseId": "kjv:proverbs:14:30",
      "numberLabel": "30",
      "text": "A sound heart is the life of the flesh: but envy the rottenness of the bones.",
      "metadata": {
        "reference": "Proverbs 14:30",
        "verseKey": "kjv:proverbs:14:30"
      }
    },
    {
      "id": "verse-031",
      "type": "bible_verse",
      "verse": 31,
      "verseId": "kjv:proverbs:14:31",
      "numberLabel": "31",
      "text": "He that oppresseth the poor reproacheth his Maker: but he that honoureth him hath mercy on the poor.",
      "metadata": {
        "reference": "Proverbs 14:31",
        "verseKey": "kjv:proverbs:14:31"
      }
    },
    {
      "id": "verse-032",
      "type": "bible_verse",
      "verse": 32,
      "verseId": "kjv:proverbs:14:32",
      "numberLabel": "32",
      "text": "The wicked is driven away in his wickedness: but the righteous hath hope in his death.",
      "metadata": {
        "reference": "Proverbs 14:32",
        "verseKey": "kjv:proverbs:14:32"
      }
    },
    {
      "id": "verse-033",
      "type": "bible_verse",
      "verse": 33,
      "verseId": "kjv:proverbs:14:33",
      "numberLabel": "33",
      "text": "Wisdom resteth in the heart of him that hath understanding: but that which is in the midst of fools is made known.",
      "metadata": {
        "reference": "Proverbs 14:33",
        "verseKey": "kjv:proverbs:14:33"
      }
    },
    {
      "id": "verse-034",
      "type": "bible_verse",
      "verse": 34,
      "verseId": "kjv:proverbs:14:34",
      "numberLabel": "34",
      "text": "Righteousness exalteth a nation: but sin is a reproach to any people.",
      "metadata": {
        "reference": "Proverbs 14:34",
        "verseKey": "kjv:proverbs:14:34"
      }
    },
    {
      "id": "verse-035",
      "type": "bible_verse",
      "verse": 35,
      "verseId": "kjv:proverbs:14:35",
      "numberLabel": "35",
      "text": "The king’s favour is toward a wise servant: but his wrath is against him that causeth shame.",
      "metadata": {
        "reference": "Proverbs 14:35",
        "verseKey": "kjv:proverbs:14:35"
      }
    }
  ],
