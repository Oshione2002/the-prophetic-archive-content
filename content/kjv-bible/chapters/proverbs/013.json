  "document_type": "bible_chapter",
  "number": 13,
  "title": "Proverbs 13",
  "display_title": "Proverbs 13",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "proverbs",
  "book": "Proverbs",
