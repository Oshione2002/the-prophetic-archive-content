  "chapter": 13,
  "sortOrder": 20013,
  "verseCount": 25,
  "aliases": [
    "Prov",
    "Pr",
    "Prv"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:proverbs:13:1",
      "numberLabel": "1",
      "text": "A wise son heareth his father’s instruction: but a scorner heareth not rebuke.",
      "metadata": {
        "reference": "Proverbs 13:1",
        "verseKey": "kjv:proverbs:13:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:proverbs:13:2",
      "numberLabel": "2",
      "text": "A man shall eat good by the fruit of his mouth: but the soul of the transgressors shall eat violence.",
      "metadata": {
        "reference": "Proverbs 13:2",
        "verseKey": "kjv:proverbs:13:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:proverbs:13:3",
      "numberLabel": "3",
      "text": "He that keepeth his mouth keepeth his life: but he that openeth wide his lips shall have destruction.",
      "metadata": {
        "reference": "Proverbs 13:3",
        "verseKey": "kjv:proverbs:13:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:proverbs:13:4",
      "numberLabel": "4",
      "text": "The soul of the sluggard desireth, and hath nothing: but the soul of the diligent shall be made fat.",
      "metadata": {
        "reference": "Proverbs 13:4",
        "verseKey": "kjv:proverbs:13:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:proverbs:13:5",
      "numberLabel": "5",
      "text": "A righteous man hateth lying: but a wicked man is loathsome, and cometh to shame.",
      "metadata": {
        "reference": "Proverbs 13:5",
        "verseKey": "kjv:proverbs:13:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:proverbs:13:6",
      "numberLabel": "6",
      "text": "Righteousness keepeth him that is upright in the way: but wickedness overthroweth the sinner.",
      "metadata": {
        "reference": "Proverbs 13:6",
        "verseKey": "kjv:proverbs:13:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:proverbs:13:7",
      "numberLabel": "7",
      "text": "There is that maketh himself rich, yet hath nothing: there is that maketh himself poor, yet hath great riches.",
      "metadata": {
        "reference": "Proverbs 13:7",
        "verseKey": "kjv:proverbs:13:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:proverbs:13:8",
      "numberLabel": "8",
      "text": "The ransom of a man’s life are his riches: but the poor heareth not rebuke.",
      "metadata": {
        "reference": "Proverbs 13:8",
        "verseKey": "kjv:proverbs:13:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:proverbs:13:9",
      "numberLabel": "9",
      "text": "The light of the righteous rejoiceth: but the lamp of the wicked shall be put out.",
      "metadata": {
        "reference": "Proverbs 13:9",
        "verseKey": "kjv:proverbs:13:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:proverbs:13:10",
      "numberLabel": "10",
      "text": "Only by pride cometh contention: but with the well advised is wisdom.",
      "metadata": {
        "reference": "Proverbs 13:10",
        "verseKey": "kjv:proverbs:13:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:proverbs:13:11",
      "numberLabel": "11",
      "text": "Wealth gotten by vanity shall be diminished: but he that gathereth by labour shall increase.",
      "metadata": {
        "reference": "Proverbs 13:11",
        "verseKey": "kjv:proverbs:13:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:proverbs:13:12",
      "numberLabel": "12",
      "text": "Hope deferred maketh the heart sick: but when the desire cometh, it is a tree of life.",
      "metadata": {
        "reference": "Proverbs 13:12",
        "verseKey": "kjv:proverbs:13:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:proverbs:13:13",
      "numberLabel": "13",
      "text": "Whoso despiseth the word shall be destroyed: but he that feareth the commandment shall be rewarded.",
      "metadata": {
        "reference": "Proverbs 13:13",
        "verseKey": "kjv:proverbs:13:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:proverbs:13:14",
      "numberLabel": "14",
      "text": "The law of the wise is a fountain of life, to depart from the snares of death.",
      "metadata": {
        "reference": "Proverbs 13:14",
        "verseKey": "kjv:proverbs:13:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:proverbs:13:15",
      "numberLabel": "15",
      "text": "Good understanding giveth favour: but the way of transgressors is hard.",
      "metadata": {
        "reference": "Proverbs 13:15",
        "verseKey": "kjv:proverbs:13:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:proverbs:13:16",
      "numberLabel": "16",
      "text": "Every prudent man dealeth with knowledge: but a fool layeth open his folly.",
      "metadata": {
        "reference": "Proverbs 13:16",
        "verseKey": "kjv:proverbs:13:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:proverbs:13:17",
      "numberLabel": "17",
      "text": "A wicked messenger falleth into mischief: but a faithful ambassador is health.",
      "metadata": {
        "reference": "Proverbs 13:17",
        "verseKey": "kjv:proverbs:13:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:proverbs:13:18",
      "numberLabel": "18",
      "text": "Poverty and shame shall be to him that refuseth instruction: but he that regardeth reproof shall be honoured.",
      "metadata": {
        "reference": "Proverbs 13:18",
        "verseKey": "kjv:proverbs:13:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:proverbs:13:19",
      "numberLabel": "19",
      "text": "The desire accomplished is sweet to the soul: but it is abomination to fools to depart from evil.",
      "metadata": {
        "reference": "Proverbs 13:19",
        "verseKey": "kjv:proverbs:13:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:proverbs:13:20",
      "numberLabel": "20",
      "text": "He that walketh with wise men shall be wise: but a companion of fools shall be destroyed.",
      "metadata": {
        "reference": "Proverbs 13:20",
        "verseKey": "kjv:proverbs:13:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:proverbs:13:21",
      "numberLabel": "21",
      "text": "Evil pursueth sinners: but to the righteous good shall be repayed.",
      "metadata": {
        "reference": "Proverbs 13:21",
        "verseKey": "kjv:proverbs:13:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:proverbs:13:22",
      "numberLabel": "22",
      "text": "A good man leaveth an inheritance to his children’s children: and the wealth of the sinner is laid up for the just.",
      "metadata": {
        "reference": "Proverbs 13:22",
        "verseKey": "kjv:proverbs:13:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:proverbs:13:23",
      "numberLabel": "23",
      "text": "Much food is in the tillage of the poor: but there is that is destroyed for want of judgment.",
      "metadata": {
        "reference": "Proverbs 13:23",
        "verseKey": "kjv:proverbs:13:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:proverbs:13:24",
      "numberLabel": "24",
      "text": "He that spareth his rod hateth his son: but he that loveth him chasteneth him betimes.",
      "metadata": {
        "reference": "Proverbs 13:24",
        "verseKey": "kjv:proverbs:13:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:proverbs:13:25",
      "numberLabel": "25",
      "text": "The righteous eateth to the satisfying of his soul: but the belly of the wicked shall want.",
      "metadata": {
        "reference": "Proverbs 13:25",
        "verseKey": "kjv:proverbs:13:25"
      }
    }
  ],
