  "document_type": "bible_chapter",
  "number": 29,
  "title": "Proverbs 29",
  "display_title": "Proverbs 29",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "proverbs",
  "book": "Proverbs",
  "bookName": "Proverbs",
  "bookOrder": 20,
  "testament": "old",
  "chapter": 29,
  "sortOrder": 20029,
  "verseCount": 27,
  "aliases": [
    "Prov",
    "Pr",
    "Prv"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:proverbs:29:1",
      "numberLabel": "1",
      "text": "He, that being often reproved hardeneth his neck, shall suddenly be destroyed, and that without remedy.",
      "metadata": {
        "reference": "Proverbs 29:1",
        "verseKey": "kjv:proverbs:29:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:proverbs:29:2",
      "numberLabel": "2",
      "text": "When the righteous are in authority, the people rejoice: but when the wicked beareth rule, the people mourn.",
      "metadata": {
        "reference": "Proverbs 29:2",
        "verseKey": "kjv:proverbs:29:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:proverbs:29:3",
      "numberLabel": "3",
      "text": "Whoso loveth wisdom rejoiceth his father: but he that keepeth company with harlots spendeth his substance.",
      "metadata": {
        "reference": "Proverbs 29:3",
        "verseKey": "kjv:proverbs:29:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:proverbs:29:4",
      "numberLabel": "4",
      "text": "The king by judgment establisheth the land: but he that receiveth gifts overthroweth it.",
      "metadata": {
        "reference": "Proverbs 29:4",
        "verseKey": "kjv:proverbs:29:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:proverbs:29:5",
      "numberLabel": "5",
      "text": "A man that flattereth his neighbour spreadeth a net for his feet.",
      "metadata": {
        "reference": "Proverbs 29:5",
        "verseKey": "kjv:proverbs:29:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:proverbs:29:6",
      "numberLabel": "6",
      "text": "In the transgression of an evil man there is a snare: but the righteous doth sing and rejoice.",
      "metadata": {
        "reference": "Proverbs 29:6",
        "verseKey": "kjv:proverbs:29:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:proverbs:29:7",
      "numberLabel": "7",
      "text": "The righteous considereth the cause of the poor: but the wicked regardeth not to know it.",
      "metadata": {
        "reference": "Proverbs 29:7",
        "verseKey": "kjv:proverbs:29:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:proverbs:29:8",
      "numberLabel": "8",
      "text": "Scornful men bring a city into a snare: but wise men turn away wrath.",
      "metadata": {
        "reference": "Proverbs 29:8",
        "verseKey": "kjv:proverbs:29:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:proverbs:29:9",
      "numberLabel": "9",
      "text": "If a wise man contendeth with a foolish man, whether he rage or laugh, there is no rest.",
      "metadata": {
        "reference": "Proverbs 29:9",
        "verseKey": "kjv:proverbs:29:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:proverbs:29:10",
      "numberLabel": "10",
      "text": "The bloodthirsty hate the upright: but the just seek his soul.",
      "metadata": {
        "reference": "Proverbs 29:10",
        "verseKey": "kjv:proverbs:29:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:proverbs:29:11",
      "numberLabel": "11",
      "text": "A fool uttereth all his mind: but a wise man keepeth it in till afterwards.",
      "metadata": {
        "reference": "Proverbs 29:11",
        "verseKey": "kjv:proverbs:29:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:proverbs:29:12",
      "numberLabel": "12",
      "text": "If a ruler hearken to lies, all his servants are wicked.",
      "metadata": {
        "reference": "Proverbs 29:12",
        "verseKey": "kjv:proverbs:29:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:proverbs:29:13",
      "numberLabel": "13",
      "text": "The poor and the deceitful man meet together: the LORD lighteneth both their eyes.",
      "metadata": {
        "reference": "Proverbs 29:13",
        "verseKey": "kjv:proverbs:29:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:proverbs:29:14",
      "numberLabel": "14",
      "text": "The king that faithfully judgeth the poor, his throne shall be established for ever.",
      "metadata": {
        "reference": "Proverbs 29:14",
        "verseKey": "kjv:proverbs:29:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:proverbs:29:15",
      "numberLabel": "15",
      "text": "The rod and reproof give wisdom: but a child left to himself bringeth his mother to shame.",
      "metadata": {
        "reference": "Proverbs 29:15",
        "verseKey": "kjv:proverbs:29:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:proverbs:29:16",
      "numberLabel": "16",
      "text": "When the wicked are multiplied, transgression increaseth: but the righteous shall see their fall.",
      "metadata": {
        "reference": "Proverbs 29:16",
        "verseKey": "kjv:proverbs:29:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:proverbs:29:17",
      "numberLabel": "17",
      "text": "Correct thy son, and he shall give thee rest; yea, he shall give delight unto thy soul.",
      "metadata": {
        "reference": "Proverbs 29:17",
        "verseKey": "kjv:proverbs:29:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:proverbs:29:18",
      "numberLabel": "18",
      "text": "Where there is no vision, the people perish: but he that keepeth the law, happy is he.",
      "metadata": {
        "reference": "Proverbs 29:18",
        "verseKey": "kjv:proverbs:29:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:proverbs:29:19",
      "numberLabel": "19",
      "text": "A servant will not be corrected by words: for though he understand he will not answer.",
      "metadata": {
        "reference": "Proverbs 29:19",
        "verseKey": "kjv:proverbs:29:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:proverbs:29:20",
      "numberLabel": "20",
      "text": "Seest thou a man that is hasty in his words? there is more hope of a fool than of him.",
      "metadata": {
        "reference": "Proverbs 29:20",
        "verseKey": "kjv:proverbs:29:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:proverbs:29:21",
      "numberLabel": "21",
      "text": "He that delicately bringeth up his servant from a child shall have him become his son at the length.",
      "metadata": {
        "reference": "Proverbs 29:21",
        "verseKey": "kjv:proverbs:29:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:proverbs:29:22",
      "numberLabel": "22",
      "text": "An angry man stirreth up strife, and a furious man aboundeth in transgression.",
      "metadata": {
        "reference": "Proverbs 29:22",
        "verseKey": "kjv:proverbs:29:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:proverbs:29:23",
      "numberLabel": "23",
      "text": "A man’s pride shall bring him low: but honour shall uphold the humble in spirit.",
      "metadata": {
        "reference": "Proverbs 29:23",
        "verseKey": "kjv:proverbs:29:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:proverbs:29:24",
      "numberLabel": "24",
      "text": "Whoso is partner with a thief hateth his own soul: he heareth cursing, and bewrayeth it not.",
      "metadata": {
        "reference": "Proverbs 29:24",
        "verseKey": "kjv:proverbs:29:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:proverbs:29:25",
      "numberLabel": "25",
      "text": "The fear of man bringeth a snare: but whoso putteth his trust in the LORD shall be safe.",
      "metadata": {
        "reference": "Proverbs 29:25",
        "verseKey": "kjv:proverbs:29:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:proverbs:29:26",
      "numberLabel": "26",
      "text": "Many seek the ruler’s favour; but every man’s judgment cometh from the LORD.",
      "metadata": {
        "reference": "Proverbs 29:26",
        "verseKey": "kjv:proverbs:29:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:proverbs:29:27",
      "numberLabel": "27",
      "text": "An unjust man is an abomination to the just: and he that is upright in the way is abomination to the wicked.",
      "metadata": {
        "reference": "Proverbs 29:27",
        "verseKey": "kjv:proverbs:29:27"
      }
    }
  ],
