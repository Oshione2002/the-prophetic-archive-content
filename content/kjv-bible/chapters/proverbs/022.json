{
  "schemaVersion": 1,
  "id": "kjv-proverbs-022",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 22,
  "title": "Proverbs 22",
  "display_title": "Proverbs 22",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "proverbs",
  "book": "Proverbs",
  "bookName": "Proverbs",
  "bookOrder": 20,
  "testament": "old",
  "chapter": 22,
  "sortOrder": 20022,
  "verseCount": 29,
  "aliases": [
    "Prov",
    "Pr",
    "Prv"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:proverbs:22:1",
      "numberLabel": "1",
      "text": "A GOOD name is rather to be chosen than great riches, and loving favour rather than silver and gold.",
      "metadata": {
        "reference": "Proverbs 22:1",
        "verseKey": "kjv:proverbs:22:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:proverbs:22:2",
      "numberLabel": "2",
      "text": "The rich and poor meet together: the LORD is the maker of them all.",
      "metadata": {
        "reference": "Proverbs 22:2",
        "verseKey": "kjv:proverbs:22:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:proverbs:22:3",
      "numberLabel": "3",
      "text": "A prudent man foreseeth the evil, and hideth himself: but the simple pass on, and are punished.",
      "metadata": {
        "reference": "Proverbs 22:3",
        "verseKey": "kjv:proverbs:22:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:proverbs:22:4",
      "numberLabel": "4",
      "text": "By humility and the fear of the LORD are riches, and honour, and life.",
      "metadata": {
        "reference": "Proverbs 22:4",
        "verseKey": "kjv:proverbs:22:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:proverbs:22:5",
      "numberLabel": "5",
      "text": "Thorns and snares are in the way of the froward: he that doth keep his soul shall be far from them.",
      "metadata": {
        "reference": "Proverbs 22:5",
        "verseKey": "kjv:proverbs:22:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:proverbs:22:6",
      "numberLabel": "6",
      "text": "Train up a child in the way he should go: and when he is old, he will not depart from it.",
      "metadata": {
        "reference": "Proverbs 22:6",
        "verseKey": "kjv:proverbs:22:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:proverbs:22:7",
      "numberLabel": "7",
      "text": "The rich ruleth over the poor, and the borrower is servant to the lender.",
      "metadata": {
        "reference": "Proverbs 22:7",
        "verseKey": "kjv:proverbs:22:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:proverbs:22:8",
      "numberLabel": "8",
      "text": "He that soweth iniquity shall reap vanity: and the rod of his anger shall fail.",
      "metadata": {
        "reference": "Proverbs 22:8",
        "verseKey": "kjv:proverbs:22:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:proverbs:22:9",
      "numberLabel": "9",
      "text": "He that hath a bountiful eye shall be blessed; for he giveth of his bread to the poor.",
      "metadata": {
        "reference": "Proverbs 22:9",
        "verseKey": "kjv:proverbs:22:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:proverbs:22:10",
      "numberLabel": "10",
      "text": "Cast out the scorner, and contention shall go out; yea, strife and reproach shall cease.",
      "metadata": {
        "reference": "Proverbs 22:10",
        "verseKey": "kjv:proverbs:22:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:proverbs:22:11",
      "numberLabel": "11",
      "text": "He that loveth pureness of heart, for the grace of his lips the king shall be his friend.",
      "metadata": {
        "reference": "Proverbs 22:11",
        "verseKey": "kjv:proverbs:22:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:proverbs:22:12",
      "numberLabel": "12",
      "text": "The eyes of the LORD preserve knowledge, and he overthroweth the words of the transgressor.",
      "metadata": {
        "reference": "Proverbs 22:12",
        "verseKey": "kjv:proverbs:22:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:proverbs:22:13",
      "numberLabel": "13",
      "text": "The slothful man saith, There is a lion without, I shall be slain in the streets.",
      "metadata": {
        "reference": "Proverbs 22:13",
        "verseKey": "kjv:proverbs:22:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:proverbs:22:14",
      "numberLabel": "14",
      "text": "The mouth of strange women is a deep pit: he that is abhorred of the LORD shall fall therein.",
      "metadata": {
        "reference": "Proverbs 22:14",
        "verseKey": "kjv:proverbs:22:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:proverbs:22:15",
      "numberLabel": "15",
      "text": "Foolishness is bound in the heart of a child; but the rod of correction shall drive it far from him.",
      "metadata": {
        "reference": "Proverbs 22:15",
        "verseKey": "kjv:proverbs:22:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:proverbs:22:16",
      "numberLabel": "16",
      "text": "He that oppresseth the poor to increase his riches, and he that giveth to the rich, shall surely come to want.",
      "metadata": {
        "reference": "Proverbs 22:16",
        "verseKey": "kjv:proverbs:22:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:proverbs:22:17",
      "numberLabel": "17",
      "text": "Bow down thine ear, and hear the words of the wise, and apply thine heart unto my knowledge.",
      "metadata": {
        "reference": "Proverbs 22:17",
        "verseKey": "kjv:proverbs:22:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:proverbs:22:18",
      "numberLabel": "18",
      "text": "For it is a pleasant thing if thou keep them within thee; they shall withal be fitted in thy lips.",
      "metadata": {
        "reference": "Proverbs 22:18",
        "verseKey": "kjv:proverbs:22:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:proverbs:22:19",
      "numberLabel": "19",
      "text": "That thy trust may be in the LORD, I have made known to thee this day, even to thee.",
      "metadata": {
        "reference": "Proverbs 22:19",
        "verseKey": "kjv:proverbs:22:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:proverbs:22:20",
      "numberLabel": "20",
      "text": "Have not I written to thee excellent things in counsels and knowledge,",
      "metadata": {
        "reference": "Proverbs 22:20",
        "verseKey": "kjv:proverbs:22:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:proverbs:22:21",
      "numberLabel": "21",
      "text": "That I might make thee know the certainty of the words of truth; that thou mightest answer the words of truth to them that send unto thee?",
      "metadata": {
        "reference": "Proverbs 22:21",
        "verseKey": "kjv:proverbs:22:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:proverbs:22:22",
      "numberLabel": "22",
      "text": "Rob not the poor, because he is poor: neither oppress the afflicted in the gate:",
      "metadata": {
        "reference": "Proverbs 22:22",
        "verseKey": "kjv:proverbs:22:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:proverbs:22:23",
      "numberLabel": "23",
      "text": "For the LORD will plead their cause, and spoil the soul of those that spoiled them.",
      "metadata": {
        "reference": "Proverbs 22:23",
        "verseKey": "kjv:proverbs:22:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:proverbs:22:24",
      "numberLabel": "24",
      "text": "Make no friendship with an angry man; and with a furious man thou shalt not go:",
      "metadata": {
        "reference": "Proverbs 22:24",
        "verseKey": "kjv:proverbs:22:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:proverbs:22:25",
      "numberLabel": "25",
      "text": "Lest thou learn his ways, and get a snare to thy soul.",
      "metadata": {
        "reference": "Proverbs 22:25",
        "verseKey": "kjv:proverbs:22:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:proverbs:22:26",
      "numberLabel": "26",
      "text": "Be not thou one of them that strike hands, or of them that are sureties for debts.",
      "metadata": {
        "reference": "Proverbs 22:26",
        "verseKey": "kjv:proverbs:22:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:proverbs:22:27",
      "numberLabel": "27",
      "text": "If thou hast nothing to pay, why should he take away thy bed from under thee?",
      "metadata": {
        "reference": "Proverbs 22:27",
        "verseKey": "kjv:proverbs:22:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:proverbs:22:28",
      "numberLabel": "28",
      "text": "Remove not the ancient landmark, which thy fathers have set.",
      "metadata": {
        "reference": "Proverbs 22:28",
        "verseKey": "kjv:proverbs:22:28"
      }
    },
    {
      "id": "verse-029",
      "type": "bible_verse",
      "verse": 29,
      "verseId": "kjv:proverbs:22:29",
      "numberLabel": "29",
      "text": "Seest thou a man diligent in his business? he shall stand before kings; he shall not stand before mean men.",
      "metadata": {
        "reference": "Proverbs 22:29",
        "verseKey": "kjv:proverbs:22:29"
      }
    }
  ],
