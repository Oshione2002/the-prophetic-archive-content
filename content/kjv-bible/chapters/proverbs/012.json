  "document_type": "bible_chapter",
  "number": 12,
  "title": "Proverbs 12",
  "display_title": "Proverbs 12",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "proverbs",
  "book": "Proverbs",
  "bookName": "Proverbs",
  "bookOrder": 20,
  "testament": "old",
  "chapter": 12,
  "sortOrder": 20012,
  "verseCount": 28,
  "aliases": [
    "Prov",
    "Pr",
    "Prv"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:proverbs:12:1",
      "numberLabel": "1",
      "text": "Whoso loveth instruction loveth knowledge: but he that hateth reproof is brutish.",
      "metadata": {
        "reference": "Proverbs 12:1",
        "verseKey": "kjv:proverbs:12:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:proverbs:12:2",
      "numberLabel": "2",
      "text": "A good man obtaineth favour of the LORD: but a man of wicked devices will he condemn.",
      "metadata": {
        "reference": "Proverbs 12:2",
        "verseKey": "kjv:proverbs:12:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:proverbs:12:3",
      "numberLabel": "3",
      "text": "A man shall not be established by wickedness: but the root of the righteous shall not be moved.",
      "metadata": {
        "reference": "Proverbs 12:3",
        "verseKey": "kjv:proverbs:12:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:proverbs:12:4",
      "numberLabel": "4",
      "text": "A virtuous woman is a crown to her husband: but she that maketh ashamed is as rottenness in his bones.",
      "metadata": {
        "reference": "Proverbs 12:4",
        "verseKey": "kjv:proverbs:12:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:proverbs:12:5",
      "numberLabel": "5",
      "text": "The thoughts of the righteous are right: but the counsels of the wicked are deceit.",
      "metadata": {
        "reference": "Proverbs 12:5",
        "verseKey": "kjv:proverbs:12:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:proverbs:12:6",
      "numberLabel": "6",
      "text": "The words of the wicked are to lie in wait for blood: but the mouth of the upright shall deliver them.",
      "metadata": {
        "reference": "Proverbs 12:6",
        "verseKey": "kjv:proverbs:12:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:proverbs:12:7",
      "numberLabel": "7",
      "text": "The wicked are overthrown, and are not: but the house of the righteous shall stand.",
      "metadata": {
        "reference": "Proverbs 12:7",
        "verseKey": "kjv:proverbs:12:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:proverbs:12:8",
      "numberLabel": "8",
      "text": "A man shall be commended according to his wisdom: but he that is of a perverse heart shall be despised.",
      "metadata": {
        "reference": "Proverbs 12:8",
        "verseKey": "kjv:proverbs:12:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:proverbs:12:9",
      "numberLabel": "9",
      "text": "He that is despised, and hath a servant, is better than he that honoureth himself, and lacketh bread.",
      "metadata": {
        "reference": "Proverbs 12:9",
        "verseKey": "kjv:proverbs:12:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:proverbs:12:10",
      "numberLabel": "10",
      "text": "A righteous man regardeth the life of his beast: but the tender mercies of the wicked are cruel.",
      "metadata": {
        "reference": "Proverbs 12:10",
        "verseKey": "kjv:proverbs:12:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:proverbs:12:11",
      "numberLabel": "11",
      "text": "He that tilleth his land shall be satisfied with bread: but he that followeth vain persons is void of understanding.",
      "metadata": {
        "reference": "Proverbs 12:11",
        "verseKey": "kjv:proverbs:12:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:proverbs:12:12",
      "numberLabel": "12",
      "text": "The wicked desireth the net of evil men: but the root of the righteous yieldeth fruit.",
      "metadata": {
        "reference": "Proverbs 12:12",
        "verseKey": "kjv:proverbs:12:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:proverbs:12:13",
      "numberLabel": "13",
      "text": "The wicked is snared by the transgression of his lips: but the just shall come out of trouble.",
      "metadata": {
        "reference": "Proverbs 12:13",
        "verseKey": "kjv:proverbs:12:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:proverbs:12:14",
      "numberLabel": "14",
      "text": "A man shall be satisfied with good by the fruit of his mouth: and the recompence of a man’s hands shall be rendered unto him.",
      "metadata": {
        "reference": "Proverbs 12:14",
        "verseKey": "kjv:proverbs:12:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:proverbs:12:15",
      "numberLabel": "15",
      "text": "The way of a fool is right in his own eyes: but he that hearkeneth unto counsel is wise.",
      "metadata": {
        "reference": "Proverbs 12:15",
        "verseKey": "kjv:proverbs:12:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:proverbs:12:16",
      "numberLabel": "16",
      "text": "A fool’s wrath is presently known: but a prudent man covereth shame.",
      "metadata": {
        "reference": "Proverbs 12:16",
        "verseKey": "kjv:proverbs:12:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:proverbs:12:17",
      "numberLabel": "17",
      "text": "He that speaketh truth sheweth forth righteousness: but a false witness deceit.",
      "metadata": {
        "reference": "Proverbs 12:17",
        "verseKey": "kjv:proverbs:12:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:proverbs:12:18",
      "numberLabel": "18",
      "text": "There is that speaketh like the piercings of a sword: but the tongue of the wise is health.",
      "metadata": {
        "reference": "Proverbs 12:18",
        "verseKey": "kjv:proverbs:12:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:proverbs:12:19",
      "numberLabel": "19",
      "text": "The lip of truth shall be established for ever: but a lying tongue is but for a moment.",
      "metadata": {
        "reference": "Proverbs 12:19",
        "verseKey": "kjv:proverbs:12:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:proverbs:12:20",
      "numberLabel": "20",
      "text": "Deceit is in the heart of them that imagine evil: but to the counsellors of peace is joy.",
      "metadata": {
        "reference": "Proverbs 12:20",
        "verseKey": "kjv:proverbs:12:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:proverbs:12:21",
      "numberLabel": "21",
      "text": "There shall no evil happen to the just: but the wicked shall be filled with mischief.",
      "metadata": {
        "reference": "Proverbs 12:21",
        "verseKey": "kjv:proverbs:12:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:proverbs:12:22",
      "numberLabel": "22",
      "text": "Lying lips are abomination to the LORD: but they that deal truly are his delight.",
      "metadata": {
        "reference": "Proverbs 12:22",
        "verseKey": "kjv:proverbs:12:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:proverbs:12:23",
      "numberLabel": "23",
      "text": "A prudent man concealeth knowledge: but the heart of fools proclaimeth foolishness.",
      "metadata": {
        "reference": "Proverbs 12:23",
        "verseKey": "kjv:proverbs:12:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:proverbs:12:24",
      "numberLabel": "24",
      "text": "The hand of the diligent shall bear rule: but the slothful shall be under tribute.",
      "metadata": {
        "reference": "Proverbs 12:24",
        "verseKey": "kjv:proverbs:12:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:proverbs:12:25",
      "numberLabel": "25",
      "text": "Heaviness in the heart of man maketh it stoop: but a good word maketh it glad.",
      "metadata": {
        "reference": "Proverbs 12:25",
        "verseKey": "kjv:proverbs:12:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:proverbs:12:26",
      "numberLabel": "26",
      "text": "The righteous is more excellent than his neighbour: but the way of the wicked seduceth them.",
      "metadata": {
        "reference": "Proverbs 12:26",
        "verseKey": "kjv:proverbs:12:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:proverbs:12:27",
      "numberLabel": "27",
      "text": "The slothful man roasteth not that which he took in hunting: but the substance of a diligent man is precious.",
      "metadata": {
        "reference": "Proverbs 12:27",
        "verseKey": "kjv:proverbs:12:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:proverbs:12:28",
      "numberLabel": "28",
      "text": "In the way of righteousness is life: and in the pathway thereof there is no death.",
      "metadata": {
        "reference": "Proverbs 12:28",
        "verseKey": "kjv:proverbs:12:28"
      }
    }
  ],
