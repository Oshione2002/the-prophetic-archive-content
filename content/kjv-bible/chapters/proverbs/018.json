  "document_type": "bible_chapter",
  "number": 18,
  "title": "Proverbs 18",
  "display_title": "Proverbs 18",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "proverbs",
  "book": "Proverbs",
  "bookName": "Proverbs",
