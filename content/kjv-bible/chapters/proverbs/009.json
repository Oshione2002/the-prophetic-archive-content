{
  "schemaVersion": 1,
  "id": "kjv-proverbs-009",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 9,
  "title": "Proverbs 9",
  "display_title": "Proverbs 9",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "proverbs",
  "book": "Proverbs",
  "bookName": "Proverbs",
  "bookOrder": 20,
  "testament": "old",
  "chapter": 9,
  "sortOrder": 20009,
  "verseCount": 18,
  "aliases": [
    "Prov",
    "Pr",
    "Prv"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:proverbs:9:1",
      "numberLabel": "1",
      "text": "Wisdom hath builded her house, she hath hewn out her seven pillars:",
      "metadata": {
        "reference": "Proverbs 9:1",
        "verseKey": "kjv:proverbs:9:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:proverbs:9:2",
      "numberLabel": "2",
      "text": "She hath killed her beasts; she hath mingled her wine; she hath also furnished her table.",
      "metadata": {
        "reference": "Proverbs 9:2",
        "verseKey": "kjv:proverbs:9:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:proverbs:9:3",
      "numberLabel": "3",
      "text": "She hath sent forth her maidens: she crieth upon the highest places of the city,",
      "metadata": {
        "reference": "Proverbs 9:3",
        "verseKey": "kjv:proverbs:9:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:proverbs:9:4",
      "numberLabel": "4",
      "text": "Whoso is simple, let him turn in hither: as for him that wanteth understanding, she saith to him,",
      "metadata": {
        "reference": "Proverbs 9:4",
        "verseKey": "kjv:proverbs:9:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:proverbs:9:5",
      "numberLabel": "5",
      "text": "Come, eat of my bread, and drink of the wine which I have mingled.",
      "metadata": {
        "reference": "Proverbs 9:5",
        "verseKey": "kjv:proverbs:9:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:proverbs:9:6",
      "numberLabel": "6",
      "text": "Forsake the foolish, and live; and go in the way of understanding.",
      "metadata": {
        "reference": "Proverbs 9:6",
        "verseKey": "kjv:proverbs:9:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:proverbs:9:7",
      "numberLabel": "7",
      "text": "He that reproveth a scorner getteth to himself shame: and he that rebuketh a wicked man getteth himself a blot.",
      "metadata": {
        "reference": "Proverbs 9:7",
        "verseKey": "kjv:proverbs:9:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:proverbs:9:8",
      "numberLabel": "8",
      "text": "Reprove not a scorner, lest he hate thee: rebuke a wise man, and he will love thee.",
      "metadata": {
        "reference": "Proverbs 9:8",
        "verseKey": "kjv:proverbs:9:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:proverbs:9:9",
      "numberLabel": "9",
      "text": "Give instruction to a wise man, and he will be yet wiser: teach a just man, and he will increase in learning.",
      "metadata": {
        "reference": "Proverbs 9:9",
        "verseKey": "kjv:proverbs:9:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:proverbs:9:10",
      "numberLabel": "10",
      "text": "The fear of the LORD is the beginning of wisdom: and the knowledge of the holy is understanding.",
      "metadata": {
        "reference": "Proverbs 9:10",
        "verseKey": "kjv:proverbs:9:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:proverbs:9:11",
      "numberLabel": "11",
      "text": "For by me thy days shall be multiplied, and the years of thy life shall be increased.",
      "metadata": {
        "reference": "Proverbs 9:11",
        "verseKey": "kjv:proverbs:9:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:proverbs:9:12",
      "numberLabel": "12",
      "text": "If thou be wise, thou shalt be wise for thyself: but if thou scornest, thou alone shalt bear it.",
      "metadata": {
        "reference": "Proverbs 9:12",
        "verseKey": "kjv:proverbs:9:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:proverbs:9:13",
      "numberLabel": "13",
      "text": "A foolish woman is clamorous: she is simple, and knoweth nothing.",
      "metadata": {
        "reference": "Proverbs 9:13",
        "verseKey": "kjv:proverbs:9:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:proverbs:9:14",
      "numberLabel": "14",
      "text": "For she sitteth at the door of her house, on a seat in the high places of the city,",
      "metadata": {
        "reference": "Proverbs 9:14",
        "verseKey": "kjv:proverbs:9:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:proverbs:9:15",
      "numberLabel": "15",
      "text": "To call passengers who go right on their ways:",
      "metadata": {
        "reference": "Proverbs 9:15",
        "verseKey": "kjv:proverbs:9:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:proverbs:9:16",
      "numberLabel": "16",
      "text": "Whoso is simple, let him turn in hither: and as for him that wanteth understanding, she saith to him,",
      "metadata": {
        "reference": "Proverbs 9:16",
        "verseKey": "kjv:proverbs:9:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:proverbs:9:17",
      "numberLabel": "17",
      "text": "Stolen waters are sweet, and bread eaten in secret is pleasant.",
      "metadata": {
        "reference": "Proverbs 9:17",
        "verseKey": "kjv:proverbs:9:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:proverbs:9:18",
      "numberLabel": "18",
      "text": "But he knoweth not that the dead are there; and that her guests are in the depths of hell.",
      "metadata": {
        "reference": "Proverbs 9:18",
        "verseKey": "kjv:proverbs:9:18"
      }
    }
  ],
  "source": {
