  "document_type": "bible_chapter",
  "number": 4,
  "title": "Proverbs 4",
  "display_title": "Proverbs 4",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "proverbs",
  "book": "Proverbs",
