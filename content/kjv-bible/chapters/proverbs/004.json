    "Prv"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:proverbs:4:1",
      "numberLabel": "1",
      "text": "Hear, ye children, the instruction of a father, and attend to know understanding.",
      "metadata": {
        "reference": "Proverbs 4:1",
        "verseKey": "kjv:proverbs:4:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:proverbs:4:2",
      "numberLabel": "2",
      "text": "For I give you good doctrine, forsake ye not my law.",
      "metadata": {
        "reference": "Proverbs 4:2",
        "verseKey": "kjv:proverbs:4:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:proverbs:4:3",
      "numberLabel": "3",
      "text": "For I was my father’s son, tender and only beloved in the sight of my mother.",
      "metadata": {
        "reference": "Proverbs 4:3",
        "verseKey": "kjv:proverbs:4:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:proverbs:4:4",
      "numberLabel": "4",
      "text": "He taught me also, and said unto me, Let thine heart retain my words: keep my commandments, and live.",
      "metadata": {
        "reference": "Proverbs 4:4",
        "verseKey": "kjv:proverbs:4:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:proverbs:4:5",
      "numberLabel": "5",
      "text": "Get wisdom, get understanding: forget it not; neither decline from the words of my mouth.",
      "metadata": {
        "reference": "Proverbs 4:5",
        "verseKey": "kjv:proverbs:4:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:proverbs:4:6",
      "numberLabel": "6",
      "text": "Forsake her not, and she shall preserve thee: love her, and she shall keep thee.",
      "metadata": {
        "reference": "Proverbs 4:6",
        "verseKey": "kjv:proverbs:4:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:proverbs:4:7",
      "numberLabel": "7",
      "text": "Wisdom is the principal thing; therefore get wisdom: and with all thy getting get understanding.",
      "metadata": {
        "reference": "Proverbs 4:7",
        "verseKey": "kjv:proverbs:4:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:proverbs:4:8",
      "numberLabel": "8",
      "text": "Exalt her, and she shall promote thee: she shall bring thee to honour, when thou dost embrace her.",
      "metadata": {
        "reference": "Proverbs 4:8",
        "verseKey": "kjv:proverbs:4:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:proverbs:4:9",
      "numberLabel": "9",
      "text": "She shall give to thine head an ornament of grace: a crown of glory shall she deliver to thee.",
      "metadata": {
        "reference": "Proverbs 4:9",
        "verseKey": "kjv:proverbs:4:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:proverbs:4:10",
      "numberLabel": "10",
      "text": "Hear, O my son, and receive my sayings; and the years of thy life shall be many.",
      "metadata": {
        "reference": "Proverbs 4:10",
        "verseKey": "kjv:proverbs:4:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:proverbs:4:11",
      "numberLabel": "11",
      "text": "I have taught thee in the way of wisdom; I have led thee in right paths.",
      "metadata": {
        "reference": "Proverbs 4:11",
        "verseKey": "kjv:proverbs:4:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:proverbs:4:12",
      "numberLabel": "12",
      "text": "When thou goest, thy steps shall not be straitened; and when thou runnest, thou shalt not stumble.",
      "metadata": {
        "reference": "Proverbs 4:12",
        "verseKey": "kjv:proverbs:4:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:proverbs:4:13",
      "numberLabel": "13",
      "text": "Take fast hold of instruction; let her not go: keep her; for she is thy life.",
      "metadata": {
        "reference": "Proverbs 4:13",
        "verseKey": "kjv:proverbs:4:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:proverbs:4:14",
      "numberLabel": "14",
      "text": "Enter not into the path of the wicked, and go not in the way of evil men.",
      "metadata": {
        "reference": "Proverbs 4:14",
        "verseKey": "kjv:proverbs:4:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:proverbs:4:15",
      "numberLabel": "15",
      "text": "Avoid it, pass not by it, turn from it, and pass away.",
      "metadata": {
        "reference": "Proverbs 4:15",
        "verseKey": "kjv:proverbs:4:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:proverbs:4:16",
      "numberLabel": "16",
      "text": "For they sleep not, except they have done mischief; and their sleep is taken away, unless they cause some to fall.",
      "metadata": {
        "reference": "Proverbs 4:16",
        "verseKey": "kjv:proverbs:4:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:proverbs:4:17",
      "numberLabel": "17",
      "text": "For they eat the bread of wickedness, and drink the wine of violence.",
      "metadata": {
        "reference": "Proverbs 4:17",
        "verseKey": "kjv:proverbs:4:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:proverbs:4:18",
      "numberLabel": "18",
      "text": "But the path of the just is as the shining light, that shineth more and more unto the perfect day.",
      "metadata": {
        "reference": "Proverbs 4:18",
        "verseKey": "kjv:proverbs:4:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:proverbs:4:19",
      "numberLabel": "19",
      "text": "The way of the wicked is as darkness: they know not at what they stumble.",
      "metadata": {
        "reference": "Proverbs 4:19",
        "verseKey": "kjv:proverbs:4:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:proverbs:4:20",
      "numberLabel": "20",
      "text": "My son, attend to my words; incline thine ear unto my sayings.",
      "metadata": {
        "reference": "Proverbs 4:20",
        "verseKey": "kjv:proverbs:4:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:proverbs:4:21",
      "numberLabel": "21",
      "text": "Let them not depart from thine eyes; keep them in the midst of thine heart.",
      "metadata": {
        "reference": "Proverbs 4:21",
        "verseKey": "kjv:proverbs:4:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:proverbs:4:22",
      "numberLabel": "22",
      "text": "For they are life unto those that find them, and health to all their flesh.",
      "metadata": {
        "reference": "Proverbs 4:22",
        "verseKey": "kjv:proverbs:4:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:proverbs:4:23",
      "numberLabel": "23",
      "text": "Keep thy heart with all diligence; for out of it are the issues of life.",
      "metadata": {
        "reference": "Proverbs 4:23",
        "verseKey": "kjv:proverbs:4:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:proverbs:4:24",
      "numberLabel": "24",
      "text": "Put away from thee a froward mouth, and perverse lips put far from thee.",
      "metadata": {
        "reference": "Proverbs 4:24",
        "verseKey": "kjv:proverbs:4:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:proverbs:4:25",
      "numberLabel": "25",
      "text": "Let thine eyes look right on, and let thine eyelids look straight before thee.",
      "metadata": {
        "reference": "Proverbs 4:25",
        "verseKey": "kjv:proverbs:4:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:proverbs:4:26",
      "numberLabel": "26",
      "text": "Ponder the path of thy feet, and let all thy ways be established.",
      "metadata": {
        "reference": "Proverbs 4:26",
        "verseKey": "kjv:proverbs:4:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:proverbs:4:27",
      "numberLabel": "27",
      "text": "Turn not to the right hand nor to the left: remove thy foot from evil.",
      "metadata": {
        "reference": "Proverbs 4:27",
        "verseKey": "kjv:proverbs:4:27"
      }
    }
  ],
  "source": {
