{
  "schemaVersion": 1,
  "id": "kjv-proverbs-031",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 31,
  "title": "Proverbs 31",
  "display_title": "Proverbs 31",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "proverbs",
  "book": "Proverbs",
  "bookName": "Proverbs",
  "bookOrder": 20,
  "testament": "old",
  "chapter": 31,
  "sortOrder": 20031,
  "verseCount": 31,
  "aliases": [
    "Prov",
    "Pr",
    "Prv"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:proverbs:31:1",
      "numberLabel": "1",
      "text": "The words of king Lemuel, the prophecy that his mother taught him.",
      "metadata": {
        "reference": "Proverbs 31:1",
        "verseKey": "kjv:proverbs:31:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:proverbs:31:2",
      "numberLabel": "2",
      "text": "What, my son? and what, the son of my womb? and what, the son of my vows?",
      "metadata": {
        "reference": "Proverbs 31:2",
        "verseKey": "kjv:proverbs:31:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:proverbs:31:3",
      "numberLabel": "3",
      "text": "Give not thy strength unto women, nor thy ways to that which destroyeth kings.",
      "metadata": {
        "reference": "Proverbs 31:3",
        "verseKey": "kjv:proverbs:31:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:proverbs:31:4",
      "numberLabel": "4",
      "text": "It is not for kings, O Lemuel, it is not for kings to drink wine; nor for princes strong drink:",
      "metadata": {
        "reference": "Proverbs 31:4",
        "verseKey": "kjv:proverbs:31:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:proverbs:31:5",
      "numberLabel": "5",
      "text": "Lest they drink, and forget the law, and pervert the judgment of any of the afflicted.",
      "metadata": {
        "reference": "Proverbs 31:5",
        "verseKey": "kjv:proverbs:31:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:proverbs:31:6",
      "numberLabel": "6",
      "text": "Give strong drink unto him that is ready to perish, and wine unto those that be of heavy hearts.",
      "metadata": {
        "reference": "Proverbs 31:6",
        "verseKey": "kjv:proverbs:31:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:proverbs:31:7",
      "numberLabel": "7",
      "text": "Let him drink, and forget his poverty, and remember his misery no more.",
      "metadata": {
        "reference": "Proverbs 31:7",
        "verseKey": "kjv:proverbs:31:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:proverbs:31:8",
      "numberLabel": "8",
      "text": "Open thy mouth for the dumb in the cause of all such as are appointed to destruction.",
      "metadata": {
        "reference": "Proverbs 31:8",
        "verseKey": "kjv:proverbs:31:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:proverbs:31:9",
      "numberLabel": "9",
      "text": "Open thy mouth, judge righteously, and plead the cause of the poor and needy.",
      "metadata": {
        "reference": "Proverbs 31:9",
        "verseKey": "kjv:proverbs:31:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:proverbs:31:10",
      "numberLabel": "10",
      "text": "Who can find a virtuous woman? for her price is far above rubies.",
      "metadata": {
        "reference": "Proverbs 31:10",
        "verseKey": "kjv:proverbs:31:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:proverbs:31:11",
      "numberLabel": "11",
      "text": "The heart of her husband doth safely trust in her, so that he shall have no need of spoil.",
      "metadata": {
        "reference": "Proverbs 31:11",
        "verseKey": "kjv:proverbs:31:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:proverbs:31:12",
      "numberLabel": "12",
      "text": "She will do him good and not evil all the days of her life.",
      "metadata": {
        "reference": "Proverbs 31:12",
        "verseKey": "kjv:proverbs:31:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:proverbs:31:13",
      "numberLabel": "13",
      "text": "She seeketh wool, and flax, and worketh willingly with her hands.",
      "metadata": {
        "reference": "Proverbs 31:13",
        "verseKey": "kjv:proverbs:31:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:proverbs:31:14",
      "numberLabel": "14",
      "text": "She is like the merchants’ ships; she bringeth her food from afar.",
      "metadata": {
        "reference": "Proverbs 31:14",
        "verseKey": "kjv:proverbs:31:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:proverbs:31:15",
      "numberLabel": "15",
      "text": "She riseth also while it is yet night, and giveth meat to her household, and a portion to her maidens.",
      "metadata": {
        "reference": "Proverbs 31:15",
        "verseKey": "kjv:proverbs:31:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:proverbs:31:16",
      "numberLabel": "16",
      "text": "She considereth a field, and buyeth it: with the fruit of her hands she planteth a vineyard.",
      "metadata": {
        "reference": "Proverbs 31:16",
        "verseKey": "kjv:proverbs:31:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:proverbs:31:17",
      "numberLabel": "17",
      "text": "She girdeth her loins with strength, and strengtheneth her arms.",
      "metadata": {
        "reference": "Proverbs 31:17",
        "verseKey": "kjv:proverbs:31:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:proverbs:31:18",
      "numberLabel": "18",
      "text": "She perceiveth that her merchandise is good: her candle goeth not out by night.",
      "metadata": {
        "reference": "Proverbs 31:18",
        "verseKey": "kjv:proverbs:31:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:proverbs:31:19",
      "numberLabel": "19",
      "text": "She layeth her hands to the spindle, and her hands hold the distaff.",
      "metadata": {
        "reference": "Proverbs 31:19",
        "verseKey": "kjv:proverbs:31:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:proverbs:31:20",
      "numberLabel": "20",
      "text": "She stretcheth out her hand to the poor; yea, she reacheth forth her hands to the needy.",
      "metadata": {
        "reference": "Proverbs 31:20",
        "verseKey": "kjv:proverbs:31:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:proverbs:31:21",
      "numberLabel": "21",
      "text": "She is not afraid of the snow for her household: for all her household are clothed with scarlet.",
      "metadata": {
        "reference": "Proverbs 31:21",
        "verseKey": "kjv:proverbs:31:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:proverbs:31:22",
      "numberLabel": "22",
      "text": "She maketh herself coverings of tapestry; her clothing is silk and purple.",
      "metadata": {
        "reference": "Proverbs 31:22",
        "verseKey": "kjv:proverbs:31:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:proverbs:31:23",
      "numberLabel": "23",
      "text": "Her husband is known in the gates, when he sitteth among the elders of the land.",
      "metadata": {
        "reference": "Proverbs 31:23",
        "verseKey": "kjv:proverbs:31:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:proverbs:31:24",
      "numberLabel": "24",
      "text": "She maketh fine linen, and selleth it; and delivereth girdles unto the merchant.",
      "metadata": {
        "reference": "Proverbs 31:24",
        "verseKey": "kjv:proverbs:31:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:proverbs:31:25",
      "numberLabel": "25",
      "text": "Strength and honour are her clothing; and she shall rejoice in time to come.",
      "metadata": {
        "reference": "Proverbs 31:25",
        "verseKey": "kjv:proverbs:31:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:proverbs:31:26",
      "numberLabel": "26",
      "text": "She openeth her mouth with wisdom; and in her tongue is the law of kindness.",
      "metadata": {
        "reference": "Proverbs 31:26",
        "verseKey": "kjv:proverbs:31:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:proverbs:31:27",
      "numberLabel": "27",
      "text": "She looketh well to the ways of her household, and eateth not the bread of idleness.",
      "metadata": {
        "reference": "Proverbs 31:27",
        "verseKey": "kjv:proverbs:31:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:proverbs:31:28",
      "numberLabel": "28",
      "text": "Her children arise up, and call her blessed; her husband also, and he praiseth her.",
      "metadata": {
        "reference": "Proverbs 31:28",
        "verseKey": "kjv:proverbs:31:28"
      }
    },
    {
      "id": "verse-029",
      "type": "bible_verse",
      "verse": 29,
      "verseId": "kjv:proverbs:31:29",
      "numberLabel": "29",
      "text": "Many daughters have done virtuously, but thou excellest them all.",
      "metadata": {
        "reference": "Proverbs 31:29",
        "verseKey": "kjv:proverbs:31:29"
      }
    },
    {
      "id": "verse-030",
      "type": "bible_verse",
      "verse": 30,
      "verseId": "kjv:proverbs:31:30",
      "numberLabel": "30",
      "text": "Favour is deceitful, and beauty is vain: but a woman that feareth the LORD, she shall be praised.",
      "metadata": {
        "reference": "Proverbs 31:30",
        "verseKey": "kjv:proverbs:31:30"
      }
    },
    {
      "id": "verse-031",
      "type": "bible_verse",
      "verse": 31,
      "verseId": "kjv:proverbs:31:31",
      "numberLabel": "31",
      "text": "Give her of the fruit of her hands; and let her own works praise her in the gates.",
      "metadata": {
        "reference": "Proverbs 31:31",
        "verseKey": "kjv:proverbs:31:31"
      }
    }
  ],
