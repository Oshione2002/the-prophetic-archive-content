{
  "schemaVersion": 1,
  "id": "kjv-proverbs-015",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 15,
  "title": "Proverbs 15",
  "display_title": "Proverbs 15",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "proverbs",
  "book": "Proverbs",
  "bookName": "Proverbs",
  "bookOrder": 20,
  "testament": "old",
  "chapter": 15,
  "sortOrder": 20015,
  "verseCount": 33,
  "aliases": [
    "Prov",
    "Pr",
    "Prv"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:proverbs:15:1",
      "numberLabel": "1",
      "text": "A soft answer turneth away wrath: but grievous words stir up anger.",
      "metadata": {
        "reference": "Proverbs 15:1",
        "verseKey": "kjv:proverbs:15:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:proverbs:15:2",
      "numberLabel": "2",
      "text": "The tongue of the wise useth knowledge aright: but the mouth of fools poureth out foolishness.",
      "metadata": {
        "reference": "Proverbs 15:2",
        "verseKey": "kjv:proverbs:15:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:proverbs:15:3",
      "numberLabel": "3",
      "text": "The eyes of the LORD are in every place, beholding the evil and the good.",
      "metadata": {
        "reference": "Proverbs 15:3",
        "verseKey": "kjv:proverbs:15:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:proverbs:15:4",
      "numberLabel": "4",
      "text": "A wholesome tongue is a tree of life: but perverseness therein is a breach in the spirit.",
      "metadata": {
        "reference": "Proverbs 15:4",
        "verseKey": "kjv:proverbs:15:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:proverbs:15:5",
      "numberLabel": "5",
      "text": "A fool despiseth his father’s instruction: but he that regardeth reproof is prudent.",
      "metadata": {
        "reference": "Proverbs 15:5",
        "verseKey": "kjv:proverbs:15:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:proverbs:15:6",
      "numberLabel": "6",
      "text": "In the house of the righteous is much treasure: but in the revenues of the wicked is trouble.",
      "metadata": {
        "reference": "Proverbs 15:6",
        "verseKey": "kjv:proverbs:15:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:proverbs:15:7",
      "numberLabel": "7",
      "text": "The lips of the wise disperse knowledge: but the heart of the foolish doeth not so.",
      "metadata": {
        "reference": "Proverbs 15:7",
        "verseKey": "kjv:proverbs:15:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:proverbs:15:8",
      "numberLabel": "8",
      "text": "The sacrifice of the wicked is an abomination to the LORD: but the prayer of the upright is his delight.",
      "metadata": {
        "reference": "Proverbs 15:8",
        "verseKey": "kjv:proverbs:15:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:proverbs:15:9",
      "numberLabel": "9",
      "text": "The way of the wicked is an abomination unto the LORD: but he loveth him that followeth after righteousness.",
      "metadata": {
        "reference": "Proverbs 15:9",
        "verseKey": "kjv:proverbs:15:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:proverbs:15:10",
      "numberLabel": "10",
      "text": "Correction is grievous unto him that forsaketh the way: and he that hateth reproof shall die.",
      "metadata": {
        "reference": "Proverbs 15:10",
        "verseKey": "kjv:proverbs:15:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:proverbs:15:11",
      "numberLabel": "11",
      "text": "Hell and destruction are before the LORD: how much more then the hearts of the children of men?",
      "metadata": {
        "reference": "Proverbs 15:11",
        "verseKey": "kjv:proverbs:15:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:proverbs:15:12",
      "numberLabel": "12",
      "text": "A scorner loveth not one that reproveth him: neither will he go unto the wise.",
      "metadata": {
        "reference": "Proverbs 15:12",
        "verseKey": "kjv:proverbs:15:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:proverbs:15:13",
      "numberLabel": "13",
      "text": "A merry heart maketh a cheerful countenance: but by sorrow of the heart the spirit is broken.",
      "metadata": {
        "reference": "Proverbs 15:13",
        "verseKey": "kjv:proverbs:15:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:proverbs:15:14",
      "numberLabel": "14",
      "text": "The heart of him that hath understanding seeketh knowledge: but the mouth of fools feedeth on foolishness.",
      "metadata": {
        "reference": "Proverbs 15:14",
        "verseKey": "kjv:proverbs:15:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:proverbs:15:15",
      "numberLabel": "15",
      "text": "All the days of the afflicted are evil: but he that is of a merry heart hath a continual feast.",
      "metadata": {
        "reference": "Proverbs 15:15",
        "verseKey": "kjv:proverbs:15:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:proverbs:15:16",
      "numberLabel": "16",
      "text": "Better is little with the fear of the LORD than great treasure and trouble therewith.",
      "metadata": {
        "reference": "Proverbs 15:16",
        "verseKey": "kjv:proverbs:15:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:proverbs:15:17",
      "numberLabel": "17",
      "text": "Better is a dinner of herbs where love is, than a stalled ox and hatred therewith.",
      "metadata": {
        "reference": "Proverbs 15:17",
        "verseKey": "kjv:proverbs:15:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:proverbs:15:18",
      "numberLabel": "18",
      "text": "A wrathful man stirreth up strife: but he that is slow to anger appeaseth strife.",
      "metadata": {
        "reference": "Proverbs 15:18",
        "verseKey": "kjv:proverbs:15:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:proverbs:15:19",
      "numberLabel": "19",
      "text": "The way of the slothful man is as an hedge of thorns: but the way of the righteous is made plain.",
      "metadata": {
        "reference": "Proverbs 15:19",
        "verseKey": "kjv:proverbs:15:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:proverbs:15:20",
      "numberLabel": "20",
      "text": "A wise son maketh a glad father: but a foolish man despiseth his mother.",
      "metadata": {
        "reference": "Proverbs 15:20",
        "verseKey": "kjv:proverbs:15:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:proverbs:15:21",
      "numberLabel": "21",
      "text": "Folly is joy to him that is destitute of wisdom: but a man of understanding walketh uprightly.",
      "metadata": {
        "reference": "Proverbs 15:21",
        "verseKey": "kjv:proverbs:15:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:proverbs:15:22",
      "numberLabel": "22",
      "text": "Without counsel purposes are disappointed: but in the multitude of counsellors they are established.",
      "metadata": {
        "reference": "Proverbs 15:22",
        "verseKey": "kjv:proverbs:15:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:proverbs:15:23",
      "numberLabel": "23",
      "text": "A man hath joy by the answer of his mouth: and a word spoken in due season, how good is it!",
      "metadata": {
        "reference": "Proverbs 15:23",
        "verseKey": "kjv:proverbs:15:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:proverbs:15:24",
      "numberLabel": "24",
      "text": "The way of life is above to the wise, that he may depart from hell beneath.",
      "metadata": {
        "reference": "Proverbs 15:24",
        "verseKey": "kjv:proverbs:15:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:proverbs:15:25",
      "numberLabel": "25",
      "text": "The LORD will destroy the house of the proud: but he will establish the border of the widow.",
      "metadata": {
        "reference": "Proverbs 15:25",
        "verseKey": "kjv:proverbs:15:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:proverbs:15:26",
      "numberLabel": "26",
      "text": "The thoughts of the wicked are an abomination to the LORD: but the words of the pure are pleasant words.",
      "metadata": {
        "reference": "Proverbs 15:26",
        "verseKey": "kjv:proverbs:15:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:proverbs:15:27",
      "numberLabel": "27",
      "text": "He that is greedy of gain troubleth his own house; but he that hateth gifts shall live.",
      "metadata": {
        "reference": "Proverbs 15:27",
        "verseKey": "kjv:proverbs:15:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:proverbs:15:28",
      "numberLabel": "28",
      "text": "The heart of the righteous studieth to answer: but the mouth of the wicked poureth out evil things.",
      "metadata": {
        "reference": "Proverbs 15:28",
        "verseKey": "kjv:proverbs:15:28"
      }
    },
    {
      "id": "verse-029",
      "type": "bible_verse",
      "verse": 29,
      "verseId": "kjv:proverbs:15:29",
      "numberLabel": "29",
      "text": "The LORD is far from the wicked: but he heareth the prayer of the righteous.",
      "metadata": {
        "reference": "Proverbs 15:29",
        "verseKey": "kjv:proverbs:15:29"
      }
    },
    {
      "id": "verse-030",
      "type": "bible_verse",
      "verse": 30,
      "verseId": "kjv:proverbs:15:30",
      "numberLabel": "30",
      "text": "The light of the eyes rejoiceth the heart: and a good report maketh the bones fat.",
      "metadata": {
        "reference": "Proverbs 15:30",
        "verseKey": "kjv:proverbs:15:30"
      }
    },
    {
      "id": "verse-031",
      "type": "bible_verse",
      "verse": 31,
      "verseId": "kjv:proverbs:15:31",
      "numberLabel": "31",
      "text": "The ear that heareth the reproof of life abideth among the wise.",
      "metadata": {
        "reference": "Proverbs 15:31",
        "verseKey": "kjv:proverbs:15:31"
      }
    },
    {
      "id": "verse-032",
      "type": "bible_verse",
      "verse": 32,
      "verseId": "kjv:proverbs:15:32",
      "numberLabel": "32",
      "text": "He that refuseth instruction despiseth his own soul: but he that heareth reproof getteth understanding.",
      "metadata": {
        "reference": "Proverbs 15:32",
        "verseKey": "kjv:proverbs:15:32"
      }
    },
    {
      "id": "verse-033",
      "type": "bible_verse",
      "verse": 33,
      "verseId": "kjv:proverbs:15:33",
      "numberLabel": "33",
      "text": "The fear of the LORD is the instruction of wisdom; and before honour is humility.",
      "metadata": {
        "reference": "Proverbs 15:33",
        "verseKey": "kjv:proverbs:15:33"
      }
    }
  ],
