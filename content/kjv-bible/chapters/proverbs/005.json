{
  "schemaVersion": 1,
  "id": "kjv-proverbs-005",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 5,
  "title": "Proverbs 5",
  "display_title": "Proverbs 5",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "proverbs",
  "book": "Proverbs",
  "bookName": "Proverbs",
  "bookOrder": 20,
  "testament": "old",
  "chapter": 5,
  "sortOrder": 20005,
  "verseCount": 23,
  "aliases": [
    "Prov",
    "Pr",
    "Prv"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:proverbs:5:1",
      "numberLabel": "1",
      "text": "My son, attend unto my wisdom, and bow thine ear to my understanding:",
      "metadata": {
        "reference": "Proverbs 5:1",
        "verseKey": "kjv:proverbs:5:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:proverbs:5:2",
      "numberLabel": "2",
      "text": "That thou mayest regard discretion, and that thy lips may keep knowledge.",
      "metadata": {
        "reference": "Proverbs 5:2",
        "verseKey": "kjv:proverbs:5:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:proverbs:5:3",
      "numberLabel": "3",
      "text": "For the lips of a strange woman drop as an honeycomb, and her mouth is smoother than oil:",
      "metadata": {
        "reference": "Proverbs 5:3",
        "verseKey": "kjv:proverbs:5:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:proverbs:5:4",
      "numberLabel": "4",
      "text": "But her end is bitter as wormwood, sharp as a two-edged sword.",
      "metadata": {
        "reference": "Proverbs 5:4",
        "verseKey": "kjv:proverbs:5:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:proverbs:5:5",
      "numberLabel": "5",
      "text": "Her feet go down to death; her steps take hold on hell.",
      "metadata": {
        "reference": "Proverbs 5:5",
        "verseKey": "kjv:proverbs:5:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:proverbs:5:6",
      "numberLabel": "6",
      "text": "Lest thou shouldest ponder the path of life, her ways are moveable, that thou canst not know them.",
      "metadata": {
        "reference": "Proverbs 5:6",
        "verseKey": "kjv:proverbs:5:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:proverbs:5:7",
      "numberLabel": "7",
      "text": "Hear me now therefore, O ye children, and depart not from the words of my mouth.",
      "metadata": {
        "reference": "Proverbs 5:7",
        "verseKey": "kjv:proverbs:5:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:proverbs:5:8",
      "numberLabel": "8",
      "text": "Remove thy way far from her, and come not nigh the door of her house:",
      "metadata": {
        "reference": "Proverbs 5:8",
        "verseKey": "kjv:proverbs:5:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:proverbs:5:9",
      "numberLabel": "9",
      "text": "Lest thou give thine honour unto others, and thy years unto the cruel:",
      "metadata": {
        "reference": "Proverbs 5:9",
        "verseKey": "kjv:proverbs:5:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:proverbs:5:10",
      "numberLabel": "10",
      "text": "Lest strangers be filled with thy wealth; and thy labours be in the house of a stranger;",
      "metadata": {
        "reference": "Proverbs 5:10",
        "verseKey": "kjv:proverbs:5:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:proverbs:5:11",
      "numberLabel": "11",
      "text": "And thou mourn at the last, when thy flesh and thy body are consumed,",
      "metadata": {
        "reference": "Proverbs 5:11",
        "verseKey": "kjv:proverbs:5:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:proverbs:5:12",
      "numberLabel": "12",
      "text": "And say, How have I hated instruction, and my heart despised reproof;",
      "metadata": {
        "reference": "Proverbs 5:12",
        "verseKey": "kjv:proverbs:5:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:proverbs:5:13",
      "numberLabel": "13",
      "text": "And have not obeyed the voice of my teachers, nor inclined mine ear to them that instructed me!",
      "metadata": {
        "reference": "Proverbs 5:13",
        "verseKey": "kjv:proverbs:5:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:proverbs:5:14",
      "numberLabel": "14",
      "text": "I was almost in all evil in the midst of the congregation and assembly.",
      "metadata": {
        "reference": "Proverbs 5:14",
        "verseKey": "kjv:proverbs:5:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:proverbs:5:15",
      "numberLabel": "15",
      "text": "Drink waters out of thine own cistern, and running waters out of thine own well.",
      "metadata": {
        "reference": "Proverbs 5:15",
        "verseKey": "kjv:proverbs:5:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:proverbs:5:16",
      "numberLabel": "16",
      "text": "Let thy fountains be dispersed abroad, and rivers of waters in the streets.",
      "metadata": {
        "reference": "Proverbs 5:16",
        "verseKey": "kjv:proverbs:5:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:proverbs:5:17",
      "numberLabel": "17",
      "text": "Let them be only thine own, and not strangers’ with thee.",
      "metadata": {
        "reference": "Proverbs 5:17",
        "verseKey": "kjv:proverbs:5:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:proverbs:5:18",
      "numberLabel": "18",
      "text": "Let thy fountain be blessed: and rejoice with the wife of thy youth.",
      "metadata": {
        "reference": "Proverbs 5:18",
        "verseKey": "kjv:proverbs:5:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:proverbs:5:19",
      "numberLabel": "19",
      "text": "Let her be as the loving hind and pleasant roe; let her breasts satisfy thee at all times; and be thou ravished always with her love.",
      "metadata": {
        "reference": "Proverbs 5:19",
        "verseKey": "kjv:proverbs:5:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:proverbs:5:20",
      "numberLabel": "20",
      "text": "And why wilt thou, my son, be ravished with a strange woman, and embrace the bosom of a stranger?",
      "metadata": {
        "reference": "Proverbs 5:20",
        "verseKey": "kjv:proverbs:5:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:proverbs:5:21",
      "numberLabel": "21",
      "text": "For the ways of man are before the eyes of the LORD, and he pondereth all his goings.",
      "metadata": {
        "reference": "Proverbs 5:21",
        "verseKey": "kjv:proverbs:5:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:proverbs:5:22",
      "numberLabel": "22",
      "text": "His own iniquities shall take the wicked himself, and he shall be holden with the cords of his sins.",
      "metadata": {
        "reference": "Proverbs 5:22",
        "verseKey": "kjv:proverbs:5:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:proverbs:5:23",
      "numberLabel": "23",
      "text": "He shall die without instruction; and in the greatness of his folly he shall go astray.",
      "metadata": {
        "reference": "Proverbs 5:23",
        "verseKey": "kjv:proverbs:5:23"
      }
    }
  ],
  "source": {
