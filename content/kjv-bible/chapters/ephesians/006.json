{
  "schemaVersion": 1,
  "id": "kjv-ephesians-006",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 6,
  "title": "Ephesians 6",
  "display_title": "Ephesians 6",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "ephesians",
  "book": "Ephesians",
  "bookName": "Ephesians",
