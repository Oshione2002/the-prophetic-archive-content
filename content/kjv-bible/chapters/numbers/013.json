{
  "schemaVersion": 1,
  "id": "kjv-numbers-013",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 13,
  "title": "Numbers 13",
  "display_title": "Numbers 13",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "numbers",
  "book": "Numbers",
  "bookName": "Numbers",
