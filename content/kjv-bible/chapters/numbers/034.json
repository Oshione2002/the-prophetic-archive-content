  "document_type": "bible_chapter",
  "number": 34,
  "title": "Numbers 34",
  "display_title": "Numbers 34",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "numbers",
  "book": "Numbers",
  "bookName": "Numbers",
