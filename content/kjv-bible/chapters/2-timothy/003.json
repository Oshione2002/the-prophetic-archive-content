  "document_type": "bible_chapter",
  "number": 3,
  "title": "2 Timothy 3",
  "display_title": "2 Timothy 3",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "2-timothy",
  "book": "2 Timothy",
  "bookName": "2 Timothy",
