  "document_type": "bible_chapter",
  "number": 27,
  "title": "Deuteronomy 27",
  "display_title": "Deuteronomy 27",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "deuteronomy",
  "book": "Deuteronomy",
  "bookName": "Deuteronomy",
