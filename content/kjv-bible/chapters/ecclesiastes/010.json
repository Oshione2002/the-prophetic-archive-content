{
  "schemaVersion": 1,
  "id": "kjv-ecclesiastes-010",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 10,
  "title": "Ecclesiastes 10",
  "display_title": "Ecclesiastes 10",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "ecclesiastes",
  "book": "Ecclesiastes",
  "bookName": "Ecclesiastes",
  "bookOrder": 21,
  "testament": "old",
  "chapter": 10,
  "sortOrder": 21010,
  "verseCount": 20,
  "aliases": [
    "Eccl",
    "Ecc",
    "Qoheleth"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:ecclesiastes:10:1",
      "numberLabel": "1",
      "text": "Dead flies cause the ointment of the apothecary to send forth a stinking savour: so doth a little folly him that is in reputation for wisdom and honour.",
      "metadata": {
        "reference": "Ecclesiastes 10:1",
        "verseKey": "kjv:ecclesiastes:10:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:ecclesiastes:10:2",
      "numberLabel": "2",
      "text": "A wise man’s heart is at his right hand; but a fool’s heart at his left.",
      "metadata": {
        "reference": "Ecclesiastes 10:2",
        "verseKey": "kjv:ecclesiastes:10:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:ecclesiastes:10:3",
      "numberLabel": "3",
      "text": "Yea also, when he that is a fool walketh by the way, his wisdom faileth him, and he saith to every one that he is a fool.",
      "metadata": {
        "reference": "Ecclesiastes 10:3",
        "verseKey": "kjv:ecclesiastes:10:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:ecclesiastes:10:4",
      "numberLabel": "4",
      "text": "If the spirit of the ruler rise up against thee, leave not thy place; for yielding pacifieth great offences.",
      "metadata": {
        "reference": "Ecclesiastes 10:4",
        "verseKey": "kjv:ecclesiastes:10:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:ecclesiastes:10:5",
      "numberLabel": "5",
      "text": "There is an evil which I have seen under the sun, as an error which proceedeth from the ruler:",
      "metadata": {
        "reference": "Ecclesiastes 10:5",
        "verseKey": "kjv:ecclesiastes:10:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:ecclesiastes:10:6",
      "numberLabel": "6",
      "text": "Folly is set in great dignity, and the rich sit in low place.",
      "metadata": {
        "reference": "Ecclesiastes 10:6",
        "verseKey": "kjv:ecclesiastes:10:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:ecclesiastes:10:7",
      "numberLabel": "7",
      "text": "I have seen servants upon horses, and princes walking as servants upon the earth.",
      "metadata": {
        "reference": "Ecclesiastes 10:7",
        "verseKey": "kjv:ecclesiastes:10:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:ecclesiastes:10:8",
      "numberLabel": "8",
      "text": "He that diggeth a pit shall fall into it; and whoso breaketh an hedge, a serpent shall bite him.",
      "metadata": {
        "reference": "Ecclesiastes 10:8",
        "verseKey": "kjv:ecclesiastes:10:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:ecclesiastes:10:9",
      "numberLabel": "9",
      "text": "Whoso removeth stones shall be hurt therewith; and he that cleaveth wood shall be endangered thereby.",
      "metadata": {
        "reference": "Ecclesiastes 10:9",
        "verseKey": "kjv:ecclesiastes:10:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:ecclesiastes:10:10",
      "numberLabel": "10",
      "text": "If the iron be blunt, and he do not whet the edge, then must he put to more strength: but wisdom is profitable to direct.",
      "metadata": {
        "reference": "Ecclesiastes 10:10",
        "verseKey": "kjv:ecclesiastes:10:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:ecclesiastes:10:11",
      "numberLabel": "11",
      "text": "Surely the serpent will bite without enchantment; and a babbler is no better.",
      "metadata": {
        "reference": "Ecclesiastes 10:11",
        "verseKey": "kjv:ecclesiastes:10:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:ecclesiastes:10:12",
      "numberLabel": "12",
      "text": "The words of a wise man’s mouth are gracious; but the lips of a fool will swallow up himself.",
      "metadata": {
        "reference": "Ecclesiastes 10:12",
        "verseKey": "kjv:ecclesiastes:10:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:ecclesiastes:10:13",
      "numberLabel": "13",
      "text": "The beginning of the words of his mouth is foolishness: and the end of his talk is mischievous madness.",
      "metadata": {
        "reference": "Ecclesiastes 10:13",
        "verseKey": "kjv:ecclesiastes:10:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:ecclesiastes:10:14",
      "numberLabel": "14",
      "text": "A fool also is full of words: a man cannot tell what shall be; and what shall be after him, who can tell him?",
      "metadata": {
        "reference": "Ecclesiastes 10:14",
        "verseKey": "kjv:ecclesiastes:10:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:ecclesiastes:10:15",
      "numberLabel": "15",
      "text": "The labour of the foolish wearieth every one of them, because he knoweth not how to go to the city.",
      "metadata": {
        "reference": "Ecclesiastes 10:15",
        "verseKey": "kjv:ecclesiastes:10:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:ecclesiastes:10:16",
      "numberLabel": "16",
      "text": "Woe to thee, O land, when thy king is a child, and thy princes eat in the morning!",
      "metadata": {
        "reference": "Ecclesiastes 10:16",
        "verseKey": "kjv:ecclesiastes:10:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:ecclesiastes:10:17",
      "numberLabel": "17",
      "text": "Blessed art thou, O land, when thy king is the son of nobles, and thy princes eat in due season, for strength, and not for drunkenness!",
      "metadata": {
        "reference": "Ecclesiastes 10:17",
        "verseKey": "kjv:ecclesiastes:10:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:ecclesiastes:10:18",
      "numberLabel": "18",
      "text": "By much slothfulness the building decayeth; and through idleness of the hands the house droppeth through.",
      "metadata": {
        "reference": "Ecclesiastes 10:18",
        "verseKey": "kjv:ecclesiastes:10:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:ecclesiastes:10:19",
      "numberLabel": "19",
      "text": "A feast is made for laughter, and wine maketh merry: but money answereth all things.",
      "metadata": {
        "reference": "Ecclesiastes 10:19",
        "verseKey": "kjv:ecclesiastes:10:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:ecclesiastes:10:20",
      "numberLabel": "20",
      "text": "Curse not the king, no not in thy thought; and curse not the rich in thy bedchamber: for a bird of the air shall carry the voice, and that which hath wings shall tell the matter.",
      "metadata": {
        "reference": "Ecclesiastes 10:20",
        "verseKey": "kjv:ecclesiastes:10:20"
      }
    }
  ],
  "source": {
