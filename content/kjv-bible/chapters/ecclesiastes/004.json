{
  "schemaVersion": 1,
  "id": "kjv-ecclesiastes-004",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 4,
  "title": "Ecclesiastes 4",
  "display_title": "Ecclesiastes 4",
  "translation": "King James Version",
  "translationCode": "KJV",
