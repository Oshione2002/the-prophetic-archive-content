{
  "schemaVersion": 1,
  "id": "kjv-mark-016",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 16,
  "title": "Mark 16",
  "display_title": "Mark 16",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "mark",
  "book": "Mark",
  "bookName": "Mark",
