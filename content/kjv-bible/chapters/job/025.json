  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:job:25:1",
      "numberLabel": "1",
      "text": "Then answered Bildad the Shuhite, and said,",
      "metadata": {
        "reference": "Job 25:1",
        "verseKey": "kjv:job:25:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:job:25:2",
      "numberLabel": "2",
      "text": "Dominion and fear are with him, he maketh peace in his high places.",
      "metadata": {
        "reference": "Job 25:2",
        "verseKey": "kjv:job:25:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:job:25:3",
      "numberLabel": "3",
      "text": "Is there any number of his armies? and upon whom doth not his light arise?",
      "metadata": {
        "reference": "Job 25:3",
        "verseKey": "kjv:job:25:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:job:25:4",
      "numberLabel": "4",
      "text": "How then can man be justified with God? or how can he be clean that is born of a woman?",
      "metadata": {
        "reference": "Job 25:4",
        "verseKey": "kjv:job:25:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:job:25:5",
      "numberLabel": "5",
      "text": "Behold even to the moon, and it shineth not; yea, the stars are not pure in his sight.",
      "metadata": {
        "reference": "Job 25:5",
        "verseKey": "kjv:job:25:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:job:25:6",
      "numberLabel": "6",
      "text": "How much less man, that is a worm? and the son of man, which is a worm?",
      "metadata": {
        "reference": "Job 25:6",
        "verseKey": "kjv:job:25:6"
      }
    }
  ],
