{
  "schemaVersion": 1,
  "id": "kjv-job-030",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 30,
  "title": "Job 30",
  "display_title": "Job 30",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "job",
  "book": "Job",
  "bookName": "Job",
  "bookOrder": 18,
  "testament": "old",
  "chapter": 30,
  "sortOrder": 18030,
  "verseCount": 31,
  "aliases": [
    "Job"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:job:30:1",
      "numberLabel": "1",
      "text": "But now they that are younger than I have me in derision, whose fathers I would have disdained to have set with the dogs of my flock.",
      "metadata": {
        "reference": "Job 30:1",
        "verseKey": "kjv:job:30:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:job:30:2",
      "numberLabel": "2",
      "text": "Yea, whereto might the strength of their hands profit me, in whom old age was perished?",
      "metadata": {
        "reference": "Job 30:2",
        "verseKey": "kjv:job:30:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:job:30:3",
      "numberLabel": "3",
      "text": "For want and famine they were solitary; fleeing into the wilderness in former time desolate and waste.",
      "metadata": {
        "reference": "Job 30:3",
        "verseKey": "kjv:job:30:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:job:30:4",
      "numberLabel": "4",
      "text": "Who cut up mallows by the bushes, and juniper roots for their meat.",
      "metadata": {
        "reference": "Job 30:4",
        "verseKey": "kjv:job:30:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:job:30:5",
      "numberLabel": "5",
      "text": "They were driven forth from among men, (they cried after them as after a thief;)",
      "metadata": {
        "reference": "Job 30:5",
        "verseKey": "kjv:job:30:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:job:30:6",
      "numberLabel": "6",
      "text": "To dwell in the cliffs of the valleys, in caves of the earth, and in the rocks.",
      "metadata": {
        "reference": "Job 30:6",
        "verseKey": "kjv:job:30:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:job:30:7",
      "numberLabel": "7",
      "text": "Among the bushes they brayed; under the nettles they were gathered together.",
      "metadata": {
        "reference": "Job 30:7",
        "verseKey": "kjv:job:30:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:job:30:8",
      "numberLabel": "8",
      "text": "They were children of fools, yea, children of base men: they were viler than the earth.",
      "metadata": {
        "reference": "Job 30:8",
        "verseKey": "kjv:job:30:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:job:30:9",
      "numberLabel": "9",
      "text": "And now am I their song, yea, I am their byword.",
      "metadata": {
        "reference": "Job 30:9",
        "verseKey": "kjv:job:30:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:job:30:10",
      "numberLabel": "10",
      "text": "They abhor me, they flee far from me, and spare not to spit in my face.",
      "metadata": {
        "reference": "Job 30:10",
        "verseKey": "kjv:job:30:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:job:30:11",
      "numberLabel": "11",
      "text": "Because he hath loosed my cord, and afflicted me, they have also let loose the bridle before me.",
      "metadata": {
        "reference": "Job 30:11",
        "verseKey": "kjv:job:30:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:job:30:12",
      "numberLabel": "12",
      "text": "Upon my right hand rise the youth; they push away my feet, and they raise up against me the ways of their destruction.",
      "metadata": {
        "reference": "Job 30:12",
        "verseKey": "kjv:job:30:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:job:30:13",
      "numberLabel": "13",
      "text": "They mar my path, they set forward my calamity, they have no helper.",
      "metadata": {
        "reference": "Job 30:13",
        "verseKey": "kjv:job:30:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:job:30:14",
      "numberLabel": "14",
      "text": "They came upon me as a wide breaking in of waters: in the desolation they rolled themselves upon me.",
      "metadata": {
        "reference": "Job 30:14",
        "verseKey": "kjv:job:30:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:job:30:15",
      "numberLabel": "15",
      "text": "Terrors are turned upon me: they pursue my soul as the wind: and my welfare passeth away as a cloud.",
      "metadata": {
        "reference": "Job 30:15",
        "verseKey": "kjv:job:30:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:job:30:16",
      "numberLabel": "16",
      "text": "And now my soul is poured out upon me; the days of affliction have taken hold upon me.",
      "metadata": {
        "reference": "Job 30:16",
        "verseKey": "kjv:job:30:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:job:30:17",
      "numberLabel": "17",
      "text": "My bones are pierced in me in the night season: and my sinews take no rest.",
      "metadata": {
        "reference": "Job 30:17",
        "verseKey": "kjv:job:30:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:job:30:18",
      "numberLabel": "18",
      "text": "By the great force of my disease is my garment changed: it bindeth me about as the collar of my coat.",
      "metadata": {
        "reference": "Job 30:18",
        "verseKey": "kjv:job:30:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:job:30:19",
      "numberLabel": "19",
      "text": "He hath cast me into the mire, and I am become like dust and ashes.",
      "metadata": {
        "reference": "Job 30:19",
        "verseKey": "kjv:job:30:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:job:30:20",
      "numberLabel": "20",
      "text": "I cry unto thee, and thou dost not hear me: I stand up, and thou regardest me not.",
      "metadata": {
        "reference": "Job 30:20",
        "verseKey": "kjv:job:30:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:job:30:21",
      "numberLabel": "21",
      "text": "Thou art become cruel to me: with thy strong hand thou opposest thyself against me.",
      "metadata": {
        "reference": "Job 30:21",
        "verseKey": "kjv:job:30:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:job:30:22",
      "numberLabel": "22",
      "text": "Thou liftest me up to the wind; thou causest me to ride upon it, and dissolvest my substance.",
      "metadata": {
        "reference": "Job 30:22",
        "verseKey": "kjv:job:30:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:job:30:23",
      "numberLabel": "23",
      "text": "For I know that thou wilt bring me to death, and to the house appointed for all living.",
      "metadata": {
        "reference": "Job 30:23",
        "verseKey": "kjv:job:30:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:job:30:24",
      "numberLabel": "24",
      "text": "Howbeit he will not stretch out his hand to the grave, though they cry in his destruction.",
      "metadata": {
        "reference": "Job 30:24",
        "verseKey": "kjv:job:30:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:job:30:25",
      "numberLabel": "25",
      "text": "Did not I weep for him that was in trouble? was not my soul grieved for the poor?",
      "metadata": {
        "reference": "Job 30:25",
        "verseKey": "kjv:job:30:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:job:30:26",
      "numberLabel": "26",
      "text": "When I looked for good, then evil came unto me: and when I waited for light, there came darkness.",
      "metadata": {
        "reference": "Job 30:26",
        "verseKey": "kjv:job:30:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:job:30:27",
      "numberLabel": "27",
      "text": "My bowels boiled, and rested not: the days of affliction prevented me.",
      "metadata": {
        "reference": "Job 30:27",
        "verseKey": "kjv:job:30:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:job:30:28",
      "numberLabel": "28",
      "text": "I went mourning without the sun: I stood up, and I cried in the congregation.",
      "metadata": {
        "reference": "Job 30:28",
        "verseKey": "kjv:job:30:28"
      }
    },
    {
      "id": "verse-029",
      "type": "bible_verse",
      "verse": 29,
      "verseId": "kjv:job:30:29",
      "numberLabel": "29",
      "text": "I am a brother to dragons, and a companion to owls.",
      "metadata": {
        "reference": "Job 30:29",
        "verseKey": "kjv:job:30:29"
      }
    },
    {
      "id": "verse-030",
      "type": "bible_verse",
      "verse": 30,
      "verseId": "kjv:job:30:30",
      "numberLabel": "30",
      "text": "My skin is black upon me, and my bones are burned with heat.",
      "metadata": {
        "reference": "Job 30:30",
        "verseKey": "kjv:job:30:30"
      }
    },
    {
      "id": "verse-031",
      "type": "bible_verse",
      "verse": 31,
      "verseId": "kjv:job:30:31",
      "numberLabel": "31",
      "text": "My harp also is turned to mourning, and my organ into the voice of them that weep.",
      "metadata": {
        "reference": "Job 30:31",
        "verseKey": "kjv:job:30:31"
      }
    }
  ],
  "source": {
