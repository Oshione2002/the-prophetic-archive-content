  "number": 26,
  "title": "1 Chronicles 26",
  "display_title": "1 Chronicles 26",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "1-chronicles",
  "book": "1 Chronicles",
  "bookName": "1 Chronicles",
