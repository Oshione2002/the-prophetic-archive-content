{
  "schemaVersion": 1,
  "id": "kjv-1-chronicles-001",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 1,
  "title": "1 Chronicles 1",
  "display_title": "1 Chronicles 1",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "1-chronicles",
  "book": "1 Chronicles",
  "bookName": "1 Chronicles",
  "bookOrder": 13,
  "testament": "old",
  "chapter": 1,
  "sortOrder": 13001,
  "verseCount": 54,
  "aliases": [
    "1 Chr",
    "1Chr",
    "1 Ch",
    "1Ch"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:1-chronicles:1:1",
      "numberLabel": "1",
      "text": "Adam, Sheth, Enosh,",
      "metadata": {
        "reference": "1 Chronicles 1:1",
        "verseKey": "kjv:1-chronicles:1:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:1-chronicles:1:2",
      "numberLabel": "2",
      "text": "Kenan, Mahalaleel, Jered,",
      "metadata": {
        "reference": "1 Chronicles 1:2",
        "verseKey": "kjv:1-chronicles:1:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:1-chronicles:1:3",
      "numberLabel": "3",
      "text": "Henoch, Methuselah, Lamech,",
      "metadata": {
        "reference": "1 Chronicles 1:3",
        "verseKey": "kjv:1-chronicles:1:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:1-chronicles:1:4",
      "numberLabel": "4",
      "text": "Noah, Shem, Ham, and Japheth.",
      "metadata": {
        "reference": "1 Chronicles 1:4",
        "verseKey": "kjv:1-chronicles:1:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:1-chronicles:1:5",
      "numberLabel": "5",
      "text": "The sons of Japheth; Gomer, and Magog, and Madai, and Javan, and Tubal, and Meshech, and Tiras.",
      "metadata": {
        "reference": "1 Chronicles 1:5",
        "verseKey": "kjv:1-chronicles:1:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:1-chronicles:1:6",
      "numberLabel": "6",
      "text": "And the sons of Gomer; Ashchenaz, and Riphath, and Togarmah.",
      "metadata": {
        "reference": "1 Chronicles 1:6",
        "verseKey": "kjv:1-chronicles:1:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:1-chronicles:1:7",
      "numberLabel": "7",
      "text": "And the sons of Javan; Elishah, and Tarshish, Kittim, and Dodanim.",
      "metadata": {
        "reference": "1 Chronicles 1:7",
        "verseKey": "kjv:1-chronicles:1:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:1-chronicles:1:8",
      "numberLabel": "8",
      "text": "The sons of Ham; Cush, and Mizraim, Put, and Canaan.",
      "metadata": {
        "reference": "1 Chronicles 1:8",
        "verseKey": "kjv:1-chronicles:1:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:1-chronicles:1:9",
      "numberLabel": "9",
      "text": "And the sons of Cush; Seba, and Havilah, and Sabta, and Raamah, and Sabtecha. And the sons of Raamah; Sheba, and Dedan.",
      "metadata": {
        "reference": "1 Chronicles 1:9",
        "verseKey": "kjv:1-chronicles:1:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:1-chronicles:1:10",
      "numberLabel": "10",
      "text": "And Cush begat Nimrod: he began to be mighty upon the earth.",
      "metadata": {
        "reference": "1 Chronicles 1:10",
        "verseKey": "kjv:1-chronicles:1:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:1-chronicles:1:11",
      "numberLabel": "11",
      "text": "And Mizraim begat Ludim, and Anamim, and Lehabim, and Naphtuhim,",
      "metadata": {
        "reference": "1 Chronicles 1:11",
        "verseKey": "kjv:1-chronicles:1:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:1-chronicles:1:12",
      "numberLabel": "12",
      "text": "And Pathrusim, and Casluhim, (of whom came the Philistines,) and Caphthorim.",
      "metadata": {
        "reference": "1 Chronicles 1:12",
        "verseKey": "kjv:1-chronicles:1:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:1-chronicles:1:13",
      "numberLabel": "13",
      "text": "And Canaan begat Zidon his firstborn, and Heth,",
      "metadata": {
        "reference": "1 Chronicles 1:13",
        "verseKey": "kjv:1-chronicles:1:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:1-chronicles:1:14",
      "numberLabel": "14",
      "text": "The Jebusite also, and the Amorite, and the Girgashite,",
      "metadata": {
        "reference": "1 Chronicles 1:14",
        "verseKey": "kjv:1-chronicles:1:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:1-chronicles:1:15",
      "numberLabel": "15",
      "text": "And the Hivite, and the Arkite, and the Sinite,",
      "metadata": {
        "reference": "1 Chronicles 1:15",
        "verseKey": "kjv:1-chronicles:1:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:1-chronicles:1:16",
      "numberLabel": "16",
      "text": "And the Arvadite, and the Zemarite, and the Hamathite.",
      "metadata": {
        "reference": "1 Chronicles 1:16",
        "verseKey": "kjv:1-chronicles:1:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:1-chronicles:1:17",
      "numberLabel": "17",
      "text": "The sons of Shem; Elam, and Asshur, and Arphaxad, and Lud, and Aram, and Uz, and Hul, and Gether, and Meshech.",
      "metadata": {
        "reference": "1 Chronicles 1:17",
        "verseKey": "kjv:1-chronicles:1:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:1-chronicles:1:18",
      "numberLabel": "18",
      "text": "And Arphaxad begat Shelah, and Shelah begat Eber.",
      "metadata": {
        "reference": "1 Chronicles 1:18",
        "verseKey": "kjv:1-chronicles:1:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:1-chronicles:1:19",
      "numberLabel": "19",
      "text": "And unto Eber were born two sons: the name of the one was Peleg; because in his days the earth was divided: and his brother’s name was Joktan.",
      "metadata": {
        "reference": "1 Chronicles 1:19",
        "verseKey": "kjv:1-chronicles:1:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:1-chronicles:1:20",
      "numberLabel": "20",
      "text": "And Joktan begat Almodad, and Sheleph, and Hazarmaveth, and Jerah,",
      "metadata": {
        "reference": "1 Chronicles 1:20",
        "verseKey": "kjv:1-chronicles:1:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:1-chronicles:1:21",
      "numberLabel": "21",
      "text": "Hadoram also, and Uzal, and Diklah,",
      "metadata": {
        "reference": "1 Chronicles 1:21",
        "verseKey": "kjv:1-chronicles:1:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:1-chronicles:1:22",
      "numberLabel": "22",
      "text": "And Ebal, and Abimael, and Sheba,",
      "metadata": {
        "reference": "1 Chronicles 1:22",
        "verseKey": "kjv:1-chronicles:1:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:1-chronicles:1:23",
      "numberLabel": "23",
      "text": "And Ophir, and Havilah, and Jobab. All these were the sons of Joktan.",
      "metadata": {
        "reference": "1 Chronicles 1:23",
        "verseKey": "kjv:1-chronicles:1:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:1-chronicles:1:24",
      "numberLabel": "24",
      "text": "Shem, Arphaxad, Shelah,",
      "metadata": {
        "reference": "1 Chronicles 1:24",
        "verseKey": "kjv:1-chronicles:1:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:1-chronicles:1:25",
      "numberLabel": "25",
      "text": "Eber, Peleg, Reu,",
      "metadata": {
        "reference": "1 Chronicles 1:25",
        "verseKey": "kjv:1-chronicles:1:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:1-chronicles:1:26",
      "numberLabel": "26",
      "text": "Serug, Nahor, Terah,",
      "metadata": {
        "reference": "1 Chronicles 1:26",
        "verseKey": "kjv:1-chronicles:1:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:1-chronicles:1:27",
      "numberLabel": "27",
      "text": "Abram; the same is Abraham.",
      "metadata": {
        "reference": "1 Chronicles 1:27",
        "verseKey": "kjv:1-chronicles:1:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:1-chronicles:1:28",
      "numberLabel": "28",
      "text": "The sons of Abraham; Isaac, and Ishmael.",
      "metadata": {
        "reference": "1 Chronicles 1:28",
        "verseKey": "kjv:1-chronicles:1:28"
      }
    },
    {
      "id": "verse-029",
      "type": "bible_verse",
      "verse": 29,
      "verseId": "kjv:1-chronicles:1:29",
      "numberLabel": "29",
      "text": "These are their generations: The firstborn of Ishmael, Nebaioth; then Kedar, and Adbeel, and Mibsam,",
      "metadata": {
        "reference": "1 Chronicles 1:29",
        "verseKey": "kjv:1-chronicles:1:29"
      }
    },
    {
      "id": "verse-030",
      "type": "bible_verse",
      "verse": 30,
      "verseId": "kjv:1-chronicles:1:30",
      "numberLabel": "30",
      "text": "Mishma, and Dumah, Massa, Hadad, and Tema,",
      "metadata": {
        "reference": "1 Chronicles 1:30",
        "verseKey": "kjv:1-chronicles:1:30"
      }
    },
    {
      "id": "verse-031",
      "type": "bible_verse",
      "verse": 31,
      "verseId": "kjv:1-chronicles:1:31",
      "numberLabel": "31",
      "text": "Jetur, Naphish, and Kedemah. These are the sons of Ishmael.",
      "metadata": {
        "reference": "1 Chronicles 1:31",
        "verseKey": "kjv:1-chronicles:1:31"
      }
    },
    {
      "id": "verse-032",
      "type": "bible_verse",
      "verse": 32,
      "verseId": "kjv:1-chronicles:1:32",
      "numberLabel": "32",
      "text": "Now the sons of Keturah, Abraham’s concubine: she bare Zimran, and Jokshan, and Medan, and Midian, and Ishbak, and Shuah. And the sons of Jokshan; Sheba, and Dedan.",
      "metadata": {
        "reference": "1 Chronicles 1:32",
        "verseKey": "kjv:1-chronicles:1:32"
      }
    },
    {
      "id": "verse-033",
      "type": "bible_verse",
      "verse": 33,
      "verseId": "kjv:1-chronicles:1:33",
      "numberLabel": "33",
      "text": "And the sons of Midian; Ephah, and Epher, and Henoch, and Abida, and Eldaah. All these are the sons of Keturah.",
      "metadata": {
        "reference": "1 Chronicles 1:33",
        "verseKey": "kjv:1-chronicles:1:33"
      }
    },
    {
      "id": "verse-034",
      "type": "bible_verse",
      "verse": 34,
      "verseId": "kjv:1-chronicles:1:34",
      "numberLabel": "34",
      "text": "And Abraham begat Isaac. The sons of Isaac; Esau and Israel.",
      "metadata": {
        "reference": "1 Chronicles 1:34",
        "verseKey": "kjv:1-chronicles:1:34"
      }
    },
    {
      "id": "verse-035",
      "type": "bible_verse",
      "verse": 35,
      "verseId": "kjv:1-chronicles:1:35",
      "numberLabel": "35",
      "text": "The sons of Esau; Eliphaz, Reuel, and Jeush, and Jaalam, and Korah.",
      "metadata": {
        "reference": "1 Chronicles 1:35",
        "verseKey": "kjv:1-chronicles:1:35"
      }
    },
    {
      "id": "verse-036",
      "type": "bible_verse",
      "verse": 36,
      "verseId": "kjv:1-chronicles:1:36",
      "numberLabel": "36",
      "text": "The sons of Eliphaz; Teman, and Omar, Zephi, and Gatam, Kenaz, and Timna, and Amalek.",
      "metadata": {
        "reference": "1 Chronicles 1:36",
        "verseKey": "kjv:1-chronicles:1:36"
      }
    },
    {
      "id": "verse-037",
      "type": "bible_verse",
      "verse": 37,
      "verseId": "kjv:1-chronicles:1:37",
      "numberLabel": "37",
      "text": "The sons of Reuel; Nahath, Zerah, Shammah, and Mizzah.",
      "metadata": {
        "reference": "1 Chronicles 1:37",
        "verseKey": "kjv:1-chronicles:1:37"
      }
    },
    {
      "id": "verse-038",
      "type": "bible_verse",
      "verse": 38,
      "verseId": "kjv:1-chronicles:1:38",
      "numberLabel": "38",
      "text": "And the sons of Seir; Lotan, and Shobal, and Zibeon, and Anah, and Dishon, and Ezar, and Dishan.",
      "metadata": {
        "reference": "1 Chronicles 1:38",
        "verseKey": "kjv:1-chronicles:1:38"
      }
    },
    {
      "id": "verse-039",
      "type": "bible_verse",
      "verse": 39,
      "verseId": "kjv:1-chronicles:1:39",
      "numberLabel": "39",
      "text": "And the sons of Lotan; Hori, and Homam: and Timna was Lotan’s sister.",
      "metadata": {
        "reference": "1 Chronicles 1:39",
        "verseKey": "kjv:1-chronicles:1:39"
      }
    },
    {
      "id": "verse-040",
      "type": "bible_verse",
      "verse": 40,
      "verseId": "kjv:1-chronicles:1:40",
      "numberLabel": "40",
      "text": "The sons of Shobal; Alian, and Manahath, and Ebal, Shephi, and Onam. And the sons of Zibeon; Aiah, and Anah.",
      "metadata": {
        "reference": "1 Chronicles 1:40",
        "verseKey": "kjv:1-chronicles:1:40"
      }
    },
    {
      "id": "verse-041",
      "type": "bible_verse",
      "verse": 41,
      "verseId": "kjv:1-chronicles:1:41",
      "numberLabel": "41",
      "text": "The sons of Anah; Dishon. And the sons of Dishon; Amram, and Eshban, and Ithran, and Cheran.",
      "metadata": {
        "reference": "1 Chronicles 1:41",
        "verseKey": "kjv:1-chronicles:1:41"
      }
    },
    {
      "id": "verse-042",
      "type": "bible_verse",
      "verse": 42,
      "verseId": "kjv:1-chronicles:1:42",
      "numberLabel": "42",
      "text": "The sons of Ezer; Bilhan, and Zavan, and Jakan. The sons of Dishan; Uz, and Aran.",
      "metadata": {
        "reference": "1 Chronicles 1:42",
        "verseKey": "kjv:1-chronicles:1:42"
      }
    },
    {
      "id": "verse-043",
      "type": "bible_verse",
      "verse": 43,
      "verseId": "kjv:1-chronicles:1:43",
      "numberLabel": "43",
      "text": "Now these are the kings that reigned in the land of Edom before any king reigned over the children of Israel; Bela the son of Beor: and the name of his city was Dinhabah.",
      "metadata": {
        "reference": "1 Chronicles 1:43",
        "verseKey": "kjv:1-chronicles:1:43"
      }
    },
    {
      "id": "verse-044",
      "type": "bible_verse",
      "verse": 44,
      "verseId": "kjv:1-chronicles:1:44",
      "numberLabel": "44",
      "text": "And when Bela was dead, Jobab the son of Zerah of Bozrah reigned in his stead.",
      "metadata": {
        "reference": "1 Chronicles 1:44",
        "verseKey": "kjv:1-chronicles:1:44"
      }
    },
    {
      "id": "verse-045",
      "type": "bible_verse",
      "verse": 45,
      "verseId": "kjv:1-chronicles:1:45",
      "numberLabel": "45",
      "text": "And when Jobab was dead, Husham of the land of the Temanites reigned in his stead.",
      "metadata": {
        "reference": "1 Chronicles 1:45",
        "verseKey": "kjv:1-chronicles:1:45"
      }
    },
    {
      "id": "verse-046",
      "type": "bible_verse",
      "verse": 46,
      "verseId": "kjv:1-chronicles:1:46",
      "numberLabel": "46",
      "text": "And when Husham was dead, Hadad the son of Bedad, which smote Midian in the field of Moab, reigned in his stead: and the name of his city was Avith.",
      "metadata": {
        "reference": "1 Chronicles 1:46",
        "verseKey": "kjv:1-chronicles:1:46"
      }
    },
    {
      "id": "verse-047",
      "type": "bible_verse",
      "verse": 47,
      "verseId": "kjv:1-chronicles:1:47",
      "numberLabel": "47",
      "text": "And when Hadad was dead, Samlah of Masrekah reigned in his stead.",
      "metadata": {
        "reference": "1 Chronicles 1:47",
        "verseKey": "kjv:1-chronicles:1:47"
      }
    },
    {
      "id": "verse-048",
      "type": "bible_verse",
      "verse": 48,
      "verseId": "kjv:1-chronicles:1:48",
      "numberLabel": "48",
      "text": "And when Samlah was dead, Shaul of Rehoboth by the river reigned in his stead.",
      "metadata": {
        "reference": "1 Chronicles 1:48",
        "verseKey": "kjv:1-chronicles:1:48"
      }
    },
    {
      "id": "verse-049",
      "type": "bible_verse",
      "verse": 49,
      "verseId": "kjv:1-chronicles:1:49",
      "numberLabel": "49",
      "text": "And when Shaul was dead, Baalhanan the son of Achbor reigned in his stead.",
      "metadata": {
        "reference": "1 Chronicles 1:49",
        "verseKey": "kjv:1-chronicles:1:49"
      }
    },
    {
      "id": "verse-050",
      "type": "bible_verse",
      "verse": 50,
      "verseId": "kjv:1-chronicles:1:50",
      "numberLabel": "50",
      "text": "And when Baalhanan was dead, Hadad reigned in his stead: and the name of his city was Pai; and his wife’s name was Mehetabel, the daughter of Matred, the daughter of Mezahab.",
      "metadata": {
        "reference": "1 Chronicles 1:50",
        "verseKey": "kjv:1-chronicles:1:50"
      }
    },
    {
      "id": "verse-051",
      "type": "bible_verse",
      "verse": 51,
      "verseId": "kjv:1-chronicles:1:51",
      "numberLabel": "51",
      "text": "Hadad died also. And the dukes of Edom were; duke Timnah, duke Aliah, duke Jetheth,",
      "metadata": {
        "reference": "1 Chronicles 1:51",
        "verseKey": "kjv:1-chronicles:1:51"
      }
    },
    {
      "id": "verse-052",
      "type": "bible_verse",
      "verse": 52,
      "verseId": "kjv:1-chronicles:1:52",
      "numberLabel": "52",
      "text": "Duke Aholibamah, duke Elah, duke Pinon,",
      "metadata": {
        "reference": "1 Chronicles 1:52",
        "verseKey": "kjv:1-chronicles:1:52"
      }
    },
    {
      "id": "verse-053",
      "type": "bible_verse",
      "verse": 53,
      "verseId": "kjv:1-chronicles:1:53",
      "numberLabel": "53",
      "text": "Duke Kenaz, duke Teman, duke Mibzar,",
      "metadata": {
        "reference": "1 Chronicles 1:53",
        "verseKey": "kjv:1-chronicles:1:53"
      }
    },
    {
      "id": "verse-054",
      "type": "bible_verse",
      "verse": 54,
      "verseId": "kjv:1-chronicles:1:54",
      "numberLabel": "54",
      "text": "Duke Magdiel, duke Iram. These are the dukes of Edom.",
      "metadata": {
