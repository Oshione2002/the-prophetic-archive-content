{
  "schemaVersion": 1,
  "id": "kjv-james-003",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 3,
  "title": "James 3",
  "display_title": "James 3",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "james",
  "book": "James",
  "bookName": "James",
