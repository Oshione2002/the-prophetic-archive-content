{
  "schemaVersion": 1,
  "id": "kjv-exodus-040",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 40,
  "title": "Exodus 40",
  "display_title": "Exodus 40",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "exodus",
  "book": "Exodus",
  "bookName": "Exodus",
  "bookOrder": 2,
  "testament": "old",
  "chapter": 40,
  "sortOrder": 2040,
  "verseCount": 38,
  "aliases": [
    "Exod",
    "Exo",
    "Ex"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:exodus:40:1",
      "numberLabel": "1",
      "text": "And the LORD spake unto Moses, saying,",
      "metadata": {
        "reference": "Exodus 40:1",
        "verseKey": "kjv:exodus:40:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:exodus:40:2",
      "numberLabel": "2",
      "text": "On the first day of the first month shalt thou set up the tabernacle of the tent of the congregation.",
      "metadata": {
        "reference": "Exodus 40:2",
        "verseKey": "kjv:exodus:40:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:exodus:40:3",
      "numberLabel": "3",
      "text": "And thou shalt put therein the ark of the testimony, and cover the ark with the vail.",
      "metadata": {
        "reference": "Exodus 40:3",
        "verseKey": "kjv:exodus:40:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:exodus:40:4",
      "numberLabel": "4",
      "text": "And thou shalt bring in the table, and set in order the things that are to be set in order upon it; and thou shalt bring in the candlestick, and light the lamps thereof.",
      "metadata": {
        "reference": "Exodus 40:4",
        "verseKey": "kjv:exodus:40:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:exodus:40:5",
      "numberLabel": "5",
      "text": "And thou shalt set the altar of gold for the incense before the ark of the testimony, and put the hanging of the door to the tabernacle.",
      "metadata": {
        "reference": "Exodus 40:5",
        "verseKey": "kjv:exodus:40:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:exodus:40:6",
      "numberLabel": "6",
      "text": "And thou shalt set the altar of the burnt offering before the door of the tabernacle of the tent of the congregation.",
      "metadata": {
        "reference": "Exodus 40:6",
        "verseKey": "kjv:exodus:40:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:exodus:40:7",
      "numberLabel": "7",
      "text": "And thou shalt set the laver between the tent of the congregation and the altar, and shalt put water therein.",
      "metadata": {
        "reference": "Exodus 40:7",
        "verseKey": "kjv:exodus:40:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:exodus:40:8",
      "numberLabel": "8",
      "text": "And thou shalt set up the court round about, and hang up the hanging at the court gate.",
      "metadata": {
        "reference": "Exodus 40:8",
        "verseKey": "kjv:exodus:40:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:exodus:40:9",
      "numberLabel": "9",
      "text": "And thou shalt take the anointing oil, and anoint the tabernacle, and all that is therein, and shalt hallow it, and all the vessels thereof: and it shall be holy.",
      "metadata": {
        "reference": "Exodus 40:9",
        "verseKey": "kjv:exodus:40:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:exodus:40:10",
      "numberLabel": "10",
      "text": "And thou shalt anoint the altar of the burnt offering, and all his vessels, and sanctify the altar: and it shall be an altar most holy.",
      "metadata": {
        "reference": "Exodus 40:10",
        "verseKey": "kjv:exodus:40:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:exodus:40:11",
      "numberLabel": "11",
      "text": "And thou shalt anoint the laver and his foot, and sanctify it.",
      "metadata": {
        "reference": "Exodus 40:11",
        "verseKey": "kjv:exodus:40:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:exodus:40:12",
      "numberLabel": "12",
      "text": "And thou shalt bring Aaron and his sons unto the door of the tabernacle of the congregation, and wash them with water.",
      "metadata": {
        "reference": "Exodus 40:12",
        "verseKey": "kjv:exodus:40:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:exodus:40:13",
      "numberLabel": "13",
      "text": "And thou shalt put upon Aaron the holy garments, and anoint him, and sanctify him; that he may minister unto me in the priest’s office.",
      "metadata": {
        "reference": "Exodus 40:13",
        "verseKey": "kjv:exodus:40:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:exodus:40:14",
      "numberLabel": "14",
      "text": "And thou shalt bring his sons, and clothe them with coats:",
      "metadata": {
        "reference": "Exodus 40:14",
        "verseKey": "kjv:exodus:40:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:exodus:40:15",
      "numberLabel": "15",
      "text": "And thou shalt anoint them, as thou didst anoint their father, that they may minister unto me in the priest’s office: for their anointing shall surely be an everlasting priesthood throughout their generations.",
      "metadata": {
        "reference": "Exodus 40:15",
        "verseKey": "kjv:exodus:40:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:exodus:40:16",
      "numberLabel": "16",
      "text": "Thus did Moses: according to all that the LORD commanded him, so did he.",
      "metadata": {
        "reference": "Exodus 40:16",
        "verseKey": "kjv:exodus:40:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:exodus:40:17",
      "numberLabel": "17",
      "text": "And it came to pass in the first month in the second year, on the first day of the month, that the tabernacle was reared up.",
      "metadata": {
        "reference": "Exodus 40:17",
        "verseKey": "kjv:exodus:40:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:exodus:40:18",
      "numberLabel": "18",
      "text": "And Moses reared up the tabernacle, and fastened his sockets, and set up the boards thereof, and put in the bars thereof, and reared up his pillars.",
      "metadata": {
        "reference": "Exodus 40:18",
        "verseKey": "kjv:exodus:40:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:exodus:40:19",
      "numberLabel": "19",
      "text": "And he spread abroad the tent over the tabernacle, and put the covering of the tent above upon it; as the LORD commanded Moses.",
      "metadata": {
        "reference": "Exodus 40:19",
        "verseKey": "kjv:exodus:40:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:exodus:40:20",
      "numberLabel": "20",
      "text": "And he took and put the testimony into the ark, and set the staves on the ark, and put the mercy seat above upon the ark:",
      "metadata": {
        "reference": "Exodus 40:20",
        "verseKey": "kjv:exodus:40:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:exodus:40:21",
      "numberLabel": "21",
      "text": "And he brought the ark into the tabernacle, and set up the vail of the covering, and covered the ark of the testimony; as the LORD commanded Moses.",
      "metadata": {
        "reference": "Exodus 40:21",
        "verseKey": "kjv:exodus:40:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:exodus:40:22",
      "numberLabel": "22",
      "text": "And he put the table in the tent of the congregation, upon the side of the tabernacle northward, without the vail.",
      "metadata": {
        "reference": "Exodus 40:22",
        "verseKey": "kjv:exodus:40:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:exodus:40:23",
      "numberLabel": "23",
      "text": "And he set the bread in order upon it before the LORD; as the LORD had commanded Moses.",
      "metadata": {
        "reference": "Exodus 40:23",
        "verseKey": "kjv:exodus:40:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:exodus:40:24",
      "numberLabel": "24",
      "text": "And he put the candlestick in the tent of the congregation, over against the table, on the side of the tabernacle southward.",
      "metadata": {
        "reference": "Exodus 40:24",
        "verseKey": "kjv:exodus:40:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:exodus:40:25",
      "numberLabel": "25",
      "text": "And he lighted the lamps before the LORD; as the LORD commanded Moses.",
      "metadata": {
        "reference": "Exodus 40:25",
        "verseKey": "kjv:exodus:40:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:exodus:40:26",
      "numberLabel": "26",
      "text": "And he put the golden altar in the tent of the congregation before the vail:",
      "metadata": {
        "reference": "Exodus 40:26",
        "verseKey": "kjv:exodus:40:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:exodus:40:27",
      "numberLabel": "27",
      "text": "And he burnt sweet incense thereon; as the LORD commanded Moses.",
      "metadata": {
        "reference": "Exodus 40:27",
        "verseKey": "kjv:exodus:40:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:exodus:40:28",
      "numberLabel": "28",
      "text": "And he set up the hanging at the door of the tabernacle.",
      "metadata": {
        "reference": "Exodus 40:28",
        "verseKey": "kjv:exodus:40:28"
      }
    },
    {
      "id": "verse-029",
      "type": "bible_verse",
      "verse": 29,
      "verseId": "kjv:exodus:40:29",
      "numberLabel": "29",
      "text": "And he put the altar of burnt offering by the door of the tabernacle of the tent of the congregation, and offered upon it the burnt offering and the meat offering; as the LORD commanded Moses.",
      "metadata": {
        "reference": "Exodus 40:29",
        "verseKey": "kjv:exodus:40:29"
      }
    },
    {
      "id": "verse-030",
      "type": "bible_verse",
      "verse": 30,
      "verseId": "kjv:exodus:40:30",
      "numberLabel": "30",
      "text": "And he set the laver between the tent of the congregation and the altar, and put water there, to wash withal.",
      "metadata": {
        "reference": "Exodus 40:30",
        "verseKey": "kjv:exodus:40:30"
      }
    },
    {
      "id": "verse-031",
      "type": "bible_verse",
      "verse": 31,
      "verseId": "kjv:exodus:40:31",
      "numberLabel": "31",
      "text": "And Moses and Aaron and his sons washed their hands and their feet thereat:",
      "metadata": {
        "reference": "Exodus 40:31",
        "verseKey": "kjv:exodus:40:31"
      }
    },
    {
      "id": "verse-032",
      "type": "bible_verse",
      "verse": 32,
      "verseId": "kjv:exodus:40:32",
      "numberLabel": "32",
      "text": "When they went into the tent of the congregation, and when they came near unto the altar, they washed; as the LORD commanded Moses.",
      "metadata": {
        "reference": "Exodus 40:32",
        "verseKey": "kjv:exodus:40:32"
      }
    },
    {
      "id": "verse-033",
      "type": "bible_verse",
      "verse": 33,
      "verseId": "kjv:exodus:40:33",
      "numberLabel": "33",
      "text": "And he reared up the court round about the tabernacle and the altar, and set up the hanging of the court gate. So Moses finished the work.",
      "metadata": {
        "reference": "Exodus 40:33",
        "verseKey": "kjv:exodus:40:33"
      }
    },
    {
      "id": "verse-034",
      "type": "bible_verse",
      "verse": 34,
      "verseId": "kjv:exodus:40:34",
      "numberLabel": "34",
      "text": "Then a cloud covered the tent of the congregation, and the glory of the LORD filled the tabernacle.",
      "metadata": {
        "reference": "Exodus 40:34",
        "verseKey": "kjv:exodus:40:34"
      }
    },
    {
      "id": "verse-035",
      "type": "bible_verse",
      "verse": 35,
      "verseId": "kjv:exodus:40:35",
      "numberLabel": "35",
      "text": "And Moses was not able to enter into the tent of the congregation, because the cloud abode thereon, and the glory of the LORD filled the tabernacle.",
      "metadata": {
        "reference": "Exodus 40:35",
        "verseKey": "kjv:exodus:40:35"
      }
    },
    {
      "id": "verse-036",
      "type": "bible_verse",
      "verse": 36,
      "verseId": "kjv:exodus:40:36",
      "numberLabel": "36",
      "text": "And when the cloud was taken up from over the tabernacle, the children of Israel went onward in all their journeys:",
      "metadata": {
        "reference": "Exodus 40:36",
        "verseKey": "kjv:exodus:40:36"
      }
    },
    {
      "id": "verse-037",
      "type": "bible_verse",
      "verse": 37,
      "verseId": "kjv:exodus:40:37",
      "numberLabel": "37",
      "text": "But if the cloud were not taken up, then they journeyed not till the day that it was taken up.",
      "metadata": {
        "reference": "Exodus 40:37",
        "verseKey": "kjv:exodus:40:37"
      }
    },
    {
      "id": "verse-038",
      "type": "bible_verse",
      "verse": 38,
      "verseId": "kjv:exodus:40:38",
      "numberLabel": "38",
      "text": "For the cloud of the LORD was upon the tabernacle by day, and fire was on it by night, in the sight of all the house of Israel, throughout all their journeys.",
      "metadata": {
        "reference": "Exodus 40:38",
        "verseKey": "kjv:exodus:40:38"
      }
    }
  ],
  "source": {
    "repository": "aruljohn/Bible-kjv",
