  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:exodus:20:1",
      "numberLabel": "1",
      "text": "And God spake all these words, saying,",
      "metadata": {
        "reference": "Exodus 20:1",
        "verseKey": "kjv:exodus:20:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:exodus:20:2",
      "numberLabel": "2",
      "text": "I am the LORD thy God, which have brought thee out of the land of Egypt, out of the house of bondage.",
      "metadata": {
        "reference": "Exodus 20:2",
        "verseKey": "kjv:exodus:20:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:exodus:20:3",
      "numberLabel": "3",
      "text": "Thou shalt have no other gods before me.",
      "metadata": {
        "reference": "Exodus 20:3",
        "verseKey": "kjv:exodus:20:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:exodus:20:4",
      "numberLabel": "4",
      "text": "Thou shalt not make unto thee any graven image, or any likeness of any thing that is in heaven above, or that is in the earth beneath, or that is in the water under the earth:",
      "metadata": {
        "reference": "Exodus 20:4",
        "verseKey": "kjv:exodus:20:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:exodus:20:5",
      "numberLabel": "5",
      "text": "Thou shalt not bow down thyself to them, nor serve them: for I the LORD thy God am a jealous God, visiting the iniquity of the fathers upon the children unto the third and fourth generation of them that hate me;",
      "metadata": {
        "reference": "Exodus 20:5",
        "verseKey": "kjv:exodus:20:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:exodus:20:6",
      "numberLabel": "6",
      "text": "And shewing mercy unto thousands of them that love me, and keep my commandments.",
      "metadata": {
        "reference": "Exodus 20:6",
        "verseKey": "kjv:exodus:20:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:exodus:20:7",
      "numberLabel": "7",
      "text": "Thou shalt not take the name of the LORD thy God in vain; for the LORD will not hold him guiltless that taketh his name in vain.",
      "metadata": {
        "reference": "Exodus 20:7",
        "verseKey": "kjv:exodus:20:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:exodus:20:8",
      "numberLabel": "8",
      "text": "Remember the sabbath day, to keep it holy.",
      "metadata": {
        "reference": "Exodus 20:8",
        "verseKey": "kjv:exodus:20:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:exodus:20:9",
      "numberLabel": "9",
      "text": "Six days shalt thou labour, and do all thy work:",
      "metadata": {
        "reference": "Exodus 20:9",
        "verseKey": "kjv:exodus:20:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:exodus:20:10",
      "numberLabel": "10",
      "text": "But the seventh day is the sabbath of the LORD thy God: in it thou shalt not do any work, thou, nor thy son, nor thy daughter, thy manservant, nor thy maidservant, nor thy cattle, nor thy stranger that is within thy gates:",
      "metadata": {
        "reference": "Exodus 20:10",
        "verseKey": "kjv:exodus:20:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:exodus:20:11",
      "numberLabel": "11",
      "text": "For in six days the LORD made heaven and earth, the sea, and all that in them is, and rested the seventh day: wherefore the LORD blessed the sabbath day, and hallowed it.",
      "metadata": {
        "reference": "Exodus 20:11",
        "verseKey": "kjv:exodus:20:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:exodus:20:12",
      "numberLabel": "12",
      "text": "Honour thy father and thy mother: that thy days may be long upon the land which the LORD thy God giveth thee.",
      "metadata": {
        "reference": "Exodus 20:12",
        "verseKey": "kjv:exodus:20:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:exodus:20:13",
      "numberLabel": "13",
      "text": "Thou shalt not kill.",
      "metadata": {
        "reference": "Exodus 20:13",
        "verseKey": "kjv:exodus:20:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:exodus:20:14",
      "numberLabel": "14",
      "text": "Thou shalt not commit adultery.",
      "metadata": {
        "reference": "Exodus 20:14",
        "verseKey": "kjv:exodus:20:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:exodus:20:15",
      "numberLabel": "15",
      "text": "Thou shalt not steal.",
      "metadata": {
        "reference": "Exodus 20:15",
        "verseKey": "kjv:exodus:20:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:exodus:20:16",
      "numberLabel": "16",
      "text": "Thou shalt not bear false witness against thy neighbour.",
      "metadata": {
        "reference": "Exodus 20:16",
        "verseKey": "kjv:exodus:20:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:exodus:20:17",
      "numberLabel": "17",
      "text": "Thou shalt not covet thy neighbour’s house, thou shalt not covet thy neighbour’s wife, nor his manservant, nor his maidservant, nor his ox, nor his ass, nor any thing that is thy neighbour’s.",
      "metadata": {
        "reference": "Exodus 20:17",
        "verseKey": "kjv:exodus:20:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:exodus:20:18",
      "numberLabel": "18",
      "text": "And all the people saw the thunderings, and the lightnings, and the noise of the trumpet, and the mountain smoking: and when the people saw it, they removed, and stood afar off.",
      "metadata": {
        "reference": "Exodus 20:18",
        "verseKey": "kjv:exodus:20:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:exodus:20:19",
      "numberLabel": "19",
      "text": "And they said unto Moses, Speak thou with us, and we will hear: but let not God speak with us, lest we die.",
      "metadata": {
        "reference": "Exodus 20:19",
        "verseKey": "kjv:exodus:20:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:exodus:20:20",
      "numberLabel": "20",
      "text": "And Moses said unto the people, Fear not: for God is come to prove you, and that his fear may be before your faces, that ye sin not.",
      "metadata": {
        "reference": "Exodus 20:20",
        "verseKey": "kjv:exodus:20:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:exodus:20:21",
      "numberLabel": "21",
      "text": "And the people stood afar off, and Moses drew near unto the thick darkness where God was.",
      "metadata": {
        "reference": "Exodus 20:21",
        "verseKey": "kjv:exodus:20:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:exodus:20:22",
      "numberLabel": "22",
      "text": "And the LORD said unto Moses, Thus thou shalt say unto the children of Israel, Ye have seen that I have talked with you from heaven.",
      "metadata": {
        "reference": "Exodus 20:22",
        "verseKey": "kjv:exodus:20:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:exodus:20:23",
      "numberLabel": "23",
      "text": "Ye shall not make with me gods of silver, neither shall ye make unto you gods of gold.",
      "metadata": {
        "reference": "Exodus 20:23",
        "verseKey": "kjv:exodus:20:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:exodus:20:24",
      "numberLabel": "24",
      "text": "An altar of earth thou shalt make unto me, and shalt sacrifice thereon thy burnt offerings, and thy peace offerings, thy sheep, and thine oxen: in all places where I record my name I will come unto thee, and I will bless thee.",
      "metadata": {
        "reference": "Exodus 20:24",
        "verseKey": "kjv:exodus:20:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:exodus:20:25",
      "numberLabel": "25",
      "text": "And if thou wilt make me an altar of stone, thou shalt not build it of hewn stone: for if thou lift up thy tool upon it, thou hast polluted it.",
      "metadata": {
        "reference": "Exodus 20:25",
        "verseKey": "kjv:exodus:20:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:exodus:20:26",
      "numberLabel": "26",
      "text": "Neither shalt thou go up by steps unto mine altar, that thy nakedness be not discovered thereon.",
      "metadata": {
        "reference": "Exodus 20:26",
        "verseKey": "kjv:exodus:20:26"
      }
    }
  ],
  "source": {
