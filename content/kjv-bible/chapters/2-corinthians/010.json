{
  "schemaVersion": 1,
  "id": "kjv-2-corinthians-010",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 10,
  "title": "2 Corinthians 10",
  "display_title": "2 Corinthians 10",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "2-corinthians",
  "book": "2 Corinthians",
  "bookName": "2 Corinthians",
