{
  "schemaVersion": 1,
  "id": "kjv-1-corinthians-012",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 12,
  "title": "1 Corinthians 12",
  "display_title": "1 Corinthians 12",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "1-corinthians",
  "book": "1 Corinthians",
  "bookName": "1 Corinthians",
