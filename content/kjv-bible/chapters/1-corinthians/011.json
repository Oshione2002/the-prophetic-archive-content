{
  "schemaVersion": 1,
  "id": "kjv-1-corinthians-011",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 11,
  "title": "1 Corinthians 11",
  "display_title": "1 Corinthians 11",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "1-corinthians",
  "book": "1 Corinthians",
  "bookName": "1 Corinthians",
  "bookOrder": 46,
  "testament": "new",
  "chapter": 11,
  "sortOrder": 46011,
  "verseCount": 34,
  "aliases": [
    "1 Cor",
    "1Cor",
    "1 Co",
    "1Co"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:1-corinthians:11:1",
      "numberLabel": "1",
      "text": "Be ye followers of me, even as I also am of Christ.",
      "metadata": {
        "reference": "1 Corinthians 11:1",
        "verseKey": "kjv:1-corinthians:11:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:1-corinthians:11:2",
      "numberLabel": "2",
      "text": "Now I praise you, brethren, that ye remember me in all things, and keep the ordinances, as I delivered them to you.",
      "metadata": {
        "reference": "1 Corinthians 11:2",
        "verseKey": "kjv:1-corinthians:11:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:1-corinthians:11:3",
      "numberLabel": "3",
      "text": "But I would have you know, that the head of every man is Christ; and the head of the woman is the man; and the head of Christ is God.",
      "metadata": {
        "reference": "1 Corinthians 11:3",
        "verseKey": "kjv:1-corinthians:11:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:1-corinthians:11:4",
      "numberLabel": "4",
      "text": "Every man praying or prophesying, having his head covered, dishonoureth his head.",
      "metadata": {
        "reference": "1 Corinthians 11:4",
        "verseKey": "kjv:1-corinthians:11:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:1-corinthians:11:5",
      "numberLabel": "5",
      "text": "But every woman that prayeth or prophesieth with her head uncovered dishonoureth her head: for that is even all one as if she were shaven.",
      "metadata": {
        "reference": "1 Corinthians 11:5",
        "verseKey": "kjv:1-corinthians:11:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:1-corinthians:11:6",
      "numberLabel": "6",
      "text": "For if the woman be not covered, let her also be shorn: but if it be a shame for a woman to be shorn or shaven, let her be covered.",
      "metadata": {
        "reference": "1 Corinthians 11:6",
        "verseKey": "kjv:1-corinthians:11:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:1-corinthians:11:7",
      "numberLabel": "7",
      "text": "For a man indeed ought not to cover his head, forasmuch as he is the image and glory of God: but the woman is the glory of the man.",
      "metadata": {
        "reference": "1 Corinthians 11:7",
        "verseKey": "kjv:1-corinthians:11:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:1-corinthians:11:8",
      "numberLabel": "8",
      "text": "For the man is not of the woman; but the woman of the man.",
      "metadata": {
        "reference": "1 Corinthians 11:8",
        "verseKey": "kjv:1-corinthians:11:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:1-corinthians:11:9",
      "numberLabel": "9",
      "text": "Neither was the man created for the woman; but the woman for the man.",
      "metadata": {
        "reference": "1 Corinthians 11:9",
        "verseKey": "kjv:1-corinthians:11:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:1-corinthians:11:10",
      "numberLabel": "10",
      "text": "For this cause ought the woman to have power on her head because of the angels.",
      "metadata": {
        "reference": "1 Corinthians 11:10",
        "verseKey": "kjv:1-corinthians:11:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:1-corinthians:11:11",
      "numberLabel": "11",
      "text": "Nevertheless neither is the man without the woman, neither the woman without the man, in the Lord.",
      "metadata": {
        "reference": "1 Corinthians 11:11",
        "verseKey": "kjv:1-corinthians:11:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:1-corinthians:11:12",
      "numberLabel": "12",
      "text": "For as the woman is of the man, even so is the man also by the woman; but all things of God.",
      "metadata": {
        "reference": "1 Corinthians 11:12",
        "verseKey": "kjv:1-corinthians:11:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:1-corinthians:11:13",
      "numberLabel": "13",
      "text": "Judge in yourselves: is it comely that a woman pray unto God uncovered?",
      "metadata": {
        "reference": "1 Corinthians 11:13",
        "verseKey": "kjv:1-corinthians:11:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:1-corinthians:11:14",
      "numberLabel": "14",
      "text": "Doth not even nature itself teach you, that, if a man have long hair, it is a shame unto him?",
      "metadata": {
        "reference": "1 Corinthians 11:14",
        "verseKey": "kjv:1-corinthians:11:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:1-corinthians:11:15",
      "numberLabel": "15",
      "text": "But if a woman have long hair, it is a glory to her: for her hair is given her for a covering.",
      "metadata": {
        "reference": "1 Corinthians 11:15",
        "verseKey": "kjv:1-corinthians:11:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:1-corinthians:11:16",
      "numberLabel": "16",
      "text": "But if any man seem to be contentious, we have no such custom, neither the churches of God.",
      "metadata": {
        "reference": "1 Corinthians 11:16",
        "verseKey": "kjv:1-corinthians:11:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:1-corinthians:11:17",
      "numberLabel": "17",
      "text": "Now in this that I declare unto you I praise you not, that ye come together not for the better, but for the worse.",
      "metadata": {
        "reference": "1 Corinthians 11:17",
        "verseKey": "kjv:1-corinthians:11:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:1-corinthians:11:18",
      "numberLabel": "18",
      "text": "For first of all, when ye come together in the church, I hear that there be divisions among you; and I partly believe it.",
      "metadata": {
        "reference": "1 Corinthians 11:18",
        "verseKey": "kjv:1-corinthians:11:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:1-corinthians:11:19",
      "numberLabel": "19",
      "text": "For there must be also heresies among you, that they which are approved may be made manifest among you.",
      "metadata": {
        "reference": "1 Corinthians 11:19",
        "verseKey": "kjv:1-corinthians:11:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:1-corinthians:11:20",
      "numberLabel": "20",
      "text": "When ye come together therefore into one place, this is not to eat the Lord’s supper.",
      "metadata": {
        "reference": "1 Corinthians 11:20",
        "verseKey": "kjv:1-corinthians:11:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:1-corinthians:11:21",
      "numberLabel": "21",
      "text": "For in eating every one taketh before other his own supper: and one is hungry, and another is drunken.",
      "metadata": {
        "reference": "1 Corinthians 11:21",
        "verseKey": "kjv:1-corinthians:11:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:1-corinthians:11:22",
      "numberLabel": "22",
      "text": "What? have ye not houses to eat and to drink in? or despise ye the church of God, and shame them that have not? What shall I say to you? shall I praise you in this? I praise you not.",
      "metadata": {
        "reference": "1 Corinthians 11:22",
        "verseKey": "kjv:1-corinthians:11:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:1-corinthians:11:23",
      "numberLabel": "23",
      "text": "For I have received of the Lord that which also I delivered unto you, That the Lord Jesus the same night in which he was betrayed took bread:",
      "metadata": {
        "reference": "1 Corinthians 11:23",
        "verseKey": "kjv:1-corinthians:11:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:1-corinthians:11:24",
      "numberLabel": "24",
      "text": "And when he had given thanks, he brake it, and said, Take, eat: this is my body, which is broken for you: this do in remembrance of me.",
      "metadata": {
        "reference": "1 Corinthians 11:24",
        "verseKey": "kjv:1-corinthians:11:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:1-corinthians:11:25",
      "numberLabel": "25",
      "text": "After the same manner also he took the cup, when he had supped, saying, This cup is the new testament in my blood: this do ye, as oft as ye drink it, in remembrance of me.",
      "metadata": {
        "reference": "1 Corinthians 11:25",
        "verseKey": "kjv:1-corinthians:11:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:1-corinthians:11:26",
      "numberLabel": "26",
      "text": "For as often as ye eat this bread, and drink this cup, ye do shew the Lord’s death till he come.",
      "metadata": {
        "reference": "1 Corinthians 11:26",
        "verseKey": "kjv:1-corinthians:11:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:1-corinthians:11:27",
      "numberLabel": "27",
      "text": "Wherefore whosoever shall eat this bread, and drink this cup of the Lord, unworthily, shall be guilty of the body and blood of the Lord.",
      "metadata": {
        "reference": "1 Corinthians 11:27",
        "verseKey": "kjv:1-corinthians:11:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:1-corinthians:11:28",
      "numberLabel": "28",
      "text": "But let a man examine himself, and so let him eat of that bread, and drink of that cup.",
      "metadata": {
        "reference": "1 Corinthians 11:28",
        "verseKey": "kjv:1-corinthians:11:28"
      }
    },
    {
      "id": "verse-029",
      "type": "bible_verse",
      "verse": 29,
      "verseId": "kjv:1-corinthians:11:29",
      "numberLabel": "29",
      "text": "For he that eateth and drinketh unworthily, eateth and drinketh damnation to himself, not discerning the Lord’s body.",
      "metadata": {
        "reference": "1 Corinthians 11:29",
        "verseKey": "kjv:1-corinthians:11:29"
      }
    },
    {
      "id": "verse-030",
      "type": "bible_verse",
      "verse": 30,
      "verseId": "kjv:1-corinthians:11:30",
      "numberLabel": "30",
      "text": "For this cause many are weak and sickly among you, and many sleep.",
      "metadata": {
        "reference": "1 Corinthians 11:30",
        "verseKey": "kjv:1-corinthians:11:30"
      }
    },
    {
      "id": "verse-031",
      "type": "bible_verse",
      "verse": 31,
      "verseId": "kjv:1-corinthians:11:31",
      "numberLabel": "31",
      "text": "For if we would judge ourselves, we should not be judged.",
      "metadata": {
        "reference": "1 Corinthians 11:31",
        "verseKey": "kjv:1-corinthians:11:31"
      }
    },
    {
      "id": "verse-032",
      "type": "bible_verse",
      "verse": 32,
      "verseId": "kjv:1-corinthians:11:32",
      "numberLabel": "32",
      "text": "But when we are judged, we are chastened of the Lord, that we should not be condemned with the world.",
      "metadata": {
        "reference": "1 Corinthians 11:32",
        "verseKey": "kjv:1-corinthians:11:32"
      }
    },
    {
      "id": "verse-033",
      "type": "bible_verse",
      "verse": 33,
      "verseId": "kjv:1-corinthians:11:33",
      "numberLabel": "33",
      "text": "Wherefore, my brethren, when ye come together to eat, tarry one for another.",
      "metadata": {
        "reference": "1 Corinthians 11:33",
        "verseKey": "kjv:1-corinthians:11:33"
      }
    },
    {
      "id": "verse-034",
      "type": "bible_verse",
      "verse": 34,
      "verseId": "kjv:1-corinthians:11:34",
      "numberLabel": "34",
      "text": "And if any man hunger, let him eat at home; that ye come not together unto condemnation. And the rest will I set in order when I come.",
      "metadata": {
        "reference": "1 Corinthians 11:34",
        "verseKey": "kjv:1-corinthians:11:34"
      }
    }
  ],
  "source": {
    "repository": "aruljohn/Bible-kjv",
