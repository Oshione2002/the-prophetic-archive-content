{
  "schemaVersion": 1,
  "id": "kjv-1-corinthians-009",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 9,
  "title": "1 Corinthians 9",
  "display_title": "1 Corinthians 9",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "1-corinthians",
  "book": "1 Corinthians",
  "bookName": "1 Corinthians",
