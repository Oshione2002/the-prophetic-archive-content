  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:3:1",
      "numberLabel": "1",
      "text": "Lord, how are they increased that trouble me! many are they that rise up against me.",
      "metadata": {
        "reference": "Psalms 3:1",
        "verseKey": "kjv:psalms:3:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:3:2",
      "numberLabel": "2",
      "text": "Many there be which say of my soul, There is no help for him in God. Selah.",
      "metadata": {
        "reference": "Psalms 3:2",
        "verseKey": "kjv:psalms:3:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:3:3",
      "numberLabel": "3",
      "text": "But thou, O LORD, art a shield for me; my glory, and the lifter up of mine head.",
      "metadata": {
        "reference": "Psalms 3:3",
        "verseKey": "kjv:psalms:3:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:3:4",
      "numberLabel": "4",
      "text": "I cried unto the LORD with my voice, and he heard me out of his holy hill. Selah.",
      "metadata": {
        "reference": "Psalms 3:4",
        "verseKey": "kjv:psalms:3:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:3:5",
      "numberLabel": "5",
      "text": "I laid me down and slept; I awaked; for the LORD sustained me.",
      "metadata": {
        "reference": "Psalms 3:5",
        "verseKey": "kjv:psalms:3:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:3:6",
      "numberLabel": "6",
      "text": "I will not be afraid of ten thousands of people, that have set themselves against me round about.",
      "metadata": {
        "reference": "Psalms 3:6",
        "verseKey": "kjv:psalms:3:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:3:7",
      "numberLabel": "7",
      "text": "Arise, O LORD; save me, O my God: for thou hast smitten all mine enemies upon the cheek bone; thou hast broken the teeth of the ungodly.",
      "metadata": {
        "reference": "Psalms 3:7",
        "verseKey": "kjv:psalms:3:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:3:8",
      "numberLabel": "8",
      "text": "Salvation belongeth unto the LORD: thy blessing is upon thy people. Selah.",
      "metadata": {
        "reference": "Psalms 3:8",
        "verseKey": "kjv:psalms:3:8"
      }
    }
  ],
  "source": {
