  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:4:1",
      "numberLabel": "1",
      "text": "Hear me when I call, O God of my righteousness: thou hast enlarged me when I was in distress; have mercy upon me, and hear my prayer.",
      "metadata": {
        "reference": "Psalms 4:1",
        "verseKey": "kjv:psalms:4:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:4:2",
      "numberLabel": "2",
      "text": "O ye sons of men, how long will ye turn my glory into shame? how long will ye love vanity, and seek after leasing? Selah.",
      "metadata": {
        "reference": "Psalms 4:2",
        "verseKey": "kjv:psalms:4:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:4:3",
      "numberLabel": "3",
      "text": "But know that the LORD hath set apart him that is godly for himself: the LORD will hear when I call unto him.",
      "metadata": {
        "reference": "Psalms 4:3",
        "verseKey": "kjv:psalms:4:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:4:4",
      "numberLabel": "4",
      "text": "Stand in awe, and sin not: commune with your own heart upon your bed, and be still. Selah.",
      "metadata": {
        "reference": "Psalms 4:4",
        "verseKey": "kjv:psalms:4:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:4:5",
      "numberLabel": "5",
      "text": "Offer the sacrifices of righteousness, and put your trust in the LORD.",
      "metadata": {
        "reference": "Psalms 4:5",
        "verseKey": "kjv:psalms:4:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:4:6",
      "numberLabel": "6",
      "text": "There be many that say, Who will shew us any good? LORD, lift thou up the light of thy countenance upon us.",
      "metadata": {
        "reference": "Psalms 4:6",
        "verseKey": "kjv:psalms:4:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:4:7",
      "numberLabel": "7",
      "text": "Thou hast put gladness in my heart, more than in the time that their corn and their wine increased.",
      "metadata": {
        "reference": "Psalms 4:7",
        "verseKey": "kjv:psalms:4:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:4:8",
      "numberLabel": "8",
      "text": "I will both lay me down in peace, and sleep: for thou, LORD, only makest me dwell in safety.",
      "metadata": {
        "reference": "Psalms 4:8",
        "verseKey": "kjv:psalms:4:8"
      }
    }
  ],
  "source": {
