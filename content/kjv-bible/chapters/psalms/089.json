{
  "schemaVersion": 1,
  "id": "kjv-psalms-089",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 89,
  "title": "Psalms 89",
  "display_title": "Psalms 89",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "psalms",
  "book": "Psalms",
  "bookName": "Psalms",
  "bookOrder": 19,
  "testament": "old",
  "chapter": 89,
  "sortOrder": 19089,
  "verseCount": 52,
  "aliases": [
    "Psalm",
    "Psalms",
    "Ps",
    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:89:1",
      "numberLabel": "1",
      "text": "I will sing of the mercies of the LORD for ever: with my mouth will I make known thy faithfulness to all generations.",
      "metadata": {
        "reference": "Psalms 89:1",
        "verseKey": "kjv:psalms:89:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:89:2",
      "numberLabel": "2",
      "text": "For I have said, Mercy shall be built up for ever: thy faithfulness shalt thou establish in the very heavens.",
      "metadata": {
        "reference": "Psalms 89:2",
        "verseKey": "kjv:psalms:89:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:89:3",
      "numberLabel": "3",
      "text": "I have made a covenant with my chosen, I have sworn unto David my servant,",
      "metadata": {
        "reference": "Psalms 89:3",
        "verseKey": "kjv:psalms:89:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:89:4",
      "numberLabel": "4",
      "text": "Thy seed will I establish for ever, and build up thy throne to all generations. Selah.",
      "metadata": {
        "reference": "Psalms 89:4",
        "verseKey": "kjv:psalms:89:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:89:5",
      "numberLabel": "5",
      "text": "And the heavens shall praise thy wonders, O LORD: thy faithfulness also in the congregation of the saints.",
      "metadata": {
        "reference": "Psalms 89:5",
        "verseKey": "kjv:psalms:89:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:89:6",
      "numberLabel": "6",
      "text": "For who in the heaven can be compared unto the LORD? who among the sons of the mighty can be likened unto the LORD?",
      "metadata": {
        "reference": "Psalms 89:6",
        "verseKey": "kjv:psalms:89:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:89:7",
      "numberLabel": "7",
      "text": "God is greatly to be feared in the assembly of the saints, and to be had in reverence of all them that are about him.",
      "metadata": {
        "reference": "Psalms 89:7",
        "verseKey": "kjv:psalms:89:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:89:8",
      "numberLabel": "8",
      "text": "O LORD God of hosts, who is a strong LORD like unto thee? or to thy faithfulness round about thee?",
      "metadata": {
        "reference": "Psalms 89:8",
        "verseKey": "kjv:psalms:89:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:89:9",
      "numberLabel": "9",
      "text": "Thou rulest the raging of the sea: when the waves thereof arise, thou stillest them.",
      "metadata": {
        "reference": "Psalms 89:9",
        "verseKey": "kjv:psalms:89:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:89:10",
      "numberLabel": "10",
      "text": "Thou hast broken Rahab in pieces, as one that is slain; thou hast scattered thine enemies with thy strong arm.",
      "metadata": {
        "reference": "Psalms 89:10",
        "verseKey": "kjv:psalms:89:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:89:11",
      "numberLabel": "11",
      "text": "The heavens are thine, the earth also is thine: as for the world and the fulness thereof, thou hast founded them.",
      "metadata": {
        "reference": "Psalms 89:11",
        "verseKey": "kjv:psalms:89:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:89:12",
      "numberLabel": "12",
      "text": "The north and the south thou hast created them: Tabor and Hermon shall rejoice in thy name.",
      "metadata": {
        "reference": "Psalms 89:12",
        "verseKey": "kjv:psalms:89:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:89:13",
      "numberLabel": "13",
      "text": "Thou hast a mighty arm: strong is thy hand, and high is thy right hand.",
      "metadata": {
        "reference": "Psalms 89:13",
        "verseKey": "kjv:psalms:89:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:89:14",
      "numberLabel": "14",
      "text": "Justice and judgment are the habitation of thy throne: mercy and truth shall go before thy face.",
      "metadata": {
        "reference": "Psalms 89:14",
        "verseKey": "kjv:psalms:89:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:89:15",
      "numberLabel": "15",
      "text": "Blessed is the people that know the joyful sound: they shall walk, O LORD, in the light of thy countenance.",
      "metadata": {
        "reference": "Psalms 89:15",
        "verseKey": "kjv:psalms:89:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:89:16",
      "numberLabel": "16",
      "text": "In thy name shall they rejoice all the day: and in thy righteousness shall they be exalted.",
      "metadata": {
        "reference": "Psalms 89:16",
        "verseKey": "kjv:psalms:89:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:89:17",
      "numberLabel": "17",
      "text": "For thou art the glory of their strength: and in thy favour our horn shall be exalted.",
      "metadata": {
        "reference": "Psalms 89:17",
        "verseKey": "kjv:psalms:89:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:psalms:89:18",
      "numberLabel": "18",
      "text": "For the LORD is our defence; and the Holy One of Israel is our king.",
      "metadata": {
        "reference": "Psalms 89:18",
        "verseKey": "kjv:psalms:89:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:psalms:89:19",
      "numberLabel": "19",
      "text": "Then thou spakest in vision to thy holy one, and saidst, I have laid help upon one that is mighty; I have exalted one chosen out of the people.",
      "metadata": {
        "reference": "Psalms 89:19",
        "verseKey": "kjv:psalms:89:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:psalms:89:20",
      "numberLabel": "20",
      "text": "I have found David my servant; with my holy oil have I anointed him:",
      "metadata": {
        "reference": "Psalms 89:20",
        "verseKey": "kjv:psalms:89:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:psalms:89:21",
      "numberLabel": "21",
      "text": "With whom my hand shall be established: mine arm also shall strengthen him.",
      "metadata": {
        "reference": "Psalms 89:21",
        "verseKey": "kjv:psalms:89:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:psalms:89:22",
      "numberLabel": "22",
      "text": "The enemy shall not exact upon him; nor the son of wickedness afflict him.",
      "metadata": {
        "reference": "Psalms 89:22",
        "verseKey": "kjv:psalms:89:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:psalms:89:23",
      "numberLabel": "23",
      "text": "And I will beat down his foes before his face, and plague them that hate him.",
      "metadata": {
        "reference": "Psalms 89:23",
        "verseKey": "kjv:psalms:89:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:psalms:89:24",
      "numberLabel": "24",
      "text": "But my faithfulness and my mercy shall be with him: and in my name shall his horn be exalted.",
      "metadata": {
        "reference": "Psalms 89:24",
        "verseKey": "kjv:psalms:89:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:psalms:89:25",
      "numberLabel": "25",
      "text": "I will set his hand also in the sea, and his right hand in the rivers.",
      "metadata": {
        "reference": "Psalms 89:25",
        "verseKey": "kjv:psalms:89:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:psalms:89:26",
      "numberLabel": "26",
      "text": "He shall cry unto me, Thou art my father, my God, and the rock of my salvation.",
      "metadata": {
        "reference": "Psalms 89:26",
        "verseKey": "kjv:psalms:89:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:psalms:89:27",
      "numberLabel": "27",
      "text": "Also I will make him my firstborn, higher than the kings of the earth.",
      "metadata": {
        "reference": "Psalms 89:27",
        "verseKey": "kjv:psalms:89:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:psalms:89:28",
      "numberLabel": "28",
      "text": "My mercy will I keep for him for evermore, and my covenant shall stand fast with him.",
      "metadata": {
        "reference": "Psalms 89:28",
        "verseKey": "kjv:psalms:89:28"
      }
    },
    {
      "id": "verse-029",
      "type": "bible_verse",
      "verse": 29,
      "verseId": "kjv:psalms:89:29",
      "numberLabel": "29",
      "text": "His seed also will I make to endure for ever, and his throne as the days of heaven.",
      "metadata": {
        "reference": "Psalms 89:29",
        "verseKey": "kjv:psalms:89:29"
      }
    },
    {
      "id": "verse-030",
      "type": "bible_verse",
      "verse": 30,
      "verseId": "kjv:psalms:89:30",
      "numberLabel": "30",
      "text": "If his children forsake my law, and walk not in my judgments;",
      "metadata": {
        "reference": "Psalms 89:30",
        "verseKey": "kjv:psalms:89:30"
      }
    },
    {
      "id": "verse-031",
      "type": "bible_verse",
      "verse": 31,
      "verseId": "kjv:psalms:89:31",
      "numberLabel": "31",
      "text": "If they break my statutes, and keep not my commandments;",
      "metadata": {
        "reference": "Psalms 89:31",
        "verseKey": "kjv:psalms:89:31"
      }
    },
    {
      "id": "verse-032",
      "type": "bible_verse",
      "verse": 32,
      "verseId": "kjv:psalms:89:32",
      "numberLabel": "32",
      "text": "Then will I visit their transgression with the rod, and their iniquity with stripes.",
      "metadata": {
        "reference": "Psalms 89:32",
        "verseKey": "kjv:psalms:89:32"
      }
    },
    {
      "id": "verse-033",
      "type": "bible_verse",
      "verse": 33,
      "verseId": "kjv:psalms:89:33",
      "numberLabel": "33",
      "text": "Nevertheless my lovingkindness will I not utterly take from him, nor suffer my faithfulness to fail.",
      "metadata": {
        "reference": "Psalms 89:33",
        "verseKey": "kjv:psalms:89:33"
      }
    },
    {
      "id": "verse-034",
      "type": "bible_verse",
      "verse": 34,
      "verseId": "kjv:psalms:89:34",
      "numberLabel": "34",
      "text": "My covenant will I not break, nor alter the thing that is gone out of my lips.",
      "metadata": {
        "reference": "Psalms 89:34",
        "verseKey": "kjv:psalms:89:34"
      }
    },
    {
      "id": "verse-035",
      "type": "bible_verse",
      "verse": 35,
      "verseId": "kjv:psalms:89:35",
      "numberLabel": "35",
      "text": "Once have I sworn by my holiness that I will not lie unto David.",
      "metadata": {
        "reference": "Psalms 89:35",
        "verseKey": "kjv:psalms:89:35"
      }
    },
    {
      "id": "verse-036",
      "type": "bible_verse",
      "verse": 36,
      "verseId": "kjv:psalms:89:36",
      "numberLabel": "36",
      "text": "His seed shall endure for ever, and his throne as the sun before me.",
      "metadata": {
        "reference": "Psalms 89:36",
        "verseKey": "kjv:psalms:89:36"
      }
    },
    {
      "id": "verse-037",
      "type": "bible_verse",
      "verse": 37,
      "verseId": "kjv:psalms:89:37",
      "numberLabel": "37",
      "text": "It shall be established for ever as the moon, and as a faithful witness in heaven. Selah.",
      "metadata": {
        "reference": "Psalms 89:37",
        "verseKey": "kjv:psalms:89:37"
      }
    },
    {
      "id": "verse-038",
      "type": "bible_verse",
      "verse": 38,
      "verseId": "kjv:psalms:89:38",
      "numberLabel": "38",
      "text": "But thou hast cast off and abhorred, thou hast been wroth with thine anointed.",
      "metadata": {
        "reference": "Psalms 89:38",
        "verseKey": "kjv:psalms:89:38"
      }
    },
    {
      "id": "verse-039",
      "type": "bible_verse",
      "verse": 39,
      "verseId": "kjv:psalms:89:39",
      "numberLabel": "39",
      "text": "Thou hast made void the covenant of thy servant: thou hast profaned his crown by casting it to the ground.",
      "metadata": {
        "reference": "Psalms 89:39",
        "verseKey": "kjv:psalms:89:39"
      }
    },
    {
      "id": "verse-040",
      "type": "bible_verse",
      "verse": 40,
      "verseId": "kjv:psalms:89:40",
      "numberLabel": "40",
      "text": "Thou hast broken down all his hedges; thou hast brought his strong holds to ruin.",
      "metadata": {
        "reference": "Psalms 89:40",
        "verseKey": "kjv:psalms:89:40"
      }
    },
    {
      "id": "verse-041",
      "type": "bible_verse",
      "verse": 41,
      "verseId": "kjv:psalms:89:41",
      "numberLabel": "41",
      "text": "All that pass by the way spoil him: he is a reproach to his neighbours.",
      "metadata": {
        "reference": "Psalms 89:41",
        "verseKey": "kjv:psalms:89:41"
      }
    },
    {
      "id": "verse-042",
      "type": "bible_verse",
      "verse": 42,
      "verseId": "kjv:psalms:89:42",
      "numberLabel": "42",
      "text": "Thou hast set up the right hand of his adversaries; thou hast made all his enemies to rejoice.",
      "metadata": {
        "reference": "Psalms 89:42",
        "verseKey": "kjv:psalms:89:42"
      }
    },
    {
      "id": "verse-043",
      "type": "bible_verse",
      "verse": 43,
      "verseId": "kjv:psalms:89:43",
      "numberLabel": "43",
      "text": "Thou hast also turned the edge of his sword, and hast not made him to stand in the battle.",
      "metadata": {
        "reference": "Psalms 89:43",
        "verseKey": "kjv:psalms:89:43"
      }
    },
    {
      "id": "verse-044",
      "type": "bible_verse",
      "verse": 44,
      "verseId": "kjv:psalms:89:44",
      "numberLabel": "44",
      "text": "Thou hast made his glory to cease, and cast his throne down to the ground.",
      "metadata": {
        "reference": "Psalms 89:44",
        "verseKey": "kjv:psalms:89:44"
      }
    },
    {
      "id": "verse-045",
      "type": "bible_verse",
      "verse": 45,
      "verseId": "kjv:psalms:89:45",
      "numberLabel": "45",
      "text": "The days of his youth hast thou shortened: thou hast covered him with shame. Selah.",
      "metadata": {
        "reference": "Psalms 89:45",
        "verseKey": "kjv:psalms:89:45"
      }
    },
    {
      "id": "verse-046",
      "type": "bible_verse",
      "verse": 46,
      "verseId": "kjv:psalms:89:46",
      "numberLabel": "46",
      "text": "How long, LORD? wilt thou hide thyself for ever? shall thy wrath burn like fire?",
      "metadata": {
        "reference": "Psalms 89:46",
        "verseKey": "kjv:psalms:89:46"
      }
    },
    {
      "id": "verse-047",
      "type": "bible_verse",
      "verse": 47,
      "verseId": "kjv:psalms:89:47",
      "numberLabel": "47",
      "text": "Remember how short my time is: wherefore hast thou made all men in vain?",
      "metadata": {
        "reference": "Psalms 89:47",
        "verseKey": "kjv:psalms:89:47"
      }
    },
    {
      "id": "verse-048",
      "type": "bible_verse",
      "verse": 48,
      "verseId": "kjv:psalms:89:48",
      "numberLabel": "48",
      "text": "What man is he that liveth, and shall not see death? shall he deliver his soul from the hand of the grave? Selah.",
      "metadata": {
        "reference": "Psalms 89:48",
        "verseKey": "kjv:psalms:89:48"
      }
    },
    {
      "id": "verse-049",
      "type": "bible_verse",
      "verse": 49,
      "verseId": "kjv:psalms:89:49",
      "numberLabel": "49",
      "text": "Lord, where are thy former lovingkindnesses, which thou swarest unto David in thy truth?",
      "metadata": {
        "reference": "Psalms 89:49",
        "verseKey": "kjv:psalms:89:49"
      }
    },
    {
      "id": "verse-050",
      "type": "bible_verse",
      "verse": 50,
      "verseId": "kjv:psalms:89:50",
      "numberLabel": "50",
      "text": "Remember, Lord, the reproach of thy servants; how I do bear in my bosom the reproach of all the mighty people;",
      "metadata": {
        "reference": "Psalms 89:50",
        "verseKey": "kjv:psalms:89:50"
      }
    },
    {
      "id": "verse-051",
      "type": "bible_verse",
      "verse": 51,
      "verseId": "kjv:psalms:89:51",
      "numberLabel": "51",
      "text": "Wherewith thine enemies have reproached, O LORD; wherewith they have reproached the footsteps of thine anointed.",
      "metadata": {
        "reference": "Psalms 89:51",
        "verseKey": "kjv:psalms:89:51"
      }
    },
    {
      "id": "verse-052",
      "type": "bible_verse",
      "verse": 52,
      "verseId": "kjv:psalms:89:52",
      "numberLabel": "52",
      "text": "Blessed be the LORD for evermore. Amen, and Amen.",
      "metadata": {
        "reference": "Psalms 89:52",
        "verseKey": "kjv:psalms:89:52"
      }
    }
  ],
