  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:141:1",
      "numberLabel": "1",
      "text": "Lord, I cry unto thee: make haste unto me; give ear unto my voice, when I cry unto thee.",
      "metadata": {
        "reference": "Psalms 141:1",
        "verseKey": "kjv:psalms:141:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:141:2",
      "numberLabel": "2",
      "text": "Let my prayer be set forth before thee as incense; and the lifting up of my hands as the evening sacrifice.",
      "metadata": {
        "reference": "Psalms 141:2",
        "verseKey": "kjv:psalms:141:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:141:3",
      "numberLabel": "3",
      "text": "Set a watch, O LORD, before my mouth; keep the door of my lips.",
      "metadata": {
        "reference": "Psalms 141:3",
        "verseKey": "kjv:psalms:141:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:141:4",
      "numberLabel": "4",
      "text": "Incline not my heart to any evil thing, to practise wicked works with men that work iniquity: and let me not eat of their dainties.",
      "metadata": {
        "reference": "Psalms 141:4",
        "verseKey": "kjv:psalms:141:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:141:5",
      "numberLabel": "5",
      "text": "Let the righteous smite me; it shall be a kindness: and let him reprove me; it shall be an excellent oil, which shall not break my head: for yet my prayer also shall be in their calamities.",
      "metadata": {
        "reference": "Psalms 141:5",
        "verseKey": "kjv:psalms:141:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:141:6",
      "numberLabel": "6",
      "text": "When their judges are overthrown in stony places, they shall hear my words; for they are sweet.",
      "metadata": {
        "reference": "Psalms 141:6",
        "verseKey": "kjv:psalms:141:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:141:7",
      "numberLabel": "7",
      "text": "Our bones are scattered at the grave’s mouth, as when one cutteth and cleaveth wood upon the earth.",
      "metadata": {
        "reference": "Psalms 141:7",
        "verseKey": "kjv:psalms:141:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:141:8",
      "numberLabel": "8",
      "text": "But mine eyes are unto thee, O GOD the Lord: in thee is my trust; leave not my soul destitute.",
      "metadata": {
        "reference": "Psalms 141:8",
        "verseKey": "kjv:psalms:141:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:141:9",
      "numberLabel": "9",
      "text": "Keep me from the snares which they have laid for me, and the gins of the workers of iniquity.",
      "metadata": {
        "reference": "Psalms 141:9",
        "verseKey": "kjv:psalms:141:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:141:10",
      "numberLabel": "10",
      "text": "Let the wicked fall into their own nets, whilst that I withal escape.",
      "metadata": {
        "reference": "Psalms 141:10",
        "verseKey": "kjv:psalms:141:10"
      }
    }
  ],
  "source": {
