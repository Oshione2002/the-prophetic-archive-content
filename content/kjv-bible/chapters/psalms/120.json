  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:120:1",
      "numberLabel": "1",
      "text": "In my distress I cried unto the LORD, and he heard me.",
      "metadata": {
        "reference": "Psalms 120:1",
        "verseKey": "kjv:psalms:120:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:120:2",
      "numberLabel": "2",
      "text": "Deliver my soul, O LORD, from lying lips, and from a deceitful tongue.",
      "metadata": {
        "reference": "Psalms 120:2",
        "verseKey": "kjv:psalms:120:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:120:3",
      "numberLabel": "3",
      "text": "What shall be given unto thee? or what shall be done unto thee, thou false tongue?",
      "metadata": {
        "reference": "Psalms 120:3",
        "verseKey": "kjv:psalms:120:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:120:4",
      "numberLabel": "4",
      "text": "Sharp arrows of the mighty, with coals of juniper.",
      "metadata": {
        "reference": "Psalms 120:4",
        "verseKey": "kjv:psalms:120:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:120:5",
      "numberLabel": "5",
      "text": "Woe is me, that I sojourn in Mesech, that I dwell in the tents of Kedar!",
      "metadata": {
        "reference": "Psalms 120:5",
        "verseKey": "kjv:psalms:120:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:120:6",
      "numberLabel": "6",
      "text": "My soul hath long dwelt with him that hateth peace.",
      "metadata": {
        "reference": "Psalms 120:6",
        "verseKey": "kjv:psalms:120:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:120:7",
      "numberLabel": "7",
      "text": "I am for peace: but when I speak, they are for war.",
      "metadata": {
        "reference": "Psalms 120:7",
        "verseKey": "kjv:psalms:120:7"
      }
    }
  ],
