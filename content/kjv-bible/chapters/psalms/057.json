  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:57:1",
      "numberLabel": "1",
      "text": "Be merciful unto me, O God, be merciful unto me: for my soul trusteth in thee: yea, in the shadow of thy wings will I make my refuge, until these calamities be overpast.",
      "metadata": {
        "reference": "Psalms 57:1",
        "verseKey": "kjv:psalms:57:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:57:2",
      "numberLabel": "2",
      "text": "I will cry unto God most high; unto God that performeth all things for me.",
      "metadata": {
        "reference": "Psalms 57:2",
        "verseKey": "kjv:psalms:57:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:57:3",
      "numberLabel": "3",
      "text": "He shall send from heaven, and save me from the reproach of him that would swallow me up. Selah. God shall send forth his mercy and his truth.",
      "metadata": {
        "reference": "Psalms 57:3",
        "verseKey": "kjv:psalms:57:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:57:4",
      "numberLabel": "4",
      "text": "My soul is among lions: and I lie even among them that are set on fire, even the sons of men, whose teeth are spears and arrows, and their tongue a sharp sword.",
      "metadata": {
        "reference": "Psalms 57:4",
        "verseKey": "kjv:psalms:57:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:57:5",
      "numberLabel": "5",
      "text": "Be thou exalted, O God, above the heavens; let thy glory be above all the earth.",
      "metadata": {
        "reference": "Psalms 57:5",
        "verseKey": "kjv:psalms:57:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:57:6",
      "numberLabel": "6",
      "text": "They have prepared a net for my steps; my soul is bowed down: they have digged a pit before me, into the midst whereof they are fallen themselves. Selah.",
      "metadata": {
        "reference": "Psalms 57:6",
        "verseKey": "kjv:psalms:57:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:57:7",
      "numberLabel": "7",
      "text": "My heart is fixed, O God, my heart is fixed: I will sing and give praise.",
      "metadata": {
        "reference": "Psalms 57:7",
        "verseKey": "kjv:psalms:57:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:57:8",
      "numberLabel": "8",
      "text": "Awake up, my glory; awake, psaltery and harp: I myself will awake early.",
      "metadata": {
        "reference": "Psalms 57:8",
        "verseKey": "kjv:psalms:57:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:57:9",
      "numberLabel": "9",
      "text": "I will praise thee, O Lord, among the people: I will sing unto thee among the nations.",
      "metadata": {
        "reference": "Psalms 57:9",
        "verseKey": "kjv:psalms:57:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:57:10",
      "numberLabel": "10",
      "text": "For thy mercy is great unto the heavens, and thy truth unto the clouds.",
      "metadata": {
        "reference": "Psalms 57:10",
        "verseKey": "kjv:psalms:57:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:57:11",
      "numberLabel": "11",
      "text": "Be thou exalted, O God, above the heavens: let thy glory be above all the earth.",
      "metadata": {
        "reference": "Psalms 57:11",
        "verseKey": "kjv:psalms:57:11"
      }
    }
  ],
