  "aliases": [
    "Psalm",
    "Psalms",
    "Ps",
    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:92:1",
      "numberLabel": "1",
      "text": "IT IS A GOOD THING TO GIVE THANKS UNTO THE LORD, AND TO SING PRAISES UNTO THY NAME, O MOST HIGH:",
      "metadata": {
        "reference": "Psalms 92:1",
        "verseKey": "kjv:psalms:92:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:92:2",
      "numberLabel": "2",
      "text": "To shew forth thy lovingkindness in the morning, and thy faithfulness every night,",
      "metadata": {
        "reference": "Psalms 92:2",
        "verseKey": "kjv:psalms:92:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:92:3",
      "numberLabel": "3",
      "text": "Upon an instrument of ten strings, and upon the psaltery; upon the harp with a solemn sound.",
      "metadata": {
        "reference": "Psalms 92:3",
        "verseKey": "kjv:psalms:92:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:92:4",
      "numberLabel": "4",
      "text": "For thou, LORD, hast made me glad through thy work: I will triumph in the works of thy hands.",
      "metadata": {
        "reference": "Psalms 92:4",
        "verseKey": "kjv:psalms:92:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:92:5",
      "numberLabel": "5",
      "text": "O LORD, how great are thy works! and thy thoughts are very deep.",
      "metadata": {
        "reference": "Psalms 92:5",
        "verseKey": "kjv:psalms:92:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:92:6",
      "numberLabel": "6",
      "text": "A brutish man knoweth not; neither doth a fool understand this.",
      "metadata": {
        "reference": "Psalms 92:6",
        "verseKey": "kjv:psalms:92:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:92:7",
      "numberLabel": "7",
      "text": "When the wicked spring as the grass, and when all the workers of iniquity do flourish; it is that they shall be destroyed for ever:",
      "metadata": {
        "reference": "Psalms 92:7",
        "verseKey": "kjv:psalms:92:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:92:8",
      "numberLabel": "8",
      "text": "But thou, LORD, art most high for evermore.",
      "metadata": {
        "reference": "Psalms 92:8",
        "verseKey": "kjv:psalms:92:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:92:9",
      "numberLabel": "9",
      "text": "For, lo, thine enemies, O LORD, for, lo, thine enemies shall perish; all the workers of iniquity shall be scattered.",
      "metadata": {
        "reference": "Psalms 92:9",
        "verseKey": "kjv:psalms:92:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:92:10",
      "numberLabel": "10",
      "text": "But my horn shalt thou exalt like the horn of an unicorn: I shall be anointed with fresh oil.",
      "metadata": {
        "reference": "Psalms 92:10",
        "verseKey": "kjv:psalms:92:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:92:11",
      "numberLabel": "11",
      "text": "Mine eye also shall see my desire on mine enemies, and mine ears shall hear my desire of the wicked that rise up against me.",
      "metadata": {
        "reference": "Psalms 92:11",
        "verseKey": "kjv:psalms:92:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:92:12",
      "numberLabel": "12",
      "text": "The righteous shall flourish like the palm tree: he shall grow like a cedar in Lebanon.",
      "metadata": {
        "reference": "Psalms 92:12",
        "verseKey": "kjv:psalms:92:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:92:13",
      "numberLabel": "13",
      "text": "Those that be planted in the house of the LORD shall flourish in the courts of our God.",
      "metadata": {
        "reference": "Psalms 92:13",
        "verseKey": "kjv:psalms:92:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:92:14",
      "numberLabel": "14",
      "text": "They shall still bring forth fruit in old age; they shall be fat and flourishing;",
      "metadata": {
        "reference": "Psalms 92:14",
        "verseKey": "kjv:psalms:92:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:92:15",
      "numberLabel": "15",
      "text": "To shew that the LORD is upright: he is my rock, and there is no unrighteousness in him.",
      "metadata": {
        "reference": "Psalms 92:15",
        "verseKey": "kjv:psalms:92:15"
      }
    }
  ],
  "source": {
