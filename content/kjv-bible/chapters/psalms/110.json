  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:110:1",
      "numberLabel": "1",
      "text": "The LORD said unto my Lord, Sit thou at my right hand, until I make thine enemies thy footstool.",
      "metadata": {
        "reference": "Psalms 110:1",
        "verseKey": "kjv:psalms:110:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:110:2",
      "numberLabel": "2",
      "text": "The LORD shall send the rod of thy strength out of Zion: rule thou in the midst of thine enemies.",
      "metadata": {
        "reference": "Psalms 110:2",
        "verseKey": "kjv:psalms:110:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:110:3",
      "numberLabel": "3",
      "text": "Thy people shall be willing in the day of thy power, in the beauties of holiness from the womb of the morning: thou hast the dew of thy youth.",
      "metadata": {
        "reference": "Psalms 110:3",
        "verseKey": "kjv:psalms:110:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:110:4",
      "numberLabel": "4",
      "text": "The LORD hath sworn, and will not repent, Thou art a priest for ever after the order of Melchizedek.",
      "metadata": {
        "reference": "Psalms 110:4",
        "verseKey": "kjv:psalms:110:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:110:5",
      "numberLabel": "5",
      "text": "The Lord at thy right hand shall strike through kings in the day of his wrath.",
      "metadata": {
        "reference": "Psalms 110:5",
        "verseKey": "kjv:psalms:110:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:110:6",
      "numberLabel": "6",
      "text": "He shall judge among the heathen, he shall fill the places with the dead bodies; he shall wound the heads over many countries.",
      "metadata": {
        "reference": "Psalms 110:6",
        "verseKey": "kjv:psalms:110:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:110:7",
      "numberLabel": "7",
      "text": "He shall drink of the brook in the way: therefore shall he lift up the head.",
      "metadata": {
        "reference": "Psalms 110:7",
        "verseKey": "kjv:psalms:110:7"
      }
    }
  ],
