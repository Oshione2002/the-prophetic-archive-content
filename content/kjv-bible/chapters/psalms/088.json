  "testament": "old",
  "chapter": 88,
  "sortOrder": 19088,
  "verseCount": 18,
  "aliases": [
    "Psalm",
    "Psalms",
    "Ps",
    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:88:1",
      "numberLabel": "1",
      "text": "O LORD God of my salvation, I have cried day and night before thee:",
      "metadata": {
        "reference": "Psalms 88:1",
        "verseKey": "kjv:psalms:88:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:88:2",
      "numberLabel": "2",
      "text": "Let my prayer come before thee: incline thine ear unto my cry;",
      "metadata": {
        "reference": "Psalms 88:2",
        "verseKey": "kjv:psalms:88:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:88:3",
      "numberLabel": "3",
      "text": "For my soul is full of troubles: and my life draweth nigh unto the grave.",
      "metadata": {
        "reference": "Psalms 88:3",
        "verseKey": "kjv:psalms:88:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:88:4",
      "numberLabel": "4",
      "text": "I am counted with them that go down into the pit: I am as a man that hath no strength:",
      "metadata": {
        "reference": "Psalms 88:4",
        "verseKey": "kjv:psalms:88:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:88:5",
      "numberLabel": "5",
      "text": "Free among the dead, like the slain that lie in the grave, whom thou rememberest no more: and they are cut off from thy hand.",
      "metadata": {
        "reference": "Psalms 88:5",
        "verseKey": "kjv:psalms:88:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:88:6",
      "numberLabel": "6",
      "text": "Thou hast laid me in the lowest pit, in darkness, in the deeps.",
      "metadata": {
        "reference": "Psalms 88:6",
        "verseKey": "kjv:psalms:88:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:88:7",
      "numberLabel": "7",
      "text": "Thy wrath lieth hard upon me, and thou hast afflicted me with all thy waves. Selah.",
      "metadata": {
        "reference": "Psalms 88:7",
        "verseKey": "kjv:psalms:88:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:88:8",
      "numberLabel": "8",
      "text": "Thou hast put away mine acquaintance far from me; thou hast made me an abomination unto them: I am shut up, and I cannot come forth.",
      "metadata": {
        "reference": "Psalms 88:8",
        "verseKey": "kjv:psalms:88:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:88:9",
      "numberLabel": "9",
      "text": "Mine eye mourneth by reason of affliction: LORD, I have called daily upon thee, I have stretched out my hands unto thee.",
      "metadata": {
        "reference": "Psalms 88:9",
        "verseKey": "kjv:psalms:88:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:88:10",
      "numberLabel": "10",
      "text": "Wilt thou shew wonders to the dead? shall the dead arise and praise thee? Selah.",
      "metadata": {
        "reference": "Psalms 88:10",
        "verseKey": "kjv:psalms:88:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:88:11",
      "numberLabel": "11",
      "text": "Shall thy lovingkindness be declared in the grave? or thy faithfulness in destruction?",
      "metadata": {
        "reference": "Psalms 88:11",
        "verseKey": "kjv:psalms:88:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:88:12",
      "numberLabel": "12",
      "text": "Shall thy wonders be known in the dark? and thy righteousness in the land of forgetfulness?",
      "metadata": {
        "reference": "Psalms 88:12",
        "verseKey": "kjv:psalms:88:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:88:13",
      "numberLabel": "13",
      "text": "But unto thee have I cried, O LORD; and in the morning shall my prayer prevent thee.",
      "metadata": {
        "reference": "Psalms 88:13",
        "verseKey": "kjv:psalms:88:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:88:14",
      "numberLabel": "14",
      "text": "LORD, why castest thou off my soul? why hidest thou thy face from me?",
      "metadata": {
        "reference": "Psalms 88:14",
        "verseKey": "kjv:psalms:88:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:88:15",
      "numberLabel": "15",
      "text": "I am afflicted and ready to die from my youth up: while I suffer thy terrors I am distracted.",
      "metadata": {
        "reference": "Psalms 88:15",
        "verseKey": "kjv:psalms:88:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:88:16",
      "numberLabel": "16",
      "text": "Thy fierce wrath goeth over me; thy terrors have cut me off.",
      "metadata": {
        "reference": "Psalms 88:16",
        "verseKey": "kjv:psalms:88:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:88:17",
      "numberLabel": "17",
      "text": "They came round about me daily like water; they compassed me about together.",
      "metadata": {
        "reference": "Psalms 88:17",
        "verseKey": "kjv:psalms:88:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:psalms:88:18",
      "numberLabel": "18",
      "text": "Lover and friend hast thou put far from me, and mine acquaintance into darkness.",
      "metadata": {
        "reference": "Psalms 88:18",
        "verseKey": "kjv:psalms:88:18"
      }
    }
  ],
  "source": {
