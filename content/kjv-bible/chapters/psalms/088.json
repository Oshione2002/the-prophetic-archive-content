  "document_type": "bible_chapter",
  "number": 88,
  "title": "Psalms 88",
  "display_title": "Psalms 88",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "psalms",
  "book": "Psalms",
  "bookName": "Psalms",
