  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:54:1",
      "numberLabel": "1",
      "text": "Save me, O God, by thy name, and judge me by thy strength.",
      "metadata": {
        "reference": "Psalms 54:1",
        "verseKey": "kjv:psalms:54:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:54:2",
      "numberLabel": "2",
      "text": "Hear my prayer, O God; give ear to the words of my mouth.",
      "metadata": {
        "reference": "Psalms 54:2",
        "verseKey": "kjv:psalms:54:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:54:3",
      "numberLabel": "3",
      "text": "For strangers are risen up against me, and oppressors seek after my soul: they have not set God before them. Selah.",
      "metadata": {
        "reference": "Psalms 54:3",
        "verseKey": "kjv:psalms:54:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:54:4",
      "numberLabel": "4",
      "text": "Behold, God is mine helper: the Lord is with them that uphold my soul.",
      "metadata": {
        "reference": "Psalms 54:4",
        "verseKey": "kjv:psalms:54:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:54:5",
      "numberLabel": "5",
      "text": "He shall reward evil unto mine enemies: cut them off in thy truth.",
      "metadata": {
        "reference": "Psalms 54:5",
        "verseKey": "kjv:psalms:54:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:54:6",
      "numberLabel": "6",
      "text": "I will freely sacrifice unto thee: I will praise thy name, O LORD; for it is good.",
      "metadata": {
        "reference": "Psalms 54:6",
        "verseKey": "kjv:psalms:54:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:54:7",
      "numberLabel": "7",
      "text": "For he hath delivered me out of all trouble: and mine eye hath seen his desire upon mine enemies.",
      "metadata": {
        "reference": "Psalms 54:7",
        "verseKey": "kjv:psalms:54:7"
      }
    }
  ],
