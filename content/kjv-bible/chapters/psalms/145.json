  "testament": "old",
  "chapter": 145,
  "sortOrder": 19145,
  "verseCount": 21,
  "aliases": [
    "Psalm",
    "Psalms",
    "Ps",
    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:145:1",
      "numberLabel": "1",
      "text": "I will extol thee, my God, O king; and I will bless thy name for ever and ever.",
      "metadata": {
        "reference": "Psalms 145:1",
        "verseKey": "kjv:psalms:145:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:145:2",
      "numberLabel": "2",
      "text": "Every day will I bless thee; and I will praise thy name for ever and ever.",
      "metadata": {
        "reference": "Psalms 145:2",
        "verseKey": "kjv:psalms:145:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:145:3",
      "numberLabel": "3",
      "text": "Great is the LORD, and greatly to be praised; and his greatness is unsearchable.",
      "metadata": {
        "reference": "Psalms 145:3",
        "verseKey": "kjv:psalms:145:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:145:4",
      "numberLabel": "4",
      "text": "One generation shall praise thy works to another, and shall declare thy mighty acts.",
      "metadata": {
        "reference": "Psalms 145:4",
        "verseKey": "kjv:psalms:145:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:145:5",
      "numberLabel": "5",
      "text": "I will speak of the glorious honour of thy majesty, and of thy wondrous works.",
      "metadata": {
        "reference": "Psalms 145:5",
        "verseKey": "kjv:psalms:145:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:145:6",
      "numberLabel": "6",
      "text": "And men shall speak of the might of thy terrible acts: and I will declare thy greatness.",
      "metadata": {
        "reference": "Psalms 145:6",
        "verseKey": "kjv:psalms:145:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:145:7",
      "numberLabel": "7",
      "text": "They shall abundantly utter the memory of thy great goodness, and shall sing of thy righteousness.",
      "metadata": {
        "reference": "Psalms 145:7",
        "verseKey": "kjv:psalms:145:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:145:8",
      "numberLabel": "8",
      "text": "The LORD is gracious, and full of compassion; slow to anger, and of great mercy.",
      "metadata": {
        "reference": "Psalms 145:8",
        "verseKey": "kjv:psalms:145:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:145:9",
      "numberLabel": "9",
      "text": "The LORD is good to all: and his tender mercies are over all his works.",
      "metadata": {
        "reference": "Psalms 145:9",
        "verseKey": "kjv:psalms:145:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:145:10",
      "numberLabel": "10",
      "text": "All thy works shall praise thee, O LORD; and thy saints shall bless thee.",
      "metadata": {
        "reference": "Psalms 145:10",
        "verseKey": "kjv:psalms:145:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:145:11",
      "numberLabel": "11",
      "text": "They shall speak of the glory of thy kingdom, and talk of thy power;",
      "metadata": {
        "reference": "Psalms 145:11",
        "verseKey": "kjv:psalms:145:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:145:12",
      "numberLabel": "12",
      "text": "To make known to the sons of men his mighty acts, and the glorious majesty of his kingdom.",
      "metadata": {
        "reference": "Psalms 145:12",
        "verseKey": "kjv:psalms:145:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:145:13",
      "numberLabel": "13",
      "text": "Thy kingdom is an everlasting kingdom, and thy dominion endureth throughout all generations.",
      "metadata": {
        "reference": "Psalms 145:13",
        "verseKey": "kjv:psalms:145:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:145:14",
      "numberLabel": "14",
      "text": "The LORD upholdeth all that fall, and raiseth up all those that be bowed down.",
      "metadata": {
        "reference": "Psalms 145:14",
        "verseKey": "kjv:psalms:145:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:145:15",
      "numberLabel": "15",
      "text": "The eyes of all wait upon thee; and thou givest them their meat in due season.",
      "metadata": {
        "reference": "Psalms 145:15",
        "verseKey": "kjv:psalms:145:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:145:16",
      "numberLabel": "16",
      "text": "Thou openest thine hand, and satisfiest the desire of every living thing.",
      "metadata": {
        "reference": "Psalms 145:16",
        "verseKey": "kjv:psalms:145:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:145:17",
      "numberLabel": "17",
      "text": "The LORD is righteous in all his ways, and holy in all his works.",
      "metadata": {
        "reference": "Psalms 145:17",
        "verseKey": "kjv:psalms:145:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:psalms:145:18",
      "numberLabel": "18",
      "text": "The LORD is nigh unto all them that call upon him, to all that call upon him in truth.",
      "metadata": {
        "reference": "Psalms 145:18",
        "verseKey": "kjv:psalms:145:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:psalms:145:19",
      "numberLabel": "19",
      "text": "He will fulfil the desire of them that fear him: he also will hear their cry, and will save them.",
      "metadata": {
        "reference": "Psalms 145:19",
        "verseKey": "kjv:psalms:145:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:psalms:145:20",
      "numberLabel": "20",
      "text": "The LORD preserveth all them that love him: but all the wicked will he destroy.",
      "metadata": {
        "reference": "Psalms 145:20",
        "verseKey": "kjv:psalms:145:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:psalms:145:21",
      "numberLabel": "21",
      "text": "My mouth shall speak the praise of the LORD: and let all flesh bless his holy name for ever and ever.",
      "metadata": {
        "reference": "Psalms 145:21",
        "verseKey": "kjv:psalms:145:21"
      }
    }
  ],
  "source": {
