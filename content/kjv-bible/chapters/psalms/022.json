  "aliases": [
    "Psalm",
    "Psalms",
    "Ps",
    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:22:1",
      "numberLabel": "1",
      "text": "My God, my God, why hast thou forsaken me? why art thou so far from helping me, and from the words of my roaring?",
      "metadata": {
        "reference": "Psalms 22:1",
        "verseKey": "kjv:psalms:22:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:22:2",
      "numberLabel": "2",
      "text": "O my God, I cry in the day time, but thou hearest not; and in the night season, and am not silent.",
      "metadata": {
        "reference": "Psalms 22:2",
        "verseKey": "kjv:psalms:22:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:22:3",
      "numberLabel": "3",
      "text": "But thou art holy, O thou that inhabitest the praises of Israel.",
      "metadata": {
        "reference": "Psalms 22:3",
        "verseKey": "kjv:psalms:22:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:22:4",
      "numberLabel": "4",
      "text": "Our fathers trusted in thee: they trusted, and thou didst deliver them.",
      "metadata": {
        "reference": "Psalms 22:4",
        "verseKey": "kjv:psalms:22:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:22:5",
      "numberLabel": "5",
      "text": "They cried unto thee, and were delivered: they trusted in thee, and were not confounded.",
      "metadata": {
        "reference": "Psalms 22:5",
        "verseKey": "kjv:psalms:22:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:22:6",
      "numberLabel": "6",
      "text": "But I am a worm, and no man; a reproach of men, and despised of the people.",
      "metadata": {
        "reference": "Psalms 22:6",
        "verseKey": "kjv:psalms:22:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:22:7",
      "numberLabel": "7",
      "text": "All they that see me laugh me to scorn: they shoot out the lip, they shake the head, saying,",
      "metadata": {
        "reference": "Psalms 22:7",
        "verseKey": "kjv:psalms:22:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:22:8",
      "numberLabel": "8",
      "text": "He trusted on the LORD that he would deliver him: let him deliver him, seeing he delighted in him.",
      "metadata": {
        "reference": "Psalms 22:8",
        "verseKey": "kjv:psalms:22:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:22:9",
      "numberLabel": "9",
      "text": "But thou art he that took me out of the womb: thou didst make me hope when I was upon my mother’s breasts.",
      "metadata": {
        "reference": "Psalms 22:9",
        "verseKey": "kjv:psalms:22:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:22:10",
      "numberLabel": "10",
      "text": "I was cast upon thee from the womb: thou art my God from my mother’s belly.",
      "metadata": {
        "reference": "Psalms 22:10",
        "verseKey": "kjv:psalms:22:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:22:11",
      "numberLabel": "11",
      "text": "Be not far from me; for trouble is near; for there is none to help.",
      "metadata": {
        "reference": "Psalms 22:11",
        "verseKey": "kjv:psalms:22:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:22:12",
      "numberLabel": "12",
      "text": "Many bulls have compassed me: strong bulls of Bashan have beset me round.",
      "metadata": {
        "reference": "Psalms 22:12",
        "verseKey": "kjv:psalms:22:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:22:13",
      "numberLabel": "13",
      "text": "They gaped upon me with their mouths, as a ravening and a roaring lion.",
      "metadata": {
        "reference": "Psalms 22:13",
        "verseKey": "kjv:psalms:22:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:22:14",
      "numberLabel": "14",
      "text": "I am poured out like water, and all my bones are out of joint: my heart is like wax; it is melted in the midst of my bowels.",
      "metadata": {
        "reference": "Psalms 22:14",
        "verseKey": "kjv:psalms:22:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:22:15",
      "numberLabel": "15",
      "text": "My strength is dried up like a potsherd; and my tongue cleaveth to my jaws; and thou hast brought me into the dust of death.",
      "metadata": {
        "reference": "Psalms 22:15",
        "verseKey": "kjv:psalms:22:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:22:16",
      "numberLabel": "16",
      "text": "For dogs have compassed me: the assembly of the wicked have inclosed me: they pierced my hands and my feet.",
      "metadata": {
        "reference": "Psalms 22:16",
        "verseKey": "kjv:psalms:22:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:22:17",
      "numberLabel": "17",
      "text": "I may tell all my bones: they look and stare upon me.",
      "metadata": {
        "reference": "Psalms 22:17",
        "verseKey": "kjv:psalms:22:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:psalms:22:18",
      "numberLabel": "18",
      "text": "They part my garments among them, and cast lots upon my vesture.",
      "metadata": {
        "reference": "Psalms 22:18",
        "verseKey": "kjv:psalms:22:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:psalms:22:19",
      "numberLabel": "19",
      "text": "But be not thou far from me, O LORD: O my strength, haste thee to help me.",
      "metadata": {
        "reference": "Psalms 22:19",
        "verseKey": "kjv:psalms:22:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:psalms:22:20",
      "numberLabel": "20",
      "text": "Deliver my soul from the sword; my darling from the power of the dog.",
      "metadata": {
        "reference": "Psalms 22:20",
        "verseKey": "kjv:psalms:22:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:psalms:22:21",
      "numberLabel": "21",
      "text": "Save me from the lion’s mouth: for thou hast heard me from the horns of the unicorns.",
      "metadata": {
        "reference": "Psalms 22:21",
        "verseKey": "kjv:psalms:22:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:psalms:22:22",
      "numberLabel": "22",
      "text": "I will declare thy name unto my brethren: in the midst of the congregation will I praise thee.",
      "metadata": {
        "reference": "Psalms 22:22",
        "verseKey": "kjv:psalms:22:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:psalms:22:23",
      "numberLabel": "23",
      "text": "Ye that fear the LORD, praise him; all ye the seed of Jacob, glorify him; and fear him, all ye the seed of Israel.",
      "metadata": {
        "reference": "Psalms 22:23",
        "verseKey": "kjv:psalms:22:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:psalms:22:24",
      "numberLabel": "24",
      "text": "For he hath not despised nor abhorred the affliction of the afflicted; neither hath he hid his face from him; but when he cried unto him, he heard.",
      "metadata": {
        "reference": "Psalms 22:24",
        "verseKey": "kjv:psalms:22:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:psalms:22:25",
      "numberLabel": "25",
      "text": "My praise shall be of thee in the great congregation: I will pay my vows before them that fear him.",
      "metadata": {
        "reference": "Psalms 22:25",
        "verseKey": "kjv:psalms:22:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:psalms:22:26",
      "numberLabel": "26",
      "text": "The meek shall eat and be satisfied: they shall praise the LORD that seek him: your heart shall live for ever.",
      "metadata": {
        "reference": "Psalms 22:26",
        "verseKey": "kjv:psalms:22:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:psalms:22:27",
      "numberLabel": "27",
      "text": "All the ends of the world shall remember and turn unto the LORD: and all the kindreds of the nations shall worship before thee.",
      "metadata": {
        "reference": "Psalms 22:27",
        "verseKey": "kjv:psalms:22:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:psalms:22:28",
      "numberLabel": "28",
      "text": "For the kingdom is the LORD’s: and he is the governor among the nations.",
      "metadata": {
        "reference": "Psalms 22:28",
        "verseKey": "kjv:psalms:22:28"
      }
    },
    {
      "id": "verse-029",
      "type": "bible_verse",
      "verse": 29,
      "verseId": "kjv:psalms:22:29",
      "numberLabel": "29",
      "text": "All they that be fat upon earth shall eat and worship: all they that go down to the dust shall bow before him: and none can keep alive his own soul.",
      "metadata": {
        "reference": "Psalms 22:29",
        "verseKey": "kjv:psalms:22:29"
      }
    },
    {
      "id": "verse-030",
      "type": "bible_verse",
      "verse": 30,
      "verseId": "kjv:psalms:22:30",
      "numberLabel": "30",
      "text": "A seed shall serve him; it shall be accounted to the Lord for a generation.",
      "metadata": {
        "reference": "Psalms 22:30",
        "verseKey": "kjv:psalms:22:30"
      }
    },
    {
      "id": "verse-031",
      "type": "bible_verse",
      "verse": 31,
      "verseId": "kjv:psalms:22:31",
      "numberLabel": "31",
      "text": "They shall come, and shall declare his righteousness unto a people that shall be born, that he hath done this.",
      "metadata": {
        "reference": "Psalms 22:31",
        "verseKey": "kjv:psalms:22:31"
      }
    }
  ],
