  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:150:1",
      "numberLabel": "1",
      "text": "Praise ye the LORD. Praise God in his sanctuary: praise him in the firmament of his power.",
      "metadata": {
        "reference": "Psalms 150:1",
        "verseKey": "kjv:psalms:150:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:150:2",
      "numberLabel": "2",
      "text": "Praise him for his mighty acts: praise him according to his excellent greatness.",
      "metadata": {
        "reference": "Psalms 150:2",
        "verseKey": "kjv:psalms:150:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:150:3",
      "numberLabel": "3",
      "text": "Praise him with the sound of the trumpet: praise him with the psaltery and harp.",
      "metadata": {
        "reference": "Psalms 150:3",
        "verseKey": "kjv:psalms:150:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:150:4",
      "numberLabel": "4",
      "text": "Praise him with the timbrel and dance: praise him with stringed instruments and organs.",
      "metadata": {
        "reference": "Psalms 150:4",
        "verseKey": "kjv:psalms:150:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:150:5",
      "numberLabel": "5",
      "text": "Praise him upon the loud cymbals: praise him upon the high sounding cymbals.",
      "metadata": {
        "reference": "Psalms 150:5",
        "verseKey": "kjv:psalms:150:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:150:6",
      "numberLabel": "6",
      "text": "Let every thing that hath breath praise the LORD. Praise ye the LORD.",
      "metadata": {
        "reference": "Psalms 150:6",
        "verseKey": "kjv:psalms:150:6"
      }
    }
  ],
