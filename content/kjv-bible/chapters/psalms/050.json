  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:50:1",
      "numberLabel": "1",
      "text": "The mighty God, even the LORD, hath spoken, and called the earth from the rising of the sun unto the going down thereof.",
      "metadata": {
        "reference": "Psalms 50:1",
        "verseKey": "kjv:psalms:50:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:50:2",
      "numberLabel": "2",
      "text": "Out of Zion, the perfection of beauty, God hath shined.",
      "metadata": {
        "reference": "Psalms 50:2",
        "verseKey": "kjv:psalms:50:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:50:3",
      "numberLabel": "3",
      "text": "Our God shall come, and shall not keep silence: a fire shall devour before him, and it shall be very tempestuous round about him.",
      "metadata": {
        "reference": "Psalms 50:3",
        "verseKey": "kjv:psalms:50:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:50:4",
      "numberLabel": "4",
      "text": "He shall call to the heavens from above, and to the earth, that he may judge his people.",
      "metadata": {
        "reference": "Psalms 50:4",
        "verseKey": "kjv:psalms:50:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:50:5",
      "numberLabel": "5",
      "text": "Gather my saints together unto me; those that have made a covenant with me by sacrifice.",
      "metadata": {
        "reference": "Psalms 50:5",
        "verseKey": "kjv:psalms:50:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:50:6",
      "numberLabel": "6",
      "text": "And the heavens shall declare his righteousness: for God is judge himself. Selah.",
      "metadata": {
        "reference": "Psalms 50:6",
        "verseKey": "kjv:psalms:50:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:50:7",
      "numberLabel": "7",
      "text": "Hear, O my people, and I will speak; O Israel, and I will testify against thee: I am God, even thy God.",
      "metadata": {
        "reference": "Psalms 50:7",
        "verseKey": "kjv:psalms:50:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:50:8",
      "numberLabel": "8",
      "text": "I will not reprove thee for thy sacrifices or thy burnt offerings, to have been continually before me.",
      "metadata": {
        "reference": "Psalms 50:8",
        "verseKey": "kjv:psalms:50:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:50:9",
      "numberLabel": "9",
      "text": "I will take no bullock out of thy house, nor he goats out of thy folds.",
      "metadata": {
        "reference": "Psalms 50:9",
        "verseKey": "kjv:psalms:50:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:50:10",
      "numberLabel": "10",
      "text": "For every beast of the forest is mine, and the cattle upon a thousand hills.",
      "metadata": {
        "reference": "Psalms 50:10",
        "verseKey": "kjv:psalms:50:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:50:11",
      "numberLabel": "11",
      "text": "I know all the fowls of the mountains: and the wild beasts of the field are mine.",
      "metadata": {
        "reference": "Psalms 50:11",
        "verseKey": "kjv:psalms:50:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:50:12",
      "numberLabel": "12",
      "text": "If I were hungry, I would not tell thee: for the world is mine, and the fulness thereof.",
      "metadata": {
        "reference": "Psalms 50:12",
        "verseKey": "kjv:psalms:50:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:50:13",
      "numberLabel": "13",
      "text": "Will I eat the flesh of bulls, or drink the blood of goats?",
      "metadata": {
        "reference": "Psalms 50:13",
        "verseKey": "kjv:psalms:50:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:50:14",
      "numberLabel": "14",
      "text": "Offer unto God thanksgiving; and pay thy vows unto the most High:",
      "metadata": {
        "reference": "Psalms 50:14",
        "verseKey": "kjv:psalms:50:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:50:15",
      "numberLabel": "15",
      "text": "And call upon me in the day of trouble: I will deliver thee, and thou shalt glorify me.",
      "metadata": {
        "reference": "Psalms 50:15",
        "verseKey": "kjv:psalms:50:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:50:16",
      "numberLabel": "16",
      "text": "But unto the wicked God saith, What hast thou to do to declare my statutes, or that thou shouldest take my covenant in thy mouth?",
      "metadata": {
        "reference": "Psalms 50:16",
        "verseKey": "kjv:psalms:50:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:50:17",
      "numberLabel": "17",
      "text": "Seeing thou hatest instruction, and casteth my words behind thee.",
      "metadata": {
        "reference": "Psalms 50:17",
        "verseKey": "kjv:psalms:50:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:psalms:50:18",
      "numberLabel": "18",
      "text": "When thou sawest a thief, then thou consentedst with him, and hast been partaker with adulterers.",
      "metadata": {
        "reference": "Psalms 50:18",
        "verseKey": "kjv:psalms:50:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:psalms:50:19",
      "numberLabel": "19",
      "text": "Thou givest thy mouth to evil, and thy tongue frameth deceit.",
      "metadata": {
        "reference": "Psalms 50:19",
        "verseKey": "kjv:psalms:50:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:psalms:50:20",
      "numberLabel": "20",
      "text": "Thou sittest and speakest against thy brother; thou slanderest thine own mother’s son.",
      "metadata": {
        "reference": "Psalms 50:20",
        "verseKey": "kjv:psalms:50:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:psalms:50:21",
      "numberLabel": "21",
      "text": "These things hast thou done, and I kept silence; thou thoughtest that I was altogether such an one as thyself: but I will reprove thee, and set them in order before thine eyes.",
      "metadata": {
        "reference": "Psalms 50:21",
        "verseKey": "kjv:psalms:50:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:psalms:50:22",
      "numberLabel": "22",
      "text": "Now consider this, ye that forget God, lest I tear you in pieces, and there be none to deliver.",
      "metadata": {
        "reference": "Psalms 50:22",
        "verseKey": "kjv:psalms:50:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:psalms:50:23",
      "numberLabel": "23",
      "text": "Whoso offereth praise glorifieth me: and to him that ordereth his conversation aright will I shew the salvation of God.",
      "metadata": {
        "reference": "Psalms 50:23",
        "verseKey": "kjv:psalms:50:23"
      }
    }
  ],
