  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:127:1",
      "numberLabel": "1",
      "text": "Except the LORD build the house, they labour in vain that build it: except the LORD keep the city, the watchman waketh but in vain.",
      "metadata": {
        "reference": "Psalms 127:1",
        "verseKey": "kjv:psalms:127:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:127:2",
      "numberLabel": "2",
      "text": "It is vain for you to rise up early, to sit up late, to eat the bread of sorrows: for so he giveth his beloved sleep.",
      "metadata": {
        "reference": "Psalms 127:2",
        "verseKey": "kjv:psalms:127:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:127:3",
      "numberLabel": "3",
      "text": "Lo, children are an heritage of the LORD: and the fruit of the womb is his reward.",
      "metadata": {
        "reference": "Psalms 127:3",
        "verseKey": "kjv:psalms:127:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:127:4",
      "numberLabel": "4",
      "text": "As arrows are in the hand of a mighty man; so are children of the youth.",
      "metadata": {
        "reference": "Psalms 127:4",
        "verseKey": "kjv:psalms:127:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:127:5",
      "numberLabel": "5",
      "text": "Happy is the man that hath his quiver full of them: they shall not be ashamed, but they shall speak with the enemies in the gate.",
      "metadata": {
        "reference": "Psalms 127:5",
        "verseKey": "kjv:psalms:127:5"
      }
    }
  ],
