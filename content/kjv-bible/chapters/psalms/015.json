  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:15:1",
      "numberLabel": "1",
      "text": "Lord, who shall abide in thy tabernacle? who shall dwell in thy holy hill?",
      "metadata": {
        "reference": "Psalms 15:1",
        "verseKey": "kjv:psalms:15:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:15:2",
      "numberLabel": "2",
      "text": "He that walketh uprightly, and worketh righteousness, and speaketh the truth in his heart.",
      "metadata": {
        "reference": "Psalms 15:2",
        "verseKey": "kjv:psalms:15:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:15:3",
      "numberLabel": "3",
      "text": "He that backbiteth not with his tongue, nor doeth evil to his neighbour, nor taketh up a reproach against his neighbour.",
      "metadata": {
        "reference": "Psalms 15:3",
        "verseKey": "kjv:psalms:15:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:15:4",
      "numberLabel": "4",
      "text": "In whose eyes a vile person is contemned; but he honoureth them that fear the LORD. He that sweareth to his own hurt, and changeth not.",
      "metadata": {
        "reference": "Psalms 15:4",
        "verseKey": "kjv:psalms:15:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:15:5",
      "numberLabel": "5",
      "text": "He that putteth not out his money to usury, nor taketh reward against the innocent. He that doeth these things shall never be moved.",
      "metadata": {
        "reference": "Psalms 15:5",
        "verseKey": "kjv:psalms:15:5"
      }
    }
  ],
