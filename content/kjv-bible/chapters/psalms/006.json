  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:6:1",
      "numberLabel": "1",
      "text": "O LORD, rebuke me not in thine anger, neither chasten me in thy hot displeasure.",
      "metadata": {
        "reference": "Psalms 6:1",
        "verseKey": "kjv:psalms:6:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:6:2",
      "numberLabel": "2",
      "text": "Have mercy upon me, O LORD; for I am weak: O LORD, heal me; for my bones are vexed.",
      "metadata": {
        "reference": "Psalms 6:2",
        "verseKey": "kjv:psalms:6:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:6:3",
      "numberLabel": "3",
      "text": "My soul is also sore vexed: but thou, O LORD, how long?",
      "metadata": {
        "reference": "Psalms 6:3",
        "verseKey": "kjv:psalms:6:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:6:4",
      "numberLabel": "4",
      "text": "Return, O LORD, deliver my soul: oh save me for thy mercies’ sake.",
      "metadata": {
        "reference": "Psalms 6:4",
        "verseKey": "kjv:psalms:6:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:6:5",
      "numberLabel": "5",
      "text": "For in death there is no remembrance of thee: in the grave who shall give thee thanks?",
      "metadata": {
        "reference": "Psalms 6:5",
        "verseKey": "kjv:psalms:6:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:6:6",
      "numberLabel": "6",
      "text": "I am weary with my groaning; all the night make I my bed to swim; I water my couch with my tears.",
      "metadata": {
        "reference": "Psalms 6:6",
        "verseKey": "kjv:psalms:6:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:6:7",
      "numberLabel": "7",
      "text": "Mine eye is consumed because of grief; it waxeth old because of all mine enemies.",
      "metadata": {
        "reference": "Psalms 6:7",
        "verseKey": "kjv:psalms:6:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:6:8",
      "numberLabel": "8",
      "text": "Depart from me, all ye workers of iniquity; for the LORD hath heard the voice of my weeping.",
      "metadata": {
        "reference": "Psalms 6:8",
        "verseKey": "kjv:psalms:6:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:6:9",
      "numberLabel": "9",
      "text": "The LORD hath heard my supplication; the LORD will receive my prayer.",
      "metadata": {
        "reference": "Psalms 6:9",
        "verseKey": "kjv:psalms:6:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:6:10",
      "numberLabel": "10",
      "text": "Let all mine enemies be ashamed and sore vexed: let them return and be ashamed suddenly.",
      "metadata": {
        "reference": "Psalms 6:10",
        "verseKey": "kjv:psalms:6:10"
      }
    }
  ],
  "source": {
