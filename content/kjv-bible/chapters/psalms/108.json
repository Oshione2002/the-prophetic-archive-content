  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:108:1",
      "numberLabel": "1",
      "text": "O God, my heart is fixed; I will sing and give praise, even with my glory.",
      "metadata": {
        "reference": "Psalms 108:1",
        "verseKey": "kjv:psalms:108:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:108:2",
      "numberLabel": "2",
      "text": "Awake, psaltery and harp: I myself will awake early.",
      "metadata": {
        "reference": "Psalms 108:2",
        "verseKey": "kjv:psalms:108:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:108:3",
      "numberLabel": "3",
      "text": "I will praise thee, O LORD, among the people: and I will sing praises unto thee among the nations.",
      "metadata": {
        "reference": "Psalms 108:3",
        "verseKey": "kjv:psalms:108:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:108:4",
      "numberLabel": "4",
      "text": "For thy mercy is great above the heavens: and thy truth reacheth unto the clouds.",
      "metadata": {
        "reference": "Psalms 108:4",
        "verseKey": "kjv:psalms:108:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:108:5",
      "numberLabel": "5",
      "text": "Be thou exalted, O God, above the heavens: and thy glory above all the earth;",
      "metadata": {
        "reference": "Psalms 108:5",
        "verseKey": "kjv:psalms:108:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:108:6",
      "numberLabel": "6",
      "text": "That thy beloved may be delivered: save with thy right hand, and answer me.",
      "metadata": {
        "reference": "Psalms 108:6",
        "verseKey": "kjv:psalms:108:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:108:7",
      "numberLabel": "7",
      "text": "God hath spoken in his holiness; I will rejoice, I will divide Shechem, and mete out the valley of Succoth.",
      "metadata": {
        "reference": "Psalms 108:7",
        "verseKey": "kjv:psalms:108:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:108:8",
      "numberLabel": "8",
      "text": "Gilead is mine; Manasseh is mine; Ephraim also is the strength of mine head; Judah is my lawgiver;",
      "metadata": {
        "reference": "Psalms 108:8",
        "verseKey": "kjv:psalms:108:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:108:9",
      "numberLabel": "9",
      "text": "Moab is my washpot; over Edom will I cast out my shoe; over Philistia will I triumph.",
      "metadata": {
        "reference": "Psalms 108:9",
        "verseKey": "kjv:psalms:108:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:108:10",
      "numberLabel": "10",
      "text": "Who will bring me into the strong city? who will lead me into Edom?",
      "metadata": {
        "reference": "Psalms 108:10",
        "verseKey": "kjv:psalms:108:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:108:11",
      "numberLabel": "11",
      "text": "Wilt not thou, O God, who hast cast us off? and wilt not thou, O God, go forth with our hosts?",
      "metadata": {
        "reference": "Psalms 108:11",
        "verseKey": "kjv:psalms:108:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:108:12",
      "numberLabel": "12",
      "text": "Give us help from trouble: for vain is the help of man.",
      "metadata": {
        "reference": "Psalms 108:12",
        "verseKey": "kjv:psalms:108:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:108:13",
      "numberLabel": "13",
      "text": "Through God we shall do valiantly: for he it is that shall tread down our enemies.",
      "metadata": {
        "reference": "Psalms 108:13",
        "verseKey": "kjv:psalms:108:13"
      }
    }
  ],
  "source": {
