  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:47:1",
      "numberLabel": "1",
      "text": "O clap your hands, all ye people; shout unto God with the voice of triumph.",
      "metadata": {
        "reference": "Psalms 47:1",
        "verseKey": "kjv:psalms:47:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:47:2",
      "numberLabel": "2",
      "text": "For the LORD most high is terrible; he is a great King over all the earth.",
      "metadata": {
        "reference": "Psalms 47:2",
        "verseKey": "kjv:psalms:47:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:47:3",
      "numberLabel": "3",
      "text": "He shall subdue the people under us, and the nations under our feet.",
      "metadata": {
        "reference": "Psalms 47:3",
        "verseKey": "kjv:psalms:47:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:47:4",
      "numberLabel": "4",
      "text": "He shall choose our inheritance for us, the excellency of Jacob whom he loved. Selah.",
      "metadata": {
        "reference": "Psalms 47:4",
        "verseKey": "kjv:psalms:47:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:47:5",
      "numberLabel": "5",
      "text": "God is gone up with a shout, the LORD with the sound of a trumpet.",
      "metadata": {
        "reference": "Psalms 47:5",
        "verseKey": "kjv:psalms:47:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:47:6",
      "numberLabel": "6",
      "text": "Sing praises to God, sing praises: sing praises unto our King, sing praises.",
      "metadata": {
        "reference": "Psalms 47:6",
        "verseKey": "kjv:psalms:47:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:47:7",
      "numberLabel": "7",
      "text": "For God is the King of all the earth: sing ye praises with understanding.",
      "metadata": {
        "reference": "Psalms 47:7",
        "verseKey": "kjv:psalms:47:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:47:8",
      "numberLabel": "8",
      "text": "God reigneth over the heathen: God sitteth upon the throne of his holiness.",
      "metadata": {
        "reference": "Psalms 47:8",
        "verseKey": "kjv:psalms:47:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:47:9",
      "numberLabel": "9",
      "text": "The princes of the people are gathered together, even the people of the God of Abraham: for the shields of the earth belong unto God: he is greatly exalted.",
      "metadata": {
        "reference": "Psalms 47:9",
        "verseKey": "kjv:psalms:47:9"
      }
    }
  ],
