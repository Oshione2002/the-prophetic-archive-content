  "sortOrder": 19091,
  "verseCount": 16,
  "aliases": [
    "Psalm",
    "Psalms",
    "Ps",
    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:91:1",
      "numberLabel": "1",
      "text": "He that dwelleth in the secret place of the most High shall abide under the shadow of the Almighty.",
      "metadata": {
        "reference": "Psalms 91:1",
        "verseKey": "kjv:psalms:91:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:91:2",
      "numberLabel": "2",
      "text": "I will say of the LORD, He is my refuge and my fortress: my God; in him will I trust.",
      "metadata": {
        "reference": "Psalms 91:2",
        "verseKey": "kjv:psalms:91:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:91:3",
      "numberLabel": "3",
      "text": "Surely he shall deliver thee from the snare of the fowler, and from the noisome pestilence.",
      "metadata": {
        "reference": "Psalms 91:3",
        "verseKey": "kjv:psalms:91:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:91:4",
      "numberLabel": "4",
      "text": "He shall cover thee with his feathers, and under his wings shalt thou trust: his truth shall be thy shield and buckler.",
      "metadata": {
        "reference": "Psalms 91:4",
        "verseKey": "kjv:psalms:91:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:91:5",
      "numberLabel": "5",
      "text": "Thou shalt not be afraid for the terror by night; nor for the arrow that flieth by day;",
      "metadata": {
        "reference": "Psalms 91:5",
        "verseKey": "kjv:psalms:91:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:91:6",
      "numberLabel": "6",
      "text": "Nor for the pestilence that walketh in darkness; nor for the destruction that wasteth at noonday.",
      "metadata": {
        "reference": "Psalms 91:6",
        "verseKey": "kjv:psalms:91:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:91:7",
      "numberLabel": "7",
      "text": "A thousand shall fall at thy side, and ten thousand at thy right hand; but it shall not come nigh thee.",
      "metadata": {
        "reference": "Psalms 91:7",
        "verseKey": "kjv:psalms:91:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:91:8",
      "numberLabel": "8",
      "text": "Only with thine eyes shalt thou behold and see the reward of the wicked.",
      "metadata": {
        "reference": "Psalms 91:8",
        "verseKey": "kjv:psalms:91:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:91:9",
      "numberLabel": "9",
      "text": "Because thou hast made the LORD, which is my refuge, even the most High, thy habitation;",
      "metadata": {
        "reference": "Psalms 91:9",
        "verseKey": "kjv:psalms:91:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:91:10",
      "numberLabel": "10",
      "text": "There shall no evil befall thee, neither shall any plague come nigh thy dwelling.",
      "metadata": {
        "reference": "Psalms 91:10",
        "verseKey": "kjv:psalms:91:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:91:11",
      "numberLabel": "11",
      "text": "For he shall give his angels charge over thee, to keep thee in all thy ways.",
      "metadata": {
        "reference": "Psalms 91:11",
        "verseKey": "kjv:psalms:91:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:91:12",
      "numberLabel": "12",
      "text": "They shall bear thee up in their hands, lest thou dash thy foot against a stone.",
      "metadata": {
        "reference": "Psalms 91:12",
        "verseKey": "kjv:psalms:91:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:91:13",
      "numberLabel": "13",
      "text": "Thou shalt tread upon the lion and adder: the young lion and the dragon shalt thou trample under feet.",
      "metadata": {
        "reference": "Psalms 91:13",
        "verseKey": "kjv:psalms:91:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:91:14",
      "numberLabel": "14",
      "text": "Because he hath set his love upon me, therefore will I deliver him: I will set him on high, because he hath known my name.",
      "metadata": {
        "reference": "Psalms 91:14",
        "verseKey": "kjv:psalms:91:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:91:15",
      "numberLabel": "15",
      "text": "He shall call upon me, and I will answer him: I will be with him in trouble; I will deliver him, and honour him.",
      "metadata": {
        "reference": "Psalms 91:15",
        "verseKey": "kjv:psalms:91:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:91:16",
      "numberLabel": "16",
      "text": "With long life will I satisfy him, and shew him my salvation.",
      "metadata": {
        "reference": "Psalms 91:16",
        "verseKey": "kjv:psalms:91:16"
      }
    }
  ],
  "source": {
