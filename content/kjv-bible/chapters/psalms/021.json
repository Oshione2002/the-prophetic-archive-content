  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:21:1",
      "numberLabel": "1",
      "text": "The king shall joy in thy strength, O LORD; and in thy salvation how greatly shall he rejoice!",
      "metadata": {
        "reference": "Psalms 21:1",
        "verseKey": "kjv:psalms:21:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:21:2",
      "numberLabel": "2",
      "text": "Thou hast given him his heart’s desire, and hast not withholden the request of his lips. Selah.",
      "metadata": {
        "reference": "Psalms 21:2",
        "verseKey": "kjv:psalms:21:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:21:3",
      "numberLabel": "3",
      "text": "For thou preventest him with the blessings of goodness: thou settest a crown of pure gold on his head.",
      "metadata": {
        "reference": "Psalms 21:3",
        "verseKey": "kjv:psalms:21:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:21:4",
      "numberLabel": "4",
      "text": "He asked life of thee, and thou gavest it him, even length of days for ever and ever.",
      "metadata": {
        "reference": "Psalms 21:4",
        "verseKey": "kjv:psalms:21:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:21:5",
      "numberLabel": "5",
      "text": "His glory is great in thy salvation: honour and majesty hast thou laid upon him.",
      "metadata": {
        "reference": "Psalms 21:5",
        "verseKey": "kjv:psalms:21:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:21:6",
      "numberLabel": "6",
      "text": "For thou hast made him most blessed for ever: thou hast made him exceeding glad with thy countenance.",
      "metadata": {
        "reference": "Psalms 21:6",
        "verseKey": "kjv:psalms:21:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:21:7",
      "numberLabel": "7",
      "text": "For the king trusteth in the LORD, and through the mercy of the most High he shall not be moved.",
      "metadata": {
        "reference": "Psalms 21:7",
        "verseKey": "kjv:psalms:21:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:21:8",
      "numberLabel": "8",
      "text": "Thine hand shall find out all thine enemies: thy right hand shall find out those that hate thee.",
      "metadata": {
        "reference": "Psalms 21:8",
        "verseKey": "kjv:psalms:21:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:21:9",
      "numberLabel": "9",
      "text": "Thou shalt make them as a fiery oven in the time of thine anger: the LORD shall swallow them up in his wrath, and the fire shall devour them.",
      "metadata": {
        "reference": "Psalms 21:9",
        "verseKey": "kjv:psalms:21:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:21:10",
      "numberLabel": "10",
      "text": "Their fruit shalt thou destroy from the earth, and their seed from among the children of men.",
      "metadata": {
        "reference": "Psalms 21:10",
        "verseKey": "kjv:psalms:21:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:21:11",
      "numberLabel": "11",
      "text": "For they intended evil against thee: they imagined a mischievous device, which they are not able to perform.",
      "metadata": {
        "reference": "Psalms 21:11",
        "verseKey": "kjv:psalms:21:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:21:12",
      "numberLabel": "12",
      "text": "Therefore shalt thou make them turn their back, when thou shalt make ready thine arrows upon thy strings against the face of them.",
      "metadata": {
        "reference": "Psalms 21:12",
        "verseKey": "kjv:psalms:21:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:21:13",
      "numberLabel": "13",
      "text": "Be thou exalted, LORD, in thine own strength: so will we sing and praise thy power.",
      "metadata": {
        "reference": "Psalms 21:13",
        "verseKey": "kjv:psalms:21:13"
      }
    }
  ],
  "source": {
