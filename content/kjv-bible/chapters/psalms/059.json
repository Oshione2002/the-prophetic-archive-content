  "document_type": "bible_chapter",
  "number": 59,
  "title": "Psalms 59",
  "display_title": "Psalms 59",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "psalms",
  "book": "Psalms",
  "bookName": "Psalms",
