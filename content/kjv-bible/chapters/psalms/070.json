  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:70:1",
      "numberLabel": "1",
      "text": "MAKE HASTE, O GOD, TO DELIVER ME; MAKE HASTE TO HELP ME, O LORD.",
      "metadata": {
        "reference": "Psalms 70:1",
        "verseKey": "kjv:psalms:70:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:70:2",
      "numberLabel": "2",
      "text": "Let them be ashamed and confounded that seek after my soul: let them be turned backward, and put to confusion, that desire my hurt.",
      "metadata": {
        "reference": "Psalms 70:2",
        "verseKey": "kjv:psalms:70:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:70:3",
      "numberLabel": "3",
      "text": "Let them be turned back for a reward of their shame that say, Aha, aha.",
      "metadata": {
        "reference": "Psalms 70:3",
        "verseKey": "kjv:psalms:70:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:70:4",
      "numberLabel": "4",
      "text": "Let all those that seek thee rejoice and be glad in thee: and let such as love thy salvation say continually, Let God be magnified.",
      "metadata": {
        "reference": "Psalms 70:4",
        "verseKey": "kjv:psalms:70:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:70:5",
      "numberLabel": "5",
      "text": "But I am poor and needy: make haste unto me, O God: thou art my help and my deliverer; O LORD, make no tarrying.",
      "metadata": {
        "reference": "Psalms 70:5",
        "verseKey": "kjv:psalms:70:5"
      }
    }
  ],
