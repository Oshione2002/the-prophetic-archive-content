  "aliases": [
    "Psalm",
    "Psalms",
    "Ps",
    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:147:1",
      "numberLabel": "1",
      "text": "Praise ye the LORD: for it is good to sing praises unto our God; for it is pleasant; and praise is comely.",
      "metadata": {
        "reference": "Psalms 147:1",
        "verseKey": "kjv:psalms:147:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:147:2",
      "numberLabel": "2",
      "text": "The LORD doth build up Jerusalem: he gathereth together the outcasts of Israel.",
      "metadata": {
        "reference": "Psalms 147:2",
        "verseKey": "kjv:psalms:147:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:147:3",
      "numberLabel": "3",
      "text": "He healeth the broken in heart, and bindeth up their wounds.",
      "metadata": {
        "reference": "Psalms 147:3",
        "verseKey": "kjv:psalms:147:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:147:4",
      "numberLabel": "4",
      "text": "He telleth the number of the stars; he calleth them all by their names.",
      "metadata": {
        "reference": "Psalms 147:4",
        "verseKey": "kjv:psalms:147:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:147:5",
      "numberLabel": "5",
      "text": "Great is our Lord, and of great power: his understanding is infinite.",
      "metadata": {
        "reference": "Psalms 147:5",
        "verseKey": "kjv:psalms:147:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:147:6",
      "numberLabel": "6",
      "text": "The LORD lifteth up the meek: he casteth the wicked down to the ground.",
      "metadata": {
        "reference": "Psalms 147:6",
        "verseKey": "kjv:psalms:147:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:147:7",
      "numberLabel": "7",
      "text": "Sing unto the LORD with thanksgiving; sing praise upon the harp unto our God:",
      "metadata": {
        "reference": "Psalms 147:7",
        "verseKey": "kjv:psalms:147:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:147:8",
      "numberLabel": "8",
      "text": "Who covereth the heaven with clouds, who prepareth rain for the earth, who maketh grass to grow upon the mountains.",
      "metadata": {
        "reference": "Psalms 147:8",
        "verseKey": "kjv:psalms:147:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:147:9",
      "numberLabel": "9",
      "text": "He giveth to the beast his food, and to the young ravens which cry.",
      "metadata": {
        "reference": "Psalms 147:9",
        "verseKey": "kjv:psalms:147:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:147:10",
      "numberLabel": "10",
      "text": "He delighteth not in the strength of the horse: he taketh not pleasure in the legs of a man.",
      "metadata": {
        "reference": "Psalms 147:10",
        "verseKey": "kjv:psalms:147:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:147:11",
      "numberLabel": "11",
      "text": "The LORD taketh pleasure in them that fear him, in those that hope in his mercy.",
      "metadata": {
        "reference": "Psalms 147:11",
        "verseKey": "kjv:psalms:147:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:147:12",
      "numberLabel": "12",
      "text": "Praise the LORD, O Jerusalem; praise thy God, O Zion.",
      "metadata": {
        "reference": "Psalms 147:12",
        "verseKey": "kjv:psalms:147:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:147:13",
      "numberLabel": "13",
      "text": "For he hath strengthened the bars of thy gates; he hath blessed thy children within thee.",
      "metadata": {
        "reference": "Psalms 147:13",
        "verseKey": "kjv:psalms:147:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:147:14",
      "numberLabel": "14",
      "text": "He maketh peace in thy borders, and filleth thee with the finest of the wheat.",
      "metadata": {
        "reference": "Psalms 147:14",
        "verseKey": "kjv:psalms:147:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:147:15",
      "numberLabel": "15",
      "text": "He sendeth forth his commandment upon earth: his word runneth very swiftly.",
      "metadata": {
        "reference": "Psalms 147:15",
        "verseKey": "kjv:psalms:147:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:147:16",
      "numberLabel": "16",
      "text": "He giveth snow like wool: he scattereth the hoarfrost like ashes.",
      "metadata": {
        "reference": "Psalms 147:16",
        "verseKey": "kjv:psalms:147:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:147:17",
      "numberLabel": "17",
      "text": "He casteth forth his ice like morsels: who can stand before his cold?",
      "metadata": {
        "reference": "Psalms 147:17",
        "verseKey": "kjv:psalms:147:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:psalms:147:18",
      "numberLabel": "18",
      "text": "He sendeth out his word, and melteth them: he causeth his wind to blow, and the waters flow.",
      "metadata": {
        "reference": "Psalms 147:18",
        "verseKey": "kjv:psalms:147:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:psalms:147:19",
      "numberLabel": "19",
      "text": "He sheweth his word unto Jacob, his statutes and his judgments unto Israel.",
      "metadata": {
        "reference": "Psalms 147:19",
        "verseKey": "kjv:psalms:147:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:psalms:147:20",
      "numberLabel": "20",
      "text": "He hath not dealt so with any nation: and as for his judgments, they have not known them. Praise ye the LORD.",
      "metadata": {
        "reference": "Psalms 147:20",
        "verseKey": "kjv:psalms:147:20"
      }
    }
  ],
  "source": {
