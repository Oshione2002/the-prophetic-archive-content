  "aliases": [
    "Psalm",
    "Psalms",
    "Ps",
    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:56:1",
      "numberLabel": "1",
      "text": "Be merciful unto me, O God: for man would swallow me up; he fighting daily oppresseth me.",
      "metadata": {
        "reference": "Psalms 56:1",
        "verseKey": "kjv:psalms:56:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:56:2",
      "numberLabel": "2",
      "text": "Mine enemies would daily swallow me up: for they be many that fight against me, O thou most High.",
      "metadata": {
        "reference": "Psalms 56:2",
        "verseKey": "kjv:psalms:56:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:56:3",
      "numberLabel": "3",
      "text": "What time I am afraid, I will trust in thee.",
      "metadata": {
        "reference": "Psalms 56:3",
        "verseKey": "kjv:psalms:56:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:56:4",
      "numberLabel": "4",
      "text": "In God I will praise his word, in God I have put my trust; I will not fear what flesh can do unto me.",
      "metadata": {
        "reference": "Psalms 56:4",
        "verseKey": "kjv:psalms:56:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:56:5",
      "numberLabel": "5",
      "text": "Every day they wrest my words: all their thoughts are against me for evil.",
      "metadata": {
        "reference": "Psalms 56:5",
        "verseKey": "kjv:psalms:56:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:56:6",
      "numberLabel": "6",
      "text": "They gather themselves together, they hide themselves, they mark my steps, when they wait for my soul.",
      "metadata": {
        "reference": "Psalms 56:6",
        "verseKey": "kjv:psalms:56:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:56:7",
      "numberLabel": "7",
      "text": "Shall they escape by iniquity? in thine anger cast down the people, O God.",
      "metadata": {
        "reference": "Psalms 56:7",
        "verseKey": "kjv:psalms:56:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:56:8",
      "numberLabel": "8",
      "text": "Thou tellest my wanderings: put thou my tears into thy bottle: are they not in thy book?",
      "metadata": {
        "reference": "Psalms 56:8",
        "verseKey": "kjv:psalms:56:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:56:9",
      "numberLabel": "9",
      "text": "When I cry unto thee, then shall mine enemies turn back: this I know; for God is for me.",
      "metadata": {
        "reference": "Psalms 56:9",
        "verseKey": "kjv:psalms:56:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:56:10",
      "numberLabel": "10",
      "text": "In God will I praise his word: in the LORD will I praise his word.",
      "metadata": {
        "reference": "Psalms 56:10",
        "verseKey": "kjv:psalms:56:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:56:11",
      "numberLabel": "11",
      "text": "In God have I put my trust: I will not be afraid what man can do unto me.",
      "metadata": {
        "reference": "Psalms 56:11",
        "verseKey": "kjv:psalms:56:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:56:12",
      "numberLabel": "12",
      "text": "Thy vows are upon me, O God: I will render praises unto thee.",
      "metadata": {
        "reference": "Psalms 56:12",
        "verseKey": "kjv:psalms:56:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:56:13",
      "numberLabel": "13",
      "text": "For thou hast delivered my soul from death: wilt not thou deliver my feet from falling, that I may walk before God in the light of the living?",
      "metadata": {
        "reference": "Psalms 56:13",
        "verseKey": "kjv:psalms:56:13"
      }
    }
  ],
  "source": {
