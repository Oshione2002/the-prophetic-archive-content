  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:100:1",
      "numberLabel": "1",
      "text": "Make a joyful noise unto the LORD, all ye lands.",
      "metadata": {
        "reference": "Psalms 100:1",
        "verseKey": "kjv:psalms:100:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:100:2",
      "numberLabel": "2",
      "text": "Serve the LORD with gladness: come before his presence with singing.",
      "metadata": {
        "reference": "Psalms 100:2",
        "verseKey": "kjv:psalms:100:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:100:3",
      "numberLabel": "3",
      "text": "Know ye that the LORD he is God: it is he that hath made us, and not we ourselves; we are his people, and the sheep of his pasture.",
      "metadata": {
        "reference": "Psalms 100:3",
        "verseKey": "kjv:psalms:100:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:100:4",
      "numberLabel": "4",
      "text": "Enter into his gates with thanksgiving, and into his courts with praise: be thankful unto him, and bless his name.",
      "metadata": {
        "reference": "Psalms 100:4",
        "verseKey": "kjv:psalms:100:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:100:5",
      "numberLabel": "5",
      "text": "For the LORD is good; his mercy is everlasting; and his truth endureth to all generations.",
      "metadata": {
        "reference": "Psalms 100:5",
        "verseKey": "kjv:psalms:100:5"
      }
    }
  ],
