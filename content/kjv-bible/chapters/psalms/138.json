  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:138:1",
      "numberLabel": "1",
      "text": "I will praise thee with my whole heart: before the gods will I sing praise unto thee.",
      "metadata": {
        "reference": "Psalms 138:1",
        "verseKey": "kjv:psalms:138:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:138:2",
      "numberLabel": "2",
      "text": "I will worship toward thy holy temple, and praise thy name for thy lovingkindness and for thy truth: for thou hast magnified thy word above all thy name.",
      "metadata": {
        "reference": "Psalms 138:2",
        "verseKey": "kjv:psalms:138:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:138:3",
      "numberLabel": "3",
      "text": "In the day when I cried thou answeredst me, and strengthenedst me with strength in my soul.",
      "metadata": {
        "reference": "Psalms 138:3",
        "verseKey": "kjv:psalms:138:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:138:4",
      "numberLabel": "4",
      "text": "All the kings of the earth shall praise thee, O LORD, when they hear the words of thy mouth.",
      "metadata": {
        "reference": "Psalms 138:4",
        "verseKey": "kjv:psalms:138:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:138:5",
      "numberLabel": "5",
      "text": "Yea, they shall sing in the ways of the LORD: for great is the glory of the LORD.",
      "metadata": {
        "reference": "Psalms 138:5",
        "verseKey": "kjv:psalms:138:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:138:6",
      "numberLabel": "6",
      "text": "Though the LORD be high, yet hath he respect unto the lowly: but the proud he knoweth afar off.",
      "metadata": {
        "reference": "Psalms 138:6",
        "verseKey": "kjv:psalms:138:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:138:7",
      "numberLabel": "7",
      "text": "Though I walk in the midst of trouble, thou wilt revive me: thou shalt stretch forth thine hand against the wrath of mine enemies, and thy right hand shall save me.",
      "metadata": {
        "reference": "Psalms 138:7",
        "verseKey": "kjv:psalms:138:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:138:8",
      "numberLabel": "8",
      "text": "The LORD will perfect that which concerneth me: thy mercy, O LORD, endureth for ever: forsake not the works of thine own hands.",
      "metadata": {
        "reference": "Psalms 138:8",
        "verseKey": "kjv:psalms:138:8"
      }
    }
  ],
