  "testament": "old",
  "chapter": 116,
  "sortOrder": 19116,
  "verseCount": 19,
  "aliases": [
    "Psalm",
    "Psalms",
    "Ps",
    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:116:1",
      "numberLabel": "1",
      "text": "I love the LORD, because he hath heard my voice and my supplications.",
      "metadata": {
        "reference": "Psalms 116:1",
        "verseKey": "kjv:psalms:116:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:116:2",
      "numberLabel": "2",
      "text": "Because he hath inclined his ear unto me, therefore will I call upon him as long as I live.",
      "metadata": {
        "reference": "Psalms 116:2",
        "verseKey": "kjv:psalms:116:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:116:3",
      "numberLabel": "3",
      "text": "The sorrows of death compassed me, and the pains of hell gat hold upon me: I found trouble and sorrow.",
      "metadata": {
        "reference": "Psalms 116:3",
        "verseKey": "kjv:psalms:116:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:116:4",
      "numberLabel": "4",
      "text": "Then called I upon the name of the LORD; O LORD, I beseech thee, deliver my soul.",
      "metadata": {
        "reference": "Psalms 116:4",
        "verseKey": "kjv:psalms:116:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:116:5",
      "numberLabel": "5",
      "text": "Gracious is the LORD, and righteous; yea, our God is merciful.",
      "metadata": {
        "reference": "Psalms 116:5",
        "verseKey": "kjv:psalms:116:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:116:6",
      "numberLabel": "6",
      "text": "The LORD preserveth the simple: I was brought low, and he helped me.",
      "metadata": {
        "reference": "Psalms 116:6",
        "verseKey": "kjv:psalms:116:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:116:7",
      "numberLabel": "7",
      "text": "Return unto thy rest, O my soul; for the LORD hath dealt bountifully with thee.",
      "metadata": {
        "reference": "Psalms 116:7",
        "verseKey": "kjv:psalms:116:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:116:8",
      "numberLabel": "8",
      "text": "For thou hast delivered my soul from death, mine eyes from tears, and my feet from falling.",
      "metadata": {
        "reference": "Psalms 116:8",
        "verseKey": "kjv:psalms:116:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:116:9",
      "numberLabel": "9",
      "text": "I will walk before the LORD in the land of the living.",
      "metadata": {
        "reference": "Psalms 116:9",
        "verseKey": "kjv:psalms:116:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:116:10",
      "numberLabel": "10",
      "text": "I believed, therefore have I spoken: I was greatly afflicted:",
      "metadata": {
        "reference": "Psalms 116:10",
        "verseKey": "kjv:psalms:116:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:116:11",
      "numberLabel": "11",
      "text": "I said in my haste, All men are liars.",
      "metadata": {
        "reference": "Psalms 116:11",
        "verseKey": "kjv:psalms:116:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:116:12",
      "numberLabel": "12",
      "text": "What shall I render unto the LORD for all his benefits toward me?",
      "metadata": {
        "reference": "Psalms 116:12",
        "verseKey": "kjv:psalms:116:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:116:13",
      "numberLabel": "13",
      "text": "I will take the cup of salvation, and call upon the name of the LORD.",
      "metadata": {
        "reference": "Psalms 116:13",
        "verseKey": "kjv:psalms:116:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:116:14",
      "numberLabel": "14",
      "text": "I will pay my vows unto the LORD now in the presence of all his people.",
      "metadata": {
        "reference": "Psalms 116:14",
        "verseKey": "kjv:psalms:116:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:116:15",
      "numberLabel": "15",
      "text": "Precious in the sight of the LORD is the death of his saints.",
      "metadata": {
        "reference": "Psalms 116:15",
        "verseKey": "kjv:psalms:116:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:116:16",
      "numberLabel": "16",
      "text": "O LORD, truly I am thy servant; I am thy servant, and the son of thine handmaid: thou hast loosed my bonds.",
      "metadata": {
        "reference": "Psalms 116:16",
        "verseKey": "kjv:psalms:116:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:116:17",
      "numberLabel": "17",
      "text": "I will offer to thee the sacrifice of thanksgiving, and will call upon the name of the LORD.",
      "metadata": {
        "reference": "Psalms 116:17",
        "verseKey": "kjv:psalms:116:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:psalms:116:18",
      "numberLabel": "18",
      "text": "I will pay my vows unto the LORD now in the presence of all his people,",
      "metadata": {
        "reference": "Psalms 116:18",
        "verseKey": "kjv:psalms:116:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:psalms:116:19",
      "numberLabel": "19",
      "text": "In the courts of the LORD’s house, in the midst of thee, O Jerusalem. Praise ye the LORD.",
      "metadata": {
        "reference": "Psalms 116:19",
        "verseKey": "kjv:psalms:116:19"
      }
    }
  ],
  "source": {
