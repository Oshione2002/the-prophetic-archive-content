  "testament": "old",
  "chapter": 135,
  "sortOrder": 19135,
  "verseCount": 21,
  "aliases": [
    "Psalm",
    "Psalms",
    "Ps",
    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:135:1",
      "numberLabel": "1",
      "text": "Praise ye the LORD. Praise ye the name of the LORD; praise him, O ye servants of the LORD.",
      "metadata": {
        "reference": "Psalms 135:1",
        "verseKey": "kjv:psalms:135:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:135:2",
      "numberLabel": "2",
      "text": "Ye that stand in the house of the LORD, in the courts of the house of our God,",
      "metadata": {
        "reference": "Psalms 135:2",
        "verseKey": "kjv:psalms:135:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:135:3",
      "numberLabel": "3",
      "text": "Praise the LORD; for the LORD is good: sing praises unto his name; for it is pleasant.",
      "metadata": {
        "reference": "Psalms 135:3",
        "verseKey": "kjv:psalms:135:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:135:4",
      "numberLabel": "4",
      "text": "For the LORD hath chosen Jacob unto himself, and Israel for his peculiar treasure.",
      "metadata": {
        "reference": "Psalms 135:4",
        "verseKey": "kjv:psalms:135:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:135:5",
      "numberLabel": "5",
      "text": "For I know that the LORD is great, and that our Lord is above all gods.",
      "metadata": {
        "reference": "Psalms 135:5",
        "verseKey": "kjv:psalms:135:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:135:6",
      "numberLabel": "6",
      "text": "Whatsoever the LORD pleased, that did he in heaven, and in earth, in the seas, and all deep places.",
      "metadata": {
        "reference": "Psalms 135:6",
        "verseKey": "kjv:psalms:135:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:135:7",
      "numberLabel": "7",
      "text": "He causeth the vapours to ascend from the ends of the earth; he maketh lightnings for the rain; he bringeth the wind out of his treasuries.",
      "metadata": {
        "reference": "Psalms 135:7",
        "verseKey": "kjv:psalms:135:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:135:8",
      "numberLabel": "8",
      "text": "Who smote the firstborn of Egypt, both of man and beast.",
      "metadata": {
        "reference": "Psalms 135:8",
        "verseKey": "kjv:psalms:135:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:135:9",
      "numberLabel": "9",
      "text": "Who sent tokens and wonders into the midst of thee, O Egypt, upon Pharaoh, and upon all his servants.",
      "metadata": {
        "reference": "Psalms 135:9",
        "verseKey": "kjv:psalms:135:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:135:10",
      "numberLabel": "10",
      "text": "Who smote great nations, and slew mighty kings;",
      "metadata": {
        "reference": "Psalms 135:10",
        "verseKey": "kjv:psalms:135:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:135:11",
      "numberLabel": "11",
      "text": "Sihon king of the Amorites, and Og king of Bashan, and all the kingdoms of Canaan:",
      "metadata": {
        "reference": "Psalms 135:11",
        "verseKey": "kjv:psalms:135:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:135:12",
      "numberLabel": "12",
      "text": "And gave their land for an heritage, an heritage unto Israel his people.",
      "metadata": {
        "reference": "Psalms 135:12",
        "verseKey": "kjv:psalms:135:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:135:13",
      "numberLabel": "13",
      "text": "Thy name, O LORD, endureth for ever; and thy memorial, O LORD, throughout all generations.",
      "metadata": {
        "reference": "Psalms 135:13",
        "verseKey": "kjv:psalms:135:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:135:14",
      "numberLabel": "14",
      "text": "For the LORD will judge his people, and he will repent himself concerning his servants.",
      "metadata": {
        "reference": "Psalms 135:14",
        "verseKey": "kjv:psalms:135:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:135:15",
      "numberLabel": "15",
      "text": "The idols of the heathen are silver and gold, the work of men’s hands.",
      "metadata": {
        "reference": "Psalms 135:15",
        "verseKey": "kjv:psalms:135:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:135:16",
      "numberLabel": "16",
      "text": "They have mouths, but they speak not; eyes have they, but they see not;",
      "metadata": {
        "reference": "Psalms 135:16",
        "verseKey": "kjv:psalms:135:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:135:17",
      "numberLabel": "17",
      "text": "They have ears, but they hear not; neither is there any breath in their mouths.",
      "metadata": {
        "reference": "Psalms 135:17",
        "verseKey": "kjv:psalms:135:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:psalms:135:18",
      "numberLabel": "18",
      "text": "They that make them are like unto them: so is every one that trusteth in them.",
      "metadata": {
        "reference": "Psalms 135:18",
        "verseKey": "kjv:psalms:135:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:psalms:135:19",
      "numberLabel": "19",
      "text": "Bless the LORD, O house of Israel: bless the LORD, O house of Aaron:",
      "metadata": {
        "reference": "Psalms 135:19",
        "verseKey": "kjv:psalms:135:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:psalms:135:20",
      "numberLabel": "20",
      "text": "Bless the LORD, O house of Levi: ye that fear the LORD, bless the LORD.",
      "metadata": {
        "reference": "Psalms 135:20",
        "verseKey": "kjv:psalms:135:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:psalms:135:21",
      "numberLabel": "21",
      "text": "Blessed be the LORD out of Zion, which dwelleth at Jerusalem. Praise ye the LORD.",
      "metadata": {
        "reference": "Psalms 135:21",
        "verseKey": "kjv:psalms:135:21"
      }
    }
  ],
