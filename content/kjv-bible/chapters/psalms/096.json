  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:96:1",
      "numberLabel": "1",
      "text": "O sing unto the LORD a new song: sing unto the LORD, all the earth.",
      "metadata": {
        "reference": "Psalms 96:1",
        "verseKey": "kjv:psalms:96:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:96:2",
      "numberLabel": "2",
      "text": "Sing unto the LORD, bless his name; shew forth his salvation from day to day.",
      "metadata": {
        "reference": "Psalms 96:2",
        "verseKey": "kjv:psalms:96:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:96:3",
      "numberLabel": "3",
      "text": "Declare his glory among the heathen, his wonders among all people.",
      "metadata": {
        "reference": "Psalms 96:3",
        "verseKey": "kjv:psalms:96:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:96:4",
      "numberLabel": "4",
      "text": "For the LORD is great, and greatly to be praised: he is to be feared above all gods.",
      "metadata": {
        "reference": "Psalms 96:4",
        "verseKey": "kjv:psalms:96:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:96:5",
      "numberLabel": "5",
      "text": "For all the gods of the nations are idols: but the LORD made the heavens.",
      "metadata": {
        "reference": "Psalms 96:5",
        "verseKey": "kjv:psalms:96:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:96:6",
      "numberLabel": "6",
      "text": "Honour and majesty are before him: strength and beauty are in his sanctuary.",
      "metadata": {
        "reference": "Psalms 96:6",
        "verseKey": "kjv:psalms:96:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:96:7",
      "numberLabel": "7",
      "text": "Give unto the LORD, O ye kindreds of the people, give unto the LORD glory and strength.",
      "metadata": {
        "reference": "Psalms 96:7",
        "verseKey": "kjv:psalms:96:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:96:8",
      "numberLabel": "8",
      "text": "Give unto the LORD the glory due unto his name: bring an offering, and come into his courts.",
      "metadata": {
        "reference": "Psalms 96:8",
        "verseKey": "kjv:psalms:96:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:96:9",
      "numberLabel": "9",
      "text": "O worship the LORD in the beauty of holiness: fear before him, all the earth.",
      "metadata": {
        "reference": "Psalms 96:9",
        "verseKey": "kjv:psalms:96:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:96:10",
      "numberLabel": "10",
      "text": "Say among the heathen that the LORD reigneth: the world also shall be established that it shall not be moved: he shall judge the people righteously.",
      "metadata": {
        "reference": "Psalms 96:10",
        "verseKey": "kjv:psalms:96:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:96:11",
      "numberLabel": "11",
      "text": "Let the heavens rejoice, and let the earth be glad; let the sea roar, and the fulness thereof.",
      "metadata": {
        "reference": "Psalms 96:11",
        "verseKey": "kjv:psalms:96:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:96:12",
      "numberLabel": "12",
      "text": "Let the field be joyful, and all that is therein: then shall all the trees of the wood rejoice",
      "metadata": {
        "reference": "Psalms 96:12",
        "verseKey": "kjv:psalms:96:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:96:13",
      "numberLabel": "13",
      "text": "Before the LORD: for he cometh, for he cometh to judge the earth: he shall judge the world with righteousness, and the people with his truth.",
      "metadata": {
        "reference": "Psalms 96:13",
        "verseKey": "kjv:psalms:96:13"
      }
    }
  ],
  "source": {
