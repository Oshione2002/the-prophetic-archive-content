    "Ps",
    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:38:1",
      "numberLabel": "1",
      "text": "O LORD, rebuke me not in thy wrath: neither chasten me in thy hot displeasure.",
      "metadata": {
        "reference": "Psalms 38:1",
        "verseKey": "kjv:psalms:38:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:38:2",
      "numberLabel": "2",
      "text": "For thine arrows stick fast in me, and thy hand presseth me sore.",
      "metadata": {
        "reference": "Psalms 38:2",
        "verseKey": "kjv:psalms:38:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:38:3",
      "numberLabel": "3",
      "text": "There is no soundness in my flesh because of thine anger; neither is there any rest in my bones because of my sin.",
      "metadata": {
        "reference": "Psalms 38:3",
        "verseKey": "kjv:psalms:38:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:38:4",
      "numberLabel": "4",
      "text": "For mine iniquities are gone over mine head: as an heavy burden they are too heavy for me.",
      "metadata": {
        "reference": "Psalms 38:4",
        "verseKey": "kjv:psalms:38:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:38:5",
      "numberLabel": "5",
      "text": "My wounds stink and are corrupt because of my foolishness.",
      "metadata": {
        "reference": "Psalms 38:5",
        "verseKey": "kjv:psalms:38:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:38:6",
      "numberLabel": "6",
      "text": "I am troubled; I am bowed down greatly; I go mourning all the day long.",
      "metadata": {
        "reference": "Psalms 38:6",
        "verseKey": "kjv:psalms:38:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:38:7",
      "numberLabel": "7",
      "text": "For my loins are filled with a loathsome disease: and there is no soundness in my flesh.",
      "metadata": {
        "reference": "Psalms 38:7",
        "verseKey": "kjv:psalms:38:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:38:8",
      "numberLabel": "8",
      "text": "I am feeble and sore broken: I have roared by reason of the disquietness of my heart.",
      "metadata": {
        "reference": "Psalms 38:8",
        "verseKey": "kjv:psalms:38:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:38:9",
      "numberLabel": "9",
      "text": "Lord, all my desire is before thee; and my groaning is not hid from thee.",
      "metadata": {
        "reference": "Psalms 38:9",
        "verseKey": "kjv:psalms:38:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:38:10",
      "numberLabel": "10",
      "text": "My heart panteth, my strength faileth me: as for the light of mine eyes, it also is gone from me.",
      "metadata": {
        "reference": "Psalms 38:10",
        "verseKey": "kjv:psalms:38:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:38:11",
      "numberLabel": "11",
      "text": "My lovers and my friends stand aloof from my sore; and my kinsmen stand afar off.",
      "metadata": {
        "reference": "Psalms 38:11",
        "verseKey": "kjv:psalms:38:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:38:12",
      "numberLabel": "12",
      "text": "They also that seek after my life lay snares for me: and they that seek my hurt speak mischievous things, and imagine deceits all the day long.",
      "metadata": {
        "reference": "Psalms 38:12",
        "verseKey": "kjv:psalms:38:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:38:13",
      "numberLabel": "13",
      "text": "But I, as a deaf man, heard not; and I was as a dumb man that openeth not his mouth.",
      "metadata": {
        "reference": "Psalms 38:13",
        "verseKey": "kjv:psalms:38:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:38:14",
      "numberLabel": "14",
      "text": "Thus I was as a man that heareth not, and in whose mouth are no reproofs.",
      "metadata": {
        "reference": "Psalms 38:14",
        "verseKey": "kjv:psalms:38:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:38:15",
      "numberLabel": "15",
      "text": "For in thee, O LORD, do I hope: thou wilt hear, O Lord my God.",
      "metadata": {
        "reference": "Psalms 38:15",
        "verseKey": "kjv:psalms:38:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:38:16",
      "numberLabel": "16",
      "text": "For I said, Hear me, lest otherwise they should rejoice over me: when my foot slippeth, they magnify themselves against me.",
      "metadata": {
        "reference": "Psalms 38:16",
        "verseKey": "kjv:psalms:38:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:38:17",
      "numberLabel": "17",
      "text": "For I am ready to halt, and my sorrow is continually before me.",
      "metadata": {
        "reference": "Psalms 38:17",
        "verseKey": "kjv:psalms:38:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:psalms:38:18",
      "numberLabel": "18",
      "text": "For I will declare mine iniquity; I will be sorry for my sin.",
      "metadata": {
        "reference": "Psalms 38:18",
        "verseKey": "kjv:psalms:38:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:psalms:38:19",
      "numberLabel": "19",
      "text": "But mine enemies are lively, and they are strong: and they that hate me wrongfully are multiplied.",
      "metadata": {
        "reference": "Psalms 38:19",
        "verseKey": "kjv:psalms:38:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:psalms:38:20",
      "numberLabel": "20",
      "text": "They also that render evil for good are mine adversaries; because I follow the thing that good is.",
      "metadata": {
        "reference": "Psalms 38:20",
        "verseKey": "kjv:psalms:38:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:psalms:38:21",
      "numberLabel": "21",
      "text": "Forsake me not, O LORD: O my God, be not far from me.",
      "metadata": {
        "reference": "Psalms 38:21",
        "verseKey": "kjv:psalms:38:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:psalms:38:22",
      "numberLabel": "22",
      "text": "Make haste to help me, O Lord my salvation.",
      "metadata": {
        "reference": "Psalms 38:22",
        "verseKey": "kjv:psalms:38:22"
      }
    }
  ],
  "source": {
