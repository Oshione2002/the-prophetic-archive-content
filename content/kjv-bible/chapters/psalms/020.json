  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:20:1",
      "numberLabel": "1",
      "text": "The LORD hear thee in the day of trouble; the name of the God of Jacob defend thee;",
      "metadata": {
        "reference": "Psalms 20:1",
        "verseKey": "kjv:psalms:20:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:20:2",
      "numberLabel": "2",
      "text": "Send thee help from the sanctuary, and strengthen thee out of Zion;",
      "metadata": {
        "reference": "Psalms 20:2",
        "verseKey": "kjv:psalms:20:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:20:3",
      "numberLabel": "3",
      "text": "Remember all thy offerings, and accept thy burnt sacrifice; Selah.",
      "metadata": {
        "reference": "Psalms 20:3",
        "verseKey": "kjv:psalms:20:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:20:4",
      "numberLabel": "4",
      "text": "Grant thee according to thine own heart, and fulfil all thy counsel.",
      "metadata": {
        "reference": "Psalms 20:4",
        "verseKey": "kjv:psalms:20:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:20:5",
      "numberLabel": "5",
      "text": "We will rejoice in thy salvation, and in the name of our God we will set up our banners: the LORD fulfil all thy petitions.",
      "metadata": {
        "reference": "Psalms 20:5",
        "verseKey": "kjv:psalms:20:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:20:6",
      "numberLabel": "6",
      "text": "Now know I that the LORD saveth his anointed; he will hear him from his holy heaven with the saving strength of his right hand.",
      "metadata": {
        "reference": "Psalms 20:6",
        "verseKey": "kjv:psalms:20:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:20:7",
      "numberLabel": "7",
      "text": "Some trust in chariots, and some in horses: but we will remember the name of the LORD our God.",
      "metadata": {
        "reference": "Psalms 20:7",
        "verseKey": "kjv:psalms:20:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:20:8",
      "numberLabel": "8",
      "text": "They are brought down and fallen: but we are risen, and stand upright.",
      "metadata": {
        "reference": "Psalms 20:8",
        "verseKey": "kjv:psalms:20:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:20:9",
      "numberLabel": "9",
      "text": "Save, LORD: let the king hear us when we call.",
      "metadata": {
        "reference": "Psalms 20:9",
        "verseKey": "kjv:psalms:20:9"
      }
    }
  ],
  "source": {
