    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:33:1",
      "numberLabel": "1",
      "text": "Rejoice in the LORD, O ye righteous: for praise is comely for the upright.",
      "metadata": {
        "reference": "Psalms 33:1",
        "verseKey": "kjv:psalms:33:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:33:2",
      "numberLabel": "2",
      "text": "Praise the LORD with harp: sing unto him with the psaltery and an instrument of ten strings.",
      "metadata": {
        "reference": "Psalms 33:2",
        "verseKey": "kjv:psalms:33:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:33:3",
      "numberLabel": "3",
      "text": "Sing unto him a new song; play skilfully with a loud noise.",
      "metadata": {
        "reference": "Psalms 33:3",
        "verseKey": "kjv:psalms:33:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:33:4",
      "numberLabel": "4",
      "text": "For the word of the LORD is right; and all his works are done in truth.",
      "metadata": {
        "reference": "Psalms 33:4",
        "verseKey": "kjv:psalms:33:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:33:5",
      "numberLabel": "5",
      "text": "He loveth righteousness and judgment: the earth is full of the goodness of the LORD.",
      "metadata": {
        "reference": "Psalms 33:5",
        "verseKey": "kjv:psalms:33:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:33:6",
      "numberLabel": "6",
      "text": "By the word of the LORD were the heavens made; and all the host of them by the breath of his mouth.",
      "metadata": {
        "reference": "Psalms 33:6",
        "verseKey": "kjv:psalms:33:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:33:7",
      "numberLabel": "7",
      "text": "He gathereth the waters of the sea together as an heap: he layeth up the depth in storehouses.",
      "metadata": {
        "reference": "Psalms 33:7",
        "verseKey": "kjv:psalms:33:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:33:8",
      "numberLabel": "8",
      "text": "Let all the earth fear the LORD: let all the inhabitants of the world stand in awe of him.",
      "metadata": {
        "reference": "Psalms 33:8",
        "verseKey": "kjv:psalms:33:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:33:9",
      "numberLabel": "9",
      "text": "For he spake, and it was done; he commanded, and it stood fast.",
      "metadata": {
        "reference": "Psalms 33:9",
        "verseKey": "kjv:psalms:33:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:33:10",
      "numberLabel": "10",
      "text": "The LORD bringeth the counsel of the heathen to nought: he maketh the devices of the people of none effect.",
      "metadata": {
        "reference": "Psalms 33:10",
        "verseKey": "kjv:psalms:33:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:33:11",
      "numberLabel": "11",
      "text": "The counsel of the LORD standeth for ever, the thoughts of his heart to all generations.",
      "metadata": {
        "reference": "Psalms 33:11",
        "verseKey": "kjv:psalms:33:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:33:12",
      "numberLabel": "12",
      "text": "Blessed is the nation whose God is the LORD; and the people whom he hath chosen for his own inheritance.",
      "metadata": {
        "reference": "Psalms 33:12",
        "verseKey": "kjv:psalms:33:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:33:13",
      "numberLabel": "13",
      "text": "The LORD looketh from heaven; he beholdeth all the sons of men.",
      "metadata": {
        "reference": "Psalms 33:13",
        "verseKey": "kjv:psalms:33:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:33:14",
      "numberLabel": "14",
      "text": "From the place of his habitation he looketh upon all the inhabitants of the earth.",
      "metadata": {
        "reference": "Psalms 33:14",
        "verseKey": "kjv:psalms:33:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:33:15",
      "numberLabel": "15",
      "text": "He fashioneth their hearts alike; he considereth all their works.",
      "metadata": {
        "reference": "Psalms 33:15",
        "verseKey": "kjv:psalms:33:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:33:16",
      "numberLabel": "16",
      "text": "There is no king saved by the multitude of an host: a mighty man is not delivered by much strength.",
      "metadata": {
        "reference": "Psalms 33:16",
        "verseKey": "kjv:psalms:33:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:33:17",
      "numberLabel": "17",
      "text": "An horse is a vain thing for safety: neither shall he deliver any by his great strength.",
      "metadata": {
        "reference": "Psalms 33:17",
        "verseKey": "kjv:psalms:33:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:psalms:33:18",
      "numberLabel": "18",
      "text": "Behold, the eye of the LORD is upon them that fear him, upon them that hope in his mercy;",
      "metadata": {
        "reference": "Psalms 33:18",
        "verseKey": "kjv:psalms:33:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:psalms:33:19",
      "numberLabel": "19",
      "text": "To deliver their soul from death, and to keep them alive in famine.",
      "metadata": {
        "reference": "Psalms 33:19",
        "verseKey": "kjv:psalms:33:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:psalms:33:20",
      "numberLabel": "20",
      "text": "Our soul waiteth for the LORD: he is our help and our shield.",
      "metadata": {
        "reference": "Psalms 33:20",
        "verseKey": "kjv:psalms:33:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:psalms:33:21",
      "numberLabel": "21",
      "text": "For our heart shall rejoice in him, because we have trusted in his holy name.",
      "metadata": {
        "reference": "Psalms 33:21",
        "verseKey": "kjv:psalms:33:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:psalms:33:22",
      "numberLabel": "22",
      "text": "Let thy mercy, O LORD, be upon us, according as we hope in thee.",
      "metadata": {
        "reference": "Psalms 33:22",
        "verseKey": "kjv:psalms:33:22"
      }
    }
  ],
  "source": {
