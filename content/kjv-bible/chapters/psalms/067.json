  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:67:1",
      "numberLabel": "1",
      "text": "God be merciful unto us, and bless us; and cause his face to shine upon us; Selah.",
      "metadata": {
        "reference": "Psalms 67:1",
        "verseKey": "kjv:psalms:67:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:67:2",
      "numberLabel": "2",
      "text": "That thy way may be known upon earth, thy saving health among all nations.",
      "metadata": {
        "reference": "Psalms 67:2",
        "verseKey": "kjv:psalms:67:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:67:3",
      "numberLabel": "3",
      "text": "Let the people praise thee, O God; let all the people praise thee.",
      "metadata": {
        "reference": "Psalms 67:3",
        "verseKey": "kjv:psalms:67:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:67:4",
      "numberLabel": "4",
      "text": "O let the nations be glad and sing for joy: for thou shalt judge the people righteously, and govern the nations upon earth. Selah.",
      "metadata": {
        "reference": "Psalms 67:4",
        "verseKey": "kjv:psalms:67:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:67:5",
      "numberLabel": "5",
      "text": "Let the people praise thee, O God; let all the people praise thee.",
      "metadata": {
        "reference": "Psalms 67:5",
        "verseKey": "kjv:psalms:67:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:67:6",
      "numberLabel": "6",
      "text": "Then shall the earth yield her increase; and God, even our own God, shall bless us.",
      "metadata": {
        "reference": "Psalms 67:6",
        "verseKey": "kjv:psalms:67:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:67:7",
      "numberLabel": "7",
      "text": "God shall bless us; and all the ends of the earth shall fear him.",
      "metadata": {
        "reference": "Psalms 67:7",
        "verseKey": "kjv:psalms:67:7"
      }
    }
  ],
