  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:114:1",
      "numberLabel": "1",
      "text": "When Israel went out of Egypt, the house of Jacob from a people of strange language;",
      "metadata": {
        "reference": "Psalms 114:1",
        "verseKey": "kjv:psalms:114:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:114:2",
      "numberLabel": "2",
      "text": "Judah was his sanctuary, and Israel his dominion.",
      "metadata": {
        "reference": "Psalms 114:2",
        "verseKey": "kjv:psalms:114:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:114:3",
      "numberLabel": "3",
      "text": "The sea saw it, and fled: Jordan was driven back.",
      "metadata": {
        "reference": "Psalms 114:3",
        "verseKey": "kjv:psalms:114:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:114:4",
      "numberLabel": "4",
      "text": "The mountains skipped like rams, and the little hills like lambs.",
      "metadata": {
        "reference": "Psalms 114:4",
        "verseKey": "kjv:psalms:114:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:114:5",
      "numberLabel": "5",
      "text": "What ailed thee, O thou sea, that thou fleddest? thou Jordan, that thou wast driven back?",
      "metadata": {
        "reference": "Psalms 114:5",
        "verseKey": "kjv:psalms:114:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:114:6",
      "numberLabel": "6",
      "text": "Ye mountains, that ye skipped like rams; and ye little hills, like lambs?",
      "metadata": {
        "reference": "Psalms 114:6",
        "verseKey": "kjv:psalms:114:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:114:7",
      "numberLabel": "7",
      "text": "Tremble, thou earth, at the presence of the Lord, at the presence of the God of Jacob;",
      "metadata": {
        "reference": "Psalms 114:7",
        "verseKey": "kjv:psalms:114:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:114:8",
      "numberLabel": "8",
      "text": "Which turned the rock into a standing water, the flint into a fountain of waters.",
      "metadata": {
        "reference": "Psalms 114:8",
        "verseKey": "kjv:psalms:114:8"
      }
    }
  ],
