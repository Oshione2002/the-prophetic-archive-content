  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:1:1",
      "numberLabel": "1",
      "text": "Blessed is the man that walketh not in the counsel of the ungodly, nor standeth in the way of sinners, nor sitteth in the seat of the scornful.",
      "metadata": {
        "reference": "Psalms 1:1",
        "verseKey": "kjv:psalms:1:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:1:2",
      "numberLabel": "2",
      "text": "But his delight is in the law of the LORD; and in his law doth he meditate day and night.",
      "metadata": {
        "reference": "Psalms 1:2",
        "verseKey": "kjv:psalms:1:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:1:3",
      "numberLabel": "3",
      "text": "And he shall be like a tree planted by the rivers of water, that bringeth forth his fruit in his season; his leaf also shall not wither; and whatsoever he doeth shall prosper.",
      "metadata": {
        "reference": "Psalms 1:3",
        "verseKey": "kjv:psalms:1:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:1:4",
      "numberLabel": "4",
      "text": "The ungodly are not so: but are like the chaff which the wind driveth away.",
      "metadata": {
        "reference": "Psalms 1:4",
        "verseKey": "kjv:psalms:1:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:1:5",
      "numberLabel": "5",
      "text": "Therefore the ungodly shall not stand in the judgment, nor sinners in the congregation of the righteous.",
      "metadata": {
        "reference": "Psalms 1:5",
        "verseKey": "kjv:psalms:1:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:1:6",
      "numberLabel": "6",
      "text": "For the LORD knoweth the way of the righteous: but the way of the ungodly shall perish.",
      "metadata": {
        "reference": "Psalms 1:6",
        "verseKey": "kjv:psalms:1:6"
      }
    }
  ],
