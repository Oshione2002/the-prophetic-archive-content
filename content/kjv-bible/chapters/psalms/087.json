  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:87:1",
      "numberLabel": "1",
      "text": "His foundation is in the holy mountains.",
      "metadata": {
        "reference": "Psalms 87:1",
        "verseKey": "kjv:psalms:87:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:87:2",
      "numberLabel": "2",
      "text": "The LORD loveth the gates of Zion more than all the dwellings of Jacob.",
      "metadata": {
        "reference": "Psalms 87:2",
        "verseKey": "kjv:psalms:87:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:87:3",
      "numberLabel": "3",
      "text": "Glorious things are spoken of thee, O city of God. Selah.",
      "metadata": {
        "reference": "Psalms 87:3",
        "verseKey": "kjv:psalms:87:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:87:4",
      "numberLabel": "4",
      "text": "I will make mention of Rahab and Babylon to them that know me: behold Philistia, and Tyre, with Ethiopia; this man was born there.",
      "metadata": {
        "reference": "Psalms 87:4",
        "verseKey": "kjv:psalms:87:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:87:5",
      "numberLabel": "5",
      "text": "And of Zion it shall be said, This and that man was born in her: and the highest himself shall establish her.",
      "metadata": {
        "reference": "Psalms 87:5",
        "verseKey": "kjv:psalms:87:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:87:6",
      "numberLabel": "6",
      "text": "The LORD shall count, when he writeth up the people, that this man was born there. Selah.",
      "metadata": {
        "reference": "Psalms 87:6",
        "verseKey": "kjv:psalms:87:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:87:7",
      "numberLabel": "7",
      "text": "As well the singers as the players on instruments shall be there: all my springs are in thee.",
      "metadata": {
        "reference": "Psalms 87:7",
        "verseKey": "kjv:psalms:87:7"
      }
    }
  ],
