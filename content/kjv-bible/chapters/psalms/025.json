    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:25:1",
      "numberLabel": "1",
      "text": "Unto thee, O LORD, do I lift up my soul.",
      "metadata": {
        "reference": "Psalms 25:1",
        "verseKey": "kjv:psalms:25:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:25:2",
      "numberLabel": "2",
      "text": "O my God, I trust in thee: let me not be ashamed, let not mine enemies triumph over me.",
      "metadata": {
        "reference": "Psalms 25:2",
        "verseKey": "kjv:psalms:25:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:25:3",
      "numberLabel": "3",
      "text": "Yea, let none that wait on thee be ashamed: let them be ashamed which transgress without cause.",
      "metadata": {
        "reference": "Psalms 25:3",
        "verseKey": "kjv:psalms:25:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:25:4",
      "numberLabel": "4",
      "text": "Shew me thy ways, O LORD; teach me thy paths.",
      "metadata": {
        "reference": "Psalms 25:4",
        "verseKey": "kjv:psalms:25:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:25:5",
      "numberLabel": "5",
      "text": "Lead me in thy truth, and teach me: for thou art the God of my salvation; on thee do I wait all the day.",
      "metadata": {
        "reference": "Psalms 25:5",
        "verseKey": "kjv:psalms:25:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:25:6",
      "numberLabel": "6",
      "text": "Remember, O LORD, thy tender mercies and thy lovingkindnesses; for they have been ever of old.",
      "metadata": {
        "reference": "Psalms 25:6",
        "verseKey": "kjv:psalms:25:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:25:7",
      "numberLabel": "7",
      "text": "Remember not the sins of my youth, nor my transgressions: according to thy mercy remember thou me for thy goodness’ sake, O LORD.",
      "metadata": {
        "reference": "Psalms 25:7",
        "verseKey": "kjv:psalms:25:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:25:8",
      "numberLabel": "8",
      "text": "Good and upright is the LORD: therefore will he teach sinners in the way.",
      "metadata": {
        "reference": "Psalms 25:8",
        "verseKey": "kjv:psalms:25:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:25:9",
      "numberLabel": "9",
      "text": "The meek will he guide in judgment: and the meek will he teach his way.",
      "metadata": {
        "reference": "Psalms 25:9",
        "verseKey": "kjv:psalms:25:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:25:10",
      "numberLabel": "10",
      "text": "All the paths of the LORD are mercy and truth unto such as keep his covenant and his testimonies.",
      "metadata": {
        "reference": "Psalms 25:10",
        "verseKey": "kjv:psalms:25:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:25:11",
      "numberLabel": "11",
      "text": "For thy name’s sake, O LORD, pardon mine iniquity; for it is great.",
      "metadata": {
        "reference": "Psalms 25:11",
        "verseKey": "kjv:psalms:25:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:25:12",
      "numberLabel": "12",
      "text": "What man is he that feareth the LORD? him shall he teach in the way that he shall choose.",
      "metadata": {
        "reference": "Psalms 25:12",
        "verseKey": "kjv:psalms:25:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:25:13",
      "numberLabel": "13",
      "text": "His soul shall dwell at ease; and his seed shall inherit the earth.",
      "metadata": {
        "reference": "Psalms 25:13",
        "verseKey": "kjv:psalms:25:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:25:14",
      "numberLabel": "14",
      "text": "The secret of the LORD is with them that fear him; and he will shew them his covenant.",
      "metadata": {
        "reference": "Psalms 25:14",
        "verseKey": "kjv:psalms:25:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:25:15",
      "numberLabel": "15",
      "text": "Mine eyes are ever toward the LORD; for he shall pluck my feet out of the net.",
      "metadata": {
        "reference": "Psalms 25:15",
        "verseKey": "kjv:psalms:25:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:25:16",
      "numberLabel": "16",
      "text": "Turn thee unto me, and have mercy upon me; for I am desolate and afflicted.",
      "metadata": {
        "reference": "Psalms 25:16",
        "verseKey": "kjv:psalms:25:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:25:17",
      "numberLabel": "17",
      "text": "The troubles of my heart are enlarged: O bring thou me out of my distresses.",
      "metadata": {
        "reference": "Psalms 25:17",
        "verseKey": "kjv:psalms:25:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:psalms:25:18",
      "numberLabel": "18",
      "text": "Look upon mine affliction and my pain; and forgive all my sins.",
      "metadata": {
        "reference": "Psalms 25:18",
        "verseKey": "kjv:psalms:25:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:psalms:25:19",
      "numberLabel": "19",
      "text": "Consider mine enemies; for they are many; and they hate me with cruel hatred.",
      "metadata": {
        "reference": "Psalms 25:19",
        "verseKey": "kjv:psalms:25:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:psalms:25:20",
      "numberLabel": "20",
      "text": "O keep my soul, and deliver me: let me not be ashamed; for I put my trust in thee.",
      "metadata": {
        "reference": "Psalms 25:20",
        "verseKey": "kjv:psalms:25:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:psalms:25:21",
      "numberLabel": "21",
      "text": "Let integrity and uprightness preserve me; for I wait on thee.",
      "metadata": {
        "reference": "Psalms 25:21",
        "verseKey": "kjv:psalms:25:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:psalms:25:22",
      "numberLabel": "22",
      "text": "Redeem Israel, O God, out of all his troubles.",
      "metadata": {
        "reference": "Psalms 25:22",
        "verseKey": "kjv:psalms:25:22"
      }
    }
  ],
  "source": {
