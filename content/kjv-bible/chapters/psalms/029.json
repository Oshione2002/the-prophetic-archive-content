  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:29:1",
      "numberLabel": "1",
      "text": "Give unto the LORD, O ye mighty, give unto the LORD glory and strength.",
      "metadata": {
        "reference": "Psalms 29:1",
        "verseKey": "kjv:psalms:29:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:29:2",
      "numberLabel": "2",
      "text": "Give unto the LORD the glory due unto his name; worship the LORD in the beauty of holiness.",
      "metadata": {
        "reference": "Psalms 29:2",
        "verseKey": "kjv:psalms:29:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:29:3",
      "numberLabel": "3",
      "text": "The voice of the LORD is upon the waters: the God of glory thundereth: the LORD is upon many waters.",
      "metadata": {
        "reference": "Psalms 29:3",
        "verseKey": "kjv:psalms:29:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:29:4",
      "numberLabel": "4",
      "text": "The voice of the LORD is powerful; the voice of the LORD is full of majesty.",
      "metadata": {
        "reference": "Psalms 29:4",
        "verseKey": "kjv:psalms:29:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:29:5",
      "numberLabel": "5",
      "text": "The voice of the LORD breaketh the cedars; yea, the LORD breaketh the cedars of Lebanon.",
      "metadata": {
        "reference": "Psalms 29:5",
        "verseKey": "kjv:psalms:29:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:29:6",
      "numberLabel": "6",
      "text": "He maketh them also to skip like a calf; Lebanon and Sirion like a young unicorn.",
      "metadata": {
        "reference": "Psalms 29:6",
        "verseKey": "kjv:psalms:29:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:29:7",
      "numberLabel": "7",
      "text": "The voice of the LORD divideth the flames of fire.",
      "metadata": {
        "reference": "Psalms 29:7",
        "verseKey": "kjv:psalms:29:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:29:8",
      "numberLabel": "8",
      "text": "The voice of the LORD shaketh the wilderness; the LORD shaketh the wilderness of Kadesh.",
      "metadata": {
        "reference": "Psalms 29:8",
        "verseKey": "kjv:psalms:29:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:29:9",
      "numberLabel": "9",
      "text": "The voice of the LORD maketh the hinds to calve, and discovereth the forests: and in his temple doth every one speak of his glory.",
      "metadata": {
        "reference": "Psalms 29:9",
        "verseKey": "kjv:psalms:29:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:29:10",
      "numberLabel": "10",
      "text": "The LORD sitteth upon the flood; yea, the LORD sitteth King for ever.",
      "metadata": {
        "reference": "Psalms 29:10",
        "verseKey": "kjv:psalms:29:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:29:11",
      "numberLabel": "11",
      "text": "The LORD will give strength unto his people; the LORD will bless his people with peace.",
      "metadata": {
        "reference": "Psalms 29:11",
        "verseKey": "kjv:psalms:29:11"
      }
    }
  ],
