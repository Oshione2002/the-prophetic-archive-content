  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:16:1",
      "numberLabel": "1",
      "text": "Preserve me, O God: for in thee do I put my trust.",
      "metadata": {
        "reference": "Psalms 16:1",
        "verseKey": "kjv:psalms:16:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:16:2",
      "numberLabel": "2",
      "text": "O my soul, thou hast said unto the LORD, Thou art my Lord: my goodness extendeth not to thee;",
      "metadata": {
        "reference": "Psalms 16:2",
        "verseKey": "kjv:psalms:16:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:16:3",
      "numberLabel": "3",
      "text": "But to the saints that are in the earth, and to the excellent, in whom is all my delight.",
      "metadata": {
        "reference": "Psalms 16:3",
        "verseKey": "kjv:psalms:16:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:16:4",
      "numberLabel": "4",
      "text": "Their sorrows shall be multiplied that hasten after another god: their drink offerings of blood will I not offer, nor take up their names into my lips.",
      "metadata": {
        "reference": "Psalms 16:4",
        "verseKey": "kjv:psalms:16:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:16:5",
      "numberLabel": "5",
      "text": "The LORD is the portion of mine inheritance and of my cup: thou maintainest my lot.",
      "metadata": {
        "reference": "Psalms 16:5",
        "verseKey": "kjv:psalms:16:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:16:6",
      "numberLabel": "6",
      "text": "The lines are fallen unto me in pleasant places; yea, I have a goodly heritage.",
      "metadata": {
        "reference": "Psalms 16:6",
        "verseKey": "kjv:psalms:16:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:16:7",
      "numberLabel": "7",
      "text": "I will bless the LORD, who hath given me counsel: my reins also instruct me in the night seasons.",
      "metadata": {
        "reference": "Psalms 16:7",
        "verseKey": "kjv:psalms:16:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:16:8",
      "numberLabel": "8",
      "text": "I have set the LORD always before me: because he is at my right hand, I shall not be moved.",
      "metadata": {
        "reference": "Psalms 16:8",
        "verseKey": "kjv:psalms:16:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:16:9",
      "numberLabel": "9",
      "text": "Therefore my heart is glad, and my glory rejoiceth: my flesh also shall rest in hope.",
      "metadata": {
        "reference": "Psalms 16:9",
        "verseKey": "kjv:psalms:16:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:16:10",
      "numberLabel": "10",
      "text": "For thou wilt not leave my soul in hell; neither wilt thou suffer thine Holy One to see corruption.",
      "metadata": {
        "reference": "Psalms 16:10",
        "verseKey": "kjv:psalms:16:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:16:11",
      "numberLabel": "11",
      "text": "Thou wilt shew me the path of life: in thy presence is fulness of joy; at thy right hand there are pleasures for evermore.",
      "metadata": {
        "reference": "Psalms 16:11",
        "verseKey": "kjv:psalms:16:11"
      }
    }
  ],
  "source": {
