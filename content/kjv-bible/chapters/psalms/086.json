    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:86:1",
      "numberLabel": "1",
      "text": "Bow down thine ear, O LORD, hear me: for I am poor and needy.",
      "metadata": {
        "reference": "Psalms 86:1",
        "verseKey": "kjv:psalms:86:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:86:2",
      "numberLabel": "2",
      "text": "Preserve my soul; for I am holy: O thou my God, save thy servant that trusteth in thee.",
      "metadata": {
        "reference": "Psalms 86:2",
        "verseKey": "kjv:psalms:86:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:86:3",
      "numberLabel": "3",
      "text": "Be merciful unto me, O Lord: for I cry unto thee daily.",
      "metadata": {
        "reference": "Psalms 86:3",
        "verseKey": "kjv:psalms:86:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:86:4",
      "numberLabel": "4",
      "text": "Rejoice the soul of thy servant: for unto thee, O Lord, do I lift up my soul.",
      "metadata": {
        "reference": "Psalms 86:4",
        "verseKey": "kjv:psalms:86:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:86:5",
      "numberLabel": "5",
      "text": "For thou, Lord, art good, and ready to forgive; and plenteous in mercy unto all them that call upon thee.",
      "metadata": {
        "reference": "Psalms 86:5",
        "verseKey": "kjv:psalms:86:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:86:6",
      "numberLabel": "6",
      "text": "Give ear, O LORD, unto my prayer; and attend to the voice of my supplications.",
      "metadata": {
        "reference": "Psalms 86:6",
        "verseKey": "kjv:psalms:86:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:86:7",
      "numberLabel": "7",
      "text": "In the day of my trouble I will call upon thee: for thou wilt answer me.",
      "metadata": {
        "reference": "Psalms 86:7",
        "verseKey": "kjv:psalms:86:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:86:8",
      "numberLabel": "8",
      "text": "Among the gods there is none like unto thee, O Lord; neither are there any works like unto thy works.",
      "metadata": {
        "reference": "Psalms 86:8",
        "verseKey": "kjv:psalms:86:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:86:9",
      "numberLabel": "9",
      "text": "All nations whom thou hast made shall come and worship before thee, O Lord; and shall glorify thy name.",
      "metadata": {
        "reference": "Psalms 86:9",
        "verseKey": "kjv:psalms:86:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:86:10",
      "numberLabel": "10",
      "text": "For thou art great, and doest wondrous things: thou art God alone.",
      "metadata": {
        "reference": "Psalms 86:10",
        "verseKey": "kjv:psalms:86:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:86:11",
      "numberLabel": "11",
      "text": "Teach me thy way, O LORD; I will walk in thy truth: unite my heart to fear thy name.",
      "metadata": {
        "reference": "Psalms 86:11",
        "verseKey": "kjv:psalms:86:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:86:12",
      "numberLabel": "12",
      "text": "I will praise thee, O Lord my God, with all my heart: and I will glorify thy name for evermore.",
      "metadata": {
        "reference": "Psalms 86:12",
        "verseKey": "kjv:psalms:86:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:86:13",
      "numberLabel": "13",
      "text": "For great is thy mercy toward me: and thou hast delivered my soul from the lowest hell.",
      "metadata": {
        "reference": "Psalms 86:13",
        "verseKey": "kjv:psalms:86:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:86:14",
      "numberLabel": "14",
      "text": "O God, the proud are risen against me, and the assemblies of violent men have sought after my soul; and have not set thee before them.",
      "metadata": {
        "reference": "Psalms 86:14",
        "verseKey": "kjv:psalms:86:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:86:15",
      "numberLabel": "15",
      "text": "But thou, O Lord, art a God full of compassion, and gracious, long suffering, and plenteous in mercy and truth.",
      "metadata": {
        "reference": "Psalms 86:15",
        "verseKey": "kjv:psalms:86:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:86:16",
      "numberLabel": "16",
      "text": "O turn unto me, and have mercy upon me; give thy strength unto thy servant, and save the son of thine handmaid.",
      "metadata": {
        "reference": "Psalms 86:16",
        "verseKey": "kjv:psalms:86:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:86:17",
      "numberLabel": "17",
      "text": "Shew me a token for good; that they which hate me may see it, and be ashamed: because thou, LORD, hast holpen me, and comforted me.",
      "metadata": {
        "reference": "Psalms 86:17",
        "verseKey": "kjv:psalms:86:17"
      }
    }
  ],
  "source": {
