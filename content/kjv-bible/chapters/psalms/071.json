  "sortOrder": 19071,
  "verseCount": 24,
  "aliases": [
    "Psalm",
    "Psalms",
    "Ps",
    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:71:1",
      "numberLabel": "1",
      "text": "In thee, O LORD, do I put my trust: let me never be put to confusion.",
      "metadata": {
        "reference": "Psalms 71:1",
        "verseKey": "kjv:psalms:71:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:71:2",
      "numberLabel": "2",
      "text": "Deliver me in thy righteousness, and cause me to escape: incline thine ear unto me, and save me.",
      "metadata": {
        "reference": "Psalms 71:2",
        "verseKey": "kjv:psalms:71:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:71:3",
      "numberLabel": "3",
      "text": "Be thou my strong habitation, whereunto I may continually resort: thou hast given commandment to save me; for thou art my rock and my fortress.",
      "metadata": {
        "reference": "Psalms 71:3",
        "verseKey": "kjv:psalms:71:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:71:4",
      "numberLabel": "4",
      "text": "Deliver me, O my God, out of the hand of the wicked, out of the hand of the unrighteous and cruel man.",
      "metadata": {
        "reference": "Psalms 71:4",
        "verseKey": "kjv:psalms:71:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:71:5",
      "numberLabel": "5",
      "text": "For thou art my hope, O Lord GOD: thou art my trust from my youth.",
      "metadata": {
        "reference": "Psalms 71:5",
        "verseKey": "kjv:psalms:71:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:71:6",
      "numberLabel": "6",
      "text": "By thee have I been holden up from the womb: thou art he that took me out of my mother’s bowels: my praise shall be continually of thee.",
      "metadata": {
        "reference": "Psalms 71:6",
        "verseKey": "kjv:psalms:71:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:71:7",
      "numberLabel": "7",
      "text": "I am as a wonder unto many; but thou art my strong refuge.",
      "metadata": {
        "reference": "Psalms 71:7",
        "verseKey": "kjv:psalms:71:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:71:8",
      "numberLabel": "8",
      "text": "Let my mouth be filled with thy praise and with thy honour all the day.",
      "metadata": {
        "reference": "Psalms 71:8",
        "verseKey": "kjv:psalms:71:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:71:9",
      "numberLabel": "9",
      "text": "Cast me not off in the time of old age; forsake me not when my strength faileth.",
      "metadata": {
        "reference": "Psalms 71:9",
        "verseKey": "kjv:psalms:71:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:71:10",
      "numberLabel": "10",
      "text": "For mine enemies speak against me; and they that lay wait for my soul take counsel together,",
      "metadata": {
        "reference": "Psalms 71:10",
        "verseKey": "kjv:psalms:71:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:71:11",
      "numberLabel": "11",
      "text": "Saying, God hath forsaken him: persecute and take him; for there is none to deliver him.",
      "metadata": {
        "reference": "Psalms 71:11",
        "verseKey": "kjv:psalms:71:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:71:12",
      "numberLabel": "12",
      "text": "O God, be not far from me: O my God, make haste for my help.",
      "metadata": {
        "reference": "Psalms 71:12",
        "verseKey": "kjv:psalms:71:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:71:13",
      "numberLabel": "13",
      "text": "Let them be confounded and consumed that are adversaries to my soul; let them be covered with reproach and dishonour that seek my hurt.",
      "metadata": {
        "reference": "Psalms 71:13",
        "verseKey": "kjv:psalms:71:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:71:14",
      "numberLabel": "14",
      "text": "But I will hope continually, and will yet praise thee more and more.",
      "metadata": {
        "reference": "Psalms 71:14",
        "verseKey": "kjv:psalms:71:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:71:15",
      "numberLabel": "15",
      "text": "My mouth shall shew forth thy righteousness and thy salvation all the day; for I know not the numbers thereof.",
      "metadata": {
        "reference": "Psalms 71:15",
        "verseKey": "kjv:psalms:71:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:71:16",
      "numberLabel": "16",
      "text": "I will go in the strength of the Lord GOD: I will make mention of thy righteousness, even of thine only.",
      "metadata": {
        "reference": "Psalms 71:16",
        "verseKey": "kjv:psalms:71:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:71:17",
      "numberLabel": "17",
      "text": "O God, thou hast taught me from my youth: and hitherto have I declared thy wondrous works.",
      "metadata": {
        "reference": "Psalms 71:17",
        "verseKey": "kjv:psalms:71:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:psalms:71:18",
      "numberLabel": "18",
      "text": "Now also when I am old and greyheaded, O God, forsake me not; until I have shewed thy strength unto this generation, and thy power to every one that is to come.",
      "metadata": {
        "reference": "Psalms 71:18",
        "verseKey": "kjv:psalms:71:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:psalms:71:19",
      "numberLabel": "19",
      "text": "Thy righteousness also, O God, is very high, who hast done great things: O God, who is like unto thee!",
      "metadata": {
        "reference": "Psalms 71:19",
        "verseKey": "kjv:psalms:71:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:psalms:71:20",
      "numberLabel": "20",
      "text": "Thou, which hast shewed me great and sore troubles, shalt quicken me again, and shalt bring me up again from the depths of the earth.",
      "metadata": {
        "reference": "Psalms 71:20",
        "verseKey": "kjv:psalms:71:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:psalms:71:21",
      "numberLabel": "21",
      "text": "Thou shalt increase my greatness, and comfort me on every side.",
      "metadata": {
        "reference": "Psalms 71:21",
        "verseKey": "kjv:psalms:71:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:psalms:71:22",
      "numberLabel": "22",
      "text": "I will also praise thee with the psaltery, even thy truth, O my God: unto thee will I sing with the harp, O thou Holy One of Israel.",
      "metadata": {
        "reference": "Psalms 71:22",
        "verseKey": "kjv:psalms:71:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:psalms:71:23",
      "numberLabel": "23",
      "text": "My lips shall greatly rejoice when I sing unto thee; and my soul, which thou hast redeemed.",
      "metadata": {
        "reference": "Psalms 71:23",
        "verseKey": "kjv:psalms:71:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:psalms:71:24",
      "numberLabel": "24",
      "text": "My tongue also shall talk of thy righteousness all the day long: for they are confounded, for they are brought unto shame, that seek my hurt.",
      "metadata": {
        "reference": "Psalms 71:24",
        "verseKey": "kjv:psalms:71:24"
      }
    }
  ],
  "source": {
