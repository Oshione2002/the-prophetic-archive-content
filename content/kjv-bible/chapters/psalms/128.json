  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:128:1",
      "numberLabel": "1",
      "text": "Blessed is every one that feareth the LORD; that walketh in his ways.",
      "metadata": {
        "reference": "Psalms 128:1",
        "verseKey": "kjv:psalms:128:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:128:2",
      "numberLabel": "2",
      "text": "For thou shalt eat the labour of thine hands: happy shalt thou be, and it shall be well with thee.",
      "metadata": {
        "reference": "Psalms 128:2",
        "verseKey": "kjv:psalms:128:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:128:3",
      "numberLabel": "3",
      "text": "Thy wife shall be as a fruitful vine by the sides of thine house: thy children like olive plants round about thy table.",
      "metadata": {
        "reference": "Psalms 128:3",
        "verseKey": "kjv:psalms:128:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:128:4",
      "numberLabel": "4",
      "text": "Behold, that thus shall the man be blessed that feareth the LORD.",
      "metadata": {
        "reference": "Psalms 128:4",
        "verseKey": "kjv:psalms:128:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:128:5",
      "numberLabel": "5",
      "text": "The LORD shall bless thee out of Zion: and thou shalt see the good of Jerusalem all the days of thy life.",
      "metadata": {
        "reference": "Psalms 128:5",
        "verseKey": "kjv:psalms:128:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:128:6",
      "numberLabel": "6",
      "text": "Yea, thou shalt see thy children’s children, and peace upon Israel.",
      "metadata": {
        "reference": "Psalms 128:6",
        "verseKey": "kjv:psalms:128:6"
      }
    }
  ],
