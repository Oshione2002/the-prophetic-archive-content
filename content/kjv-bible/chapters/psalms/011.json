  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:11:1",
      "numberLabel": "1",
      "text": "In the LORD put I my trust: how say ye to my soul, Flee as a bird to your mountain?",
      "metadata": {
        "reference": "Psalms 11:1",
        "verseKey": "kjv:psalms:11:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:11:2",
      "numberLabel": "2",
      "text": "For, lo, the wicked bend their bow, they make ready their arrow upon the string, that they may privily shoot at the upright in heart.",
      "metadata": {
        "reference": "Psalms 11:2",
        "verseKey": "kjv:psalms:11:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:11:3",
      "numberLabel": "3",
      "text": "If the foundations be destroyed, what can the righteous do?",
      "metadata": {
        "reference": "Psalms 11:3",
        "verseKey": "kjv:psalms:11:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:11:4",
      "numberLabel": "4",
      "text": "The LORD is in his holy temple, the LORD’s throne is in heaven: his eyes behold, his eyelids try, the children of men.",
      "metadata": {
        "reference": "Psalms 11:4",
        "verseKey": "kjv:psalms:11:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:11:5",
      "numberLabel": "5",
      "text": "The LORD trieth the righteous: but the wicked and him that loveth violence his soul hateth.",
      "metadata": {
        "reference": "Psalms 11:5",
        "verseKey": "kjv:psalms:11:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:11:6",
      "numberLabel": "6",
      "text": "Upon the wicked he shall rain snares, fire and brimstone, and an horrible tempest: this shall be the portion of their cup.",
      "metadata": {
        "reference": "Psalms 11:6",
        "verseKey": "kjv:psalms:11:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:11:7",
      "numberLabel": "7",
      "text": "For the righteous LORD loveth righteousness; his countenance doth behold the upright.",
      "metadata": {
        "reference": "Psalms 11:7",
        "verseKey": "kjv:psalms:11:7"
      }
    }
  ],
