  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:14:1",
      "numberLabel": "1",
      "text": "The fool hath said in his heart, There is no God. They are corrupt, they have done abominable works, there is none that doeth good.",
      "metadata": {
        "reference": "Psalms 14:1",
        "verseKey": "kjv:psalms:14:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:14:2",
      "numberLabel": "2",
      "text": "The LORD looked down from heaven upon the children of men, to see if there were any that did understand, and seek God.",
      "metadata": {
        "reference": "Psalms 14:2",
        "verseKey": "kjv:psalms:14:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:14:3",
      "numberLabel": "3",
      "text": "They are all gone aside, they are all together become filthy: there is none that doeth good, no, not one.",
      "metadata": {
        "reference": "Psalms 14:3",
        "verseKey": "kjv:psalms:14:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:14:4",
      "numberLabel": "4",
      "text": "Have all the workers of iniquity no knowledge? who eat up my people as they eat bread, and call not upon the LORD.",
      "metadata": {
        "reference": "Psalms 14:4",
        "verseKey": "kjv:psalms:14:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:14:5",
      "numberLabel": "5",
      "text": "There were they in great fear: for God is in the generation of the righteous.",
      "metadata": {
        "reference": "Psalms 14:5",
        "verseKey": "kjv:psalms:14:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:14:6",
      "numberLabel": "6",
      "text": "Ye have shamed the counsel of the poor, because the LORD is his refuge.",
      "metadata": {
        "reference": "Psalms 14:6",
        "verseKey": "kjv:psalms:14:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:14:7",
      "numberLabel": "7",
      "text": "Oh that the salvation of Israel were come out of Zion! when the LORD bringeth back the captivity of his people, Jacob shall rejoice, and Israel shall be glad.",
      "metadata": {
        "reference": "Psalms 14:7",
        "verseKey": "kjv:psalms:14:7"
      }
    }
  ],
