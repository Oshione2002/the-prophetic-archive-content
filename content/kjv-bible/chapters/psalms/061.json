  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:61:1",
      "numberLabel": "1",
      "text": "Hear my cry, O God; attend unto my prayer.",
      "metadata": {
        "reference": "Psalms 61:1",
        "verseKey": "kjv:psalms:61:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:61:2",
      "numberLabel": "2",
      "text": "From the end of the earth will I cry unto thee, when my heart is overwhelmed: lead me to the rock that is higher than I.",
      "metadata": {
        "reference": "Psalms 61:2",
        "verseKey": "kjv:psalms:61:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:61:3",
      "numberLabel": "3",
      "text": "For thou hast been a shelter for me, and a strong tower from the enemy.",
      "metadata": {
        "reference": "Psalms 61:3",
        "verseKey": "kjv:psalms:61:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:61:4",
      "numberLabel": "4",
      "text": "I will abide in thy tabernacle for ever: I will trust in the covert of thy wings. Selah.",
      "metadata": {
        "reference": "Psalms 61:4",
        "verseKey": "kjv:psalms:61:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:61:5",
      "numberLabel": "5",
      "text": "For thou, O God, hast heard my vows: thou hast given me the heritage of those that fear thy name.",
      "metadata": {
        "reference": "Psalms 61:5",
        "verseKey": "kjv:psalms:61:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:61:6",
      "numberLabel": "6",
      "text": "Thou wilt prolong the king’s life: and his years as many generations.",
      "metadata": {
        "reference": "Psalms 61:6",
        "verseKey": "kjv:psalms:61:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:61:7",
      "numberLabel": "7",
      "text": "He shall abide before God for ever: O prepare mercy and truth, which may preserve him.",
      "metadata": {
        "reference": "Psalms 61:7",
        "verseKey": "kjv:psalms:61:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:61:8",
      "numberLabel": "8",
      "text": "So will I sing praise unto thy name for ever, that I may daily perform my vows.",
      "metadata": {
        "reference": "Psalms 61:8",
        "verseKey": "kjv:psalms:61:8"
      }
    }
  ],
  "source": {
