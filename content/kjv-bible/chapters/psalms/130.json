  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:130:1",
      "numberLabel": "1",
      "text": "Out of the depths have I cried unto thee, O LORD.",
      "metadata": {
        "reference": "Psalms 130:1",
        "verseKey": "kjv:psalms:130:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:130:2",
      "numberLabel": "2",
      "text": "Lord, hear my voice: let thine ears be attentive to the voice of my supplications.",
      "metadata": {
        "reference": "Psalms 130:2",
        "verseKey": "kjv:psalms:130:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:130:3",
      "numberLabel": "3",
      "text": "If thou, LORD, shouldest mark iniquities, O Lord, who shall stand?",
      "metadata": {
        "reference": "Psalms 130:3",
        "verseKey": "kjv:psalms:130:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:130:4",
      "numberLabel": "4",
      "text": "But there is forgiveness with thee, that thou mayest be feared.",
      "metadata": {
        "reference": "Psalms 130:4",
        "verseKey": "kjv:psalms:130:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:130:5",
      "numberLabel": "5",
      "text": "I wait for the LORD, my soul doth wait, and in his word do I hope.",
      "metadata": {
        "reference": "Psalms 130:5",
        "verseKey": "kjv:psalms:130:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:130:6",
      "numberLabel": "6",
      "text": "My soul waiteth for the Lord more than they that watch for the morning: I say, more than they that watch for the morning.",
      "metadata": {
        "reference": "Psalms 130:6",
        "verseKey": "kjv:psalms:130:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:130:7",
      "numberLabel": "7",
      "text": "Let Israel hope in the LORD: for with the LORD there is mercy, and with him is plenteous redemption.",
      "metadata": {
        "reference": "Psalms 130:7",
        "verseKey": "kjv:psalms:130:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:130:8",
      "numberLabel": "8",
      "text": "And he shall redeem Israel from all his iniquities.",
      "metadata": {
        "reference": "Psalms 130:8",
        "verseKey": "kjv:psalms:130:8"
      }
    }
  ],
  "source": {
