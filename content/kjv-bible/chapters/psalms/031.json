    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:31:1",
      "numberLabel": "1",
      "text": "In thee, O LORD, do I put my trust; let me never be ashamed: deliver me in thy righteousness.",
      "metadata": {
        "reference": "Psalms 31:1",
        "verseKey": "kjv:psalms:31:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:31:2",
      "numberLabel": "2",
      "text": "Bow down thine ear to me; deliver me speedily: be thou my strong rock, for an house of defence to save me.",
      "metadata": {
        "reference": "Psalms 31:2",
        "verseKey": "kjv:psalms:31:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:31:3",
      "numberLabel": "3",
      "text": "For thou art my rock and my fortress; therefore for thy name’s sake lead me, and guide me.",
      "metadata": {
        "reference": "Psalms 31:3",
        "verseKey": "kjv:psalms:31:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:31:4",
      "numberLabel": "4",
      "text": "Pull me out of the net that they have laid privily for me: for thou art my strength.",
      "metadata": {
        "reference": "Psalms 31:4",
        "verseKey": "kjv:psalms:31:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:31:5",
      "numberLabel": "5",
      "text": "Into thine hand I commit my spirit: thou hast redeemed me, O LORD God of truth.",
      "metadata": {
        "reference": "Psalms 31:5",
        "verseKey": "kjv:psalms:31:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:31:6",
      "numberLabel": "6",
      "text": "I have hated them that regard lying vanities: but I trust in the LORD.",
      "metadata": {
        "reference": "Psalms 31:6",
        "verseKey": "kjv:psalms:31:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:31:7",
      "numberLabel": "7",
      "text": "I will be glad and rejoice in thy mercy: for thou hast considered my trouble; thou hast known my soul in adversities;",
      "metadata": {
        "reference": "Psalms 31:7",
        "verseKey": "kjv:psalms:31:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:31:8",
      "numberLabel": "8",
      "text": "And hast not shut me up into the hand of the enemy: thou hast set my feet in a large room.",
      "metadata": {
        "reference": "Psalms 31:8",
        "verseKey": "kjv:psalms:31:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:31:9",
      "numberLabel": "9",
      "text": "Have mercy upon me, O LORD, for I am in trouble: mine eye is consumed with grief, yea, my soul and my belly.",
      "metadata": {
        "reference": "Psalms 31:9",
        "verseKey": "kjv:psalms:31:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:31:10",
      "numberLabel": "10",
      "text": "For my life is spent with grief, and my years with sighing: my strength faileth because of mine iniquity, and my bones are consumed.",
      "metadata": {
        "reference": "Psalms 31:10",
        "verseKey": "kjv:psalms:31:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:31:11",
      "numberLabel": "11",
      "text": "I was a reproach among all mine enemies, but especially among my neighbours, and a fear to mine acquaintance: they that did see me without fled from me.",
      "metadata": {
        "reference": "Psalms 31:11",
        "verseKey": "kjv:psalms:31:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:31:12",
      "numberLabel": "12",
      "text": "I am forgotten as a dead man out of mind: I am like a broken vessel.",
      "metadata": {
        "reference": "Psalms 31:12",
        "verseKey": "kjv:psalms:31:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:31:13",
      "numberLabel": "13",
      "text": "For I have heard the slander of many: fear was on every side: while they took counsel together against me, they devised to take away my life.",
      "metadata": {
        "reference": "Psalms 31:13",
        "verseKey": "kjv:psalms:31:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:31:14",
      "numberLabel": "14",
      "text": "But I trusted in thee, O LORD: I said, Thou art my God.",
      "metadata": {
        "reference": "Psalms 31:14",
        "verseKey": "kjv:psalms:31:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:31:15",
      "numberLabel": "15",
      "text": "My times are in thy hand: deliver me from the hand of mine enemies, and from them that persecute me.",
      "metadata": {
        "reference": "Psalms 31:15",
        "verseKey": "kjv:psalms:31:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:31:16",
      "numberLabel": "16",
      "text": "Make thy face to shine upon thy servant: save me for thy mercies’ sake.",
      "metadata": {
        "reference": "Psalms 31:16",
        "verseKey": "kjv:psalms:31:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:31:17",
      "numberLabel": "17",
      "text": "Let me not be ashamed, O LORD; for I have called upon thee: let the wicked be ashamed, and let them be silent in the grave.",
      "metadata": {
        "reference": "Psalms 31:17",
        "verseKey": "kjv:psalms:31:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:psalms:31:18",
      "numberLabel": "18",
      "text": "Let the lying lips be put to silence; which speak grievous things proudly and contemptuously against the righteous.",
      "metadata": {
        "reference": "Psalms 31:18",
        "verseKey": "kjv:psalms:31:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:psalms:31:19",
      "numberLabel": "19",
      "text": "Oh how great is thy goodness, which thou hast laid up for them that fear thee; which thou hast wrought for them that trust in thee before the sons of men!",
      "metadata": {
        "reference": "Psalms 31:19",
        "verseKey": "kjv:psalms:31:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:psalms:31:20",
      "numberLabel": "20",
      "text": "Thou shalt hide them in the secret of thy presence from the pride of man: thou shalt keep them secretly in a pavilion from the strife of tongues.",
      "metadata": {
        "reference": "Psalms 31:20",
        "verseKey": "kjv:psalms:31:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:psalms:31:21",
      "numberLabel": "21",
      "text": "Blessed be the LORD: for he hath shewed me his marvellous kindness in a strong city.",
      "metadata": {
        "reference": "Psalms 31:21",
        "verseKey": "kjv:psalms:31:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:psalms:31:22",
      "numberLabel": "22",
      "text": "For I said in my haste, I am cut off from before thine eyes: nevertheless thou heardest the voice of my supplications when I cried unto thee.",
      "metadata": {
        "reference": "Psalms 31:22",
        "verseKey": "kjv:psalms:31:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:psalms:31:23",
      "numberLabel": "23",
      "text": "O love the LORD, all ye his saints: for the LORD preserveth the faithful, and plentifully rewardeth the proud doer.",
      "metadata": {
        "reference": "Psalms 31:23",
        "verseKey": "kjv:psalms:31:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:psalms:31:24",
      "numberLabel": "24",
      "text": "Be of good courage, and he shall strengthen your heart, all ye that hope in the LORD.",
      "metadata": {
        "reference": "Psalms 31:24",
        "verseKey": "kjv:psalms:31:24"
      }
    }
  ],
  "source": {
