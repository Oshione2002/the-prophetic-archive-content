  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:121:1",
      "numberLabel": "1",
      "text": "I will lift up mine eyes unto the hills, from whence cometh my help.",
      "metadata": {
        "reference": "Psalms 121:1",
        "verseKey": "kjv:psalms:121:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:121:2",
      "numberLabel": "2",
      "text": "My help cometh from the LORD, which made heaven and earth.",
      "metadata": {
        "reference": "Psalms 121:2",
        "verseKey": "kjv:psalms:121:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:121:3",
      "numberLabel": "3",
      "text": "He will not suffer thy foot to be moved: he that keepeth thee will not slumber.",
      "metadata": {
        "reference": "Psalms 121:3",
        "verseKey": "kjv:psalms:121:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:121:4",
      "numberLabel": "4",
      "text": "Behold, he that keepeth Israel shall neither slumber nor sleep.",
      "metadata": {
        "reference": "Psalms 121:4",
        "verseKey": "kjv:psalms:121:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:121:5",
      "numberLabel": "5",
      "text": "The LORD is thy keeper: the LORD is thy shade upon thy right hand.",
      "metadata": {
        "reference": "Psalms 121:5",
        "verseKey": "kjv:psalms:121:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:121:6",
      "numberLabel": "6",
      "text": "The sun shall not smite thee by day, nor the moon by night.",
      "metadata": {
        "reference": "Psalms 121:6",
        "verseKey": "kjv:psalms:121:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:121:7",
      "numberLabel": "7",
      "text": "The LORD shall preserve thee from all evil: he shall preserve thy soul.",
      "metadata": {
        "reference": "Psalms 121:7",
        "verseKey": "kjv:psalms:121:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:121:8",
      "numberLabel": "8",
      "text": "The LORD shall preserve thy going out and thy coming in from this time forth, and even for evermore.",
      "metadata": {
        "reference": "Psalms 121:8",
        "verseKey": "kjv:psalms:121:8"
      }
    }
  ],
