  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:148:1",
      "numberLabel": "1",
      "text": "Praise ye the LORD. Praise ye the LORD from the heavens: praise him in the heights.",
      "metadata": {
        "reference": "Psalms 148:1",
        "verseKey": "kjv:psalms:148:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:148:2",
      "numberLabel": "2",
      "text": "Praise ye him, all his angels: praise ye him, all his hosts.",
      "metadata": {
        "reference": "Psalms 148:2",
        "verseKey": "kjv:psalms:148:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:148:3",
      "numberLabel": "3",
      "text": "Praise ye him, sun and moon: praise him, all ye stars of light.",
      "metadata": {
        "reference": "Psalms 148:3",
        "verseKey": "kjv:psalms:148:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:148:4",
      "numberLabel": "4",
      "text": "Praise him, ye heavens of heavens, and ye waters that be above the heavens.",
      "metadata": {
        "reference": "Psalms 148:4",
        "verseKey": "kjv:psalms:148:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:148:5",
      "numberLabel": "5",
      "text": "Let them praise the name of the LORD: for he commanded, and they were created.",
      "metadata": {
        "reference": "Psalms 148:5",
        "verseKey": "kjv:psalms:148:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:148:6",
      "numberLabel": "6",
      "text": "He hath also stablished them for ever and ever: he hath made a decree which shall not pass.",
      "metadata": {
        "reference": "Psalms 148:6",
        "verseKey": "kjv:psalms:148:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:148:7",
      "numberLabel": "7",
      "text": "Praise the LORD from the earth, ye dragons, and all deeps:",
      "metadata": {
        "reference": "Psalms 148:7",
        "verseKey": "kjv:psalms:148:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:148:8",
      "numberLabel": "8",
      "text": "Fire, and hail; snow, and vapours; stormy wind fulfilling his word:",
      "metadata": {
        "reference": "Psalms 148:8",
        "verseKey": "kjv:psalms:148:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:148:9",
      "numberLabel": "9",
      "text": "Mountains, and all hills; fruitful trees, and all cedars:",
      "metadata": {
        "reference": "Psalms 148:9",
        "verseKey": "kjv:psalms:148:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:148:10",
      "numberLabel": "10",
      "text": "Beasts, and all cattle; creeping things, and flying fowl:",
      "metadata": {
        "reference": "Psalms 148:10",
        "verseKey": "kjv:psalms:148:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:148:11",
      "numberLabel": "11",
      "text": "Kings of the earth, and all people; princes, and all judges of the earth:",
      "metadata": {
        "reference": "Psalms 148:11",
        "verseKey": "kjv:psalms:148:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:148:12",
      "numberLabel": "12",
      "text": "Both young men, and maidens; old men, and children:",
      "metadata": {
        "reference": "Psalms 148:12",
        "verseKey": "kjv:psalms:148:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:148:13",
      "numberLabel": "13",
      "text": "Let them praise the name of the LORD: for his name alone is excellent; his glory is above the earth and heaven.",
      "metadata": {
        "reference": "Psalms 148:13",
        "verseKey": "kjv:psalms:148:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:148:14",
      "numberLabel": "14",
      "text": "He also exalteth the horn of his people, the praise of all his saints; even of the children of Israel, a people near unto him. Praise ye the LORD.",
      "metadata": {
        "reference": "Psalms 148:14",
        "verseKey": "kjv:psalms:148:14"
      }
    }
  ],
  "source": {
