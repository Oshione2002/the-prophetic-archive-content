    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:45:1",
      "numberLabel": "1",
      "text": "My heart is inditing a good matter: I speak of the things which I have made touching the king: my tongue is the pen of a ready writer.",
      "metadata": {
        "reference": "Psalms 45:1",
        "verseKey": "kjv:psalms:45:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:45:2",
      "numberLabel": "2",
      "text": "Thou art fairer than the children of men: grace is poured into thy lips: therefore God hath blessed thee for ever.",
      "metadata": {
        "reference": "Psalms 45:2",
        "verseKey": "kjv:psalms:45:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:45:3",
      "numberLabel": "3",
      "text": "Gird thy sword upon thy thigh, O most mighty, with thy glory and thy majesty.",
      "metadata": {
        "reference": "Psalms 45:3",
        "verseKey": "kjv:psalms:45:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:45:4",
      "numberLabel": "4",
      "text": "And in thy majesty ride prosperously because of truth and meekness and righteousness; and thy right hand shall teach thee terrible things.",
      "metadata": {
        "reference": "Psalms 45:4",
        "verseKey": "kjv:psalms:45:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:45:5",
      "numberLabel": "5",
      "text": "Thine arrows are sharp in the heart of the king’s enemies; whereby the people fall under thee.",
      "metadata": {
        "reference": "Psalms 45:5",
        "verseKey": "kjv:psalms:45:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:45:6",
      "numberLabel": "6",
      "text": "Thy throne, O God, is for ever and ever: the sceptre of thy kingdom is a right sceptre.",
      "metadata": {
        "reference": "Psalms 45:6",
        "verseKey": "kjv:psalms:45:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:45:7",
      "numberLabel": "7",
      "text": "Thou lovest righteousness, and hatest wickedness: therefore God, thy God, hath anointed thee with the oil of gladness above thy fellows.",
      "metadata": {
        "reference": "Psalms 45:7",
        "verseKey": "kjv:psalms:45:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:45:8",
      "numberLabel": "8",
      "text": "All thy garments smell of myrrh, and aloes, and cassia, out of the ivory palaces, whereby they have made thee glad.",
      "metadata": {
        "reference": "Psalms 45:8",
        "verseKey": "kjv:psalms:45:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:45:9",
      "numberLabel": "9",
      "text": "Kings’ daughters were among thy honourable women: upon thy right hand did stand the queen in gold of Ophir.",
      "metadata": {
        "reference": "Psalms 45:9",
        "verseKey": "kjv:psalms:45:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:45:10",
      "numberLabel": "10",
      "text": "Hearken, O daughter, and consider, and incline thine ear; forget also thine own people, and thy father’s house;",
      "metadata": {
        "reference": "Psalms 45:10",
        "verseKey": "kjv:psalms:45:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:45:11",
      "numberLabel": "11",
      "text": "So shall the king greatly desire thy beauty: for he is thy Lord; and worship thou him.",
      "metadata": {
        "reference": "Psalms 45:11",
        "verseKey": "kjv:psalms:45:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:45:12",
      "numberLabel": "12",
      "text": "And the daughter of Tyre shall be there with a gift; even the rich among the people shall intreat thy favour.",
      "metadata": {
        "reference": "Psalms 45:12",
        "verseKey": "kjv:psalms:45:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:45:13",
      "numberLabel": "13",
      "text": "The king’s daughter is all glorious within: her clothing is of wrought gold.",
      "metadata": {
        "reference": "Psalms 45:13",
        "verseKey": "kjv:psalms:45:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:45:14",
      "numberLabel": "14",
      "text": "She shall be brought unto the king in raiment of needlework: the virgins her companions that follow her shall be brought unto thee.",
      "metadata": {
        "reference": "Psalms 45:14",
        "verseKey": "kjv:psalms:45:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:45:15",
      "numberLabel": "15",
      "text": "With gladness and rejoicing shall they be brought: they shall enter into the king’s palace.",
      "metadata": {
        "reference": "Psalms 45:15",
        "verseKey": "kjv:psalms:45:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:45:16",
      "numberLabel": "16",
      "text": "Instead of thy fathers shall be thy children, whom thou mayest make princes in all the earth.",
      "metadata": {
        "reference": "Psalms 45:16",
        "verseKey": "kjv:psalms:45:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:45:17",
      "numberLabel": "17",
      "text": "I will make thy name to be remembered in all generations: therefore shall the people praise thee for ever and ever.",
      "metadata": {
        "reference": "Psalms 45:17",
        "verseKey": "kjv:psalms:45:17"
      }
    }
  ],
  "source": {
