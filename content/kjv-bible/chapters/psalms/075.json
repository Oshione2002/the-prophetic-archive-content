  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:75:1",
      "numberLabel": "1",
      "text": "Unto thee, O God, do we give thanks, unto thee do we give thanks: for that thy name is near thy wondrous works declare.",
      "metadata": {
        "reference": "Psalms 75:1",
        "verseKey": "kjv:psalms:75:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:75:2",
      "numberLabel": "2",
      "text": "When I shall receive the congregation I will judge uprightly.",
      "metadata": {
        "reference": "Psalms 75:2",
        "verseKey": "kjv:psalms:75:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:75:3",
      "numberLabel": "3",
      "text": "The earth and all the inhabitants thereof are dissolved: I bear up the pillars of it. Selah.",
      "metadata": {
        "reference": "Psalms 75:3",
        "verseKey": "kjv:psalms:75:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:75:4",
      "numberLabel": "4",
      "text": "I said unto the fools, Deal not foolishly: and to the wicked, Lift not up the horn:",
      "metadata": {
        "reference": "Psalms 75:4",
        "verseKey": "kjv:psalms:75:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:75:5",
      "numberLabel": "5",
      "text": "Lift not up your horn on high: speak not with a stiff neck.",
      "metadata": {
        "reference": "Psalms 75:5",
        "verseKey": "kjv:psalms:75:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:75:6",
      "numberLabel": "6",
      "text": "For promotion cometh neither from the east, nor from the west, nor from the south.",
      "metadata": {
        "reference": "Psalms 75:6",
        "verseKey": "kjv:psalms:75:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:75:7",
      "numberLabel": "7",
      "text": "But God is the judge: he putteth down one, and setteth up another.",
      "metadata": {
        "reference": "Psalms 75:7",
        "verseKey": "kjv:psalms:75:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:75:8",
      "numberLabel": "8",
      "text": "For in the hand of the LORD there is a cup, and the wine is red; it is full of mixture; and he poureth out of the same: but the dregs thereof, all the wicked of the earth shall wring them out, and drink them.",
      "metadata": {
        "reference": "Psalms 75:8",
        "verseKey": "kjv:psalms:75:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:75:9",
      "numberLabel": "9",
      "text": "But I will declare for ever; I will sing praises to the God of Jacob.",
      "metadata": {
        "reference": "Psalms 75:9",
        "verseKey": "kjv:psalms:75:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:75:10",
      "numberLabel": "10",
      "text": "All the horns of the wicked also will I cut off; but the horns of the righteous shall be exalted.",
      "metadata": {
        "reference": "Psalms 75:10",
        "verseKey": "kjv:psalms:75:10"
      }
    }
  ],
  "source": {
