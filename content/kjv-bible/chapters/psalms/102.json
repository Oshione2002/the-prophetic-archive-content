  "document_type": "bible_chapter",
  "number": 102,
  "title": "Psalms 102",
  "display_title": "Psalms 102",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "psalms",
  "book": "Psalms",
  "bookName": "Psalms",
  "bookOrder": 19,
  "testament": "old",
  "chapter": 102,
  "sortOrder": 19102,
  "verseCount": 28,
  "aliases": [
    "Psalm",
    "Psalms",
    "Ps",
    "Psa",
    "Psm"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:102:1",
      "numberLabel": "1",
      "text": "Hear my prayer, O LORD, and let my cry come unto thee.",
      "metadata": {
        "reference": "Psalms 102:1",
        "verseKey": "kjv:psalms:102:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:102:2",
      "numberLabel": "2",
      "text": "Hide not thy face from me in the day when I am in trouble; incline thine ear unto me: in the day when I call answer me speedily.",
      "metadata": {
        "reference": "Psalms 102:2",
        "verseKey": "kjv:psalms:102:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:102:3",
      "numberLabel": "3",
      "text": "For my days are consumed like smoke, and my bones are burned as an hearth.",
      "metadata": {
        "reference": "Psalms 102:3",
        "verseKey": "kjv:psalms:102:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:102:4",
      "numberLabel": "4",
      "text": "My heart is smitten, and withered like grass; so that I forget to eat my bread.",
      "metadata": {
        "reference": "Psalms 102:4",
        "verseKey": "kjv:psalms:102:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:102:5",
      "numberLabel": "5",
      "text": "By reason of the voice of my groaning my bones cleave to my skin.",
      "metadata": {
        "reference": "Psalms 102:5",
        "verseKey": "kjv:psalms:102:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:102:6",
      "numberLabel": "6",
      "text": "I am like a pelican of the wilderness: I am like an owl of the desert.",
      "metadata": {
        "reference": "Psalms 102:6",
        "verseKey": "kjv:psalms:102:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:102:7",
      "numberLabel": "7",
      "text": "I watch, and am as a sparrow alone upon the house top.",
      "metadata": {
        "reference": "Psalms 102:7",
        "verseKey": "kjv:psalms:102:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:102:8",
      "numberLabel": "8",
      "text": "Mine enemies reproach me all the day; and they that are mad against me are sworn against me.",
      "metadata": {
        "reference": "Psalms 102:8",
        "verseKey": "kjv:psalms:102:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:102:9",
      "numberLabel": "9",
      "text": "For I have eaten ashes like bread, and mingled my drink with weeping,",
      "metadata": {
        "reference": "Psalms 102:9",
        "verseKey": "kjv:psalms:102:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:102:10",
      "numberLabel": "10",
      "text": "Because of thine indignation and thy wrath: for thou hast lifted me up, and cast me down.",
      "metadata": {
        "reference": "Psalms 102:10",
        "verseKey": "kjv:psalms:102:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:102:11",
      "numberLabel": "11",
      "text": "My days are like a shadow that declineth; and I am withered like grass.",
      "metadata": {
        "reference": "Psalms 102:11",
        "verseKey": "kjv:psalms:102:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:102:12",
      "numberLabel": "12",
      "text": "But thou, O LORD, shalt endure for ever; and thy remembrance unto all generations.",
      "metadata": {
        "reference": "Psalms 102:12",
        "verseKey": "kjv:psalms:102:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:102:13",
      "numberLabel": "13",
      "text": "Thou shalt arise, and have mercy upon Zion: for the time to favour her, yea, the set time, is come.",
      "metadata": {
        "reference": "Psalms 102:13",
        "verseKey": "kjv:psalms:102:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:102:14",
      "numberLabel": "14",
      "text": "For thy servants take pleasure in her stones, and favour the dust thereof.",
      "metadata": {
        "reference": "Psalms 102:14",
        "verseKey": "kjv:psalms:102:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:psalms:102:15",
      "numberLabel": "15",
      "text": "So the heathen shall fear the name of the LORD, and all the kings of the earth thy glory.",
      "metadata": {
        "reference": "Psalms 102:15",
        "verseKey": "kjv:psalms:102:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:psalms:102:16",
      "numberLabel": "16",
      "text": "When the LORD shall build up Zion, he shall appear in his glory.",
      "metadata": {
        "reference": "Psalms 102:16",
        "verseKey": "kjv:psalms:102:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:psalms:102:17",
      "numberLabel": "17",
      "text": "He will regard the prayer of the destitute, and not despise their prayer.",
      "metadata": {
        "reference": "Psalms 102:17",
        "verseKey": "kjv:psalms:102:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:psalms:102:18",
      "numberLabel": "18",
      "text": "This shall be written for the generation to come: and the people which shall be created shall praise the LORD.",
      "metadata": {
        "reference": "Psalms 102:18",
        "verseKey": "kjv:psalms:102:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:psalms:102:19",
      "numberLabel": "19",
      "text": "For he hath looked down from the height of his sanctuary; from heaven did the LORD behold the earth;",
      "metadata": {
        "reference": "Psalms 102:19",
        "verseKey": "kjv:psalms:102:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:psalms:102:20",
      "numberLabel": "20",
      "text": "To hear the groaning of the prisoner; to loose those that are appointed to death;",
      "metadata": {
        "reference": "Psalms 102:20",
        "verseKey": "kjv:psalms:102:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:psalms:102:21",
      "numberLabel": "21",
      "text": "To declare the name of the LORD in Zion, and his praise in Jerusalem;",
      "metadata": {
        "reference": "Psalms 102:21",
        "verseKey": "kjv:psalms:102:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:psalms:102:22",
      "numberLabel": "22",
      "text": "When the people are gathered together, and the kingdoms, to serve the LORD.",
      "metadata": {
        "reference": "Psalms 102:22",
        "verseKey": "kjv:psalms:102:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:psalms:102:23",
      "numberLabel": "23",
      "text": "He weakened my strength in the way; he shortened my days.",
      "metadata": {
        "reference": "Psalms 102:23",
        "verseKey": "kjv:psalms:102:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:psalms:102:24",
      "numberLabel": "24",
      "text": "I said, O my God, take me not away in the midst of my days: thy years are throughout all generations.",
      "metadata": {
        "reference": "Psalms 102:24",
        "verseKey": "kjv:psalms:102:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:psalms:102:25",
      "numberLabel": "25",
      "text": "Of old hast thou laid the foundation of the earth: and the heavens are the work of thy hands.",
      "metadata": {
        "reference": "Psalms 102:25",
        "verseKey": "kjv:psalms:102:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:psalms:102:26",
      "numberLabel": "26",
      "text": "They shall perish, but thou shalt endure: yea, all of them shall wax old like a garment; as a vesture shalt thou change them, and they shall be changed:",
      "metadata": {
        "reference": "Psalms 102:26",
        "verseKey": "kjv:psalms:102:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:psalms:102:27",
      "numberLabel": "27",
      "text": "But thou art the same, and thy years shall have no end.",
      "metadata": {
        "reference": "Psalms 102:27",
        "verseKey": "kjv:psalms:102:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:psalms:102:28",
      "numberLabel": "28",
      "text": "The children of thy servants shall continue, and their seed shall be established before thee.",
      "metadata": {
        "reference": "Psalms 102:28",
        "verseKey": "kjv:psalms:102:28"
      }
    }
  ],
  "source": {
