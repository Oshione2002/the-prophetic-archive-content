  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:76:1",
      "numberLabel": "1",
      "text": "In Judah is God known: his name is great in Israel.",
      "metadata": {
        "reference": "Psalms 76:1",
        "verseKey": "kjv:psalms:76:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:76:2",
      "numberLabel": "2",
      "text": "In Salem also is his tabernacle, and his dwelling place in Zion.",
      "metadata": {
        "reference": "Psalms 76:2",
        "verseKey": "kjv:psalms:76:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:76:3",
      "numberLabel": "3",
      "text": "There brake he the arrows of the bow, the shield, and the sword, and the battle. Selah.",
      "metadata": {
        "reference": "Psalms 76:3",
        "verseKey": "kjv:psalms:76:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:76:4",
      "numberLabel": "4",
      "text": "Thou art more glorious and excellent than the mountains of prey.",
      "metadata": {
        "reference": "Psalms 76:4",
        "verseKey": "kjv:psalms:76:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:76:5",
      "numberLabel": "5",
      "text": "The stouthearted are spoiled, they have slept their sleep: and none of the men of might have found their hands.",
      "metadata": {
        "reference": "Psalms 76:5",
        "verseKey": "kjv:psalms:76:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:76:6",
      "numberLabel": "6",
      "text": "At thy rebuke, O God of Jacob, both the chariot and horse are cast into a dead sleep.",
      "metadata": {
        "reference": "Psalms 76:6",
        "verseKey": "kjv:psalms:76:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:76:7",
      "numberLabel": "7",
      "text": "Thou, even thou, art to be feared: and who may stand in thy sight when once thou art angry?",
      "metadata": {
        "reference": "Psalms 76:7",
        "verseKey": "kjv:psalms:76:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:76:8",
      "numberLabel": "8",
      "text": "Thou didst cause judgment to be heard from heaven; the earth feared, and was still,",
      "metadata": {
        "reference": "Psalms 76:8",
        "verseKey": "kjv:psalms:76:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:76:9",
      "numberLabel": "9",
      "text": "When God arose to judgment, to save all the meek of the earth. Selah.",
      "metadata": {
        "reference": "Psalms 76:9",
        "verseKey": "kjv:psalms:76:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:76:10",
      "numberLabel": "10",
      "text": "Surely the wrath of man shall praise thee: the remainder of wrath shalt thou restrain.",
      "metadata": {
        "reference": "Psalms 76:10",
        "verseKey": "kjv:psalms:76:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:76:11",
      "numberLabel": "11",
      "text": "Vow, and pay unto the LORD your God: let all that be round about him bring presents unto him that ought to be feared.",
      "metadata": {
        "reference": "Psalms 76:11",
        "verseKey": "kjv:psalms:76:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:76:12",
      "numberLabel": "12",
      "text": "He shall cut off the spirit of princes: he is terrible to the kings of the earth.",
      "metadata": {
        "reference": "Psalms 76:12",
        "verseKey": "kjv:psalms:76:12"
      }
    }
  ],
  "source": {
