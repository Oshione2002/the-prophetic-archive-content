  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:124:1",
      "numberLabel": "1",
      "text": "If it had not been the LORD who was on our side, now may Israel say;",
      "metadata": {
        "reference": "Psalms 124:1",
        "verseKey": "kjv:psalms:124:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:124:2",
      "numberLabel": "2",
      "text": "If it had not been the LORD who was on our side, when men rose up against us:",
      "metadata": {
        "reference": "Psalms 124:2",
        "verseKey": "kjv:psalms:124:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:124:3",
      "numberLabel": "3",
      "text": "Then they had swallowed us up quick, when their wrath was kindled against us:",
      "metadata": {
        "reference": "Psalms 124:3",
        "verseKey": "kjv:psalms:124:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:124:4",
      "numberLabel": "4",
      "text": "Then the waters had overwhelmed us, the stream had gone over our soul:",
      "metadata": {
        "reference": "Psalms 124:4",
        "verseKey": "kjv:psalms:124:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:124:5",
      "numberLabel": "5",
      "text": "Then the proud waters had gone over our soul.",
      "metadata": {
        "reference": "Psalms 124:5",
        "verseKey": "kjv:psalms:124:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:124:6",
      "numberLabel": "6",
      "text": "Blessed be the LORD, who hath not given us as a prey to their teeth.",
      "metadata": {
        "reference": "Psalms 124:6",
        "verseKey": "kjv:psalms:124:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:124:7",
      "numberLabel": "7",
      "text": "Our soul is escaped as a bird out of the snare of the fowlers: the snare is broken, and we are escaped.",
      "metadata": {
        "reference": "Psalms 124:7",
        "verseKey": "kjv:psalms:124:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:124:8",
      "numberLabel": "8",
      "text": "Our help is in the name of the LORD, who made heaven and earth.",
      "metadata": {
        "reference": "Psalms 124:8",
        "verseKey": "kjv:psalms:124:8"
      }
    }
  ],
