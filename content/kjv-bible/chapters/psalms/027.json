  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:psalms:27:1",
      "numberLabel": "1",
      "text": "The LORD is my light and my salvation; whom shall I fear? the LORD is the strength of my life; of whom shall I be afraid?",
      "metadata": {
        "reference": "Psalms 27:1",
        "verseKey": "kjv:psalms:27:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:psalms:27:2",
      "numberLabel": "2",
      "text": "When the wicked, even mine enemies and my foes, came upon me to eat up my flesh, they stumbled and fell.",
      "metadata": {
        "reference": "Psalms 27:2",
        "verseKey": "kjv:psalms:27:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:psalms:27:3",
      "numberLabel": "3",
      "text": "Though an host should encamp against me, my heart shall not fear: though war should rise against me, in this will I be confident.",
      "metadata": {
        "reference": "Psalms 27:3",
        "verseKey": "kjv:psalms:27:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:psalms:27:4",
      "numberLabel": "4",
      "text": "One thing have I desired of the LORD, that will I seek after; that I may dwell in the house of the LORD all the days of my life, to behold the beauty of the LORD, and to enquire in his temple.",
      "metadata": {
        "reference": "Psalms 27:4",
        "verseKey": "kjv:psalms:27:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:psalms:27:5",
      "numberLabel": "5",
      "text": "For in the time of trouble he shall hide me in his pavilion: in the secret of his tabernacle shall he hide me; he shall set me up upon a rock.",
      "metadata": {
        "reference": "Psalms 27:5",
        "verseKey": "kjv:psalms:27:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:psalms:27:6",
      "numberLabel": "6",
      "text": "And now shall mine head be lifted up above mine enemies round about me: therefore will I offer in his tabernacle sacrifices of joy; I will sing, yea, I will sing praises unto the LORD.",
      "metadata": {
        "reference": "Psalms 27:6",
        "verseKey": "kjv:psalms:27:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:psalms:27:7",
      "numberLabel": "7",
      "text": "Hear, O LORD, when I cry with my voice: have mercy also upon me, and answer me.",
      "metadata": {
        "reference": "Psalms 27:7",
        "verseKey": "kjv:psalms:27:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:psalms:27:8",
      "numberLabel": "8",
      "text": "When thou saidst, Seek ye my face; my heart said unto thee, Thy face, LORD, will I seek.",
      "metadata": {
        "reference": "Psalms 27:8",
        "verseKey": "kjv:psalms:27:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:psalms:27:9",
      "numberLabel": "9",
      "text": "Hide not thy face far from me; put not thy servant away in anger: thou hast been my help; leave me not, neither forsake me, O God of my salvation.",
      "metadata": {
        "reference": "Psalms 27:9",
        "verseKey": "kjv:psalms:27:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:psalms:27:10",
      "numberLabel": "10",
      "text": "When my father and my mother forsake me, then the LORD will take me up.",
      "metadata": {
        "reference": "Psalms 27:10",
        "verseKey": "kjv:psalms:27:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:psalms:27:11",
      "numberLabel": "11",
      "text": "Teach me thy way, O LORD, and lead me in a plain path, because of mine enemies.",
      "metadata": {
        "reference": "Psalms 27:11",
        "verseKey": "kjv:psalms:27:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:psalms:27:12",
      "numberLabel": "12",
      "text": "Deliver me not over unto the will of mine enemies: for false witnesses are risen up against me, and such as breathe out cruelty.",
      "metadata": {
        "reference": "Psalms 27:12",
        "verseKey": "kjv:psalms:27:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:psalms:27:13",
      "numberLabel": "13",
      "text": "I had fainted, unless I had believed to see the goodness of the LORD in the land of the living.",
      "metadata": {
        "reference": "Psalms 27:13",
        "verseKey": "kjv:psalms:27:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:psalms:27:14",
      "numberLabel": "14",
      "text": "Wait on the LORD: be of good courage, and he shall strengthen thine heart: wait, I say, on the LORD.",
      "metadata": {
        "reference": "Psalms 27:14",
        "verseKey": "kjv:psalms:27:14"
      }
    }
  ],
