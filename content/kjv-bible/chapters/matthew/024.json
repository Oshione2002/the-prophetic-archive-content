{
  "schemaVersion": 1,
  "id": "kjv-matthew-024",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 24,
  "title": "Matthew 24",
  "display_title": "Matthew 24",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "matthew",
  "book": "Matthew",
  "bookName": "Matthew",
  "bookOrder": 40,
  "testament": "new",
  "chapter": 24,
  "sortOrder": 40024,
  "verseCount": 51,
  "aliases": [
    "Matt",
    "Mt"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:matthew:24:1",
      "numberLabel": "1",
      "text": "And Jesus went out, and departed from the temple: and his disciples came to him for to shew him the buildings of the temple.",
      "metadata": {
        "reference": "Matthew 24:1",
        "verseKey": "kjv:matthew:24:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:matthew:24:2",
      "numberLabel": "2",
      "text": "And Jesus said unto them, See ye not all these things? verily I say unto you, There shall not be left here one stone upon another, that shall not be thrown down.",
      "metadata": {
        "reference": "Matthew 24:2",
        "verseKey": "kjv:matthew:24:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:matthew:24:3",
      "numberLabel": "3",
      "text": "And as he sat upon the mount of Olives, the disciples came unto him privately, saying, Tell us, when shall these things be? and what shall be the sign of thy coming, and of the end of the world?",
      "metadata": {
        "reference": "Matthew 24:3",
        "verseKey": "kjv:matthew:24:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:matthew:24:4",
      "numberLabel": "4",
      "text": "And Jesus answered and said unto them, Take heed that no man deceive you.",
      "metadata": {
        "reference": "Matthew 24:4",
        "verseKey": "kjv:matthew:24:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:matthew:24:5",
      "numberLabel": "5",
      "text": "For many shall come in my name, saying, I am Christ; and shall deceive many.",
      "metadata": {
        "reference": "Matthew 24:5",
        "verseKey": "kjv:matthew:24:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:matthew:24:6",
      "numberLabel": "6",
      "text": "And ye shall hear of wars and rumours of wars: see that ye be not troubled: for all these things must come to pass, but the end is not yet.",
      "metadata": {
        "reference": "Matthew 24:6",
        "verseKey": "kjv:matthew:24:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:matthew:24:7",
      "numberLabel": "7",
      "text": "For nation shall rise against nation, and kingdom against kingdom: and there shall be famines, and pestilences, and earthquakes, in divers places.",
      "metadata": {
        "reference": "Matthew 24:7",
        "verseKey": "kjv:matthew:24:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:matthew:24:8",
      "numberLabel": "8",
      "text": "All these are the beginning of sorrows.",
      "metadata": {
        "reference": "Matthew 24:8",
        "verseKey": "kjv:matthew:24:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:matthew:24:9",
      "numberLabel": "9",
      "text": "Then shall they deliver you up to be afflicted, and shall kill you: and ye shall be hated of all nations for my name’s sake.",
      "metadata": {
        "reference": "Matthew 24:9",
        "verseKey": "kjv:matthew:24:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:matthew:24:10",
      "numberLabel": "10",
      "text": "And then shall many be offended, and shall betray one another, and shall hate one another.",
      "metadata": {
        "reference": "Matthew 24:10",
        "verseKey": "kjv:matthew:24:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:matthew:24:11",
      "numberLabel": "11",
      "text": "And many false prophets shall rise, and shall deceive many.",
      "metadata": {
        "reference": "Matthew 24:11",
        "verseKey": "kjv:matthew:24:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:matthew:24:12",
      "numberLabel": "12",
      "text": "And because iniquity shall abound, the love of many shall wax cold.",
      "metadata": {
        "reference": "Matthew 24:12",
        "verseKey": "kjv:matthew:24:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:matthew:24:13",
      "numberLabel": "13",
      "text": "But he that shall endure unto the end, the same shall be saved.",
      "metadata": {
        "reference": "Matthew 24:13",
        "verseKey": "kjv:matthew:24:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:matthew:24:14",
      "numberLabel": "14",
      "text": "And this gospel of the kingdom shall be preached in all the world for a witness unto all nations; and then shall the end come.",
      "metadata": {
        "reference": "Matthew 24:14",
        "verseKey": "kjv:matthew:24:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:matthew:24:15",
      "numberLabel": "15",
      "text": "When ye therefore shall see the abomination of desolation, spoken of by Daniel the prophet, stand in the holy place, (whoso readeth, let him understand:)",
      "metadata": {
        "reference": "Matthew 24:15",
        "verseKey": "kjv:matthew:24:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:matthew:24:16",
      "numberLabel": "16",
      "text": "Then let them which be in Judaea flee into the mountains:",
      "metadata": {
        "reference": "Matthew 24:16",
        "verseKey": "kjv:matthew:24:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:matthew:24:17",
      "numberLabel": "17",
      "text": "Let him which is on the housetop not come down to take any thing out of his house:",
      "metadata": {
        "reference": "Matthew 24:17",
        "verseKey": "kjv:matthew:24:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:matthew:24:18",
      "numberLabel": "18",
      "text": "Neither let him which is in the field return back to take his clothes.",
      "metadata": {
        "reference": "Matthew 24:18",
        "verseKey": "kjv:matthew:24:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:matthew:24:19",
      "numberLabel": "19",
      "text": "And woe unto them that are with child, and to them that give suck in those days!",
      "metadata": {
        "reference": "Matthew 24:19",
        "verseKey": "kjv:matthew:24:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:matthew:24:20",
      "numberLabel": "20",
      "text": "But pray ye that your flight be not in the winter, neither on the sabbath day:",
      "metadata": {
        "reference": "Matthew 24:20",
        "verseKey": "kjv:matthew:24:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:matthew:24:21",
      "numberLabel": "21",
      "text": "For then shall be great tribulation, such as was not since the beginning of the world to this time, no, nor ever shall be.",
      "metadata": {
        "reference": "Matthew 24:21",
        "verseKey": "kjv:matthew:24:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:matthew:24:22",
      "numberLabel": "22",
      "text": "And except those days should be shortened, there should no flesh be saved: but for the elect’s sake those days shall be shortened.",
      "metadata": {
        "reference": "Matthew 24:22",
        "verseKey": "kjv:matthew:24:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:matthew:24:23",
      "numberLabel": "23",
      "text": "Then if any man shall say unto you, Lo, here is Christ, or there; believe it not.",
      "metadata": {
        "reference": "Matthew 24:23",
        "verseKey": "kjv:matthew:24:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:matthew:24:24",
      "numberLabel": "24",
      "text": "For there shall arise false Christs, and false prophets, and shall shew great signs and wonders; insomuch that, if it were possible, they shall deceive the very elect.",
      "metadata": {
        "reference": "Matthew 24:24",
        "verseKey": "kjv:matthew:24:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:matthew:24:25",
      "numberLabel": "25",
      "text": "Behold, I have told you before.",
      "metadata": {
        "reference": "Matthew 24:25",
        "verseKey": "kjv:matthew:24:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:matthew:24:26",
      "numberLabel": "26",
      "text": "Wherefore if they shall say unto you, Behold, he is in the desert; go not forth: behold, he is in the secret chambers; believe it not.",
      "metadata": {
        "reference": "Matthew 24:26",
        "verseKey": "kjv:matthew:24:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:matthew:24:27",
      "numberLabel": "27",
      "text": "For as the lightning cometh out of the east, and shineth even unto the west; so shall also the coming of the Son of man be.",
      "metadata": {
        "reference": "Matthew 24:27",
        "verseKey": "kjv:matthew:24:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:matthew:24:28",
      "numberLabel": "28",
      "text": "For wheresoever the carcase is, there will the eagles be gathered together.",
      "metadata": {
        "reference": "Matthew 24:28",
        "verseKey": "kjv:matthew:24:28"
      }
    },
    {
      "id": "verse-029",
      "type": "bible_verse",
      "verse": 29,
      "verseId": "kjv:matthew:24:29",
      "numberLabel": "29",
      "text": "Immediately after the tribulation of those days shall the sun be darkened, and the moon shall not give her light, and the stars shall fall from heaven, and the powers of the heavens shall be shaken:",
      "metadata": {
        "reference": "Matthew 24:29",
        "verseKey": "kjv:matthew:24:29"
      }
    },
    {
      "id": "verse-030",
      "type": "bible_verse",
      "verse": 30,
      "verseId": "kjv:matthew:24:30",
      "numberLabel": "30",
      "text": "And then shall appear the sign of the Son of man in heaven: and then shall all the tribes of the earth mourn, and they shall see the Son of man coming in the clouds of heaven with power and great glory.",
      "metadata": {
        "reference": "Matthew 24:30",
        "verseKey": "kjv:matthew:24:30"
      }
    },
    {
      "id": "verse-031",
      "type": "bible_verse",
      "verse": 31,
      "verseId": "kjv:matthew:24:31",
      "numberLabel": "31",
      "text": "And he shall send his angels with a great sound of a trumpet, and they shall gather together his elect from the four winds, from one end of heaven to the other.",
      "metadata": {
        "reference": "Matthew 24:31",
        "verseKey": "kjv:matthew:24:31"
      }
    },
    {
      "id": "verse-032",
      "type": "bible_verse",
      "verse": 32,
      "verseId": "kjv:matthew:24:32",
      "numberLabel": "32",
      "text": "Now learn a parable of the fig tree; When his branch is yet tender, and putteth forth leaves, ye know that summer is nigh:",
      "metadata": {
        "reference": "Matthew 24:32",
        "verseKey": "kjv:matthew:24:32"
      }
    },
    {
      "id": "verse-033",
      "type": "bible_verse",
      "verse": 33,
      "verseId": "kjv:matthew:24:33",
      "numberLabel": "33",
      "text": "So likewise ye, when ye shall see all these things, know that it is near, even at the doors.",
      "metadata": {
        "reference": "Matthew 24:33",
        "verseKey": "kjv:matthew:24:33"
      }
    },
    {
      "id": "verse-034",
      "type": "bible_verse",
      "verse": 34,
      "verseId": "kjv:matthew:24:34",
      "numberLabel": "34",
      "text": "Verily I say unto you, This generation shall not pass, till all these things be fulfilled.",
      "metadata": {
        "reference": "Matthew 24:34",
        "verseKey": "kjv:matthew:24:34"
      }
    },
    {
      "id": "verse-035",
      "type": "bible_verse",
      "verse": 35,
      "verseId": "kjv:matthew:24:35",
      "numberLabel": "35",
      "text": "Heaven and earth shall pass away, but my words shall not pass away.",
      "metadata": {
        "reference": "Matthew 24:35",
        "verseKey": "kjv:matthew:24:35"
      }
    },
    {
      "id": "verse-036",
      "type": "bible_verse",
      "verse": 36,
      "verseId": "kjv:matthew:24:36",
      "numberLabel": "36",
      "text": "But of that day and hour knoweth no man, no, not the angels of heaven, but my Father only.",
      "metadata": {
        "reference": "Matthew 24:36",
        "verseKey": "kjv:matthew:24:36"
      }
    },
    {
      "id": "verse-037",
      "type": "bible_verse",
      "verse": 37,
      "verseId": "kjv:matthew:24:37",
      "numberLabel": "37",
      "text": "But as the days of Noe were, so shall also the coming of the Son of man be.",
      "metadata": {
        "reference": "Matthew 24:37",
        "verseKey": "kjv:matthew:24:37"
      }
    },
    {
      "id": "verse-038",
      "type": "bible_verse",
      "verse": 38,
      "verseId": "kjv:matthew:24:38",
      "numberLabel": "38",
      "text": "For as in the days that were before the flood they were eating and drinking, marrying and giving in marriage, until the day that Noe entered into the ark,",
      "metadata": {
        "reference": "Matthew 24:38",
        "verseKey": "kjv:matthew:24:38"
      }
    },
    {
      "id": "verse-039",
      "type": "bible_verse",
      "verse": 39,
      "verseId": "kjv:matthew:24:39",
      "numberLabel": "39",
      "text": "And knew not until the flood came, and took them all away; so shall also the coming of the Son of man be.",
      "metadata": {
        "reference": "Matthew 24:39",
        "verseKey": "kjv:matthew:24:39"
      }
    },
    {
      "id": "verse-040",
      "type": "bible_verse",
      "verse": 40,
      "verseId": "kjv:matthew:24:40",
      "numberLabel": "40",
      "text": "Then shall two be in the field; the one shall be taken, and the other left.",
      "metadata": {
        "reference": "Matthew 24:40",
        "verseKey": "kjv:matthew:24:40"
      }
    },
    {
      "id": "verse-041",
      "type": "bible_verse",
      "verse": 41,
      "verseId": "kjv:matthew:24:41",
      "numberLabel": "41",
      "text": "Two women shall be grinding at the mill; the one shall be taken, and the other left.",
      "metadata": {
        "reference": "Matthew 24:41",
        "verseKey": "kjv:matthew:24:41"
      }
    },
    {
      "id": "verse-042",
      "type": "bible_verse",
      "verse": 42,
      "verseId": "kjv:matthew:24:42",
      "numberLabel": "42",
      "text": "Watch therefore: for ye know not what hour your Lord doth come.",
      "metadata": {
        "reference": "Matthew 24:42",
        "verseKey": "kjv:matthew:24:42"
      }
    },
    {
      "id": "verse-043",
      "type": "bible_verse",
      "verse": 43,
      "verseId": "kjv:matthew:24:43",
      "numberLabel": "43",
      "text": "But know this, that if the goodman of the house had known in what watch the thief would come, he would have watched, and would not have suffered his house to be broken up.",
      "metadata": {
        "reference": "Matthew 24:43",
        "verseKey": "kjv:matthew:24:43"
      }
    },
    {
      "id": "verse-044",
      "type": "bible_verse",
      "verse": 44,
      "verseId": "kjv:matthew:24:44",
      "numberLabel": "44",
      "text": "Therefore be ye also ready: for in such an hour as ye think not the Son of man cometh.",
      "metadata": {
        "reference": "Matthew 24:44",
        "verseKey": "kjv:matthew:24:44"
      }
    },
    {
      "id": "verse-045",
      "type": "bible_verse",
      "verse": 45,
      "verseId": "kjv:matthew:24:45",
      "numberLabel": "45",
      "text": "Who then is a faithful and wise servant, whom his lord hath made ruler over his household, to give them meat in due season?",
      "metadata": {
        "reference": "Matthew 24:45",
        "verseKey": "kjv:matthew:24:45"
      }
    },
    {
      "id": "verse-046",
      "type": "bible_verse",
      "verse": 46,
      "verseId": "kjv:matthew:24:46",
      "numberLabel": "46",
      "text": "Blessed is that servant, whom his lord when he cometh shall find so doing.",
      "metadata": {
        "reference": "Matthew 24:46",
        "verseKey": "kjv:matthew:24:46"
      }
    },
    {
      "id": "verse-047",
      "type": "bible_verse",
      "verse": 47,
      "verseId": "kjv:matthew:24:47",
      "numberLabel": "47",
      "text": "Verily I say unto you, That he shall make him ruler over all his goods.",
      "metadata": {
        "reference": "Matthew 24:47",
        "verseKey": "kjv:matthew:24:47"
      }
    },
    {
      "id": "verse-048",
      "type": "bible_verse",
      "verse": 48,
      "verseId": "kjv:matthew:24:48",
      "numberLabel": "48",
      "text": "But and if that evil servant shall say in his heart, My lord delayeth his coming;",
      "metadata": {
        "reference": "Matthew 24:48",
        "verseKey": "kjv:matthew:24:48"
      }
    },
    {
      "id": "verse-049",
      "type": "bible_verse",
      "verse": 49,
      "verseId": "kjv:matthew:24:49",
      "numberLabel": "49",
      "text": "And shall begin to smite his fellowservants, and to eat and drink with the drunken;",
      "metadata": {
        "reference": "Matthew 24:49",
        "verseKey": "kjv:matthew:24:49"
      }
    },
    {
      "id": "verse-050",
      "type": "bible_verse",
      "verse": 50,
      "verseId": "kjv:matthew:24:50",
      "numberLabel": "50",
      "text": "The lord of that servant shall come in a day when he looketh not for him, and in an hour that he is not aware of,",
      "metadata": {
        "reference": "Matthew 24:50",
        "verseKey": "kjv:matthew:24:50"
      }
    },
    {
      "id": "verse-051",
      "type": "bible_verse",
      "verse": 51,
      "verseId": "kjv:matthew:24:51",
      "numberLabel": "51",
      "text": "And shall cut him asunder, and appoint him his portion with the hypocrites: there shall be weeping and gnashing of teeth.",
      "metadata": {
        "reference": "Matthew 24:51",
        "verseKey": "kjv:matthew:24:51"
      }
    }
  ],
  "source": {
