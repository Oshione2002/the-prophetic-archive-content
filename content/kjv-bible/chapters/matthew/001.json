  "chapter": 1,
  "sortOrder": 40001,
  "verseCount": 25,
  "aliases": [
    "Matt",
    "Mt"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:matthew:1:1",
      "numberLabel": "1",
      "text": "The book of the generation of Jesus Christ, the son of David, the son of Abraham.",
      "metadata": {
        "reference": "Matthew 1:1",
        "verseKey": "kjv:matthew:1:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:matthew:1:2",
      "numberLabel": "2",
      "text": "Abraham begat Isaac; and Isaac begat Jacob; and Jacob begat Judas and his brethren;",
      "metadata": {
        "reference": "Matthew 1:2",
        "verseKey": "kjv:matthew:1:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:matthew:1:3",
      "numberLabel": "3",
      "text": "And Judas begat Phares and Zara of Thamar; and Phares begat Esrom; and Esrom begat Aram;",
      "metadata": {
        "reference": "Matthew 1:3",
        "verseKey": "kjv:matthew:1:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:matthew:1:4",
      "numberLabel": "4",
      "text": "And Aram begat Aminadab; and Aminadab begat Naasson; and Naasson begat Salmon;",
      "metadata": {
        "reference": "Matthew 1:4",
        "verseKey": "kjv:matthew:1:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:matthew:1:5",
      "numberLabel": "5",
      "text": "And Salmon begat Booz of Rachab; and Booz begat Obed of Ruth; and Obed begat Jesse;",
      "metadata": {
        "reference": "Matthew 1:5",
        "verseKey": "kjv:matthew:1:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:matthew:1:6",
      "numberLabel": "6",
      "text": "And Jesse begat David the king; and David the king begat Solomon of her that had been the wife of Urias;",
      "metadata": {
        "reference": "Matthew 1:6",
        "verseKey": "kjv:matthew:1:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:matthew:1:7",
      "numberLabel": "7",
      "text": "And Solomon begat Roboam; and Roboam begat Abia; and Abia begat Asa;",
      "metadata": {
        "reference": "Matthew 1:7",
        "verseKey": "kjv:matthew:1:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:matthew:1:8",
      "numberLabel": "8",
      "text": "And Asa begat Josaphat; and Josaphat begat Joram; and Joram begat Ozias;",
      "metadata": {
        "reference": "Matthew 1:8",
        "verseKey": "kjv:matthew:1:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:matthew:1:9",
      "numberLabel": "9",
      "text": "And Ozias begat Joatham; and Joatham begat Achaz; and Achaz begat Ezekias;",
      "metadata": {
        "reference": "Matthew 1:9",
        "verseKey": "kjv:matthew:1:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:matthew:1:10",
      "numberLabel": "10",
      "text": "And Ezekias begat Manasses; and Manasses begat Amon; and Amon begat Josias;",
      "metadata": {
        "reference": "Matthew 1:10",
        "verseKey": "kjv:matthew:1:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:matthew:1:11",
      "numberLabel": "11",
      "text": "And Josias begat Jechonias and his brethren, about the time they were carried away to Babylon:",
      "metadata": {
        "reference": "Matthew 1:11",
        "verseKey": "kjv:matthew:1:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:matthew:1:12",
      "numberLabel": "12",
      "text": "And after they were brought to Babylon, Jechonias begat Salathiel; and Salathiel begat Zorobabel;",
      "metadata": {
        "reference": "Matthew 1:12",
        "verseKey": "kjv:matthew:1:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:matthew:1:13",
      "numberLabel": "13",
      "text": "And Zorobabel begat Abiud; and Abiud begat Eliakim; and Eliakim begat Azor;",
      "metadata": {
        "reference": "Matthew 1:13",
        "verseKey": "kjv:matthew:1:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:matthew:1:14",
      "numberLabel": "14",
      "text": "And Azor begat Sadoc; and Sadoc begat Achim; and Achim begat Eliud;",
      "metadata": {
        "reference": "Matthew 1:14",
        "verseKey": "kjv:matthew:1:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:matthew:1:15",
      "numberLabel": "15",
      "text": "And Eliud begat Eleazar; and Eleazar begat Matthan; and Matthan begat Jacob;",
      "metadata": {
        "reference": "Matthew 1:15",
        "verseKey": "kjv:matthew:1:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:matthew:1:16",
      "numberLabel": "16",
      "text": "And Jacob begat Joseph the husband of Mary, of whom was born Jesus, who is called Christ.",
      "metadata": {
        "reference": "Matthew 1:16",
        "verseKey": "kjv:matthew:1:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:matthew:1:17",
      "numberLabel": "17",
      "text": "So all the generations from Abraham to David are fourteen generations; and from David until the carrying away into Babylon are fourteen generations; and from the carrying away into Babylon unto Christ are fourteen generations.",
      "metadata": {
        "reference": "Matthew 1:17",
        "verseKey": "kjv:matthew:1:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:matthew:1:18",
      "numberLabel": "18",
      "text": "Now the birth of Jesus Christ was on this wise: When as his mother Mary was espoused to Joseph, before they came together, she was found with child of the Holy Ghost.",
      "metadata": {
        "reference": "Matthew 1:18",
        "verseKey": "kjv:matthew:1:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:matthew:1:19",
      "numberLabel": "19",
      "text": "Then Joseph her husband, being a just man, and not willing to make her a publick example, was minded to put her away privily.",
      "metadata": {
        "reference": "Matthew 1:19",
        "verseKey": "kjv:matthew:1:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:matthew:1:20",
      "numberLabel": "20",
      "text": "But while he thought on these things, behold, the angel of the LORD appeared unto him in a dream, saying, Joseph, thou son of David, fear not to take unto thee Mary thy wife: for that which is conceived in her is of the Holy Ghost.",
      "metadata": {
        "reference": "Matthew 1:20",
        "verseKey": "kjv:matthew:1:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:matthew:1:21",
      "numberLabel": "21",
      "text": "And she shall bring forth a son, and thou shalt call his name JESUS: for he shall save his people from their sins.",
      "metadata": {
        "reference": "Matthew 1:21",
        "verseKey": "kjv:matthew:1:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:matthew:1:22",
      "numberLabel": "22",
      "text": "Now all this was done, that it might be fulfilled which was spoken of the Lord by the prophet, saying,",
      "metadata": {
        "reference": "Matthew 1:22",
        "verseKey": "kjv:matthew:1:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:matthew:1:23",
      "numberLabel": "23",
      "text": "Behold, a virgin shall be with child, and shall bring forth a son, and they shall call his name Emmanuel, which being interpreted is, God with us.",
      "metadata": {
        "reference": "Matthew 1:23",
        "verseKey": "kjv:matthew:1:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:matthew:1:24",
      "numberLabel": "24",
      "text": "Then Joseph being raised from sleep did as the angel of the Lord had bidden him, and took unto him his wife:",
      "metadata": {
        "reference": "Matthew 1:24",
        "verseKey": "kjv:matthew:1:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:matthew:1:25",
      "numberLabel": "25",
      "text": "And knew her not till she had brought forth her firstborn son: and he called his name JESUS.",
      "metadata": {
        "reference": "Matthew 1:25",
        "verseKey": "kjv:matthew:1:25"
      }
    }
  ],
  "source": {
