{
  "schemaVersion": 1,
  "id": "kjv-matthew-010",
  "collection": "kjv-bible",
  "document_type": "bible_chapter",
  "number": 10,
  "title": "Matthew 10",
  "display_title": "Matthew 10",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "matthew",
  "book": "Matthew",
  "bookName": "Matthew",
  "bookOrder": 40,
  "testament": "new",
  "chapter": 10,
  "sortOrder": 40010,
  "verseCount": 42,
  "aliases": [
    "Matt",
    "Mt"
  ],
  "verses": [
    {
      "id": "verse-001",
      "type": "bible_verse",
      "verse": 1,
      "verseId": "kjv:matthew:10:1",
      "numberLabel": "1",
      "text": "And when he had called unto him his twelve disciples, he gave them power against unclean spirits, to cast them out, and to heal all manner of sickness and all manner of disease.",
      "metadata": {
        "reference": "Matthew 10:1",
        "verseKey": "kjv:matthew:10:1"
      }
    },
    {
      "id": "verse-002",
      "type": "bible_verse",
      "verse": 2,
      "verseId": "kjv:matthew:10:2",
      "numberLabel": "2",
      "text": "Now the names of the twelve apostles are these; The first, Simon, who is called Peter, and Andrew his brother; James the son of Zebedee, and John his brother;",
      "metadata": {
        "reference": "Matthew 10:2",
        "verseKey": "kjv:matthew:10:2"
      }
    },
    {
      "id": "verse-003",
      "type": "bible_verse",
      "verse": 3,
      "verseId": "kjv:matthew:10:3",
      "numberLabel": "3",
      "text": "Philip, and Bartholomew; Thomas, and Matthew the publican; James the son of Alphaeus, and Lebbaeus, whose surname was Thaddaeus;",
      "metadata": {
        "reference": "Matthew 10:3",
        "verseKey": "kjv:matthew:10:3"
      }
    },
    {
      "id": "verse-004",
      "type": "bible_verse",
      "verse": 4,
      "verseId": "kjv:matthew:10:4",
      "numberLabel": "4",
      "text": "Simon the Canaanite, and Judas Iscariot, who also betrayed him.",
      "metadata": {
        "reference": "Matthew 10:4",
        "verseKey": "kjv:matthew:10:4"
      }
    },
    {
      "id": "verse-005",
      "type": "bible_verse",
      "verse": 5,
      "verseId": "kjv:matthew:10:5",
      "numberLabel": "5",
      "text": "These twelve Jesus sent forth, and commanded them, saying, Go not into the way of the Gentiles, and into any city of the Samaritans enter ye not:",
      "metadata": {
        "reference": "Matthew 10:5",
        "verseKey": "kjv:matthew:10:5"
      }
    },
    {
      "id": "verse-006",
      "type": "bible_verse",
      "verse": 6,
      "verseId": "kjv:matthew:10:6",
      "numberLabel": "6",
      "text": "But go rather to the lost sheep of the house of Israel.",
      "metadata": {
        "reference": "Matthew 10:6",
        "verseKey": "kjv:matthew:10:6"
      }
    },
    {
      "id": "verse-007",
      "type": "bible_verse",
      "verse": 7,
      "verseId": "kjv:matthew:10:7",
      "numberLabel": "7",
      "text": "And as ye go, preach, saying, The kingdom of heaven is at hand.",
      "metadata": {
        "reference": "Matthew 10:7",
        "verseKey": "kjv:matthew:10:7"
      }
    },
    {
      "id": "verse-008",
      "type": "bible_verse",
      "verse": 8,
      "verseId": "kjv:matthew:10:8",
      "numberLabel": "8",
      "text": "Heal the sick, cleanse the lepers, raise the dead, cast out devils: freely ye have received, freely give.",
      "metadata": {
        "reference": "Matthew 10:8",
        "verseKey": "kjv:matthew:10:8"
      }
    },
    {
      "id": "verse-009",
      "type": "bible_verse",
      "verse": 9,
      "verseId": "kjv:matthew:10:9",
      "numberLabel": "9",
      "text": "Provide neither gold, nor silver, nor brass in your purses,",
      "metadata": {
        "reference": "Matthew 10:9",
        "verseKey": "kjv:matthew:10:9"
      }
    },
    {
      "id": "verse-010",
      "type": "bible_verse",
      "verse": 10,
      "verseId": "kjv:matthew:10:10",
      "numberLabel": "10",
      "text": "Nor scrip for your journey, neither two coats, neither shoes, nor yet staves: for the workman is worthy of his meat.",
      "metadata": {
        "reference": "Matthew 10:10",
        "verseKey": "kjv:matthew:10:10"
      }
    },
    {
      "id": "verse-011",
      "type": "bible_verse",
      "verse": 11,
      "verseId": "kjv:matthew:10:11",
      "numberLabel": "11",
      "text": "And into whatsoever city or town ye shall enter, enquire who in it is worthy; and there abide till ye go thence.",
      "metadata": {
        "reference": "Matthew 10:11",
        "verseKey": "kjv:matthew:10:11"
      }
    },
    {
      "id": "verse-012",
      "type": "bible_verse",
      "verse": 12,
      "verseId": "kjv:matthew:10:12",
      "numberLabel": "12",
      "text": "And when ye come into an house, salute it.",
      "metadata": {
        "reference": "Matthew 10:12",
        "verseKey": "kjv:matthew:10:12"
      }
    },
    {
      "id": "verse-013",
      "type": "bible_verse",
      "verse": 13,
      "verseId": "kjv:matthew:10:13",
      "numberLabel": "13",
      "text": "And if the house be worthy, let your peace come upon it: but if it be not worthy, let your peace return to you.",
      "metadata": {
        "reference": "Matthew 10:13",
        "verseKey": "kjv:matthew:10:13"
      }
    },
    {
      "id": "verse-014",
      "type": "bible_verse",
      "verse": 14,
      "verseId": "kjv:matthew:10:14",
      "numberLabel": "14",
      "text": "And whosoever shall not receive you, nor hear your words, when ye depart out of that house or city, shake off the dust of your feet.",
      "metadata": {
        "reference": "Matthew 10:14",
        "verseKey": "kjv:matthew:10:14"
      }
    },
    {
      "id": "verse-015",
      "type": "bible_verse",
      "verse": 15,
      "verseId": "kjv:matthew:10:15",
      "numberLabel": "15",
      "text": "Verily I say unto you, It shall be more tolerable for the land of Sodom and Gomorrha in the day of judgment, than for that city.",
      "metadata": {
        "reference": "Matthew 10:15",
        "verseKey": "kjv:matthew:10:15"
      }
    },
    {
      "id": "verse-016",
      "type": "bible_verse",
      "verse": 16,
      "verseId": "kjv:matthew:10:16",
      "numberLabel": "16",
      "text": "Behold, I send you forth as sheep in the midst of wolves: be ye therefore wise as serpents, and harmless as doves.",
      "metadata": {
        "reference": "Matthew 10:16",
        "verseKey": "kjv:matthew:10:16"
      }
    },
    {
      "id": "verse-017",
      "type": "bible_verse",
      "verse": 17,
      "verseId": "kjv:matthew:10:17",
      "numberLabel": "17",
      "text": "But beware of men: for they will deliver you up to the councils, and they will scourge you in their synagogues;",
      "metadata": {
        "reference": "Matthew 10:17",
        "verseKey": "kjv:matthew:10:17"
      }
    },
    {
      "id": "verse-018",
      "type": "bible_verse",
      "verse": 18,
      "verseId": "kjv:matthew:10:18",
      "numberLabel": "18",
      "text": "And ye shall be brought before governors and kings for my sake, for a testimony against them and the Gentiles.",
      "metadata": {
        "reference": "Matthew 10:18",
        "verseKey": "kjv:matthew:10:18"
      }
    },
    {
      "id": "verse-019",
      "type": "bible_verse",
      "verse": 19,
      "verseId": "kjv:matthew:10:19",
      "numberLabel": "19",
      "text": "But when they deliver you up, take no thought how or what ye shall speak: for it shall be given you in that same hour what ye shall speak.",
      "metadata": {
        "reference": "Matthew 10:19",
        "verseKey": "kjv:matthew:10:19"
      }
    },
    {
      "id": "verse-020",
      "type": "bible_verse",
      "verse": 20,
      "verseId": "kjv:matthew:10:20",
      "numberLabel": "20",
      "text": "For it is not ye that speak, but the Spirit of your Father which speaketh in you.",
      "metadata": {
        "reference": "Matthew 10:20",
        "verseKey": "kjv:matthew:10:20"
      }
    },
    {
      "id": "verse-021",
      "type": "bible_verse",
      "verse": 21,
      "verseId": "kjv:matthew:10:21",
      "numberLabel": "21",
      "text": "And the brother shall deliver up the brother to death, and the father the child: and the children shall rise up against their parents, and cause them to be put to death.",
      "metadata": {
        "reference": "Matthew 10:21",
        "verseKey": "kjv:matthew:10:21"
      }
    },
    {
      "id": "verse-022",
      "type": "bible_verse",
      "verse": 22,
      "verseId": "kjv:matthew:10:22",
      "numberLabel": "22",
      "text": "And ye shall be hated of all men for my name’s sake: but he that endureth to the end shall be saved.",
      "metadata": {
        "reference": "Matthew 10:22",
        "verseKey": "kjv:matthew:10:22"
      }
    },
    {
      "id": "verse-023",
      "type": "bible_verse",
      "verse": 23,
      "verseId": "kjv:matthew:10:23",
      "numberLabel": "23",
      "text": "But when they persecute you in this city, flee ye into another: for verily I say unto you, Ye shall not have gone over the cities of Israel, till the Son of man be come.",
      "metadata": {
        "reference": "Matthew 10:23",
        "verseKey": "kjv:matthew:10:23"
      }
    },
    {
      "id": "verse-024",
      "type": "bible_verse",
      "verse": 24,
      "verseId": "kjv:matthew:10:24",
      "numberLabel": "24",
      "text": "The disciple is not above his master, nor the servant above his lord.",
      "metadata": {
        "reference": "Matthew 10:24",
        "verseKey": "kjv:matthew:10:24"
      }
    },
    {
      "id": "verse-025",
      "type": "bible_verse",
      "verse": 25,
      "verseId": "kjv:matthew:10:25",
      "numberLabel": "25",
      "text": "It is enough for the disciple that he be as his master, and the servant as his lord. If they have called the master of the house Beelzebub, how much more shall they call them of his household?",
      "metadata": {
        "reference": "Matthew 10:25",
        "verseKey": "kjv:matthew:10:25"
      }
    },
    {
      "id": "verse-026",
      "type": "bible_verse",
      "verse": 26,
      "verseId": "kjv:matthew:10:26",
      "numberLabel": "26",
      "text": "Fear them not therefore: for there is nothing covered, that shall not be revealed; and hid, that shall not be known.",
      "metadata": {
        "reference": "Matthew 10:26",
        "verseKey": "kjv:matthew:10:26"
      }
    },
    {
      "id": "verse-027",
      "type": "bible_verse",
      "verse": 27,
      "verseId": "kjv:matthew:10:27",
      "numberLabel": "27",
      "text": "What I tell you in darkness, that speak ye in light: and what ye hear in the ear, that preach ye upon the housetops.",
      "metadata": {
        "reference": "Matthew 10:27",
        "verseKey": "kjv:matthew:10:27"
      }
    },
    {
      "id": "verse-028",
      "type": "bible_verse",
      "verse": 28,
      "verseId": "kjv:matthew:10:28",
      "numberLabel": "28",
      "text": "And fear not them which kill the body, but are not able to kill the soul: but rather fear him which is able to destroy both soul and body in hell.",
      "metadata": {
        "reference": "Matthew 10:28",
        "verseKey": "kjv:matthew:10:28"
      }
    },
    {
      "id": "verse-029",
      "type": "bible_verse",
      "verse": 29,
      "verseId": "kjv:matthew:10:29",
      "numberLabel": "29",
      "text": "Are not two sparrows sold for a farthing? and one of them shall not fall on the ground without your Father.",
      "metadata": {
        "reference": "Matthew 10:29",
        "verseKey": "kjv:matthew:10:29"
      }
    },
    {
      "id": "verse-030",
      "type": "bible_verse",
      "verse": 30,
      "verseId": "kjv:matthew:10:30",
      "numberLabel": "30",
      "text": "But the very hairs of your head are all numbered.",
      "metadata": {
        "reference": "Matthew 10:30",
        "verseKey": "kjv:matthew:10:30"
      }
    },
    {
      "id": "verse-031",
      "type": "bible_verse",
      "verse": 31,
      "verseId": "kjv:matthew:10:31",
      "numberLabel": "31",
      "text": "Fear ye not therefore, ye are of more value than many sparrows.",
      "metadata": {
        "reference": "Matthew 10:31",
        "verseKey": "kjv:matthew:10:31"
      }
    },
    {
      "id": "verse-032",
      "type": "bible_verse",
      "verse": 32,
      "verseId": "kjv:matthew:10:32",
      "numberLabel": "32",
      "text": "Whosoever therefore shall confess me before men, him will I confess also before my Father which is in heaven.",
      "metadata": {
        "reference": "Matthew 10:32",
        "verseKey": "kjv:matthew:10:32"
      }
    },
    {
      "id": "verse-033",
      "type": "bible_verse",
      "verse": 33,
      "verseId": "kjv:matthew:10:33",
      "numberLabel": "33",
      "text": "But whosoever shall deny me before men, him will I also deny before my Father which is in heaven.",
      "metadata": {
        "reference": "Matthew 10:33",
        "verseKey": "kjv:matthew:10:33"
      }
    },
    {
      "id": "verse-034",
      "type": "bible_verse",
      "verse": 34,
      "verseId": "kjv:matthew:10:34",
      "numberLabel": "34",
      "text": "Think not that I am come to send peace on earth: I came not to send peace, but a sword.",
      "metadata": {
        "reference": "Matthew 10:34",
        "verseKey": "kjv:matthew:10:34"
      }
    },
    {
      "id": "verse-035",
      "type": "bible_verse",
      "verse": 35,
      "verseId": "kjv:matthew:10:35",
      "numberLabel": "35",
      "text": "For I am come to set a man at variance against his father, and the daughter against her mother, and the daughter in law against her mother in law.",
      "metadata": {
        "reference": "Matthew 10:35",
        "verseKey": "kjv:matthew:10:35"
      }
    },
    {
      "id": "verse-036",
      "type": "bible_verse",
      "verse": 36,
      "verseId": "kjv:matthew:10:36",
      "numberLabel": "36",
      "text": "And a man’s foes shall be they of his own household.",
      "metadata": {
        "reference": "Matthew 10:36",
        "verseKey": "kjv:matthew:10:36"
      }
    },
    {
      "id": "verse-037",
      "type": "bible_verse",
      "verse": 37,
      "verseId": "kjv:matthew:10:37",
      "numberLabel": "37",
      "text": "He that loveth father or mother more than me is not worthy of me: and he that loveth son or daughter more than me is not worthy of me.",
      "metadata": {
        "reference": "Matthew 10:37",
        "verseKey": "kjv:matthew:10:37"
      }
    },
    {
      "id": "verse-038",
      "type": "bible_verse",
      "verse": 38,
      "verseId": "kjv:matthew:10:38",
      "numberLabel": "38",
      "text": "And he that taketh not his cross, and followeth after me, is not worthy of me.",
      "metadata": {
        "reference": "Matthew 10:38",
        "verseKey": "kjv:matthew:10:38"
      }
    },
    {
      "id": "verse-039",
      "type": "bible_verse",
      "verse": 39,
      "verseId": "kjv:matthew:10:39",
      "numberLabel": "39",
      "text": "He that findeth his life shall lose it: and he that loseth his life for my sake shall find it.",
      "metadata": {
        "reference": "Matthew 10:39",
        "verseKey": "kjv:matthew:10:39"
      }
    },
    {
      "id": "verse-040",
      "type": "bible_verse",
      "verse": 40,
      "verseId": "kjv:matthew:10:40",
      "numberLabel": "40",
      "text": "He that receiveth you receiveth me, and he that receiveth me receiveth him that sent me.",
      "metadata": {
        "reference": "Matthew 10:40",
        "verseKey": "kjv:matthew:10:40"
      }
    },
    {
      "id": "verse-041",
      "type": "bible_verse",
      "verse": 41,
      "verseId": "kjv:matthew:10:41",
      "numberLabel": "41",
      "text": "He that receiveth a prophet in the name of a prophet shall receive a prophet’s reward; and he that receiveth a righteous man in the name of a righteous man shall receive a righteous man’s reward.",
      "metadata": {
        "reference": "Matthew 10:41",
        "verseKey": "kjv:matthew:10:41"
      }
    },
    {
      "id": "verse-042",
      "type": "bible_verse",
      "verse": 42,
      "verseId": "kjv:matthew:10:42",
      "numberLabel": "42",
      "text": "And whosoever shall give to drink unto one of these little ones a cup of cold water only in the name of a disciple, verily I say unto you, he shall in no wise lose his reward.",
      "metadata": {
        "reference": "Matthew 10:42",
        "verseKey": "kjv:matthew:10:42"
      }
    }
  ],
  "source": {
    "repository": "aruljohn/Bible-kjv",
