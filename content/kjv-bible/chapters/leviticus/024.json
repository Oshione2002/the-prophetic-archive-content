  "document_type": "bible_chapter",
  "number": 24,
  "title": "Leviticus 24",
  "display_title": "Leviticus 24",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "leviticus",
  "book": "Leviticus",
  "bookName": "Leviticus",
