  "document_type": "bible_chapter",
  "number": 4,
  "title": "1 John 4",
  "display_title": "1 John 4",
  "translation": "King James Version",
  "translationCode": "KJV",
  "bookId": "1-john",
  "book": "1 John",
  "bookName": "1 John",
